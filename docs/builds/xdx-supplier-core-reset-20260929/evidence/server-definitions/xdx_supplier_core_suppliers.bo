{
  "supportedObjectId": "300000334169602",
  "name": "XDX Supplier Core Suppliers",
  "description": "Query suppliers with explicit framework filters and create an exactly reviewed required-field supplier.",
  "objectCode": "XDX_SUPPLIER_CORE_SUPPLIERS",
  "family": "PRC",
  "product": "SUPPLIER",
  "objectSource": "ADF_BC",
  "restResourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers",
  "seededFlag": false,
  "mandatoryFlag": false,
  "objectProperties": {
    "jsonSchemaName": "supportedObjectProperties",
    "jsonSchemaVersion": 1,
    "tools": [
      {
        "name": "ListSuppliers",
        "description": "List or find suppliers using validated framework4 q, deterministic ordering and explicit paging. Preserve service errors.",
        "operationId": "getall_suppliers",
        "operationType": "GET",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers?q={q}&limit={limit}&offset={offset}&orderBy=SupplierId:asc&fields=SupplierId,SupplierNumber,Supplier,SupplierType,BusinessRelationship,InactiveDate&onlyData=true",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "q",
            "dataType": "string",
            "description": "Trusted allowlisted escaped framework4 filter; use SupplierId>0 for ordinary list.",
            "id": 2,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "limit",
            "dataType": "integer",
            "description": "Validated positive bounded page size.",
            "id": 3,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "offset",
            "dataType": "integer",
            "description": "Validated nonnegative offset; preserve filter across pages.",
            "id": 4,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "headers": {
          "REST-Framework-Version": "4"
        },
