        "resourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers/{suppliers_Id}/child/sites",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\"SupplierSite\":\"{SupplierSite}\",\"ProcurementBUId\":\"{ProcurementBUId}\",\"SupplierAddressName\":\"{SupplierAddressName}\",\"SitePurposePurchasingFlag\":true}",
