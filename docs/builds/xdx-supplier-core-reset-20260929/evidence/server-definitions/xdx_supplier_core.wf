          "metadata": {
            "name": "shape site bu",
            "sourceCode": "// SITE_BU_INPUT converges SHAPE_SITE_ADDRESS and NORMALIZE_SITE continuation.\nvar request=$context.$nodes.SITE_BU_INPUT.$output.result,state=JSON.parse(JSON.stringify(request.state)),draft=state.siteDraft,response=$context.$nodes.LIST_SITE_BUSINESS_UNITS.$output;\nvar result={route:'display',resource:'site',state:state,draft:draft,message:''},lookup=draft&&draft.buLookup;\nfunction fail(message){if(lookup){lookup.complete=false;lookup.failed=true;}result.message=message+' No site create was submitted. Prepare the site again to restart lookup.';return result;}\nvar blocked=['draft','addressDraft','contactDraft','siteDraft'].some(function(k){return state[k]&&['reserved','uncertain'].indexOf(state[k].status)>=0;});\nif(blocked||!draft||draft.status!=='draft'||!lookup||lookup.failed||lookup.complete||lookup.revision!==draft.revision||lookup.parentId!==draft.parent.SupplierId||request.route!=='bu'||!request.parent||request.parent.SupplierId!==draft.parent.SupplierId||!request.query||request.query.q!=='ProcurementBUId>0'||request.query.limit!==100||request.query.offset!==lookup.nextOffset)return fail('Lookup state is stale or inconsistent.');\nif(!response||!Array.isArray(response.items)||!Number.isSafeInteger(response.count)||response.count!==response.items.length||response.count<0||response.count>100||response.limit!==100||response.offset!==lookup.nextOffset||typeof response.hasMore!=='boolean'||(response.hasMore&&response.count===0))return fail('BU service response did not provide a valid paging envelope.');\nfor(var i=0;i<response.items.length;i++){var row=response.items[i];if(!row||typeof row!=='object'||Array.isArray(row))return fail('BU row is not a valid object.');var id=String(row.ProcurementBUId),name=row.ProcurementBU;if(!/^[1-9][0-9]*$/.test(id)||!Number.isSafeInteger(Number(id))||typeof name!=='string'||!name.trim()||/[\\u0000-\\u001f]/.test(name))return fail('BU row has an invalid ID or name.');if(Object.prototype.hasOwnProperty.call(lookup.choices,id)&&lookup.choices[id]!==name)return fail('The same BU ID has conflicting names.');lookup.choices[id]=name;}\nlookup.pages++;var next=lookup.nextOffset+response.count;if(!Number.isSafeInteger(next))return fail('BU pagination exceeded safe bounds.');lookup.nextOffset=next;\nif(response.hasMore){result.nextCommand='Continue site lookup '+draft.requestId+' revision '+draft.revision+' offset '+next;result.message='BU lookup is incomplete. Continue before selecting or reviewing: '+result.nextCommand;return result;}\nlookup.complete=true;result.businessUnits=Object.keys(lookup.choices).map(function(id){return {ProcurementBUId:Number(id),ProcurementBU:lookup.choices[id]};});\nresult.message=lookup.choices[String(draft.payload.ProcurementBUId)]?'Complete current BU lookup and exact supplier address resolved. Review site '+draft.requestId+' revision '+draft.revision:'Select a listed BU using Site ProcurementBUId: followed by its numeric ID. No create was submitted.';return result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
