          },
          "inputs": [
            {
              "id": "verify_created_site_suppliers_Id",
              "name": "suppliers_Id",
              "type": "string",
              "value": "{{$context.$nodes.CAPTURE_SITE.$output.result.parent.SupplierId}}"
            },
            {
              "id": "verify_created_site_suppliers_sites_Id",
