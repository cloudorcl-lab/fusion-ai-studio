{
  "workflowId": "300000334168954",
  "workflowCode": "XDX_SUPPLIER_CORE",
  "name": "XDX Supplier Core",
  "description": "Query and create suppliers and their addresses, sites and contacts with exact payload approval, parent-scoped child operations and independent persisted verification.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
