        {
          "id": "reserve_address",
          "code": "RESERVE_ADDRESS",
          "type": "CODE",
          "metadata": {
            "name": "reserve address",
            "sourceCode": "var request = $context.$nodes.NORMALIZE_ADDRESS.$output.result;\nvar state = JSON.parse(JSON.stringify(request.state));\nvar draft = state.addressDraft;\nvar response = $context.$nodes.CHECK_ADDRESS_DUPLICATE.$output;\nvar result = { route: 'display', resource: 'address', state: state, draft: draft, message: '' };\nvar blocked = ['draft', 'addressDraft', 'contactDraft', 'siteDraft'].some(function (key) { return state[key] && ['reserved', 'uncertain'].indexOf(state[key].status) >= 0; });\nvar fields = ['AddressName', 'CountryCode', 'AddressLine1', 'City', 'State', 'PostalCode', 'Email', 'AddressPurposeOrderingFlag'];\nvar payload = {};\nif (draft) fields.forEach(function (key) { payload[key] = draft.payload[key]; });\nvar exact = draft ? JSON.stringify({ supplierId: draft.parent.SupplierId, payload: payload }) : '';\nif (blocked || !draft || draft.status !== 'draft' || request.route !== 'duplicate' || draft.approvedRevision !== draft.revision || draft.approvedPayload !== exact ||\n    draft.reviewedRevision !== draft.revision || draft.reviewedPayload !== exact) {\n  result.message = 'The exact address and parent approval is no longer eligible.'; return result;\n}\nif (!response || !Array.isArray(response.items) || response.items.length || response.count !== 0 || response.hasMore !== false) {\n  result.message = 'Duplicate check did not prove absence within this supplier. No create was submitted.'; return result;\n}\ndraft.status = 'reserved'; draft.attempt = { requestId: draft.requestId, revision: draft.revision, approved: exact, jobId: String($context.$workflow.$jobId || '') };\nresult.route = 'create'; result.parent = draft.parent; result.payload = payload;\nresult.message = 'Address create reserved; uncertain outcomes must be reconciled without replay.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_address_reservation"
          },
          "inputs": [],
          "diagram": {
            "x": 6350,
            "y": 7204
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
