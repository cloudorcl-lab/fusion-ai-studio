          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplierContactId\": {\n            \"type\": \"number\"\n          },\n          \"ContactName\": {\n            \"type\": \"string\"\n          },\n          \"FirstName\": {\n            \"type\": \"string\"\n          },\n          \"LastName\": {\n            \"type\": \"string\"\n          },\n          \"Email\": {\n            \"type\": \"string\"\n          },\n          \"PersonProfileId\": {\n            \"type\": \"number\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"InactiveDate\": {\n            \"type\": \"null\"\n          },\n          \"UserName\": {\n            \"type\": \"null\"\n          },\n          \"UserAccountStatus\": {\n            \"type\": \"null\"\n          }\n        },\n        \"required\": [\n          \"SupplierContactId\",\n          \"ContactName\",\n          \"FirstName\",\n          \"LastName\",\n          \"Email\",\n          \"PersonProfileId\",\n          \"Status\",\n          \"InactiveDate\",\n          \"UserName\",\n          \"UserAccountStatus\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "shape_contact_list",
          "code": "SHAPE_CONTACT_LIST",
          "type": "CODE",
          "metadata": {
            "name": "shape contact list",
            "sourceCode": "var request = $context.$nodes.SHAPE_CONTACT_PARENT.$output.result;\nvar response = $context.$nodes.LIST_CONTACTS.$output;\nvar result = { route: 'display', resource: 'contact', parent: request.parent, state: request.state, rows: [], message: '', nextCommand: null };\nif (!response || !Array.isArray(response.items) || typeof response.hasMore !== 'boolean' || response.count !== response.items.length ||\n    !Number.isSafeInteger(response.count) || response.count < 0 || response.count > request.query.limit || response.offset !== request.query.offset || response.limit !== request.query.limit || (response.hasMore && response.count === 0) ||\n    response.items.some(function (row) { return !row || !/^[1-9][0-9]*$/.test(String(row.SupplierContactId)); })) { result.message = 'The contact response was incomplete or its paging envelope did not match.'; return result; }\nresult.rows = response.items.map(function (row) { return { SupplierContactId: row.SupplierContactId, ContactName: row.ContactName, FirstName: row.FirstName, LastName: row.LastName, Email: row.Email, PersonProfileId: row.PersonProfileId, Status: row.Status, InactiveDate: row.InactiveDate }; });\nif (request.query.detail) {\n  if (result.rows.length !== 1 || response.hasMore) { result.message = 'Contact detail requires one exact match within this supplier.'; return result; }\n  result.contactId = String(result.rows[0].SupplierContactId); result.route = 'detail'; return result;\n}\nif (response.hasMore) result.nextCommand = 'List contacts for supplier ' + request.parent.SupplierNumber + ' offset ' + (request.query.offset + response.count) + ' limit ' + request.query.limit + ' filter ' + JSON.stringify(request.query.filter);\nresult.message = result.rows.length ? 'Showing ' + result.rows.length + ' contacts for supplier ' + request.parent.SupplierNumber + ' at offset ' + request.query.offset + '.' : 'No contacts matched within this supplier.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "route_contact_list"
          },
          "inputs": [],
          "diagram": {
            "x": 7137.5,
            "y": 8092
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
