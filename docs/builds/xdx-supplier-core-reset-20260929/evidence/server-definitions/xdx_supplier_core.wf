          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplierAddressId\": {\n            \"type\": \"number\"\n          },\n          \"AddressName\": {\n            \"type\": \"string\"\n          },\n          \"CountryCode\": {\n            \"type\": \"string\"\n          },\n          \"Country\": {\n            \"type\": \"string\"\n          },\n          \"AddressLine1\": {\n            \"type\": \"string\"\n          },\n          \"AddressLine2\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"AddressLine3\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"AddressLine4\": {\n            \"type\": \"null\"\n          },\n          \"City\": {\n            \"type\": \"string\"\n          },\n          \"State\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"PostalCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"PostalCodeExtension\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Province\": {\n            \"anyOf\"