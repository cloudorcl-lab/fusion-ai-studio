QOrBiddingFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"PhoneCountryCode\": {\n            \"type\": \"null\"\n          },\n          \"PhoneAreaCode\": {\n            \"type\": \"null\"\n          },\n          \"PhoneNumber\": {\n            \"type\": \"null\"\n          },\n          \"PhoneExtension\": {\n            \"type\": \"null\"\n          },\n          \"FaxCountryCode\": {\n            \"type\": \"null\"\n          },\n          \"FaxAreaCode\": {\n            \"type\": \"null\"\n          },\n          \"FaxNumber\": {\n            \"type\": \"null\"\n          },\n          \"Email\": {\n            \"type\": \"null\"\n          },\n          \"InactiveDate\": {\n            \"type\": \"string\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"CreatedBy\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"AddressPartyNumber\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"SupplierAddressId\",\n          \"AddressName\",\n          \"CountryCode\",\n          \"Country\",\n          \"AddressLine1\",\n          \"AddressLine2\",\n          \"AddressLine3\",\n          \"AddressLine4\",\n          \"City\",\n          \"State\",\n          \"PostalCode\",\n          \"PostalCodeExtension\",\n          \"Province\",\n          \"County\",\n          \"Building\",\n          \"FloorNumber\",\n          \"PhoneticAddress\",\n          \"LanguageCode\",\n          \"Language\",\n          \"Addressee\",\n          \"GlobalLocationNumber\",\n          \"AdditionalAddressAttribute1\",\n          \"AdditionalAddressAttribute2\",\n          \"AdditionalAddressAttribute3\",\n          \"AdditionalAddressAttribute4\",\n          \"AdditionalAddressAttribute5\",\n          \"FormattedAddress\",\n          \"AddressPurposeOrderingFlag\",\n          \"AddressPurposeRemitToFlag\",\n          \"AddressPurposeRFQOrBiddingFlag\",\n          \"PhoneCountryCode\",\n          \"PhoneAreaCode\",\n          \"PhoneNumber\",\n          \"PhoneExtension\",\n          \"FaxCountryCode\",\n          \"FaxAreaCode\",\n          \"FaxNumber\",\n          \"Email\",\n          \"InactiveDate\",\n          \"Status\",\n          \"CreationDate\",\n          \"CreatedBy\",\n          \"LastUpdateDate\",\n          \"LastUpdatedBy\",\n          \"AddressPartyNumber\"\n        ],\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
