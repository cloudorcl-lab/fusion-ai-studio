        {
          "id": "normalize_address",
          "code": "NORMALIZE_ADDRESS",
          "type": "CODE",
          "metadata": {
            "name": "normalize address",
            "sourceCode": "// Address state is separate from the supplier draft. Only exact raw controls authorize writes.\nvar request = $context.$nodes.NORMALIZE_REQUEST.$output.result;\nvar state = JSON.parse(JSON.stringify(request.state));\nvar extracted = $context.$nodes.EXTRACT_REQUEST.$output || {};\nvar raw = String($context.$system.$inputMessage || '').trim();\nvar draft = state.addressDraft || null;\nvar result = { route: 'display', resource: 'address', state: state, message: '', draft: draft };\nvar fields = ['AddressName', 'CountryCode', 'AddressLine1', 'City', 'State', 'PostalCode', 'Email', 'AddressPurposeOrderingFlag'];\nfunction literal(value) { return \"'\" + String(value).replace(/'/g, \"''\") + \"'\"; }\nfunction frozen(value) { return value && ['reserved', 'uncertain', 'accepted'].indexOf(value.status) >= 0; }\nfunction blocked() { return ['draft', 'addressDraft', 'contactDraft', 'siteDraft'].some(function (key) { return state[key] && ['reserved', 'uncertain'].indexOf(state[key].status) >= 0; }); }\nfunction canonical(value) {\n  var payload = {}; fields.forEach(function (key) { payload[key] = value.payload[key]; });\n  return JSON.stringify({ supplierId: value.parent.SupplierId, payload: payload });\n}\nfunction valid(value) {\n  return value && value.parent && /^[1-9][0-9]*$/.test(String(value.parent.SupplierId)) &&\n    fields.every(function (key) { return key === 'AddressPurposeOrderingFlag' ? value.payload[key] === true : typeof value.payload[key] === 'string' && !!value.payload[key].trim() && !/[\\u0000-\\u001f]/.test(value.payload[key]); });\n}\nvar control = /^(Review|Approve|Create) address ([A-Za-z0-9_-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nvar edit = /^(?:(Address)\\s+)?(AddressName|CountryCode|AddressLine1|City|State|PostalCode|Email|AddressPurposeOrderingFlag)\\s*:\\s*([\\s\\S]+)$/i.exec(raw);\nvar page = /^List addresses for supplier ([0-9]+) offset ([0-9]+) limit ([0-9]+) filter (\\{[\\s\\S]*\\})$/i.exec(raw);\nvar intent = control ? control[1].toLowerCase() : edit ? 'edit' : page ? 'list' : String(extracted.intent || 'help');\nif (edit && edit[2].toLowerCase() === 'email' && !edit[1] && state.editResource !== 'address') { result.message = 'Specify Address Email: followed by the value, or prepare/select the address draft first. No draft was changed.'; return result; }\nif (['review', 'approve', 'create'].indexOf(intent) >= 0) {\n  if (!control || !draft || control[2] !== draft.requestId || Number(control[3]) !== draft.revision) {\n    result.message = 'Use the exact displayed address request and revision command. No create was submitted.'; return result;\n  }\n  if (frozen(draft) || blocked()) { result.message = 'A prior request is frozen or awaiting reconciliation. No new create was submitted.'; return result; }\n  if (!valid(draft)) { result.message = 'Complete all eight address fields and a verified supplier parent before review. Ordering must be true.'; return result; }\n  var exact = canonical(draft);\n  if (intent === 'review') {\n    draft.reviewedRevision = draft.revision; draft.reviewedPayload = exact;\n    state.editResource = 'address';\n    result.message = 'Review this address payload and supplier parent. Approval command: Approve address ' + draft.requestId + ' revision ' + draft.revision;\n  } else if (draft.reviewedRevision !== draft.revision || draft.reviewedPayload !== exact) {\n    result.message = 'Review the current address revision and parent before approving or creating.';\n  } else if (intent === 'approve') {\n    draft.approvedRevision = draft.revision; draft.approvedPayload = exact;\n    result.message = 'Approved this exact address and parent. Create command: Create address ' + draft.requestId + ' revision ' + draft.revision;\n  } else if (draft.approvedRevision === draft.revision && draft.approvedPayload === exact && !blocked()) {\n    result.route = 'duplicate'; result.parent = draft.parent;\n    result.query = { q: 'AddressName=' + literal(draft.payload.AddressName), limit: 2, offset: 0 };\n  } else result.message = 'An exact current approval and reconciled prior attempts are required before creating.';\n  return result;\n}\nif (intent === 'edit' || intent === 'prepare') {\n  if (blocked() || frozen(draft)) { result.message = 'A prior request must remain frozen. No address change or new create was submitted.'; return result; }\n  var patch = extracted.addressPatch || {};\n  if (edit) {\n    patch = {}; var key = fields.filter(function (f) { return f.toLowerCase() === edit[2].toLowerCase(); })[0];\n    patch[key] = key === 'AddressPurposeOrderingFlag' ? edit[3].trim().toLowerCase() === 'true' : edit[3].trim();\n  }\n  if (!patch || typeof patch !== 'object' || Array.isArray(patch) || Object.keys(patch).some(function (key) {\n    return fields.indexOf(key) < 0 || (key === 'AddressPurposeOrderingFlag' ? patch[key] !== true : typeof patch[key] !== 'string' || /[\\u0000-\\u001f]/.test(patch[key]));\n  })) { result.message = 'Only the eight address fields are editable. Ordering must be the boolean true; false is not supported by this create contract.'; return result; }\n  if (!draft) {\n    if (intent === 'edit') { result.message = 'Prepare an address for a supplier number first.'; return result; }\n    var number = String(extracted.parentNumber || '');\n    if (!/^[0-9]+$/.test(number)) { result.message = 'Specify the supplier number for the new address.'; return result; }\n    result.route = 'parent'; result.pending = { intent: 'prepare', patch: patch, parentNumber: number };\n    result.parentQuery = { q: 'SupplierNumber=' + literal(number), limit: 2, offset: 0 }; return result;\n  }\n  if (!edit && extracted.parentNumber && String(extracted.parentNumber) !== String(draft.parent.SupplierNumber)) {\n    result.message = 'This address draft belongs to supplier ' + draft.parent.SupplierNumber + '. Parent changes require a separate reviewed request.'; return result;\n  }\n  var changed = false;\n  fields.forEach(function (key) { if (Object.prototype.hasOwnProperty.call(patch, key) && patch[key] !== draft.payload[key]) { draft.payload[key] = patch[key]; changed = true; } });\n  if (changed) {\n    draft.revision += 1; draft.reviewedRevision = null; draft.reviewedPayload = null; draft.approvedRevision = null; draft.approvedPayload = null;\n  }\n  state.editResource = 'address';\n  result.message = 'Address draft revision ' + draft.revision + '. Review command: Review address ' + draft.requestId + ' revision ' + draft.revision;\n  return result;\n}\nif (['list', 'search', 'detail'].indexOf(intent) >= 0) {\n  var parentNumber = page ? page[1] : String(extracted.parentNumber || '');\n  var offset = page ? Number(page[2]) : 0, limit = page ? Number(page[3]) : 10;\n  var filter = { field: 'all', value: '' };\n  if (page) { try { filter = JSON.parse(page[4]); } catch (e) { result.message = 'Invalid address paging filter.'; return result; } }\n  else if (extracted.addressId) filter = { field: 'SupplierAddressId', value: String(extracted.addressId) };\n  else if (extracted.addressName) filter = { field: 'AddressName', value: String(extracted.addressName) };\n  else if (extracted.city) filter = { field: 'City', value: String(extracted.city) };\n  if (!/^[0-9]+$/.test(parentNumber) || !Number.isSafeInteger(offset) || offset < 0 || !Number.isSafeInteger(limit) || limit < 1 || limit > 25 ||\n      !filter || ['all', 'SupplierAddressId', 'AddressName', 'City'].indexOf(filter.field) < 0 || typeof filter.value !== 'string' || /[\\u0000-\\u001f]/.test(filter.value) ||\n      (filter.field === 'SupplierAddressId' && !/^[1-9][0-9]*$/.test(filter.value)) || (filter.field !== 'all' && !filter.value.trim())) {\n    result.message = 'Specify a supplier number and valid bounded address filter.'; return result;\n  }\n  if (intent === 'detail' && ['SupplierAddressId', 'AddressName'].indexOf(filter.field) < 0) { result.message = 'Address detail needs its ID or exact name within the supplier.'; return result; }\n  var q = filter.field === 'all' ? 'SupplierAddressId>0' : filter.field + '=' + (filter.field === 'SupplierAddressId' ? filter.value : literal(filter.value));\n  result.route = 'parent'; result.pending = { intent: intent, parentNumber: parentNumber, query: { q: q, limit: limit, offset: offset, filter: filter, detail: intent === 'detail' } };\n  result.parentQuery = { q: 'SupplierNumber=' + literal(parentNumber), limit: 2, offset: 0 }; return result;\n}\nresult.message = 'List addresses for a supplier number, request detail by address ID or exact name, or prepare an address with the eight supported fields.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_address_request"
          },
          "inputs": [],
          "diagram": {
            "x": 7250,
            "y": 6316
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
