          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplierSiteId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierSite\": {\n            \"type\": \"string\"\n          },\n          \"ProcurementBUId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierAddressName\": {\n            \"type\": \"string\"\n          },\n          \"SitePurposePurchasingFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"ProcurementBU\": {\n            \"type\": \"string\"\n          },\n          \"SupplierAddressId\": {\n            \"type\": \"number\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"InactiveDate\": {\n            \"type\": \"null\"\n          }\n        },\n        \"required\": [\n          \"SupplierSiteId\",\n          \"SupplierSite\",\n          \"ProcurementBUId\",\n          \"SupplierAddressName\",\n          \"SitePurposePurchasingFlag\",\n          \"ProcurementBU\",\n          \"SupplierAddressId\",\n          \"Status\",\n          \"InactiveDate\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "shape_site_list",
          "code": "SHAPE_SITE_LIST",
          "type": "CODE",
          "metadata": {
            "name": "shape site list",
            "sourceCode": "var request=$context.$nodes.SHAPE_SITE_PARENT.$output.result,response=$context.$nodes.LIST_SITES.$output;\nvar result={route:'display',resource:'site',parent:request.parent,state:request.state,rows:[],message:'',nextCommand:null};\nif(!request.query||!response||!Array.isArray(response.items)||typeof response.hasMore!=='boolean'||response.count!==response.items.length||!Number.isSafeInteger(response.count)||response.count<0||response.count>request.query.limit||response.offset!==request.query.offset||response.limit!==request.query.limit||(response.hasMore&&response.count===0)||response.items.some(function(row){return !row||!/^[1-9][0-9]*$/.test(String(row.SupplierSiteId))||(row.SupplierId!==undefined&&String(row.SupplierId)!==request.parent.SupplierId);})){result.message='The site response was incomplete or did not match its parent/paging contract.';return result;}\nresult.rows=response.items.map(function(row){return {SupplierSiteId:row.SupplierSiteId,SupplierSite:row.SupplierSite,ProcurementBUId:row.ProcurementBUId,ProcurementBU:row.ProcurementBU,SupplierAddressId:row.SupplierAddressId,SupplierAddressName:row.SupplierAddressName,SitePurposePurchasingFlag:row.SitePurposePurchasingFlag,Status:row.Status,InactiveDate:row.InactiveDate};});\nif(request.query.detail){if(result.rows.length!==1||response.hasMore){result.message='Site detail requires exactly one matching site within the selected supplier.';return result;}result.siteId=String(result.rows[0].SupplierSiteId);result.route='detail';return result;}\nif(response.hasMore){var next=request.query.offset+response.count;if(!Number.isSafeInteger(next)){result.rows=[];result.message='Site pagination exceeded safe bounds.';return result;}result.nextCommand='List sites for supplier '+request.parent.SupplierNumber+' offset '+next+' limit '+request.query.limit+' filter '+JSON.stringify(request.query.filter);}\nresult.message=result.rows.length?'Showing '+result.rows.length+' sites for supplier '+request.parent.SupplierNumber+' at offset '+request.query.offset+'.':'No sites matched within this supplier.';return result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "route_site_list"
          },
          "inputs": [],
          "diagram": {
