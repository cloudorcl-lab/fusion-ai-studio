        {
          "id": "reserve_create",
          "code": "RESERVE_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "reserve create",
            "sourceCode": "// CODE node body after duplicate GET; SET_FIELDS must persist state before POST.\nvar request = $context.$nodes.NORMALIZE_REQUEST.$output.result;\nvar state = JSON.parse(JSON.stringify(request.state));\nvar draft = state.draft;\nvar duplicates = $context.$nodes.CHECK_DUPLICATE.$output;\nvar result = { route: 'display', state: state, message: '' };\nvar blocked = ['draft', 'addressDraft', 'contactDraft', 'siteDraft'].some(function (key) { return state[key] && ['reserved', 'uncertain'].indexOf(state[key].status) >= 0; });\nvar canonical = draft ? JSON.stringify({ Supplier: draft.payload.Supplier, BusinessRelationship: draft.payload.BusinessRelationship, TaxOrganizationType: draft.payload.TaxOrganizationType }) : '';\nif (blocked || !draft || draft.status !== 'draft' || draft.approvedRevision !== draft.revision || draft.approvedPayload !== canonical || request.route !== 'duplicate') {\n  result.message = 'The exact reviewed approval is no longer eligible. No new create was submitted.'; return result;\n}\nif (!duplicates || !Array.isArray(duplicates.items) || duplicates.items.length || duplicates.hasMore !== false || duplicates.count !== 0) {\n  result.message = 'Duplicate check did not prove an empty result. No new create was submitted.'; return result;\n}\ndraft.status = 'reserved';\ndraft.attempt = { requestId: draft.requestId, revision: draft.revision, payload: draft.approvedPayload, jobId: String($context.$workflow.$jobId || '') };\nresult.route = 'create'; result.payload = JSON.parse(draft.attempt.payload);\nresult.message = 'Create attempt reserved. An uncertain result must be reconciled before any further write.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_reservation"
          },
          "inputs": [],
