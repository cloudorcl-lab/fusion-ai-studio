        {
          "id": "verify_address",
          "code": "VERIFY_ADDRESS",
          "type": "CODE",
          "metadata": {
            "name": "verify address",
            "sourceCode": "var prior = $context.$nodes.CAPTURE_ADDRESS.$output.result;\nvar state = JSON.parse(JSON.stringify(prior.state));\nvar draft = state.addressDraft;\nvar response = $context.$nodes.VERIFY_CREATED_ADDRESS.$output;\nvar approved = JSON.parse(draft.attempt.approved);\nvar fields = ['AddressName', 'CountryCode', 'AddressLine1', 'City', 'State', 'PostalCode', 'Email', 'AddressPurposeOrderingFlag'];\nvar matches = response && approved.supplierId === draft.parent.SupplierId && String(response.SupplierAddressId) === draft.attempt.addressId && fields.every(function (key) { return response[key] === approved.payload[key]; });\ndraft.attempt.verifiedResponse = response || null; draft.status = matches ? 'accepted' : 'uncertain';\nreturn { route: 'display', resource: 'address', state: state, parent: draft.parent, draft: draft, address: response || null,\n  message: matches ? 'Created address verified by independent same-parent GET. This request cannot be replayed.' : 'Independent address verification did not match every approved field. Reconcile without another create.' };\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_address_verified"
          },
          "inputs": [],
