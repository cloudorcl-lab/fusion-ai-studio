          "id": "capture_address",
          "code": "CAPTURE_ADDRESS",
          "type": "CODE",
          "metadata": {
            "name": "capture address",
            "sourceCode": "var prior = $context.$nodes.RESERVE_ADDRESS.$output.result;\nvar state = JSON.parse(JSON.stringify(prior.state));\nvar draft = state.addressDraft;\nvar response = $context.$nodes.CREATE_ADDRESS.$output;\nvar result = { route: 'display', resource: 'address', state: state, parent: draft.parent, draft: draft, message: '' };\ndraft.status = 'uncertain'; draft.attempt.response = response || null;\nif (response && /^[1-9][0-9]*$/.test(String(response.SupplierAddressId))) {\n  draft.attempt.addressId = String(response.SupplierAddressId); result.addressId = draft.attempt.addressId; result.route = 'verify';\n  result.message = 'Address key returned; independent same-parent verification pending. Do not replay.';\n} else result.message = 'Address create outcome is uncertain. Keep this request frozen and reconcile by reading.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
