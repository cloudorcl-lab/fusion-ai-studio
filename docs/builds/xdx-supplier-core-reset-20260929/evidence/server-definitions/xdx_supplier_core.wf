        {
          "id": "shape_site_detail",
          "code": "SHAPE_SITE_DETAIL",
          "type": "CODE",
          "metadata": {
            "name": "shape site detail",
            "sourceCode": "var prior=$context.$nodes.SHAPE_SITE_LIST.$output.result,response=$context.$nodes.GET_SITE.$output;\nvar valid=prior.route==='detail'&&prior.parent&&response&&!Array.isArray(response)&&/^[1-9][0-9]*$/.test(String(response.SupplierSiteId))&&String(response.SupplierSiteId)===prior.siteId&&(response.SupplierId===undefined||String(response.SupplierId)===prior.parent.SupplierId);\nreturn {route:'display',resource:'site',state:prior.state,parent:prior.parent,site:valid?response:null,message:valid?'Site detail for supplier '+prior.parent.SupplierNumber+'.':'The site detail response did not match the selected parent and site key.'};\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
