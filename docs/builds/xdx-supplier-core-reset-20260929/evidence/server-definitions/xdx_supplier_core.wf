        {
          "id": "handle_error",
          "code": "HANDLE_ERROR",
          "type": "CODE",
          "metadata": {
            "name": "handle error",
            "sourceCode": "// Shared supported error edge. Persist the returned state before the terminal display.\nvar state = null;\ntry {\n  var stored = $context.$variables.supplierState;\n  state = stored ? JSON.parse(typeof stored === 'string' ? stored : JSON.stringify(stored)) : null;\n} catch (e) {}\nvar attempted = false;\n['draft', 'addressDraft', 'contactDraft', 'siteDraft'].forEach(function (key) {\n  var draft = state && state[key];\n  if (draft && ['reserved', 'uncertain', 'accepted'].indexOf(draft.status) >= 0) {\n    attempted = true;\n    if (draft.status !== 'accepted') draft.status = 'uncertain';\n  }\n});\nreturn { route: 'display', state: state, message: attempted ? 'A prior create attempt remains recorded. This operation failed; no new create was submitted by this error handler. Keep the request frozen and reconcile its result.' : 'The operation failed. No create was submitted by this error handler. If an earlier attempt is not available in this conversation, reconcile it before starting another request.', errorNode: String($context.$error.$nodeCode || ''), error: String($context.$error.$errorMessage || '') };\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "persist_error"
          },
          "inputs": [],
          "diagram": {
            "x": 11925,
            "y": 5000
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
