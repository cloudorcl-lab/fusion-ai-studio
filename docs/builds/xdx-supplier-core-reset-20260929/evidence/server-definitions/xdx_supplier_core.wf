          "id": "shape_site_parent",
          "code": "SHAPE_SITE_PARENT",
          "type": "CODE",
          "metadata": {
            "name": "shape site parent",
            "sourceCode": "var request=$context.$nodes.NORMALIZE_SITE.$output.result,state=JSON.parse(JSON.stringify(request.state)),response=$context.$nodes.RESOLVE_SITE_SUPPLIER.$output;\nvar result={route:'display',resource:'site',state:state,message:''};\nvar blocked=['draft','addressDraft','contactDraft','siteDraft'].some(function(k){return state[k]&&['reserved','uncertain'].indexOf(state[k].status)>=0;});\nvar id=String($context.$workflow.$jobId||'');\nif(!request.pending||!response||!Array.isArray(response.items)||response.items.length!==1||response.count!==1||response.hasMore!==false||!response.items[0]||typeof response.items[0]!=='object'||Array.isArray(response.items[0])||!/^[1-9][0-9]*$/.test(String(response.items[0].SupplierId))||String(response.items[0].SupplierNumber)!==request.pending.parentNumber){result.message='One exact supplier number is required.';return result;}\nvar row=response.items[0];result.parent={SupplierId:String(row.SupplierId),SupplierNumber:String(row.SupplierNumber),Supplier:row.Supplier};\nif(['list','search','detail'].indexOf(request.pending.intent)>=0){result.route='list';result.query=request.pending.query;return result;}\nif(blocked||state.siteDraft||!/^[A-Za-z0-9_-]+$/.test(id)){result.message='A unique eligible site request is required.';return result;}\nvar payload=request.pending.patch;payload.SitePurposePurchasingFlag=true;\nstate.siteDraft={requestId:id,revision:1,status:'draft',parent:{SupplierId:String(row.SupplierId),SupplierNumber:String(row.SupplierNumber),Supplier:row.Supplier},payload:payload,address:null,buLookup:null};state.editResource='site';\nresult.draft=state.siteDraft;result.parent=state.siteDraft.parent;result.route='address';result.query={q:\"AddressName='\"+payload.SupplierAddressName.replace(/'/g,\"''\")+\"'\",limit:2,offset:0};return result;\n",
