            "y": 8758
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"SupplierSiteId\": {\n      \"type\": \"number\"\n    },\n    \"SupplierSite\": {\n      \"type\": \"string\"\n    },\n    \"ProcurementBUId\": {\n      \"type\": \"number\"\n    },\n    \"SupplierAddressName\": {\n      \"type\": \"string\"\n    },\n    \"SitePurposePurchasingFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"ProcurementBU\": {\n      \"type\": \"string\"\n    },\n    \"SupplierAddressId\": {\n      \"type\": \"number\"\n    },\n    \"Status\": {\n      \"type\": \"string\"\n    },\n    \"InactiveDate\": {\n      \"type\": \"null\"\n    }\n  },\n  \"required\": [\n    \"SupplierSiteId\",\n    \"SupplierSite\",\n    \"ProcurementBUId\",\n    \"SupplierAddressName\",\n    \"SitePurposePurchasingFlag\",\n    \"ProcurementBU\",\n    \"SupplierAddressId\",\n    \"Status\",\n    \"InactiveDate\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "verify_site",
          "code": "VERIFY_SITE",
          "type": "CODE",
          "metadata": {
            "name": "verify site",
            "sourceCode": "var prior=$context.$nodes.CAPTURE_SITE.$output.result,state=JSON.parse(JSON.stringify(prior.state)),draft=state.siteDraft,response=$context.$nodes.VERIFY_CREATED_SITE.$output,approved=null;\ntry{approved=draft&&draft.attempt?JSON.parse(draft.attempt.approved):null;}catch(e){}\nvar match=!!(draft&&draft.status==='uncertain'&&approved&&approved.payload&&Object.keys(approved.payload).length===4&&response&&!Array.isArray(response)&&prior.parent&&prior.parent.SupplierId===approved.supplierId&&draft.parent.SupplierId===approved.supplierId&&String(response.SupplierSiteId)===draft.attempt.siteId&&String(response.SupplierAddressId)===approved.addressId&&String(response.ProcurementBUId)===String(approved.payload.ProcurementBUId)&&response.SupplierSite===approved.payload.SupplierSite&&response.SupplierAddressName===approved.payload.SupplierAddressName&&response.SitePurposePurchasingFlag===true&&(response.SupplierId===undefined||String(response.SupplierId)===approved.supplierId));\nif(draft&&draft.attempt&&draft.status!=='accepted'){draft.attempt.verifiedResponse=response||null;draft.status=match?'accepted':'uncertain';}\nreturn {route:'display',resource:'site',state:state,draft:draft,parent:draft?draft.parent:null,site:response||null,message:match?'Created site independently verified against all four fields and same-parent address/BU relationships. This request cannot be replayed.':'Independent site verification did not match. Reconcile without another create.'};\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_site_verified"
          },
          "inputs": [],
          "diagram": {
            "x": 8487.5,
            "y": 8980
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
