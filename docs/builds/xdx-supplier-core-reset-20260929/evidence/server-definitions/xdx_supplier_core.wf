        {
          "id": "capture_site",
          "code": "CAPTURE_SITE",
          "type": "CODE",
          "metadata": {
            "name": "capture site",
            "sourceCode": "var prior=$context.$nodes.RESERVE_SITE.$output.result,state=JSON.parse(JSON.stringify(prior.state)),draft=state.siteDraft,response=$context.$nodes.CREATE_SITE.$output;\nvar result={route:'display',resource:'site',state:state,draft:draft,parent:draft?draft.parent:null,message:'Site outcome needs reconciliation without another create.'};\nif(!draft||draft.status!=='reserved'||!draft.attempt)return result;\ndraft.status='uncertain';draft.attempt.response=response||null;\nif(response&&/^[1-9][0-9]*$/.test(String(response.SupplierSiteId))){draft.attempt.siteId=String(response.SupplierSiteId);result.siteId=draft.attempt.siteId;result.route='verify';result.message='Site key returned; independent same-parent verification pending.';}return result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_site_capture"
          },
          "inputs": [],
          "diagram": {
            "x": 8937.5,
            "y": 8092
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
