        {
          "id": "normalize_site",
          "code": "NORMALIZE_SITE",
          "type": "CODE",
          "metadata": {
            "name": "normalize site",
            "sourceCode": "var state=JSON.parse(JSON.stringify($context.$nodes.NORMALIZE_REQUEST.$output.result.state));\nvar extracted=$context.$nodes.EXTRACT_REQUEST.$output||{},raw=String($context.$system.$inputMessage||'').trim(),draft=state.siteDraft;\nvar result={route:'display',resource:'site',state:state,draft:draft,message:''};\nvar fields=['SupplierSite','ProcurementBUId','SupplierAddressName','SitePurposePurchasingFlag'];\nfunction blocked(){return ['draft','addressDraft','contactDraft','siteDraft'].some(function(k){return state[k]&&['reserved','uncertain'].indexOf(state[k].status)>=0;});}\nfunction frozen(){return draft&&['reserved','uncertain','accepted'].indexOf(draft.status)>=0;}\nfunction text(v){return typeof v==='string'&&!!v.trim()&&v===v.trim()&&v.length<=240&&!/[\\u0000-\\u001f]/.test(v);}\nfunction valid(k,v){return k==='ProcurementBUId'?typeof v==='number'&&Number.isSafeInteger(v)&&v>0:k==='SitePurposePurchasingFlag'?v===true:text(v);}\nfunction exact(){return JSON.stringify({supplierId:draft.parent.SupplierId,addressId:draft.address.SupplierAddressId,payload:{SupplierSite:draft.payload.SupplierSite,ProcurementBUId:draft.payload.ProcurementBUId,SupplierAddressName:draft.payload.SupplierAddressName,SitePurposePurchasingFlag:true}});}\nfunction dependencies(){return draft&&draft.parent&&draft.address&&draft.address.parentId===draft.parent.SupplierId&&draft.address.AddressName===draft.payload.SupplierAddressName&&draft.buLookup&&draft.buLookup.complete===true&&draft.buLookup.revision===draft.revision&&draft.buLookup.parentId===draft.parent.SupplierId&&draft.buLookup.choices[String(draft.payload.ProcurementBUId)];}\nfunction resolve(){result.route='address';result.parent=draft.parent;result.query={q:\"AddressName='\"+draft.payload.SupplierAddressName.replace(/'/g,\"''\")+\"'\",limit:2,offset:0};}\nvar control=/^(Review|Approve|Create) site ([A-Za-z0-9_-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nvar edit=/^Site (SupplierSite|ProcurementBUId|SupplierAddressName|SitePurposePurchasingFlag)\\s*:\\s*([\\s\\S]+)$/i.exec(raw);\nvar continuation=/^Continue site lookup ([A-Za-z0-9_-]+) revision ([1-9][0-9]*) offset ([0-9]+)$/i.exec(raw);\nvar intent=control?control[1].toLowerCase():edit?'edit':continuation?'continue':String(extracted.intent||'help');\nvar page=/^List sites for supplier ([0-9]+) offset ([0-9]+) limit ([0-9]+) filter (\\{[\\s\\S]*\\})$/i.exec(raw);\nif(page)intent='list';\n// Ordinary reads remain available for reconciliation while any draft is frozen.\nif(['list','search','detail'].indexOf(intent)>=0){\n var number=page?page[1]:String(extracted.parentNumber||''),offset=page?Number(page[2]):0,limit=page?Number(page[3]):10;\n var filter={field:'all',value:'',mode:'exact'};\n if(page){try{filter=JSON.parse(page[4]);}catch(e){result.message='Invalid site paging filter.';return result;}}\n else if(extracted.siteId)filter={field:'SupplierSiteId',value:String(extracted.siteId),mode:'exact'};\n else if(extracted.siteName)filter={field:'SupplierSite',value:String(extracted.siteName),mode:extracted.match==='contains'?'contains':'exact'};\n if(filter&&filter.mode===undefined)filter.mode='exact';\n if(!/^\\d+$/.test(number)||!Number.isSafeInteger(offset)||offset<0||!Number.isSafeInteger(limit)||limit<1||limit>25||!filter||['all','SupplierSiteId','SupplierSite'].indexOf(filter.field)<0||typeof filter.value!=='string'||filter.value.length>240||/[\\u0000-\\u001f]/.test(filter.value)||['exact','contains'].indexOf(filter.mode)<0||(filter.mode==='contains'&&(filter.field!=='SupplierSite'||/[%_\\\\]/.test(filter.value)))||(filter.field==='SupplierSiteId'&&!/^[1-9][0-9]*$/.test(filter.value))||(filter.field!=='all'&&!filter.value.trim())){result.message='Specify a supplier number and valid bounded site filter.';return result;}\n if(intent==='detail'&&(filter.field==='all'||filter.mode!=='exact')){result.message='Site detail requires its ID or exact name within the supplier.';return result;}\n var value=filter.mode==='contains'?'%'+filter.value+'%':filter.value;\n var q=filter.field==='all'?'SupplierSiteId>0':filter.field+(filter.mode==='contains'?' like ':'=')+(filter.field==='SupplierSiteId'?value:\"'\"+value.replace(/'/g,\"''\")+\"'\");\n result.route='parent';result.pending={intent:intent,parentNumber:number,query:{q:q,limit:limit,offset:offset,filter:filter,detail:intent==='detail'}};result.parentQuery={q:\"SupplierNumber='\"+number+\"'\",limit:2,offset:0};return result;\n}\nif(blocked()||frozen()){result.message='A prior request is frozen or awaiting reconciliation. No new site mutation was submitted.';return result;}\nif(intent==='continue'){\n var l=draft&&draft.buLookup;\n if(!continuation||!l||l.complete!==false||l.failed||l.revision!==draft.revision||l.parentId!==draft.parent.SupplierId||continuation[1]!==draft.requestId||Number(continuation[2])!==draft.revision||Number(continuation[3])!==l.nextOffset||!Number.isSafeInteger(l.nextOffset)||l.nextOffset<0){result.message='Use the exact pending lookup continuation. No create was submitted.';return result;}\n result.route='bu';result.parent=draft.parent;result.query={q:'ProcurementBUId>0',limit:100,offset:l.nextOffset};return result;\n}\nif(['review','approve','create'].indexOf(intent)>=0){\n if(!control||!draft||control[2]!==draft.requestId||Number(control[3])!==draft.revision||Object.keys(draft.payload).length!==4||!fields.every(function(k){return valid(k,draft.payload[k]);})||!dependencies()){result.message='Resolve the exact supplier address and complete current BU lookup before reviewing this exact revision.';return result;}\n var bound=exact();\n if(intent==='review'){draft.reviewedRevision=draft.revision;draft.reviewedPayload=bound;result.message='Review all four fields, supplier, address ID and BU. Approve site '+draft.requestId+' revision '+draft.revision;}\n else if(draft.reviewedRevision!==draft.revision||draft.reviewedPayload!==bound)result.message='Review the current site revision first.';\n else if(intent==='approve'){draft.approvedRevision=draft.revision;draft.approvedPayload=bound;result.message='Create site '+draft.requestId+' revision '+draft.revision;}\n else if(draft.approvedRevision===draft.revision&&draft.approvedPayload===bound){result.route='duplicate';result.parent=draft.parent;result.query={q:\"SupplierSite='\"+draft.payload.SupplierSite.replace(/'/g,\"''\")+\"'\",limit:2,offset:0};}\n else result.message='Exact current approval is required.';\n return result;\n}\nif(intent==='prepare'||intent==='edit'){\n var patch=extracted.sitePatch||{};\n if(edit){patch={};var key=fields.filter(function(k){return k.toLowerCase()===edit[1].toLowerCase();})[0];var value=edit[2].trim();if(key==='ProcurementBUId'){if(!/^[1-9][0-9]*$/.test(value)){result.message='Site ProcurementBUId must be a positive integer.';return result;}value=Number(value);}if(key==='SitePurposePurchasingFlag')value=value==='true'?true:value;patch[key]=value;}\n if(!patch||typeof patch!=='object'||Array.isArray(patch)||Object.keys(patch).some(function(k){return fields.indexOf(k)<0||!valid(k,patch[k]);})){result.message='Provide only valid site name, numeric BU ID, address name and purchasing true.';return result;}\n if(!draft){var number=String(extracted.parentNumber||'');if(intent==='edit'||!/^\\d+$/.test(number)||!text(patch.SupplierAddressName)){result.message='Prepare a site with supplier number and exact address name first.';return result;}result.route='parent';result.pending={parentNumber:number,patch:patch};result.parentQuery={q:\"SupplierNumber='\"+number+\"'\",limit:2,offset:0};return result;}\n if(!edit&&extracted.parentNumber&&String(extracted.parentNumber)!==draft.parent.SupplierNumber){result.message='Parent changes require a separate site request.';return result;}\n var changed=false;Object.keys(patch).forEach(function(k){if(draft.payload[k]!==patch[k]){draft.payload[k]=patch[k];changed=true;}});\n if(changed){draft.revision++;draft.reviewedRevision=null;draft.reviewedPayload=null;draft.approvedRevision=null;draft.approvedPayload=null;draft.address=null;draft.buLookup=null;}\n state.editResource='site';if(changed||!dependencies())resolve();else result.message='Review site '+draft.requestId+' revision '+draft.revision;return result;\n}\nresult.message='Prepare a site for a supplier number with an exact address name and a dynamically selected numeric procurement BU. Use Site field edits.';return result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
