            "name": "shape contact detail",
            "sourceCode": "var list = $context.$nodes.SHAPE_CONTACT_LIST.$output.result;\nvar row = $context.$nodes.GET_CONTACT.$output;\nvar valid = list && list.parent && /^[1-9][0-9]*$/.test(String(list.parent.SupplierId)) && /^[1-9][0-9]*$/.test(String(list.contactId)) && row && !Array.isArray(row) && String(row.SupplierContactId) === String(list.contactId);\nreturn {route:'display',resource:'contact',state:list.state,parent:list.parent,contact:valid?row:null,message:valid?'Contact detail retrieved within the verified supplier parent.':'Contact detail did not match the selected contact key. No new create was submitted.'};",
            "returnType": "object",
            "errorNodeId": "handle_error"
