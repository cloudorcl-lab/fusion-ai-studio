          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"SupplierAddressId\": {\n      \"type\": \"number\"\n    },\n    \"AddressName\": {\n      \"type\": \"string\"\n    },\n    \"CountryCode\": {\n      \"type\": \"string\"\n    },\n    \"Country\": {\n      \"type\": \"string\"\n    },\n    \"AddressLine1\": {\n      \"type\": \"string\"\n    },\n    \"AddressLine2\": {\n      \"type\": \"null\"\n    },\n    \"AddressLine3\": {\n      \"type\": \"null\"\n    },\n    \"AddressLine4\": {\n      \"type\": \"null\"\n    },\n    \"City\": {\n      \"type\": \"string\"\n    },\n    \"State\": {\n      \"type\": \"string\"\n    },\n    \"PostalCode\": {\n      \"type\": \"string\"\n    },\n    \"PostalCodeExtension\": {\n      \"type\": \"string\"\n    },\n    \"Province\": {\n      \"type\": \"null\"\n    },\n    \"County\": {\n      \"type\": \"string\"\n    },\n    \"Building\": {\n      \"type\": \"null\"\n    },\n    \"FloorNumber\": {\n      \"type\": \"null\"\n    },\n    \"PhoneticAddress\": {\n      \"type\": \"null\"\n    },\n    \"LanguageCode\": {\n      \"type\": \"string\"\n    },\n    \"Language\": {\n      \"type\": \"string\"\n    },\n    \"Addressee\": {\n      \"type\": \"null\"\n    },\n    \"GlobalLocationNumber\": {\n      \"type\": \"null\"\n    },\n    \"AdditionalAddressAttribute1\": {\n      \"type\": \"null\"\n    },\n    \"AdditionalAddressAttribute2\": {\n      \"type\": \"null\"\n    },\n    \"AdditionalAddressAttribute3\": {\n      \"type\": \"null\"\n    },\n    \"AdditionalAddressAttribute4\": {\n      \"type\": \"null\"\n    },\n    \"AdditionalAddressAttribute5\": {\n      \"type\": \"null\"\n    },\n    \"FormattedAddress\": {\n      \"type\": \"string\"\n    },\n    \"AddressPurposeOrderingFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"AddressPurposeRemitToFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"AddressPurposeRFQOrBiddingFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"PhoneCountryCode\": {\n      \"type\": \"null\"\n    },\n    \"PhoneAreaCode\": {\n      \"type\": \"null\"\n    },\n    \"PhoneNumber\": {\n      \"type\": \"null\"\n    },\n    \"PhoneExtension\": {\n      \"type\": \"null\"\n    },\n    \"FaxCountryCode\": {\n      \"type\": \"null\"\n    },\n    \"FaxAreaCode\": {\n      \"type\": \"null\"\n    },\n    \"FaxNumber\": {\n      \"type\": \"null\"\n    },\n    \"Email\": {\n      \"type\": \"null\"\n    },\n    \"InactiveDate\": {\n      \"type\": \"string\"\n    },\n    \"Status\": {\n      \"type\": \"string\"\n    },\n    \"CreationDate\": {\n      \"type\": \"string\"\n    },\n    \"CreatedBy\": {\n      \"type\": \"string\"\n    },\n    \"LastUpdateDate\": {\n      \"type\": \"string\"\n    },\n    \"LastUpdatedBy\": {\n      \"type\": \"string\"\n    },\n    \"AddressPartyNumber\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"SupplierAddressId\",\n    \"AddressName\",\n    \"CountryCode\",\n    \"Country\",\n    \"AddressLine1\",\n    \"AddressLine2\",\n    \"AddressLine3\",\n    \"AddressLine4\",\n    \"City\",\n    \"State\",\n    \"PostalCode\",\n    \"PostalCodeExtension\",\n    \"Province\",\n    \"County\",\n    \"Building\",\n    \"FloorNumber\",\n    \"PhoneticAddress\",\n    \"LanguageCode\",\n    \"Language\",\n    \"Addressee\",\n    \"GlobalLocationNumber\",\n    \"AdditionalAddressAttribute1\",\n    \"AdditionalAddressAttribute2\",\n    \"AdditionalAddressAttribute3\",\n    \"AdditionalAddressAttribute4\",\n    \"AdditionalAddressAttribute5\",\n    \"FormattedAddress\",\n    \"AddressPurposeOrderingFlag\",\n    \"AddressPurposeRemitToFlag\",\n    \"AddressPurposeRFQOrBiddingFlag\",\n    \"PhoneCountryCode\",\n    \"PhoneAreaCode\",\n    \"PhoneNumber\",\n    \"PhoneExtension\",\n    \"FaxCountryCode\",\n    \"FaxAreaCode\",\n    \"FaxNumber\",\n    \"Email\",\n    \"InactiveDate\",\n    \"Status\",\n    \"CreationDate\",\n    \"CreatedBy\",\n    \"LastUpdateDate\",\n    \"LastUpdatedBy\",\n    \"AddressPartyNumber\"\n  ],\n  \"additionalProperties\": false\n}"
