        {
          "id": "capture_contact",
          "code": "CAPTURE_CONTACT",
          "type": "CODE",
          "metadata": {
            "name": "capture contact",
            "sourceCode": "var prior = $context.$nodes.RESERVE_CONTACT.$output.result;\nvar state = JSON.parse(JSON.stringify(prior.state));\nvar draft = state.contactDraft;\nvar response = $context.$nodes.CREATE_CONTACT.$output;\nvar result = { route: 'display', resource: 'contact', state: state, parent: draft ? draft.parent : null, draft: draft, message: '' };\nif (!draft || !draft.attempt || draft.status !== 'reserved') { result.message = 'Contact attempt state is missing or frozen. Reconcile any prior attempt without another create.'; return result; }\ndraft.status = 'uncertain'; draft.attempt.response = response || null;\nif (response && /^[1-9][0-9]*$/.test(String(response.SupplierContactId)) && /^[1-9][0-9]*$/.test(String(response.PersonProfileId))) {\n  draft.attempt.contactId = String(response.SupplierContactId); draft.attempt.personProfileId = String(response.PersonProfileId);\n  result.contactId = draft.attempt.contactId; result.route = 'verify';\n  result.message = 'Contact and profile keys returned; independent same-parent verification pending. Do not replay.';\n} else result.message = 'Contact create outcome is uncertain. Keep this request frozen and reconcile by reading.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_contact_capture"
          },
          "inputs": [],
          "diagram": {
            "x": 6687.5,
            "y": 8092
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
