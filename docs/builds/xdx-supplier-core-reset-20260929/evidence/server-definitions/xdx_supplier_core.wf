            "success": "end"
          },
          "inputs": [
            {
              "id": "init_display_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Render only the specified static application introduction. Do not query data, interpret the user message, add guidance, or invent business results."
            },
            {
              "id": "init_display_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Emit exactly one oraInfoDisplay cardWidget. Its title and subject are Supplier Core. Its properties.summary must be exactly \"This app helps you manage suppliers\" without a trailing period. No other visible body text, subtitle, status, lists, links, or actions. Emit only the valid widget block."
            }
          ],
          "diagram": {
            "x": 10850,
            "y": 5428
          },
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_CARD"
              ],
              "customNotes": "Show one card with summary exactly: This app helps you manage suppliers"
            }
          }
        },
        {
          "id": "extract_request",
          "code": "EXTRACT_REQUEST",
          "type": "LLM",
          "metadata": {
            "name": "extract request",
            "chatHistoryEnabled": false,
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "normalize_request"
          },
          "inputs": [
            {
              "id": "extract_request_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Interpret only the current message into the declared JSON schema. Never authorize a write or infer missing fields. Resource is supplier, address, contact or site. Supplier queries use number/name/match; supplier prepare/edit patch contains only explicitly supplied Supplier, BusinessRelationship, TaxOrganizationType. Child parentNumber is the displayed supplier number, never an internal ID. Address filters use addressId/addressName/city; addressPatch has only explicitly supplied address fields with exact values and boolean types. Contact filters use contactId/contactName/contactEmail; contact prepare/edit contactPatch has only explicitly supplied FirstName, LastName, Email. Site reads use siteId or siteName with match exact/contains. Site prepare/edit sitePatch has only explicitly supplied SupplierSite, ProcurementBUId, SupplierAddressName, SitePurposePurchasingFlag. ProcurementBUId must be a numeric integer from an explicit selected ID; do not invent an ID from a BU name or use a default. Preserve numeric and boolean types. Site address name is an exact name under the displayed supplier parent. Purchasing true is enforced downstream. Read requests never patch drafts. Preserve full explicitly supplied names and email without normalizing them. Raw Review/Approve/Create controls, Site field edits, explicit resource field edits, Continue site lookup and paging commands are deterministic downstream; classify help and retain the correct resource. Bare Email is resolved only by persisted edit context downstream, never by guessed history. Do not copy conversation history. The extractor supplies candidate fields only. Deterministic revision, exact approval, duplicate, reservation and persisted verification gates own creation and success."
            },
            {
              "id": "extract_request_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Extract the current request. App stage: {{$context.$app.$OraMessageHint}}. Current message: {{$context.$system.$inputMessage}}"
            }
          ],
          "diagram": {
            "x": 9275,
            "y": 5428
          },
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"list\",\n        \"search\",\n        \"detail\",\n        \"prepare\",\n        \"edit\",\n        \"help\"\n      ]\n    },\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"number\": {\n      \"type\": \"string\"\n    },\n    \"match\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"exact\",\n        \"contains\"\n      ]\n    },\n    \"patch\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"Supplier\": {\n          \"type\": \"string\"\n        },\n        \"BusinessRelationship\": {\n          \"type\": \"string\"\n        },\n        \"TaxOrganizationType\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"resource\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"supplier\",\n        \"address\",\n        \"contact\",\n        \"site\"\n      ]\n    },\n    \"parentNumber\": {\n      \"type\": \"string\"\n    },\n    \"addressId\": {\n      \"type\": \"string\"\n    },\n    \"addressName\": {\n      \"type\": \"string\"\n    },\n    \"city\": {\n      \"type\": \"string\"\n    },\n    \"addressPatch\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"AddressName\": {\n          \"type\": \"string\"\n        },\n        \"CountryCode\": {\n          \"type\": \"string\"\n        },\n        \"AddressLine1\": {\n          \"type\": \"string\"\n        },\n        \"City\": {\n          \"type\": \"string\"\n        },\n        \"State\": {\n          \"type\": \"string\"\n        },\n        \"PostalCode\": {\n          \"type\": \"string\"\n        },\n        \"Email\": {\n          \"type\": \"string\"\n        },\n        \"AddressPurposeOrderingFlag\": {\n          \"type\": \"boolean\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"contactId\": {\n      \"type\": \"string\"\n    },\n    \"contactName\": {\n      \"type\": \"string\"\n    },\n    \"contactEmail\": {\n      \"type\": \"string\"\n    },\n    \"contactPatch\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"FirstName\": {\n          \"type\": \"string\"\n        },\n        \"LastName\": {\n          \"type\": \"string\"\n        },\n        \"Email\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"siteId\": {\n      \"type\": \"string\"\n    },\n    \"siteName\": {\n      \"type\": \"string\"\n    },\n    \"sitePatch\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"SupplierSite\": {\n          \"type\": \"string\"\n        },\n        \"ProcurementBUId\": {\n          \"type\": \"integer\"\n        },\n        \"SupplierAddressName\": {\n          \"type\": \"string\"\n        },\n        \"SitePurposePurchasingFlag\": {\n          \"type\": \"boolean\"\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\n    \"intent\"\n  ],\n  \"additionalProperties\": false\n}\n"
        },
        {
          "id": "normalize_request",
          "code": "NORMALIZE_REQUEST",
          "type": "CODE",
          "metadata": {
            "name": "normalize request",
            "sourceCode": "// CODE node body. Persist returned state with SET_FIELDS before dependent BO calls.\nvar raw = String($context.$system.$inputMessage || '').trim();\nvar hint = String($context.$app.$OraMessageHint || 'Query');\nvar extracted = $context.$nodes.EXTRACT_REQUEST.$output || {};\nvar state = { draft: null, read: null };\ntry {\n  var stored = $context.$variables.supplierState;\n  if (stored) state = JSON.parse(typeof stored === 'string' ? stored : JSON.stringify(stored));\n} catch (e) {\n  return { route: 'display', message: 'Stored request state could not be read. No new create was submitted. Reconcile any prior attempt before starting another request.', state: null };\n}\nvar draft = state.draft;\nvar result = { route: 'display', state: state, message: '', query: null };\nfunction pendingAttempt() { return ['draft', 'addressDraft', 'contactDraft', 'siteDraft'].some(function (key) { return state[key] && ['reserved', 'uncertain'].indexOf(state[key].status) >= 0; }); }\n// Raw controls, paging and field names establish the resource before extraction.\nif (hint !== 'InitDisplay') {\n  var rawResource = null, rawMutation = false;\n  var resourceControl = /^(Review|Approve|Create) (supplier|address|contact|site)\\s/i.exec(raw);\n  var resourcePage = /^List (suppliers|addresses|contacts|sites) (?:offset |for supplier )/i.exec(raw);\n  var siteContinuation = /^Continue site lookup\\s/i.test(raw);\n  if (resourceControl && !/^(Review|Approve|Create) (supplier|address|contact|site) [A-Za-z0-9_-]+ revision [1-9][0-9]*$/i.test(raw)) { result.message = 'Use the exact displayed resource request and revision command. No draft was changed and no new create was submitted.'; return result; }\n  if (siteContinuation && !/^Continue site lookup [A-Za-z0-9_-]+ revision [1-9][0-9]* offset [0-9]+$/i.test(raw)) { result.message = 'Use the exact displayed site lookup continuation. No draft was changed and no new create was submitted.'; return result; }\n  if (resourceControl) { rawResource = resourceControl[2].toLowerCase(); rawMutation = true; }\n  else if (siteContinuation) { rawResource = 'site'; rawMutation = true; }\n  else if (/^Site\\s+(SupplierSite|ProcurementBUId|SupplierAddressName|SitePurposePurchasingFlag)\\s*:/i.test(raw)) { rawResource = 'site'; rawMutation = true; }\n  else if (/^(Supplier|BusinessRelationship|TaxOrganizationType)\\s*:/i.test(raw)) { rawResource = 'supplier'; rawMutation = true; }\n  else if (/^(?:Address\\s+)?(AddressName|CountryCode|AddressLine1|City|State|PostalCode|AddressPurposeOrderingFlag)\\s*:/i.test(raw) || /^Address\\s+Email\\s*:/i.test(raw)) { rawResource = 'address'; rawMutation = true; }\n  else if (/^(?:Contact\\s+)?(FirstName|LastName)\\s*:/i.test(raw) || /^Contact\\s+Email\\s*:/i.test(raw)) { rawResource = 'contact'; rawMutation = true; }\n  else if (/^Email\\s*:/i.test(raw)) {\n    if (['address', 'contact'].indexOf(state.editResource) < 0) { result.message = 'Specify Address Email: or Contact Email: followed by the value. No draft was changed.'; return result; }\n    rawResource = state.editResource; rawMutation = true;\n  } else if (resourcePage) rawResource = { suppliers: 'supplier', addresses: 'address', contacts: 'contact', sites: 'site' }[resourcePage[1].toLowerCase()];\n  var routedResource = rawResource || extracted.resource;\n  var mutation = rawResource ? rawMutation : ['prepare', 'edit', 'review', 'approve', 'create'].indexOf(String(extracted.intent || '')) >= 0;\n  if (mutation && pendingAttempt()) { result.message = 'A prior create attempt is reserved or uncertain. Reconcile it before changing or submitting another request. No new create was submitted.'; return result; }\n  if (routedResource === 'address' || routedResource === 'contact' || routedResource === 'site') { result.route = routedResource; return result; }\n}\nvar fields = ['Supplier', 'BusinessRelationship', 'TaxOrganizationType'];\nfunction literal(value) { return \"'\" + String(value).replace(/'/g, \"''\") + \"'\"; }\nfunction body(value) {\n  return { Supplier: value.Supplier, BusinessRelationship: value.BusinessRelationship, TaxOrganizationType: value.TaxOrganizationType };\n}\nfunction valid(value) {\n  if (!value || typeof value.Supplier !== 'string' || !value.Supplier.trim() || value.Supplier.length > 360) return false;\n  return ['Prospective', 'Spend Authorized'].indexOf(value.BusinessRelationship) >= 0 && typeof value.TaxOrganizationType === 'string' && !!value.TaxOrganizationType.trim();\n}\nfunction locked() { return draft && ['reserved', 'uncertain', 'accepted'].indexOf(draft.status) >= 0; }\nfunction review() {\n  if (!draft) { result.message = 'Prepare a supplier draft first.'; return; }\n  result.draft = draft;\n  if (locked()) { result.message = 'This request has a prior create attempt (' + draft.status + '). No new create was submitted. Keep the request frozen and reconcile its persisted result.'; return; }\n  if (!valid(draft.payload)) { result.message = 'Complete Supplier, BusinessRelationship and TaxOrganizationType before review.'; return; }\n  draft.reviewedPayload = JSON.stringify(body(draft.payload));\n  draft.reviewedRevision = draft.revision;\n  state.editResource = 'supplier';\n  result.message = 'Review the exact supplier payload. Approval command: Approve supplier ' + draft.requestId + ' revision ' + draft.revision;\n}\n// Raw full-message control commands outrank model classifications or reconstructed fields.\nvar control = /^(Review|Approve|Create) supplier ([A-Za-z0-9_-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nvar fieldEdit = /^(Supplier|BusinessRelationship|TaxOrganizationType)\\s*:\\s*([\\s\\S]+)$/i.exec(raw);\nvar page = /^List suppliers offset ([0-9]+) limit ([0-9]+) filter (\\{[\\s\\S]*\\})$/i.exec(raw);\nvar intent = hint === 'InitDisplay' ? 'list' : String(extracted.intent || 'help');\nif (control) intent = control[1].toLowerCase();\nif (fieldEdit) intent = 'edit';\nif (page) intent = 'page';\nif (['approve', 'create', 'review'].indexOf(intent) >= 0) {\n  if (pendingAttempt()) { result.message = 'Reconcile every reserved or uncertain attempt before changing approvals or submitting another create.'; return result; }\n  if (!control || !draft || control[2] !== draft.requestId || Number(control[3]) !== draft.revision) {\n    result.message = 'Use the exact displayed request and revision command. No new create was submitted.'; return result;\n  }\n  if (locked()) { review(); return result; }\n  if (intent === 'review') { review(); return result; }\n  var current = JSON.stringify(body(draft.payload));\n  if (!valid(draft.payload) || draft.reviewedRevision !== draft.revision || draft.reviewedPayload !== current) {\n    result.message = 'Review this revision and exact payload before approving or creating.'; return result;\n  }\n  if (intent === 'approve') {\n    draft.approvedRevision = draft.revision; draft.approvedPayload = current;\n    result.message = 'Approved this exact payload. Create command: Create supplier ' + draft.requestId + ' revision ' + draft.revision;\n  } else if (draft.approvedRevision === draft.revision && draft.approvedPayload === current) {\n    if (pendingAttempt()) { result.message = 'Reconcile the prior attempt before creating another record.'; return result; }\n    result.route = 'duplicate'; result.query = { q: 'Supplier=' + literal(draft.payload.Supplier), limit: 2, offset: 0 };\n  } else result.message = 'Approve this exact revision before creating.';\n  result.draft = draft; return result;\n}\nif (intent === 'prepare' || intent === 'edit') {\n  if (pendingAttempt()) { result.message = 'Reconcile every reserved or uncertain attempt before changing a draft. No new create was submitted.'; return result; }\n  if (locked()) { review(); return result; }\n  if (intent === 'edit' && !draft) { result.message = 'Prepare a supplier draft before editing fields.'; return result; }\n  var patch = extracted.patch || {};\n  if (fieldEdit) {\n    patch = {}; var key = fields.filter(function (f) { return f.toLowerCase() === fieldEdit[1].toLowerCase(); })[0];\n    patch[key] = fieldEdit[2].trim();\n  }\n  if (!patch || typeof patch !== 'object' || Array.isArray(patch) || Object.keys(patch).some(function (k) { return fields.indexOf(k) < 0 || typeof patch[k] !== 'string'; })) {\n    result.message = 'Only Supplier, BusinessRelationship and TaxOrganizationType can be edited.'; return result;\n  }\n  if (!draft) {\n    var requestId = String($context.$workflow.$jobId || '');\n    if (!/^[A-Za-z0-9_-]+$/.test(requestId)) { result.message = 'A request identity is unavailable. No draft or create was submitted.'; return result; }\n    draft = { requestId: requestId, revision: 0, status: 'draft', payload: {} }; state.draft = draft;\n  }\n  var changed = false;\n  fields.forEach(function (f) { if (Object.prototype.hasOwnProperty.call(patch, f) && draft.payload[f] !== patch[f]) { draft.payload[f] = patch[f]; changed = true; } });\n  if (changed) {\n    draft.revision += 1; draft.reviewedRevision = null; draft.reviewedPayload = null;\n    draft.approvedRevision = null; draft.approvedPayload = null;\n  }\n  result.draft = draft;\n  state.editResource = 'supplier';\n  result.message = 'Draft revision ' + draft.revision + '. Review command: Review supplier ' + draft.requestId + ' revision ' + draft.revision;\n  return result;\n}\nif (['list', 'search', 'detail', 'page'].indexOf(intent) >= 0) {\n  var filter = { kind: 'all', value: '' }, offset = 0, limit = 10;\n  if (page) {\n    try { filter = JSON.parse(page[3]); } catch (e) { result.message = 'Invalid paging filter.'; return result; }\n    offset = Number(page[1]); limit = Number(page[2]);\n  } else if (hint !== 'InitDisplay') {\n    if (extracted.number) filter = { kind: 'number', value: String(extracted.number) };\n    else if (extracted.name) filter = { kind: extracted.match === 'exact' ? 'exact' : 'contains', value: String(extracted.name) };\n  }\n  if (!filter || ['all', 'number', 'exact', 'contains'].indexOf(filter.kind) < 0 || typeof filter.value !== 'string' || !Number.isSafeInteger(offset) || offset < 0 || !Number.isSafeInteger(limit) || limit < 1 || limit > 25 || /[\\u0000-\\u001f]/.test(filter.value) || (filter.kind === 'contains' && /[%_]/.test(filter.value))) {\n    result.message = 'Use a valid bounded page and literal search text without wildcard characters.'; return result;\n  }\n  if (intent === 'detail' && filter.kind !== 'number' && filter.kind !== 'exact') { result.message = 'Specify a supplier number or exact name for detail.'; return result; }\n  var q = filter.kind === 'all' ? 'SupplierId>0' : filter.kind === 'number' ? 'SupplierNumber=' + literal(filter.value) : filter.kind === 'exact' ? 'Supplier=' + literal(filter.value) : 'Supplier like ' + literal('%' + filter.value + '%');\n  result.query = { q: q, limit: limit, offset: offset, filter: filter, detail: intent === 'detail' };\n  state.read = result.query; result.route = 'list'; return result;\n}\nresult.message = 'List or find suppliers; request detail by supplier number; or prepare a supplier draft with Supplier, BusinessRelationship and TaxOrganizationType.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_request"
          },
          "inputs": [],
          "diagram": {
            "x": 9275,
            "y": 5650
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "persist_request",
          "code": "PERSIST_REQUEST",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "persist request"
          },
          "outcomes": {
            "success": "route_operation"
          },
          "inputs": [
            {
              "id": "persist_request_supplierState",
              "name": "supplierState",
              "type": "string",
              "value": "{{JSON.stringify($context.$nodes.NORMALIZE_REQUEST.$output.result.state)}}"
            }
          ],
          "diagram": {
            "x": 9275,
            "y": 5872
          }
        },
        {
          "id": "route_operation",
          "code": "ROUTE_OPERATION",
          "type": "SWITCH",
          "metadata": {
            "name": "route operation"
          },
          "outcomes": {
            "list": "list_suppliers",
            "duplicate": "check_duplicate",
            "display": "display_request",
            "address": "normalize_address",
            "contact": "normalize_contact",
            "site": "normalize_site"
          },
          "inputs": [
            {
              "id": "route_operation_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.NORMALIZE_REQUEST.$output.result.route}}"
            }
          ],
          "diagram": {
            "x": 9275,
            "y": 6094
          },
          "convergenceTargetId": "prepare_display"
        },
        {
          "id": "list_suppliers",
          "code": "LIST_SUPPLIERS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "list suppliers",
            "businessObjectCode": "XDX_SUPPLIER_CORE_SUPPLIERS",
            "functionName": "ListSuppliers",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "shape_list"
          },
          "inputs": [
            {
              "id": "list_suppliers_q",
              "name": "q",
              "type": "string",
              "value": "{{$context.$nodes.NORMALIZE_REQUEST.$output.result.query.q}}"
            },
            {
              "id": "list_suppliers_limit",
              "name": "limit",
              "type": "integer",
              "value": "{{$context.$nodes.NORMALIZE_REQUEST.$output.result.query.limit}}"
            },
            {
              "id": "list_suppliers_offset",
              "name": "offset",
              "type": "integer",
              "value": "{{$context.$nodes.NORMALIZE_REQUEST.$output.result.query.offset}}"
            }
          ],
          "diagram": {
            "x": 10850,
            "y": 6316
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplierId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierNumber\": {\n            \"type\": \"string\"\n          },\n          \"Supplier\": {\n            \"type\": \"string\"\n          },\n          \"SupplierType\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"BusinessRelationship\": {\n            \"type\": \"string\"\n          },\n          \"InactiveDate\": {\n            \"type\": \"null\"\n          }\n        },\n        \"required\": [\n          \"SupplierId\",\n          \"SupplierNumber\",\n          \"Supplier\",\n          \"SupplierType\",\n          \"BusinessRelationship\",\n          \"InactiveDate\"\n        ],\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "shape_list",
          "code": "SHAPE_LIST",
          "type": "CODE",
          "metadata": {
            "name": "shape list",
            "sourceCode": "// CODE node after list GET. Selection resolves the internal key, never the display number.\nvar request = $context.$nodes.NORMALIZE_REQUEST.$output.result;\nvar response = $context.$nodes.LIST_SUPPLIERS.$output;\nvar result = { route: 'display', state: request.state, message: '', rows: [], nextCommand: null, supplierId: null };\nif (!response || !Array.isArray(response.items) || typeof response.hasMore !== 'boolean' || !Number.isInteger(response.count) || response.count !== response.items.length) {\n  result.message = 'The supplier response was incomplete. No new create was submitted.'; return result;\n}\nresult.rows = response.items.map(function (item) {\n  return { SupplierId: item.SupplierId, SupplierNumber: item.SupplierNumber, Supplier: item.Supplier, BusinessRelationship: item.BusinessRelationship, SupplierType: item.SupplierType, InactiveDate: item.InactiveDate };\n});\nif (request.query.detail) {\n  if (result.rows.length !== 1 || response.hasMore || !/^[1-9][0-9]*$/.test(String(result.rows[0].SupplierId))) {\n    result.message = 'Detail requires exactly one resolved supplier. Refine the supplier number or exact name.'; return result;\n  }\n  result.supplierId = String(result.rows[0].SupplierId); result.route = 'detail'; return result;\n}\nif (response.hasMore && response.count > 0) {\n  result.nextCommand = 'List suppliers offset ' + (request.query.offset + response.count) + ' limit ' + request.query.limit + ' filter ' + JSON.stringify(request.query.filter);\n}\nresult.message = result.rows.length ? 'Showing ' + result.rows.length + ' suppliers starting at offset ' + request.query.offset + '.' : 'No suppliers matched the filter.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "route_list"
          },
          "inputs": [],
          "diagram": {
            "x": 10850,
