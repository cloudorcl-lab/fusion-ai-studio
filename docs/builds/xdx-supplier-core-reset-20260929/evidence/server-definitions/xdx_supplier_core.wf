        {
          "id": "shape_address_list",
          "code": "SHAPE_ADDRESS_LIST",
          "type": "CODE",
          "metadata": {
            "name": "shape address list",
            "sourceCode": "var request = $context.$nodes.SHAPE_ADDRESS_PARENT.$output.result;\nvar response = $context.$nodes.LIST_ADDRESSES.$output;\nvar result = { route: 'display', resource: 'address', parent: request.parent, state: request.state, rows: [], message: '', nextCommand: null };\nif (!response || !Array.isArray(response.items) || typeof response.hasMore !== 'boolean' || response.count !== response.items.length) {\n  result.message = 'The address response was incomplete.'; return result;\n}\nresult.rows = response.items.map(function (row) {\n  return { SupplierAddressId: row.SupplierAddressId, AddressName: row.AddressName, CountryCode: row.CountryCode, AddressLine1: row.AddressLine1, City: row.City, State: row.State, PostalCode: row.PostalCode, Email: row.Email, AddressPurposeOrderingFlag: row.AddressPurposeOrderingFlag };\n});\nif (request.query.detail) {\n  if (result.rows.length !== 1 || response.hasMore || !/^[1-9][0-9]*$/.test(String(result.rows[0].SupplierAddressId))) { result.message = 'Address detail requires one exact match within this supplier.'; return result; }\n  result.addressId = String(result.rows[0].SupplierAddressId); result.route = 'detail'; return result;\n}\nif (response.hasMore && response.count > 0) result.nextCommand = 'List addresses for supplier ' + request.parent.SupplierNumber + ' offset ' + (request.query.offset + response.count) + ' limit ' + request.query.limit + ' filter ' + JSON.stringify(request.query.filter);\nresult.message = result.rows.length ? 'Showing ' + result.rows.length + ' addresses for supplier ' + request.parent.SupplierNumber + ' at offset ' + request.query.offset + '.' : 'No addresses matched within this supplier.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "route_address_list"
          },
          "inputs": [],
          "diagram": {
            "x": 6237.5,
            "y": 8092
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
