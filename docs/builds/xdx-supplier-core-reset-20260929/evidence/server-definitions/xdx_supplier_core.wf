astUpdatedBy\",\n    \"CreationSourceCode\",\n    \"CreationSource\",\n    \"DataFoxScore\",\n    \"DataFoxScoringCriteria\",\n    \"Alias\",\n    \"DUNSNumber\",\n    \"OneTimeSupplierFlag\",\n    \"RegistryId\",\n    \"CustomerNumber\",\n    \"StandardIndustryClass\",\n    \"IndustryCategory\",\n    \"IndustrySubcategory\",\n    \"NationalInsuranceNumber\",\n    \"NationalInsuranceNumberExistsFlag\",\n    \"CorporateWebsite\",\n    \"YearEstablished\",\n    \"MissionStatement\",\n    \"YearIncorporated\",\n    \"ChiefExecutiveTitle\",\n    \"ChiefExecutiveName\",\n    \"PrincipalTitle\",\n    \"PrincipalName\",\n    \"FiscalYearEndMonthCode\",\n    \"FiscalYearEndMonth\",\n    \"CurrentFiscalYearPotentialRevenue\",\n    \"PreferredFunctionalCurrencyCode\",\n    \"PreferredFunctionalCurrency\",\n    \"TaxRegistrationCountryCode\",\n    \"TaxRegistrationCountry\",\n    \"TaxRegistrationNumber\",\n    \"TaxpayerCountryCode\",\n    \"TaxpayerCountry\",\n    \"TaxpayerId\",\n    \"TaxpayerIdExistsFlag\",\n    \"FederalReportableFlag\",\n    \"FederalIncomeTaxTypeCode\",\n    \"FederalIncomeTaxType\",\n    \"StateReportableFlag\",\n    \"TaxReportingName\",\n    \"NameControl\",\n    \"VerificationDate\",\n    \"UseWithholdingTaxFlag\",\n    \"WithholdingTaxGroupId\",\n    \"WithholdingTaxGroup\",\n    \"BusinessClassificationNotApplicableFlag\",\n    \"SpendAuthReviewStatus\",\n    \"SpendAuthReviewStatusDisplay\",\n    \"DataFoxId\",\n    \"DataFoxCompanyName\",\n    \"DataFoxLegalName\",\n    \"DataFoxCompanyPrimaryURL\",\n    \"DataFoxNAICSCode\",\n    \"DataFoxCountry\",\n    \"DataFoxEIN\",\n    \"DataFoxLastSyncDate\",\n    \"OBNEnabledFlag\",\n    \"OnOFACListFlag\",\n    \"OFACSources\",\n    \"SupplierRegId\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "verify_result",
          "code": "VERIFY_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "verify result",
            "sourceCode": "// CODE node after independent GET; preserve the attempt even if persisted fields differ.\nvar prior = $context.$nodes.CAPTURE_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(prior.state));\nvar response = $context.$nodes.VERIFY_CREATED_SUPPLIER.$output;\nvar draft = state.draft;\nvar result = { route: 'display', state: state, message: '', supplier: response || null };\nvar expected = JSON.parse(draft.attempt.payload);\nvar matches = response && String(response.SupplierId) === draft.attempt.supplierId && ['Supplier', 'BusinessRelationship', 'TaxOrganizationType'].every(function (key) { return response[key] === expected[key]; });\ndraft.attempt.verifiedResponse = response || null;\ndraft.status = matches ? 'accepted' : 'uncertain';\nresult.message = matches ? 'Created supplier verified by independent GET. This request is complete and cannot be replayed.' : 'A create was attempted, but independent verification did not match every approved field. Keep this request frozen; reconcile before any further write.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_verified"
          },
          "inputs": [],
