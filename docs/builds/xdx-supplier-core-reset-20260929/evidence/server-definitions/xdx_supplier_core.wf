          "diagram": {
            "x": 6350,
            "y": 9646
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "normalize_contact",
          "code": "NORMALIZE_CONTACT",
          "type": "CODE",
          "metadata": {
            "name": "normalize contact",
            "sourceCode": "var request = $context.$nodes.NORMALIZE_REQUEST.$output.result;\nvar state = JSON.parse(JSON.stringify(request.state));\nvar extracted = $context.$nodes.EXTRACT_REQUEST.$output || {};\nvar raw = String($context.$system.$inputMessage || '').trim();\nvar draft = state.contactDraft || null;\nvar result = { route: 'display', resource: 'contact', state: state, message: '', draft: draft };\nvar fields = ['FirstName', 'LastName', 'Email'];\nfunction literal(value) { return \"'\" + String(value).replace(/'/g, \"''\") + \"'\"; }\nfunction blocked() { return ['draft', 'addressDraft', 'contactDraft', 'siteDraft'].some(function (key) { return state[key] && ['reserved', 'uncertain'].indexOf(state[key].status) >= 0; }); }\nfunction frozen(value) { return value && ['reserved', 'uncertain', 'accepted'].indexOf(value.status) >= 0; }\nfunction canonical(value) { var payload = {}; fields.forEach(function (key) { payload[key] = value.payload[key]; }); return JSON.stringify({ supplierId: value.parent.SupplierId, payload: payload }); }\nfunction fieldValid(key, value) {\n  return typeof value === 'string' && !!value.trim() && value === value.trim() && !/[\\u0000-\\u001f]/.test(value) && value.length <= (key === 'Email' ? 320 : 150) &&\n    (key !== 'Email' || /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value));\n}\nfunction valid(value) { return value && value.parent && /^[1-9][0-9]*$/.test(String(value.parent.SupplierId)) && value.payload && Object.keys(value.payload).length === 3 && fields.every(function (key) { return fieldValid(key, value.payload[key]); }); }\nvar control = /^(Review|Approve|Create) contact ([A-Za-z0-9_-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nvar edit = /^(?:(Contact)\\s+)?(FirstName|LastName|Email)\\s*:\\s*([\\s\\S]+)$/i.exec(raw);\nvar page = /^List contacts for supplier ([0-9]+) offset ([0-9]+) limit ([0-9]+) filter (\\{[\\s\\S]*\\})$/i.exec(raw);\nvar intent = control ? control[1].toLowerCase() : edit ? 'edit' : page ? 'list' : String(extracted.intent || 'help');\nif (edit && edit[2].toLowerCase() === 'email' && !edit[1] && state.editResource !== 'contact') { result.message = 'Specify Contact Email: followed by the value, or prepare/select the contact draft first. No draft was changed.'; return result; }\nif (['review', 'approve', 'create'].indexOf(intent) >= 0) {\n  if (!control || !draft || control[2] !== draft.requestId || Number(control[3]) !== draft.revision) { result.message = 'Use the exact displayed contact request and revision command. No new create was submitted.'; return result; }\n  if (frozen(draft) || blocked()) { result.message = 'A prior request is frozen or awaiting reconciliation. No new create was submitted.'; return result; }\n  if (!valid(draft)) { result.message = 'Complete valid FirstName, LastName and Email and a verified supplier parent before review.'; return result; }\n  var exact = canonical(draft);\n  if (intent === 'review') {\n    draft.reviewedRevision = draft.revision; draft.reviewedPayload = exact; state.editResource = 'contact';\n    result.message = 'Review this contact payload and supplier parent. Approval command: Approve contact ' + draft.requestId + ' revision ' + draft.revision;\n  } else if (draft.reviewedRevision !== draft.revision || draft.reviewedPayload !== exact) result.message = 'Review the current contact revision and parent before approving or creating.';\n  else if (intent === 'approve') {\n    draft.approvedRevision = draft.revision; draft.approvedPayload = exact;\n    result.message = 'Approved this exact contact and parent. Create command: Create contact ' + draft.requestId + ' revision ' + draft.revision;\n  } else if (draft.approvedRevision === draft.revision && draft.approvedPayload === exact) {\n    result.route = 'duplicate'; result.parent = draft.parent; result.query = { q: 'Email=' + literal(draft.payload.Email), limit: 2, offset: 0 };\n  } else result.message = 'Exact current approval is required before creating.';\n  return result;\n}\nif (intent === 'edit' || intent === 'prepare') {\n  if (blocked() || frozen(draft)) { result.message = 'A prior request must remain frozen. No contact change or new create was submitted.'; return result; }\n  var patch = extracted.contactPatch || {};\n  if (edit) { patch = {}; var key = fields.filter(function (f) { return f.toLowerCase() === edit[2].toLowerCase(); })[0]; patch[key] = edit[3].trim(); }\n  if (!patch || typeof patch !== 'object' || Array.isArray(patch) || Object.keys(patch).some(function (key) { return fields.indexOf(key) < 0 || !fieldValid(key, patch[key]); })) { result.message = 'Only valid FirstName, LastName and Email values are editable; maximum lengths are 150, 150 and 320.'; return result; }\n  if (!draft) {\n    if (intent === 'edit') { result.message = 'Prepare a contact for a supplier number first.'; return result; }\n    var number = String(extracted.parentNumber || '');\n    if (!/^[0-9]+$/.test(number)) { result.message = 'Specify the supplier number for the new contact.'; return result; }\n    result.route = 'parent'; result.pending = { intent: 'prepare', patch: patch, parentNumber: number }; result.parentQuery = { q: 'SupplierNumber=' + literal(number), limit: 2, offset: 0 }; return result;\n  }\n  // Exact raw field edits retain the existing parent even if model extraction conflicts.\n  if (!edit && extracted.parentNumber && String(extracted.parentNumber) !== String(draft.parent.SupplierNumber)) { result.message = 'This contact draft belongs to supplier ' + draft.parent.SupplierNumber + '. Parent changes require a separate reviewed request.'; return result; }\n  var changed = false;\n  fields.forEach(function (key) { if (Object.prototype.hasOwnProperty.call(patch, key) && patch[key] !== draft.payload[key]) { draft.payload[key] = patch[key]; changed = true; } });\n  if (changed) { draft.revision += 1; draft.reviewedRevision = null; draft.reviewedPayload = null; draft.approvedRevision = null; draft.approvedPayload = null; }\n  state.editResource = 'contact'; result.message = 'Contact draft revision ' + draft.revision + '. Review command: Review contact ' + draft.requestId + ' revision ' + draft.revision; return result;\n}\nif (['list', 'search', 'detail'].indexOf(intent) >= 0) {\n  var parentNumber = page ? page[1] : String(extracted.parentNumber || '');\n  var offset = page ? Number(page[2]) : 0, limit = page ? Number(page[3]) : 10;\n  var filter = { field: 'all', value: '', mode: 'exact' };\n  if (page) { try { filter = JSON.parse(page[4]); } catch (e) { result.message = 'Invalid contact paging filter.'; return result; } }\n  else if (extracted.contactId) filter = { field: 'SupplierContactId', value: String(extracted.contactId), mode: 'exact' };\n  else if (extracted.contactName) filter = { field: 'ContactName', value: String(extracted.contactName), mode: extracted.match === 'contains' ? 'contains' : 'exact' };\n  else if (extracted.contactEmail) filter = { field: 'Email', value: String(extracted.contactEmail), mode: 'exact' };\n  if (filter && filter.mode === undefined) filter.mode = 'exact';\n  if (!/^[0-9]+$/.test(parentNumber) || !Number.isSafeInteger(offset) || offset < 0 || !Number.isSafeInteger(limit) || limit < 1 || limit > 25 ||\n    !filter || ['all', 'SupplierContactId', 'ContactName', 'Email'].indexOf(filter.field) < 0 || typeof filter.value !== 'string' || /[\\u0000-\\u001f]/.test(filter.value) ||\n    ['exact', 'contains'].indexOf(filter.mode) < 0 || (filter.mode === 'contains' && (filter.field !== 'ContactName' || /[%_\\\\]/.test(filter.value))) ||\n    (filter.field === 'SupplierContactId' && !/^[1-9][0-9]*$/.test(filter.value)) || (filter.field !== 'all' && !filter.value.trim()) || filter.value.length > 320) { result.message = 'Specify a supplier number and valid bounded contact filter.'; return result; }\n  if (intent === 'detail' && (filter.field === 'all' || filter.mode !== 'exact')) { result.message = 'Contact detail needs its ID, exact name or exact email within the supplier.'; return result; }\n  var q = filter.field === 'all' ? 'SupplierContactId>0' : filter.field + (filter.mode === 'contains' ? ' like ' : '=') + (filter.field === 'SupplierContactId' ? filter.value : literal(filter.mode === 'contains' ? '%' + filter.value + '%' : filter.value));\n  result.route = 'parent'; result.pending = { intent: intent, parentNumber: parentNumber, query: { q: q, limit: limit, offset: offset, filter: filter, detail: intent === 'detail' } };\n  result.parentQuery = { q: 'SupplierNumber=' + literal(parentNumber), limit: 2, offset: 0 }; return result;\n}\nresult.message = 'List contacts for a supplier number, request detail by contact ID or exact name/email, or prepare a contact with FirstName, LastName and Email.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_contact_request"
