        {
          "id": "reserve_site",
          "code": "RESERVE_SITE",
          "type": "CODE",
          "metadata": {
            "name": "reserve site",
            "sourceCode": "var request=$context.$nodes.NORMALIZE_SITE.$output.result,state=JSON.parse(JSON.stringify(request.state)),draft=state.siteDraft,response=$context.$nodes.CHECK_SITE_DUPLICATE.$output;\nvar result={route:'display',resource:'site',state:state,draft:draft,message:'The exact site approval or conservative same-parent absence check did not pass. No create was submitted.'};\nvar blocked=['draft','addressDraft','contactDraft','siteDraft'].some(function(k){return state[k]&&['reserved','uncertain'].indexOf(state[k].status)>=0;});\nif(!draft||draft.status!=='draft'||blocked||!draft.address||!draft.buLookup||!draft.buLookup.complete||draft.buLookup.failed||draft.buLookup.revision!==draft.revision||draft.buLookup.parentId!==draft.parent.SupplierId||draft.address.parentId!==draft.parent.SupplierId||draft.address.AddressName!==draft.payload.SupplierAddressName)return result;\nvar p=draft.payload;if(Object.keys(p).length!==4||!Number.isSafeInteger(p.ProcurementBUId)||p.ProcurementBUId<=0||!draft.buLookup.choices[String(p.ProcurementBUId)]||p.SitePurposePurchasingFlag!==true||['SupplierSite','SupplierAddressName'].some(function(k){return typeof p[k]!=='string'||!p[k].trim()||p[k]!==p[k].trim()||p[k].length>240||/[\\u0000-\\u001f]/.test(p[k]);}))return result;\nvar payload={SupplierSite:p.SupplierSite,ProcurementBUId:p.ProcurementBUId,SupplierAddressName:p.SupplierAddressName,SitePurposePurchasingFlag:true};\nvar exact=JSON.stringify({supplierId:draft.parent.SupplierId,addressId:draft.address.SupplierAddressId,payload:payload}),raw=String($context.$system.$inputMessage||'').trim(),job=String($context.$workflow.$jobId||'');\nif(!/^[A-Za-z0-9_-]+$/.test(job)||request.route!=='duplicate'||!request.parent||request.parent.SupplierId!==draft.parent.SupplierId||!request.query||request.query.q!==\"SupplierSite='\"+p.SupplierSite.replace(/'/g,\"''\")+\"'\"||request.query.limit!==2||request.query.offset!==0||raw.toLowerCase()!==('Create site '+draft.requestId+' revision '+draft.revision).toLowerCase()||draft.reviewedRevision!==draft.revision||draft.approvedRevision!==draft.revision||draft.reviewedPayload!==exact||draft.approvedPayload!==exact||!response||!Array.isArray(response.items)||response.items.length!==0||response.count!==0||response.hasMore!==false)return result;\ndraft.status='reserved';draft.attempt={requestId:draft.requestId,revision:draft.revision,approved:exact,jobId:job};result.route='create';result.parent=draft.parent;result.payload=payload;result.message='Site create reserved. Reconcile uncertain outcomes without replay.';return result;\n",
