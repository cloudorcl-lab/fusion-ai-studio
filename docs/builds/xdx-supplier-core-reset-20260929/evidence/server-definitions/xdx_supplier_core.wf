            "sourceCode": "// Runtime may deserialize a JSON-string assignment into an object.\nvar view = $context.$variables.view;\nif (typeof view === 'string') view = JSON.parse(view);\nif (!view || typeof view !== 'object' || Array.isArray(view)) throw new Error('Display state is unavailable');\nreturn view;\n",
