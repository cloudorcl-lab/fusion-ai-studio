        {
          "id": "shape_contact_parent",
          "code": "SHAPE_CONTACT_PARENT",
          "type": "CODE",
          "metadata": {
            "name": "shape contact parent",
            "sourceCode": "var request = $context.$nodes.NORMALIZE_CONTACT.$output.result;\nvar state = JSON.parse(JSON.stringify(request.state));\nvar response = $context.$nodes.RESOLVE_CONTACT_SUPPLIER.$output;\nvar result = { route: 'display', resource: 'contact', state: state, message: '' };\nif (!request.pending || !response || !Array.isArray(response.items) || response.items.length !== 1 || response.count !== 1 || response.hasMore !== false ||\n    !/^[1-9][0-9]*$/.test(String(response.items[0].SupplierId)) || String(response.items[0].SupplierNumber) !== request.pending.parentNumber) {\n  result.message = 'Exactly one supplier matching the requested number is required. No new contact create was submitted.'; return result;\n}\nvar row = response.items[0];\nresult.parent = { SupplierId: String(row.SupplierId), SupplierNumber: String(row.SupplierNumber), Supplier: row.Supplier };\nif (request.pending.intent === 'prepare') {\n  var blocked = ['draft', 'addressDraft', 'contactDraft', 'siteDraft'].some(function (key) { return state[key] && ['reserved', 'uncertain'].indexOf(state[key].status) >= 0; });\n  var id = String($context.$workflow.$jobId || '');\n  if (!/^[A-Za-z0-9_-]+$/.test(id) || state.contactDraft || blocked) { result.message = 'A unique new contact request and reconciled prior attempts are required.'; return result; }\n  state.contactDraft = { requestId: id, revision: 1, status: 'draft', parent: result.parent, payload: request.pending.patch };\n  state.editResource = 'contact'; result.draft = state.contactDraft;\n  result.message = 'Contact draft revision 1. Review command: Review contact ' + id + ' revision 1';\n} else { result.route = 'list'; result.query = request.pending.query; }\nreturn result;\n",
