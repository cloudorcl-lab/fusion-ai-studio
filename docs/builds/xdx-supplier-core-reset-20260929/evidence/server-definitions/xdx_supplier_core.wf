        {
          "id": "capture_create",
          "code": "CAPTURE_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "capture create",
            "sourceCode": "// CODE node immediately after POST. Persist this returned state before verification GET.\nvar reserved = $context.$nodes.RESERVE_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(reserved.state));\nvar response = $context.$nodes.CREATE_SUPPLIER.$output;\nvar draft = state.draft;\nvar result = { route: 'display', state: state, message: '', supplierId: null };\ndraft.status = 'uncertain';\ndraft.attempt.response = response || null;\nif (response && /^[1-9][0-9]*$/.test(String(response.SupplierId))) {\n  draft.attempt.supplierId = String(response.SupplierId);\n  result.supplierId = draft.attempt.supplierId; result.route = 'verify';\n  result.message = 'Create returned a supplier key; independent read verification is pending. Do not replay the create.';\n} else result.message = 'A create was attempted, but its result is uncertain. Keep this request frozen and reconcile by reading; do not submit another create.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_capture"
          },
          "inputs": [],
          "diagram": {
            "x": 9837.5,
            "y": 7426
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
