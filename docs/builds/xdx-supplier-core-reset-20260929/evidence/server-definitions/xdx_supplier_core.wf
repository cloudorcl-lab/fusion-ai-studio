        {
          "id": "verify_created_contact",
          "code": "VERIFY_CREATED_CONTACT",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "verify created contact",
            "businessObjectCode": "XDX_SUPPLIER_CORE_CONTACTS",
            "functionName": "GetContact",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "verify_contact"
          },
          "inputs": [
            {
              "id": "verify_created_contact_suppliers_Id",
              "name": "suppliers_Id",
              "type": "string",
              "value": "{{$context.$nodes.CAPTURE_CONTACT.$output.result.parent.SupplierId}}"
            },
            {
              "id": "verify_created_contact_suppliers_contacts_Id",
              "name": "suppliers_contacts_Id",
              "type": "string",
              "value": "{{$context.$nodes.CAPTURE_CONTACT.$output.result.contactId}}"
            }
          ],
          "diagram": {
            "x": 6350,
            "y": 8758
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"SupplierContactId\": {\n      \"type\": \"number\"\n    },\n    \"ContactName\": {\n      \"type\": \"string\"\n    },\n    \"FirstName\": {\n      \"type\": \"string\"\n    },\n    \"LastName\": {\n      \"type\": \"string\"\n    },\n    \"Email\": {\n      \"type\": \"string\"\n    },\n    \"PersonProfileId\": {\n      \"type\": \"number\"\n    },\n    \"Status\": {\n      \"type\": \"string\"\n    },\n    \"InactiveDate\": {\n      \"type\": \"null\"\n    },\n    \"UserName\": {\n      \"type\": \"null\"\n    },\n    \"UserAccountStatus\": {\n      \"type\": \"null\"\n    }\n  },\n  \"required\": [\n    \"SupplierContactId\",\n    \"ContactName\",\n    \"FirstName\",\n    \"LastName\",\n    \"Email\",\n    \"PersonProfileId\",\n    \"Status\",\n    \"InactiveDate\",\n    \"UserName\",\n    \"UserAccountStatus\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "verify_contact",
          "code": "VERIFY_CONTACT",
          "type": "CODE",
          "metadata": {
            "name": "verify contact",
            "sourceCode": "var prior = $context.$nodes.CAPTURE_CONTACT.$output.result;\nvar state = JSON.parse(JSON.stringify(prior.state));\nvar draft = state.contactDraft;\nvar response = $context.$nodes.VERIFY_CREATED_CONTACT.$output;\nvar approved = null;\ntry { approved = draft && draft.attempt ? JSON.parse(draft.attempt.approved) : null; } catch (e) {}\nvar fields = ['FirstName', 'LastName', 'Email'];\nvar matches = draft && draft.status === 'uncertain' && approved && approved.payload && Object.keys(approved.payload).length === 3 && response && !Array.isArray(response) &&\n  approved.supplierId === draft.parent.SupplierId && String(response.SupplierContactId) === draft.attempt.contactId && String(response.PersonProfileId) === draft.attempt.personProfileId &&\n  fields.every(function (key) { return response[key] === approved.payload[key]; }) && (response.UserName === null || response.UserName === undefined) && (response.UserAccountStatus === null || response.UserAccountStatus === undefined);\nif (draft && draft.attempt && draft.status !== 'accepted') { draft.attempt.verifiedResponse = response || null; draft.status = matches ? 'accepted' : 'uncertain'; }\nreturn { route: 'display', resource: 'contact', state: state, parent: draft ? draft.parent : null, draft: draft, contact: response || null,\n  message: matches ? 'Created contact verified by independent same-parent GET. This request cannot be replayed.' : 'Independent contact verification did not match every approved field and returned key. Reconcile without another create.' };\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_contact_verified"
          },
          "inputs": [],
          "diagram": {
            "x": 6350,
            "y": 8980
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
