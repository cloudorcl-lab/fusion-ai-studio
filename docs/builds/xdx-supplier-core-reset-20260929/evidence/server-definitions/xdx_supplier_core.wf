          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"@context\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"key\": {\n          \"type\": \"string\"\n        },\n        \"headers\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"ETag\": {\n              \"type\": \"string\"\n            }\n          },\n          \"additionalProperties\": false\n        },\n        \"links\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"href\": {\n                \"type\": \"string\"\n              },\n              \"rel\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"self\",\n                  \"lov\",\n                  \"parent\",\n                  \"canonical\",\n                  \"child\",\n                  \"enclosure\",\n                  \"action\",\n                  \"custom\"\n                ]\n              },\n              \"name\": {\n                \"type\": \"string\"\n              },\n              \"kind\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"collection\",\n                  \"item\",\n                  \"describe\",\n                  \"other\"\n                ]\n              }\n            },\n            \"additionalProperties\": false\n          }\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"SupplierAddressId\": {\n      \"type\": \"string\",\n      \"format\": \"BigInt\"\n    },\n    \"FormattedAddress\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"Status\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"nu