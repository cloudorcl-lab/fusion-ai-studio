          "diagram": {
            "x": 10625,
            "y": 6982
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"SupplierId\": {\n      \"type\": \"number\"\n    },\n    \"SupplierPartyId\": {\n      \"type\": \"number\"\n    },\n    \"Supplier\": {\n      \"type\": \"string\"\n    },\n    \"SupplierNumber\": {\n      \"type\": \"string\"\n    },\n    \"AlternateName\": {\n      \"type\": \"string\"\n    },\n    \"TaxOrganizationTypeCode\": {\n      \"type\": \"string\"\n    },\n    \"TaxOrganizationType\": {\n      \"type\": \"string\"\n    },\n    \"SupplierTypeCode\": {\n      \"type\": \"string\"\n    },\n    \"SupplierType\": {\n      \"type\": \"string\"\n    },\n    \"InactiveDate\": {\n      \"type\": \"null\"\n    },\n    \"Status\": {\n      \"type\": \"string\"\n    },\n    \"BusinessRelationshipCode\": {\n      \"type\": \"string\"\n    },\n    \"BusinessRelationship\": {\n      \"type\": \"string\"\n    },\n    \"RelationshipDisplay\": {\n      \"type\": \"string\"\n    },\n    \"RequestNumber\": {\n      \"type\": \"null\"\n    },\n    \"ParentSupplierId\": {\n      \"type\": \"null\"\n    },\n    \"ParentSupplier\": {\n      \"type\": \"null\"\n    },\n    \"ParentSupplierNumber\": {\n      \"type\": \"null\"\n    },\n    \"CreationDate\": {\n      \"type\": \"string\"\n    },\n    \"CreatedBy\": {\n      \"type\": \"string\"\n    },\n    \"LastUpdateDate\": {\n      \"type\": \"string\"\n    },\n    \"LastUpdatedBy\": {\n      \"type\": \"string\"\n    },\n    \"CreationSourceCode\": {\n      \"type\": \"string\"\n    },\n    \"CreationSource\": {\n      \"type\": \"string\"\n    },\n    \"DataFoxScore\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxScoringCriteria\": {\n      \"type\": \"null\"\n    },\n    \"Alias\": {\n      \"type\": \"null\"\n    },\n    \"DUNSNumber\": {\n      \"type\": \"null\"\n    },\n    \"OneTimeSupplierFlag\": {\n      \"type\": \"null\"\n    },\n    \"RegistryId\": {\n      \"type\": \"string\"\n    },\n    \"CustomerNumber\": {\n      \"type\": \"null\"\n    },\n    \"StandardIndustryClass\": {\n      \"type\": \"string\"\n    },\n    \"IndustryCategory\": {\n      \"type\": \"null\"\n    },\n    \"IndustrySubcategory\": {\n      \"type\": \"null\"\n    },\n    \"NationalInsuranceNumber\": {\n      \"type\": \"null\"\n    },\n    \"NationalInsuranceNumberExistsFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"CorporateWebsite\": {\n      \"type\": \"string\"\n    },\n    \"YearEstablished\": {\n      \"type\": \"number\"\n    },\n    \"MissionStatement\": {\n      \"type\": \"null\"\n    },\n    \"YearIncorporated\": {\n      \"type\": \"null\"\n    },\n    \"ChiefExecutiveTitle\": {\n      \"type\": \"null\"\n    },\n    \"ChiefExecutiveName\": {\n      \"type\": \"null\"\n    },\n    \"PrincipalTitle\": {\n      \"type\": \"null\"\n    },\n    \"PrincipalName\": {\n      \"type\": \"null\"\n    },\n    \"FiscalYearEndMonthCode\": {\n      \"type\": \"null\"\n    },\n    \"FiscalYearEndMonth\": {\n      \"type\": \"null\"\n    },\n    \"CurrentFiscalYearPotentialRevenue\": {\n      \"type\": \"number\"\n    },\n    \"PreferredFunctionalCurrencyCode\": {\n      \"type\": \"null\"\n    },\n    \"PreferredFunctionalCurrency\": {\n      \"type\": \"null\"\n    },\n    \"TaxRegistrationCountryCode\": {\n      \"type\": \"string\"\n    },\n    \"TaxRegistrationCountry\": {\n      \"type\": \"string\"\n    },\n    \"TaxRegistrationNumber\": {\n      \"type\": \"string\"\n    },\n    \"TaxpayerCountryCode\": {\n      \"type\": \"string\"\n    },\n    \"TaxpayerCountry\": {\n      \"type\": \"string\"\n    },\n    \"TaxpayerId\": {\n      \"type\": \"string\"\n    },\n    \"TaxpayerIdExistsFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"FederalReportableFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"FederalIncomeTaxTypeCode\": {\n      \"type\": \"null\"\n    },\n    \"FederalIncomeTaxType\": {\n      \"type\": \"null\"\n    },\n    \"StateReportableFlag\": {\n      \"type\": \"null\"\n    },\n    \"TaxReportingName\": {\n      \"type\": \"null\"\n    },\n    \"NameControl\": {\n      \"type\": \"null\"\n    },\n    \"VerificationDate\": {\n      \"type\": \"null\"\n    },\n    \"UseWithholdingTaxFlag\": {\n      \"type\": \"null\"\n    },\n    \"WithholdingTaxGroupId\": {\n      \"type\": \"null\"\n    },\n    \"WithholdingTaxGroup\": {\n      \"type\": \"null\"\n    },\n    \"BusinessClassificationNotApplicableFlag\": {\n      \"type\": \"null\"\n    },\n    \"SpendAuthReviewStatus\": {\n      \"type\": \"null\"\n    },\n    \"SpendAuthReviewStatusDisplay\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxId\": {\n      \"type\": \"string\"\n    },\n    \"DataFoxCompanyName\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxLegalName\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxCompanyPrimaryURL\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxNAICSCode\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxCountry\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxEIN\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxLastSyncDate\": {\n      \"type\": \"string\"\n    },\n    \"OBNEnabledFlag\": {\n      \"type\": \"null\"\n    },\n    \"OnOFACListFlag\": {\n      \"type\": \"string\"\n    },\n    \"OFACSources\": {\n      \"type\": \"null\"\n    },\n    \"SupplierRegId\": {\n      \"type\": \"null\"\n    }\n  },\n  \"required\": [\n    \"SupplierId\",\n    \"SupplierPartyId\",\n    \"Supplier\",\n    \"SupplierNumber\",\n    \"AlternateName\",\n    \"TaxOrganizationTypeCode\",\n    \"TaxOrganizationType\",\n    \"SupplierTypeCode\",\n    \"SupplierType\",\n    \"InactiveDate\",\n    \"Status\",\n    \"BusinessRelationshipCode\",\n    \"BusinessRelationship\",\n    \"RelationshipDisplay\",\n    \"RequestNumber\",\n    \"ParentSupplierId\",\n    \"ParentSupplier\",\n    \"ParentSupplierNumber\",\n    \"CreationDate\",\n    \"CreatedBy\",\n    \"LastUpdateDate\",\n    \"LastUpdatedBy\",\n    \"CreationSourceCode\",\n    \"CreationSource\",\n    \"DataFoxScore\",\n    \"DataFoxScoringCriteria\",\n    \"Alias\",\n    \"DUNSNumber\",\n    \"OneTimeSupplierFlag\",\n    \"RegistryId\",\n    \"CustomerNumber\",\n    \"StandardIndustryClass\",\n    \"IndustryCategory\",\n    \"IndustrySubcategory\",\n    \"NationalInsuranceNumber\",\n    \"NationalInsuranceNumberExistsFlag\",\n    \"CorporateWebsite\",\n    \"YearEstablished\",\n    \"MissionStatement\",\n    \"YearIncorporated\",\n    \"ChiefExecutiveTitle\",\n    \"ChiefExecutiveName\",\n    \"PrincipalTitle\",\n    \"PrincipalName\",\n    \"FiscalYearEndMonthCode\",\n    \"FiscalYearEndMonth\",\n    \"CurrentFiscalYearPotentialRevenue\",\n    \"PreferredFunctionalCurrencyCode\",\n    \"PreferredFunctionalCurrency\",\n    \"TaxRegistrationCountryCode\",\n    \"TaxRegistrationCountry\",\n    \"TaxRegistrationNumber\",\n    \"TaxpayerCountryCode\",\n    \"TaxpayerCountry\",\n    \"TaxpayerId\",\n    \"TaxpayerIdExistsFlag\",\n    \"FederalReportableFlag\",\n    \"FederalIncomeTaxTypeCode\",\n    \"FederalIncomeTaxType\",\n    \"StateReportableFlag\",\n    \"TaxReportingName\",\n    \"NameControl\",\n    \"VerificationDate\",\n    \"UseWithholdingTaxFlag\",\n    \"WithholdingTaxGroupId\",\n    \"WithholdingTaxGroup\",\n    \"BusinessClassificationNotApplicableFlag\",\n    \"SpendAuthReviewStatus\",\n    \"SpendAuthReviewStatusDisplay\",\n    \"DataFoxId\",\n    \"DataFoxCompanyName\",\n    \"DataFoxLegalName\",\n    \"DataFoxCompanyPrimaryURL\",\n    \"DataFoxNAICSCode\",\n    \"DataFoxCountry\",\n    \"DataFoxEIN\",\n    \"DataFoxLastSyncDate\",\n    \"OBNEnabledFlag\",\n    \"OnOFACListFlag\",\n    \"OFACSources\",\n    \"SupplierRegId\"\n  ],\n  \"additionalProperties\": false\n}"
        },
