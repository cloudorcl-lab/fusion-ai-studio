        {
          "id": "shape_site_address",
          "code": "SHAPE_SITE_ADDRESS",
          "type": "CODE",
          "metadata": {
            "name": "shape site address",
            "sourceCode": "// SITE_ADDRESS_INPUT is the converged NORMALIZE_SITE or SHAPE_SITE_PARENT result.\nvar request=$context.$nodes.SITE_ADDRESS_INPUT.$output.result,state=JSON.parse(JSON.stringify(request.state)),draft=state.siteDraft,response=$context.$nodes.RESOLVE_SITE_ADDRESS.$output;\nvar result={route:'display',resource:'site',state:state,draft:draft,message:''};\nvar blocked=['draft','addressDraft','contactDraft','siteDraft'].some(function(k){return state[k]&&['reserved','uncertain'].indexOf(state[k].status)>=0;});\nif(!draft||draft.status!=='draft'||blocked||request.route!=='address'||!request.parent||request.parent.SupplierId!==draft.parent.SupplierId||!request.query||request.query.q!==\"AddressName='\"+draft.payload.SupplierAddressName.replace(/'/g,\"''\")+\"'\"||request.query.limit!==2||request.query.offset!==0||!response||!Array.isArray(response.items)||response.items.length!==1||response.count!==1||response.hasMore!==false||!response.items[0]||typeof response.items[0]!=='object'||Array.isArray(response.items[0])||response.items[0].AddressName!==draft.payload.SupplierAddressName||!/^[1-9][0-9]*$/.test(String(response.items[0].SupplierAddressId))){if(draft){draft.address=null;draft.buLookup=null;}result.message='Exactly one address under the selected supplier must match the approved address name. No create was submitted.';return result;}\ndraft.address={SupplierAddressId:String(response.items[0].SupplierAddressId),AddressName:response.items[0].AddressName,parentId:draft.parent.SupplierId};\ndraft.buLookup={revision:draft.revision,parentId:draft.parent.SupplierId,complete:false,nextOffset:0,choices:{},pages:0};\nresult.route='bu';result.parent=draft.parent;result.query={q:'ProcurementBUId>0',limit:100,offset:0};return result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_site_address"
          },
          "inputs": [],
          "diagram": {
