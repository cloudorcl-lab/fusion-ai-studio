        {
          "id": "reserve_contact",
          "code": "RESERVE_CONTACT",
          "type": "CODE",
          "metadata": {
            "name": "reserve contact",
            "sourceCode": "var request = $context.$nodes.NORMALIZE_CONTACT.$output.result;\nvar state = JSON.parse(JSON.stringify(request.state));\nvar draft = state.contactDraft;\nvar response = $context.$nodes.CHECK_CONTACT_DUPLICATE.$output;\nvar result = { route: 'display', resource: 'contact', state: state, draft: draft, message: '' };\nvar fields = ['FirstName', 'LastName', 'Email'], payload = {};\nvar blocked = ['draft', 'addressDraft', 'contactDraft', 'siteDraft'].some(function (key) { return state[key] && ['reserved', 'uncertain'].indexOf(state[key].status) >= 0; });\nif (draft && draft.payload) fields.forEach(function (key) { payload[key] = draft.payload[key]; });\nvar exact = draft && draft.parent ? JSON.stringify({ supplierId: draft.parent.SupplierId, payload: payload }) : '';\nvar valid = draft && draft.payload && Object.keys(draft.payload).length === 3 && draft.parent && /^[1-9][0-9]*$/.test(String(draft.parent.SupplierId)) && fields.every(function (key) {\n  var value = payload[key]; return typeof value === 'string' && !!value.trim() && value === value.trim() && !/[\\u0000-\\u001f]/.test(value) && value.length <= (key === 'Email' ? 320 : 150) && (key !== 'Email' || /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value));\n});\nvar raw = String($context.$system.$inputMessage || '').trim();\nvar jobId = String($context.$workflow.$jobId || '');\nif (!valid || blocked || draft.status !== 'draft' || request.route !== 'duplicate' || raw.toLowerCase() !== ('Create contact ' + draft.requestId + ' revision ' + draft.revision).toLowerCase() || !/^[A-Za-z0-9_-]+$/.test(jobId) ||\n    draft.approvedRevision !== draft.revision || draft.approvedPayload !== exact || draft.reviewedRevision !== draft.revision || draft.reviewedPayload !== exact ||\n    !request.parent || request.parent.SupplierId !== draft.parent.SupplierId || !request.query || request.query.q !== \"Email='\" + payload.Email.replace(/'/g, \"''\") + \"'\" || request.query.offset !== 0 || request.query.limit !== 2) {\n  result.message = 'The exact contact and parent approval is no longer eligible. No new create was submitted.'; return result;\n}\nif (!response || !Array.isArray(response.items) || response.items.length || response.count !== 0 || response.hasMore !== false) {\n  result.message = 'The same-parent email check did not prove absence. No new create was submitted.'; return result;\n}\ndraft.status = 'reserved'; draft.attempt = { requestId: draft.requestId, revision: draft.revision, approved: exact, jobId: jobId };\nresult.route = 'create'; result.parent = draft.parent; result.payload = payload;\nresult.message = 'Contact create reserved; uncertain outcomes must be reconciled without replay.';\nreturn result;\n",
            "returnType": "object",
            "errorNodeId": "handle_error"
          },
          "outcomes": {
            "success": "persist_contact_reservation"
          },
          "inputs": [],
          "diagram": {
            "x": 7250,
            "y": 7204
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
