    "tools": [
      {
        "name": "getall_suppliers",
        "description": "Query one supplier page using an allowlisted escaped filter. Preserve count, limit, offset and hasMore; never claim a page is the full catalog.",
        "operationId": "getall_suppliers",
        "operationType": "GET",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers?fields=SupplierId,SupplierNumber,Supplier,SupplierType,BusinessRelationship,InactiveDate&onlyData=true&orderBy=SupplierId:asc&limit={limit}&offset={offset}&q={q}",
