        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "limit",
            "dataType": "integer",
            "description": "Requested page size, integer 1 to 25.",
            "id": 2,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "offset",
            "dataType": "integer",
            "description": "Zero-based page offset, nonnegative integer.",
            "id": 3,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "q",
            "dataType": "string",
            "description": "Deterministic allowlisted supplier filter; escape literals before binding. Never accept raw query code from user.",
            "id": 4,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
