          "id": "1",
          "code": "GUARD",
          "type": "CODE",
          "metadata": {
            "name": "Guard",
            "sourceCode": "let p;\ntry { p=JSON.parse(String($context.$system.$inputMessage||'')); }\ncatch(e) { return {valid:false,error:'Expected JSON read request'}; }\nif(!p||Array.isArray(p)||typeof p!=='object')return {valid:false,error:'Expected object'};\nconst route=p.route===undefined?'GetAddress':p.route;\nconst allowed={GetAddress:['SupplierId','SupplierAddressId'],GetSite:['route','SupplierId','SupplierSiteId'],QuerySites:['route','SupplierId','limit','offset'],GetContact:['route','SupplierId','SupplierContactId'],QueryContacts:['route','SupplierId','limit','offset']};\nif(!Object.prototype.hasOwnProperty.call(allowed,route))return {valid:false,error:'GET route not allowed'};\nconst keys=allowed[route].slice();if(route==='GetAddress'&&p.route!==undefined)keys.push('route');\nif(Object.keys(p).sort().join(',')!==keys.sort().join(','))return {valid:false,error:'Unexpected or missing input'};\nconst idNames=route==='GetAddress'?['SupplierId','SupplierAddressId']:route==='GetSite'?['SupplierId','SupplierSiteId']:route==='GetContact'?['SupplierId','SupplierContactId']:['SupplierId'];\nfor(const k of idNames)if(typeof p[k]!=='number'||!Number.isSafeInteger(p[k])||p[k]<=0)return {valid:false,error:'Internal keys must be positive safe integers'};\nif((route==='QuerySites'||route==='QueryContacts')&&(!Number.isInteger(p.limit)||p.limit<1||p.limit>100||!Number.isInteger(p.offset)||p.offset<0))return {valid:false,error:'Invalid paging'};\nconst result={valid:true,route:route,SupplierId:p.SupplierId};\nif(route==='GetAddress')result.SupplierAddressId=p.SupplierAddressId;\nif(route==='GetSite')result.SupplierSiteId=p.SupplierSiteId;\nif(route==='QuerySites'){result.q='SupplierSiteId>0';result.limit=p.limit;result.offset=p.offset;}\nif(route==='GetContact')result.SupplierContactId=p.SupplierContactId;\nif(route==='QueryContacts'){result.q='SupplierContactId>0';result.limit=p.limit;result.offset=p.offset;}\nreturn result;\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "2"
          },
          "inputs": [],
          "diagram": {
            "x": 6125,
            "y": 5206
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
