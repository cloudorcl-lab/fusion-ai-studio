            "name": "XDX shape site detail",
            "sourceCode": "\nconst fields=['SupplierSite','ProcurementBUId','SupplierAddressName','SitePurposePurchasingFlag'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction state(){const s=clone(($context.$variables||{}).siteState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\nfunction snapshot(t){const p={},payload=obj(t.payload);fields.forEach(function(k){p[k]=payload[k];});return JSON.stringify({parentId:t.parentId,parentNumber:t.parentNumber,parentName:t.parentName,payload:p,addressId:t.addressId,buName:t.buName});}\nfunction valid(t){if(!key(t.parentId)||!t.parentNumber||!t.parentName)return 'Select a verified supplier parent.';const p=obj(t.payload);if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported site field.';for(const k of ['SupplierSite','SupplierAddressName'])if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>240||/[\\x00-\\x1f]/.test(p[k]))return 'Supply a valid '+k+'.';if(typeof p.ProcurementBUId!=='number'||!key(p.ProcurementBUId))return 'Select an explicit valid ProcurementBUId from the current site lookup.';if(p.SitePurposePurchasingFlag!==true)return 'SitePurposePurchasingFlag must be true in this purchasing-site flow.';return '';}\nfunction frozen(t){return t.attempt&&t.attempt.requestId===t.requestId&&t.attempt.revision===t.revision&&t.attempt.payload===snapshot(t);}\nfunction refs(t){return key(t.addressId)&&typeof t.buName==='string'&&!!t.buName&&t.referencesPayload===JSON.stringify({parentId:t.parentId,SupplierAddressName:t.payload.SupplierAddressName,ProcurementBUId:t.payload.ProcurementBUId});}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'cardWidget',title:title,description:'Supplier site request.',properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx,rows=[{cells:['Supplier number',t.parentNumber||'Not selected']},{cells:['Supplier ID',t.parentId||'Not selected']},{cells:['Supplier',t.parentName||'Not selected']}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));rows.push({cells:['Resolved address ID',t.addressId||'Not verified']},{cells:['Procurement business unit',t.buName||'Not verified']});if(t.siteId)rows.push({cells:['Supplier site ID',t.siteId]});s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Site created and verified':t.status==='pending'?'Site outcome awaiting verification':'Site draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction parent(){const supplier=clone(($context.$variables||{}).readState),view=obj(supplier.view),r=obj(($context.$variables||{}).request),cols=view.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber'),c=cols.indexOf('Supplier');if(view.error||a<0||b<0||c<0)return {error:'Find the supplier first and use its displayed supplier number.'};let rows=(view.rows||[]).filter(function(row){return key(row[a])&&row[b]&&row[c];});if(r.supplierId)rows=rows.filter(function(row){return String(row[b])===String(r.supplierId);});else rows=rows.filter(function(row){return String(row[a])===String(supplier.selectedSupplierId||'');});const ids=[];rows.forEach(function(row){if(ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});if(ids.length!==1)return {error:'Supplier number is absent, ambiguous or unverified. Query the supplier first.'};const row=rows[0];return {parentId:String(row[a]),parentNumber:String(row[b]),parentName:String(row[c]),error:''};}\n\nconst s=state(),read=s.read;function fail(m){read.selectedId='';read.hasMore=false;read.nextOffset=null;return {state:card(s,'Site query unavailable',m)};}\nfunction rows(items,description){const cols=['SupplierSiteId','SupplierSite','ProcurementBUId','ProcurementBU','SupplierAddressId','SupplierAddressName','SitePurposePurchasingFlag','InactiveDate'];if(!items.length){read.selectedId='';return {state:card(s,'No sites match',description)};}s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Supplier sites',description:'Supplier '+read.parentName+' (number '+read.parentNumber+', ID '+read.parentId+'). '+description,properties:{cols:cols,rows:items.map(function(row){return {cells:cols.map(function(k){return row[k]===undefined||row[k]===null?'Not specified':String(row[k]);})};})}})+'</oraInfoDisplay>';return {state:s};}\n\nconst raw=obj($context.$nodes.FETCH_SITE_DETAIL.$output);if(!key(raw.SupplierSiteId)||String(raw.SupplierSiteId)!==read.selectedId||!raw.SupplierSite)return fail('Site detail was not verified under selected supplier.');read.hasMore=false;read.nextOffset=null;return rows([raw],'Verified selected site detail.');\n",
