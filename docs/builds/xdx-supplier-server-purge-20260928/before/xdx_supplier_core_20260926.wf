        {
          "id": "91",
          "code": "PREPARE_CONTACT",
          "type": "CODE",
          "metadata": {
            "name": "XDX prepare contact",
            "sourceCode": "\nconst fields=['FirstName','LastName','Email'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction state(){const s=clone(($context.$variables||{}).contactState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\nfunction snapshot(t){const p={},payload=obj(t.payload);fields.forEach(function(k){p[k]=payload[k];});return JSON.stringify({parentId:t.parentId,parentNumber:t.parentNumber,parentName:t.parentName,payload:p});}\nfunction valid(t){if(!key(t.parentId)||!t.parentNumber||!t.parentName)return 'Select a verified supplier parent.';const p=obj(t.payload);if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Only FirstName, LastName and Email are permitted; no account fields.';for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>(k==='Email'?320:150)||/[\\x00-\\x1f]/.test(p[k]))return 'Supply a valid '+k+'.';}if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.Email))return 'Supply a valid contact email.';return '';}\nfunction frozen(t){return t.attempt&&t.attempt.requestId===t.requestId&&t.attempt.revision===t.revision&&t.attempt.payload===snapshot(t);}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'cardWidget',title:title,description:'Supplier contact request.',properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx,rows=[{cells:['Supplier number',t.parentNumber||'Not selected']},{cells:['Supplier ID',t.parentId||'Not selected']},{cells:['Supplier',t.parentName||'Not selected']}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?t.payload[k]:'Not supplied']};}));if(t.contactId)rows.push({cells:['Supplier contact ID',t.contactId]});if(t.personProfileId)rows.push({cells:['Person profile ID',t.personProfileId]});if(t.status==='verified')rows.push({cells:['Contact name',t.persisted.ContactName]},{cells:['UserName','Not specified']},{cells:['UserAccountStatus','Not specified']});s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Contact created and verified':t.status==='pending'?'Contact outcome awaiting verification':'Contact draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction parent(){const supplier=clone(($context.$variables||{}).readState),view=obj(supplier.view),r=obj(($context.$variables||{}).request),cols=view.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber'),c=cols.indexOf('Supplier');if(view.error||a<0||b<0||c<0)return {error:'Find the supplier first and use its displayed supplier number.'};let rows=(view.rows||[]).filter(function(row){return key(row[a])&&row[b]&&row[c];});if(r.supplierId)rows=rows.filter(function(row){return String(row[b])===String(r.supplierId);});else rows=rows.filter(function(row){return String(row[a])===String(supplier.selectedSupplierId||'');});const ids=[];rows.forEach(function(row){if(ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});if(ids.length!==1)return {error:'Supplier number is absent, ambiguous or unverified. Query the supplier first.'};const row=rows[0];return {parentId:String(row[a]),parentNumber:String(row[b]),parentName:String(row[c]),error:''};}\n\nconst s=state(),r=clone($context.$variables.request),raw=String($context.$system.$inputMessage||'').trim();let t=s.tx;function display(m){return {route:'display',state:render(s,m)};}\nif(r.error)return display(r.error);\nif(r.resource!=='contact')return display('Contact request required. Nothing was changed.');\nif($context.$app.$OraMessageHint!=='Query')return {route:'display',state:card(s,'Contact request unavailable','Use application Query conversation.')};\nif(/^(please )?(delete|purge|remove)( |$)/i.test(raw))return display('Persisted contact changes and deletion are unsupported.');\nconst control=/^(approve|create) contact ([a-z0-9_-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nif(/^cancel contact$/i.test(raw)){if(t.status==='pending')return display('Contact attempt may have occurred. Reconcile contact; never retry.');if(t.status==='verified')return display('Verified contact cannot be cancelled.');t.status='cancelled';t.approval=null;t.reviewedPayload='';return display('Contact draft cancelled.');}\nif(/^reconcile contact$/i.test(raw)){if(t.status!=='pending'||!frozen(t))return display('No valid uncertain contact attempt exists.');return {route:'preflight',state:s,parentId:Number(t.parentId),q:\"Email='\"+t.payload.Email.replace(/'/g,\"''\")+\"'\"};}\nif(/^review contact$/i.test(raw)){if(t.status!=='draft')return display('Prepare an editable contact draft first.');const error=valid(t);if(error)return display(error);t.reviewedPayload=snapshot(t);t.reviewedRevision=t.revision;t.approval=null;return display('Review supplier parent and all three contact fields. No account is requested. To approve exactly, enter: approve contact '+t.requestId+' revision '+t.revision+'. Approval alone does not create.');}\nif(control){if(control[2]!==t.requestId||Number(control[3])!==t.revision)return display('Stale contact request or revision.');if(t.status!=='draft')return display(t.status==='pending'?'Attempt pending. Reconcile contact; never repeat create.':'Contact request cannot create again.');const error=valid(t),exact=snapshot(t);if(error)return display(error);if(t.reviewedRevision!==t.revision||t.reviewedPayload!==exact)return display('Review exact current contact fields and parent first.');if(control[1].toLowerCase()==='approve'){t.approval={requestId:t.requestId,revision:t.revision,payload:exact};return display('Exact contact snapshot approved. To create once, enter: create contact '+t.requestId+' revision '+t.revision+'.');}if(!t.approval||t.approval.requestId!==t.requestId||t.approval.revision!==t.revision||t.approval.payload!==exact)return display('Exact current contact approval required.');return {route:'preflight',state:s,parentId:Number(t.parentId),q:\"Email='\"+t.payload.Email.replace(/'/g,\"''\")+\"'\"};}\nconst explicit=r.requestRef?[null,r.requestRef]:null;\nif(r.intent==='prepare_contact'||r.intent==='edit_contact'){\n if(t.status==='pending')return display('Uncertain contact attempt blocks edits and new drafts.');if(r.intent==='edit_contact'&&t.status!=='draft')return display('Prepare an editable contact draft first.');const patch=obj(r.contactPatch);if(!Object.keys(patch).length||Object.keys(patch).some(function(k){return fields.indexOf(k)<0||typeof patch[k]!=='string'||!patch[k].trim();}))return display('Only explicit FirstName, LastName and Email are permitted; no account fields.');\n if(r.intent==='prepare_contact'){if(!r.supplierId)return display('Name the verified displayed supplier number for this contact draft.');const p=parent();if(p.error)return display(p.error);const job=String($context.$workflow.$jobId||'').toLowerCase();if(!explicit&&!/^[a-z0-9-]+$/.test(job))return display('No valid request identity.');const id=explicit?'ref-'+explicit[1]:'job-'+job,used=t.usedRequestRefs===undefined?[]:t.usedRequestRefs;if(!Array.isArray(used)||used.some(function(v){return typeof v!=='string';}))return display('Contact request history invalid.');if(used.indexOf(id)>=0||id===t.requestId)return display('Contact request reference already used.');if(used.length>=100)return display('Contact request limit reached in this conversation.');t=s.tx={requestId:id,usedRequestRefs:used.concat([id]),parentId:p.parentId,parentNumber:p.parentNumber,parentName:p.parentName,revision:0,payload:{},status:'draft',approval:null,reviewedPayload:''};}\n let changed=false;fields.forEach(function(k){if(Object.prototype.hasOwnProperty.call(patch,k)&&patch[k]!==t.payload[k]){t.payload[k]=patch[k];changed=true;}});if(changed){t.revision++;t.approval=null;t.reviewedPayload='';t.reviewedRevision=null;}return display((valid(t)||'Required contact fields supplied.')+' Draft only; enter review contact.');\n}\nif(/^(review|approve|create|cancel|reconcile)_contact$/.test(String(r.intent||'')))return display('Use the exact contact control command.');\nlet intent=r.intent;if(/^(next contact|next contact page)$/i.test(raw))intent='next_contact';if(['list_contact','search_contact','detail_contact','next_contact'].indexOf(intent)<0)return {route:'display',state:card(s,'Contact request guidance','List/search/detail contacts or prepare a contact draft for a verified supplier.')};const p=parent();if(p.error)return {route:'display',state:card(s,'Contact parent unavailable',p.error)};let limit=r.limit===undefined?5:Number(r.limit),offset=r.offset===undefined?0:Number(r.offset),q='SupplierContactId>0',contactId=null;\nif(intent==='next_contact'){if(s.read.parentId!==p.parentId||!s.read.hasMore||!Number.isInteger(s.read.nextOffset))return {route:'display',state:card(s,'Contact continuation unavailable','Select the same supplier and run its contact query first.')};q=s.read.q;limit=s.read.limit;offset=s.read.nextOffset;}\nif(intent==='search_contact'){const name=typeof r.name==='string'?r.name:'';if(!name.trim()||name.length>360||/[\\x00-\\x1f]/.test(name))return {route:'display',state:card(s,'Contact query unavailable','Supply a valid exact ContactName.')};q=\"ContactName='\"+name.replace(/'/g,\"''\")+\"'\";}\nif(intent==='detail_contact'){const id=r.itemId||(s.read.parentId===p.parentId?s.read.selectedId:'');if(!key(id))return {route:'display',state:card(s,'Contact detail unavailable','Select a valid contact ID for this supplier.')};contactId=Number(id);limit=1;offset=0;}\nif(!Number.isInteger(limit)||limit<1||limit>25||!Number.isInteger(offset)||offset<0)return {route:'display',state:card(s,'Contact query unavailable','Use page size1 to25 and nonnegative offset.')};s.read={parentId:p.parentId,parentNumber:p.parentNumber,parentName:p.parentName,q:q,limit:limit,offset:offset,selectedId:contactId?String(contactId):'',hasMore:false,nextOffset:null};return {route:intent==='detail_contact'?'detail':'list',state:s,parentId:Number(p.parentId),contactId:contactId,q:q,limit:limit,offset:offset};\n",
