        {
          "id": "23",
          "code": "AUTHORIZE_SUPPLIER_WRITE",
          "type": "CODE",
          "metadata": {
            "name": "XDX authorize supplier write",
            "sourceCode": "\nconst fields=['Supplier','BusinessRelationship','TaxOrganizationType'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction snapshot(p){const o={};fields.forEach(function(k){o[k]=p[k];});return JSON.stringify(o);}\nfunction valid(p){if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported supplier field.';for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>(k==='Supplier'?360:80)||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid '+k+'.';}return '';}\nfunction render(s,message){const rows=fields.map(function(k){return {cells:[k,s.payload&&s.payload[k]!==undefined?s.payload[k]:'Not supplied']};});if(s.supplierId)rows.push({cells:['Supplier ID',s.supplierId]});if(s.supplierNumber)rows.push({cells:['Supplier number',s.supplierNumber]});if(s.supplierPartyId)rows.push({cells:['Supplier party ID',s.supplierPartyId]});s.view={widget:'<oraInfoDisplay key=\"supplierTransaction\">'+JSON.stringify({patternId:'multiRecordWidget',title:s.status==='verified'?'Supplier created and verified':s.status==='pending'?'Supplier outcome awaiting verification':'Supplier draft',description:message+(s.requestId?' Request '+s.requestId+', revision '+s.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>'};return s;}\nfunction frozen(s){return s.attempt&&s.attempt.requestId===s.requestId&&s.attempt.revision===s.revision&&s.attempt.payload===snapshot(s.payload||{});}\n\nconst s=clone($context.$nodes.PREPARE_TRANSACTION.$output.result.state),raw=obj($context.$nodes.CHECK_SUPPLIER_DUPLICATE.$output);\nfunction stop(m){return {next:'display',state:render(s,m)};}\nif(!Array.isArray(raw.items)||typeof raw.hasMore!=='boolean'||raw.count!==raw.items.length||raw.offset!==0||!Number.isInteger(raw.limit)||raw.limit<1||raw.count>raw.limit)return stop(s.status==='pending'?\"The prior supplier attempt remains uncertain because the duplicate check response is invalid. No new create submitted. Never retry; reconcile supplier.\":'Duplicate response invalid. No create submitted.');\nif(s.status==='pending'){if(!frozen(s)||raw.hasMore||raw.items.length!==1||raw.items[0].Supplier!==s.payload.Supplier||!key(raw.items[0].SupplierId))return stop('Uncertain outcome unresolved. No retry authorized.');s.supplierId=String(raw.items[0].SupplierId);return {next:'verify',state:render(s,'Matching supplier found; independent verification required.'),supplierId:Number(s.supplierId)};}\nif(raw.items.length||raw.hasMore)return stop('Supplier name exists; edit and review a new name.');\nconst exact=snapshot(s.payload||{});if(s.status!=='draft'||valid(s.payload||{})||!s.approval||s.approval.requestId!==s.requestId||s.approval.revision!==s.revision||s.approval.payload!==exact||s.reviewedRevision!==s.revision||s.reviewedPayload!==exact)return stop('Exact approval mismatch. No create submitted.');\ns.attempt={requestId:s.requestId,revision:s.revision,payload:exact,started:String($context.$system.$currentDateTime)};s.status='pending';s.approval=null;const escaped={};fields.forEach(function(k){escaped[k]=JSON.stringify(s.payload[k]).slice(1,-1);});\nreturn {next:'write',state:render(s,'One attempt recorded. Await independent verification; never retry.'),escaped:escaped};\n",
            "returnType": "object"
          },
