te request.',properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx,rows=[{cells:['Supplier number',t.parentNumber||'Not selected']},{cells:['Supplier ID',t.parentId||'Not selected']},{cells:['Supplier',t.parentName||'Not selected']}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));rows.push({cells:['Resolved address ID',t.addressId||'Not verified']},{cells:['Procurement business unit',t.buName||'Not verified']});if(t.siteId)rows.push({cells:['Supplier site ID',t.siteId]});s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Site created and verified':t.status==='pending'?'Site outcome awaiting verification':'Site draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction parent(){const supplier=clone(($context.$variables||{}).readState),view=obj(supplier.view),r=obj(($context.$variables||{}).request),cols=view.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber'),c=cols.indexOf('Supplier');if(view.error||a<0||b<0||c<0)return {error:'Find the supplier first and use its displayed supplier number.'};let rows=(view.rows||[]).filter(function(row){return key(row[a])&&row[b]&&row[c];});if(r.supplierId)rows=rows.filter(function(row){return String(row[b])===String(r.supplierId);});else rows=rows.filter(function(row){return String(row[a])===String(supplier.selectedSupplierId||'');});const ids=[];rows.forEach(function(row){if(ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});if(ids.length!==1)return {error:'Supplier number is absent, ambiguous or unverified. Query the supplier first.'};const row=rows[0];return {parentId:String(row[a]),parentNumber:String(row[b]),parentName:String(row[c]),error:''};}\n\nconst s=state(),t=s.tx,raw=obj($context.$nodes.GET_CREATED_SITE.$output);const match=t.status==='pending'&&frozen(t)&&key(raw.SupplierSiteId)&&String(raw.SupplierSiteId)===t.siteId&&String(raw.SupplierAddressId)===t.addressId&&raw.ProcurementBU===t.buName&&fields.every(function(k){return k==='ProcurementBUId'?key(raw[k])&&Number(raw[k])===t.payload[k]:raw[k]===t.payload[k];});if(!match)return {state:render(s,'Independent GET did not match every site field/address/BU relationship. Pending outcome; no retry.')};t.status='verified';t.persisted={SupplierSiteId:t.siteId,SupplierAddressId:t.addressId,ProcurementBU:t.buName};fields.forEach(function(k){t.persisted[k]=raw[k];});return {state:render(s,'Independent same-parent GET confirms all four approved fields, address and BU. Site created once.')};\n",
