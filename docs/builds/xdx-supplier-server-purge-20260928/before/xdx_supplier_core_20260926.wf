 \"CreationSourceCode\",\n    \"CreationSource\",\n    \"DataFoxScore\",\n    \"DataFoxScoringCriteria\",\n    \"Alias\",\n    \"DUNSNumber\",\n    \"OneTimeSupplierFlag\",\n    \"RegistryId\",\n    \"CustomerNumber\",\n    \"StandardIndustryClass\",\n    \"IndustryCategory\",\n    \"IndustrySubcategory\",\n    \"NationalInsuranceNumber\",\n    \"NationalInsuranceNumberExistsFlag\",\n    \"CorporateWebsite\",\n    \"YearEstablished\",\n    \"MissionStatement\",\n    \"YearIncorporated\",\n    \"ChiefExecutiveTitle\",\n    \"ChiefExecutiveName\",\n    \"PrincipalTitle\",\n    \"PrincipalName\",\n    \"FiscalYearEndMonthCode\",\n    \"FiscalYearEndMonth\",\n    \"CurrentFiscalYearPotentialRevenue\",\n    \"PreferredFunctionalCurrencyCode\",\n    \"PreferredFunctionalCurrency\",\n    \"TaxRegistrationCountryCode\",\n    \"TaxRegistrationCountry\",\n    \"TaxRegistrationNumber\",\n    \"TaxpayerCountryCode\",\n    \"TaxpayerCountry\",\n    \"TaxpayerId\",\n    \"TaxpayerIdExistsFlag\",\n    \"FederalReportableFlag\",\n    \"FederalIncomeTaxTypeCode\",\n    \"FederalIncomeTaxType\",\n    \"StateReportableFlag\",\n    \"TaxReportingName\",\n    \"NameControl\",\n    \"VerificationDate\",\n    \"UseWithholdingTaxFlag\",\n    \"WithholdingTaxGroupId\",\n    \"WithholdingTaxGroup\",\n    \"BusinessClassificationNotApplicableFlag\",\n    \"SpendAuthReviewStatus\",\n    \"SpendAuthReviewStatusDisplay\",\n    \"DataFoxId\",\n    \"DataFoxCompanyName\",\n    \"DataFoxLegalName\",\n    \"DataFoxCompanyPrimaryURL\",\n    \"DataFoxNAICSCode\",\n    \"DataFoxCountry\",\n    \"DataFoxEIN\",\n    \"DataFoxLastSyncDate\",\n    \"OBNEnabledFlag\",\n    \"OnOFACListFlag\",\n    \"OFACSources\",\n    \"SupplierRegId\"\n  ],\n  \"additionalProperties\": false\n}"
