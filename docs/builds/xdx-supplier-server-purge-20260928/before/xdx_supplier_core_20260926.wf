            "sourceCode": "\nconst fields=['FirstName','LastName','Email'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction state(){const s=clone(($context.$variables||{}).contactState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\nfunction snapshot(t){const p={},payload=obj(t.payload);fields.forEach(function(k){p[k]=payload[k];});return JSON.stringify({parentId:t.parentId,parentNumber:t.parentNumber,parentName:t.parentName,payload:p});}\nfunction valid(t){if(!key(t.parentId)||!t.parentNumber||!t.parentName)return 'Select a verified supplier parent.';const p=obj(t.payload);if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Only FirstName, LastName and Email are permitted; no account fields.';for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>(k==='Email'?320:150)||/[\\x00-\\x1f]/.test(p[k]))return 'Supply a valid '+k+'.';}if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.Email))return 'Supply a valid contact email.';return '';}\nfunction frozen(t){return t.attempt&&t.attempt.requestId===t.requestId&&t.attempt.revision===t.revision&&t.attempt.payload===snapshot(t);}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'cardWidget',title:title,description:'Supplier contact request.',properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx,rows=[{cells:['Supplier number',t.parentNumber||'Not selected']},{cells:['Supplier ID',t.parentId||'Not selected']},{cells:['Supplier',t.parentName||'Not selected']}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?t.payload[k]:'Not supplied']};}));if(t.contactId)rows.push({cells:['Supplier contact ID',t.contactId]});if(t.personProfileId)rows.push({cells:['Person profile ID',t.personProfileId]});if(t.status==='verified')rows.push({cells:['Contact name',t.persisted.ContactName]},{cells:['UserName','Not specified']},{cells:['UserAccountStatus','Not specified']});s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Contact created and verified':t.status==='pending'?'Contact outcome awaiting verification':'Contact draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction parent(){const supplier=clone(($context.$variables||{}).readState),view=obj(supplier.view),r=obj(($context.$variables||{}).request),cols=view.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber'),c=cols.indexOf('Supplier');if(view.error||a<0||b<0||c<0)return {error:'Find the supplier first and use its displayed supplier number.'};let rows=(view.rows||[]).filter(function(row){return key(row[a])&&row[b]&&row[c];});if(r.supplierId)rows=rows.filter(function(row){return String(row[b])===String(r.supplierId);});else rows=rows.filter(function(row){return String(row[a])===String(supplier.selectedSupplierId||'');});const ids=[];rows.forEach(function(row){if(ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});if(ids.length!==1)return {error:'Supplier number is absent, ambiguous or unverified. Query the supplier first.'};const row=rows[0];return {parentId:String(row[a]),parentNumber:String(row[b]),parentName:String(row[c]),error:''};}\n\nconst s=state(),t=s.tx,raw=obj($context.$nodes.CHECK_CONTACT_DUPLICATE.$output);function stop(m){return {next:'display',state:render(s,m)};}\nif(!Array.isArray(raw.items)||typeof raw.hasMore!=='boolean'||raw.count!==raw.items.length||raw.offset!==0||!Number.isInteger(raw.limit)||raw.limit<1||raw.count>raw.limit)return stop(t.status==='pending'?\"The prior contact attempt remains uncertain because the duplicate check response is invalid. No new create submitted. Never retry; reconcile contact.\":'Contact collision check invalid. No create submitted.');\nif(t.status==='pending'){if(!frozen(t)||raw.hasMore||raw.items.length!==1||raw.items[0].Email!==t.payload.Email||!key(raw.items[0].SupplierContactId))return stop('Uncertain contact outcome unresolved. No retry authorized.');t.contactId=String(raw.items[0].SupplierContactId);return {next:'verify',state:render(s,'Same-parent contact candidate found; independent GET required.')};}\nif(raw.items.length||raw.hasMore)return stop('A contact with this Email is present under the supplier. No create submitted; uniqueness scope is not inferred.');const exact=snapshot(t);if(t.status!=='draft'||valid(t)||!t.approval||t.approval.requestId!==t.requestId||t.approval.revision!==t.revision||t.approval.payload!==exact||t.reviewedPayload!==exact||t.reviewedRevision!==t.revision)return stop('Exact contact approval mismatch.');t.attempt={requestId:t.requestId,revision:t.revision,payload:exact,started:String($context.$system.$currentDateTime)};t.status='pending';t.approval=null;const escaped={};fields.forEach(function(k){escaped[k]=JSON.stringify(t.payload[k]).slice(1,-1);});return {next:'write',state:render(s,'One contact attempt recorded. Await independent GET; never retry.'),parentId:Number(t.parentId),escaped:escaped};\n",
