          "outputSpecification": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"resource\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"supplier\",\n        \"address\",\n        \"site\",\n        \"contact\"\n      ]\n    },\n    \"action\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"list\",\n        \"search\",\n        \"detail\",\n        \"next\",\n        \"lookup\",\n        \"prepare\",\n        \"edit\",\n        \"unsupported\"\n      ]\n    },\n    \"parentNumber\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"itemId\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"searchName\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"limit\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"fields\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"Supplier\": {\n          \"type\": \"string\"\n        },\n        \"BusinessRelationship\": {\n          \"type\": \"string\"\n        },\n        \"TaxOrganizationType\": {\n          \"type\": \"string\"\n        },\n        \"AddressName\": {\n          \"type\": \"string\"\n        },\n        \"CountryCode\": {\n          \"type\": \"string\"\n        },\n        \"AddressLine1\": {\n          \"type\": \"string\"\n        },\n        \"City\": {\n          \"type\": \"string\"\n        },\n        \"State\": {\n          \"type\": \"string\"\n        },\n        \"PostalCode\": {\n          \"type\": \"string\"\n        },\n        \"Email\": {\n          \"type\": \"string\"\n        },\n        \"SupplierSite\": {\n          \"type\": \"string\"\n        },\n        \"SupplierAddressName\": {\n          \"type\": \"string\"\n        },\n        \"FirstName\": {\n          \"type\": \"string\"\n        },\n        \"LastName\": {\n          \"type\": \"string\"\n        },\n        \"ProcurementBUId\": {\n          \"type\": \"integer\"\n        },\n        \"AddressPurposeOrderingFlag\": {\n          \"type\": \"boolean\"\n        },\n        \"SitePurposePurchasingFlag\": {\n          \"type\": \"boolean\"\n        }\n      }\n    },\n    \"evidence\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"parentNumber\": {\n          \"type\": \"string\"\n        },\n        \"itemId\": {\n          \"type\": \"string\"\n        },\n        \"searchName\": {\n          \"type\": \"string\"\n        },\n        \"limit\": {\n          \"type\": \"string\"\n        },\n        \"fields.Supplier\": {\n          \"type\": \"string\"\n        },\n        \"fields.BusinessRelationship\": {\n          \"type\": \"string\"\n        },\n        \"fields.TaxOrganizationType\": {\n          \"type\": \"string\"\n        },\n        \"fields.AddressName\": {\n          \"type\": \"string\"\n        },\n        \"fields.CountryCode\": {\n          \"type\": \"string\"\n        },\n        \"fields.AddressLine1\": {\n          \"type\": \"string\"\n        },\n        \"fields.City\": {\n          \"type\": \"string\"\n        },\n        \"fields.State\": {\n          \"type\": \"string\"\n        },\n        \"fields.PostalCode\": {\n          \"type\": \"string\"\n        },\n        \"fields.Email\": {\n          \"type\": \"string\"\n        },\n        \"fields.SupplierSite\": {\n          \"type\": \"string\"\n        },\n        \"fields.SupplierAddressName\": {\n          \"type\": \"string\"\n        },\n        \"fields.FirstName\": {\n          \"type\": \"string\"\n        },\n        \"fields.LastName\": {\n          \"type\": \"string\"\n        },\n        \"fields.ProcurementBUId\": {\n          \"type\": \"string\"\n        },\n        \"fields.AddressPurposeOrderingFlag\": {\n          \"type\": \"string\"\n        },\n        \"fields.SitePurposePurchasingFlag\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\n    \"resource\",\n    \"action\",\n    \"parentNumber\",\n    \"itemId\",\n    \"searchName\",\n    \"limit\",\n    \"fields\",\n    \"evidence\"\n  ]\n}\n"
