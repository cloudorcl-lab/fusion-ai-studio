          "id": "1",
          "code": "GUARD",
          "type": "CODE",
          "metadata": {
            "name": "GUARD",
            "sourceCode": "let p;try{p=JSON.parse(String($context.$system.$inputMessage||''));}catch(e){return {valid:false};}if(!p||typeof p!=='object'||Array.isArray(p))return {valid:false};const exact=k=>Object.keys(p).sort().join(',')===k.sort().join(',');if(p.route==='GetSupplier'){if(!exact(['route','SupplierId'])||!Number.isSafeInteger(p.SupplierId)||p.SupplierId<=0)return {valid:false};return {valid:true,route:p.route,SupplierId:p.SupplierId};}if(p.route==='QuerySuppliers'){if(!exact(['route','name','limit','offset'])||typeof p.name!=='string'||p.name.length>360||/[\\x00-\\x1f]/.test(p.name)||!Number.isSafeInteger(p.limit)||p.limit<1||p.limit>100||!Number.isSafeInteger(p.offset)||p.offset<0)return {valid:false};return {valid:true,route:p.route,q:p.name?\"Supplier='\"+p.name.replace(/'/g,\"''\")+\"'\":'SupplierId>0',limit:p.limit,offset:p.offset};}\nconst positive=x=>Number.isSafeInteger(x)&&x>0;\nconst page=()=>Number.isSafeInteger(p.limit)&&p.limit>=1&&p.limit<=100&&Number.isSafeInteger(p.offset)&&p.offset>=0;\nconst text=(x,max)=>typeof x==='string'&&x.length<=max&&!/[\\x00-\\x1f]/.test(x);\nconst resources={QueryAddresses:{key:'SupplierAddressId',field:'AddressName',input:'name',max:240},QuerySites:{key:'SupplierSiteId',field:'SupplierSite',input:'name',max:240},QueryContacts:{key:'SupplierContactId',field:'Email',input:'email',max:320}};\nif(resources[p.route]){const r=resources[p.route];if(!exact(['route','SupplierId',r.input,'limit','offset'])||!positive(p.SupplierId)||!page()||!text(p[r.input],r.max))return {valid:false};return {valid:true,route:p.route,SupplierId:p.SupplierId,q:p[r.input]?r.field+\"='\"+p[r.input].replace(/'/g,\"''\")+\"'\":r.key+'>0',limit:p.limit,offset:p.offset};}\nconst keys={GetAddress:'SupplierAddressId',GetSite:'SupplierSiteId',GetContact:'SupplierContactId'};\nif(keys[p.route]){const key=keys[p.route];if(!exact(['route','SupplierId',key])||!positive(p.SupplierId)||!positive(p[key]))return {valid:false};return {valid:true,route:p.route,SupplierId:p.SupplierId,[key]:p[key]};}\nif(p.route==='QuerySiteBusinessUnits'){if(!exact(['route','SupplierId','context','limit','offset'])||p.context!=='site-reference'||!positive(p.SupplierId)||!page())return {valid:false};return {valid:true,route:p.route,SupplierId:p.SupplierId,context:p.context,limit:String(p.limit),offset:String(p.offset)};}\nreturn {valid:false};",
            "returnType": "object"
          },
