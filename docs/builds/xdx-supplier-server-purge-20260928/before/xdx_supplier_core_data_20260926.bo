        "name": "QueryContacts",
        "description": "Parent-scoped contacts read. Trusted filter and bounded paging; native errors remain distinct from empty.",
        "operationId": "getall_suppliers-contacts",
        "operationType": "GET",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers/{SupplierId}/child/contacts?fields=SupplierContactId,PersonProfileId,ContactName,FirstName,LastName,Email,InactiveDate,UserName,UserAccountStatus&onlyData=true&orderBy=SupplierContactId:asc&q={q}&limit={limit}&offset={offset}",
        "resourceType": "ADF_BC_FIXED_QUERY",
