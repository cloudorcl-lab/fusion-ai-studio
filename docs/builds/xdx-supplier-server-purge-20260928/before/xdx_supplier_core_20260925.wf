ll\"\n    },\n    \"InvoiceChannelCode\": {\n      \"type\": \"null\"\n    },\n    \"InvoiceChannel\": {\n      \"type\": \"null\"\n    },\n    \"PaymentCurrencyCode\": {\n      \"type\": \"null\"\n    },\n    \"PaymentCurrency\": {\n      \"type\": \"null\"\n    },\n    \"PaymentPriority\": {\n      \"type\": \"null\"\n    },\n    \"PayGroupCode\": {\n      \"type\": \"null\"\n    },\n    \"PayGroup\": {\n      \"type\": \"null\"\n    },\n    \"HoldAllInvoicesFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"HoldUnmatchedInvoicesCode\": {\n      \"type\": \"string\"\n    },\n    \"HoldUnmatchedInvoices\": {\n      \"type\": \"string\"\n    },\n    \"HoldUnvalidatedInvoicesFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"PaymentHoldDate\": {\n      \"type\": \"null\"\n    },\n    \"PaymentHoldReason\": {\n      \"type\": \"null\"\n    },\n    \"PaymentTermsId\": {\n      \"type\": \"null\"\n    },\n    \"PaymentTerms\": {\n      \"type\": \"null\"\n    },\n    \"PaymentTermsDateBasisCode\": {\n      \"type\": \"null\"\n    },\n    \"PaymentTermsDateBasis\": {\n      \"type\": \"null\"\n    },\n    \"PayDateBasisCode\": {\n      \"type\": \"null\"\n    },\n    \"PayDateBasis\": {\n      \"type\": \"null\"\n    },\n    \"BankChargeDeductionTypeCode\": {\n      \"type\": \"string\"\n    },\n    \"BankChargeDeductionType\": {\n      \"type\": \"string\"\n    },\n    \"AlwaysTakeDiscountCode\": {\n      \"type\": \"string\"\n    },\n    \"AlwaysTakeDiscount\": {\n      \"type\": \"string\"\n    },\n    \"ExcludeFreightFromDiscountCode\": {\n      \"type\": \"string\"\n    },\n    \"ExcludeFreightFromDiscount\": {\n      \"type\": \"string\"\n    },\n    \"ExcludeTaxFromDiscountCode\": {\n      \"type\": \"string\"\n    },\n    \"ExcludeTaxFromDiscount\": {\n      \"type\": \"string\"\n    },\n    \"CreateInterestInvoicesCode\": {\n      \"type\": \"string\"\n    },\n    \"CreateInterestInvoices\": {\n      \"type\": \"string\"\n    },\n    \"CreationDate\": {\n      \"type\": \"string\"\n    },\n    \"CreatedBy\": {\n      \"type\": \"string\"\n    },\n    \"LastUpdateDate\": {\n      \"type\": \"string\"\n    },\n    \"LastUpdatedBy\": {\n      \"type\": \"string\"\n    },\n    \"OverrideB2BCommunicationforSpecialHandlingOrdersFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          },\n          \"properties\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"changeIndicator\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"changeIndicator\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": true\n      }\n    }\n  },\n  \"required\": [\n    \"SupplierSiteId\",\n    \"SupplierSite\",\n    \"ProcurementBUId\",\n    \"ProcurementBU\",\n    \"SupplierAddressId\",\n    \"SupplierAddressName\",\n    \"Address\",\n    \"InactiveDate\",\n    \"Status\",\n    \"SitePurposeSourcingOnlyFlag\",\n    \"SitePurposePurchasingFlag\",\n    \"SitePurposeProcurementCardFlag\",\n    \"SitePurposePayFlag\",\n    \"SitePurposePrimaryPayFlag\",\n    \"IncomeTaxReportingSiteFlag\",\n    \"AlternateSiteName\",\n    \"CustomerNumber\",\n    \"B2BCommunicationMethodCode\",\n    \"B2BCommunicationMethod\",\n    \"B2BSupplierSiteCode\",\n    \"CommunicationMethodCode\",\n    \"CommunicationMethod\",\n    \"Email\",\n    \"FaxCountryCode\",\n    \"FaxAreaCode\",\n    \"FaxNumber\",\n    \"HoldAllNewPurchasingDocumentsFlag\",\n    \"PurchasingHoldReason\",\n    \"AllNewPurchasingDocumentsHoldDate\",\n    \"AllNewPurchasingDocumentsHoldBy\",\n    \"RequiredAcknowledgmentCode\",\n    \"RequiredAcknowledgment\",\n    \"AcknowledgmentWithinDays\",\n    \"CarrierId\",\n    \"Carrier\",\n    \"ModeOfTransportCode\",\n    \"ModeOfTransport\",\n    \"ServiceLevelCode\",\n    \"ServiceLevel\",\n    \"FreightTermsCode\",\n    \"FreightTerms\",\n    \"PayOnReceiptFlag\",\n    \"FOBCode\",\n    \"FOB\",\n    \"CountryOfOriginCode\",\n    \"CountryOfOrigin\",\n    \"BuyerManagedTransportationCode\",\n    \"BuyerManagedTransportation\",\n    \"PayOnUseFlag\",\n    \"AgingOnsetPointCode\",\n    \"AgingOnsetPoint\",\n    \"AgingPeriodDays\",\n    \"ConsumptionAdviceFrequencyCode\",\n    \"ConsumptionAdviceFrequency\",\n    \"ConsumptionAdviceSummaryCode\",\n    \"ConsumptionAdviceSummary\",\n    \"AlternatePaySiteId\",\n    \"AlternatePaySite\",\n    \"InvoiceSummaryLevelCode\",\n    \"InvoiceSummaryLevel\",\n    \"GaplessInvoiceNumberingFlag\",\n    \"SellingCompanyIdentifier\",\n    \"CreateDebitMemoFromReturnFlag\",\n    \"ShipToExceptionCode\",\n    \"ShipToException\",\n    \"ReceiptRoutingId\",\n    \"ReceiptRouting\",\n    \"OverReceiptTolerance\",\n    \"OverReceiptActionCode\",\n    \"OverReceiptAction\",\n    \"EarlyReceiptToleranceInDays\",\n    \"LateReceiptToleranceInDays\",\n    \"AllowSubstituteReceiptsCode\",\n    \"AllowSubstituteReceipts\",\n    \"AllowUnorderedReceiptsFlag\",\n    \"ReceiptDateExceptionCode\",\n    \"ReceiptDateException\",\n    \"InvoiceCurrencyCode\",\n    \"InvoiceCurrency\",\n    \"InvoiceAmountLimit\",\n    \"InvoiceMatchOptionCode\",\n    \"InvoiceMatchOption\",\n    \"MatchApprovalLevelCode\",\n    \"MatchApprovalLevel\",\n    \"QuantityTolerancesId\",\n    \"QuantityTolerances\",\n    \"AmountTolerancesId\",\n    \"AmountTolerances\",\n    \"InvoiceChannelCode\",\n    \"InvoiceChannel\",\n    \"PaymentCurr