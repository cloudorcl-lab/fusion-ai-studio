          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"SupplierSiteId\": {\n      \"type\": \"number\"\n    },\n    \"SupplierSite\": {\n      \"type\": \"string\"\n    },\n    \"ProcurementBUId\": {\n      \"type\": \"number\"\n    },\n    \"ProcurementBU\": {\n      \"type\": \"string\"\n    },\n    \"SupplierAddressId\": {\n      \"type\": \"number\"\n    },\n    \"SupplierAddressName\": {\n      \"type\": \"string\"\n    },\n    \"Address\": {\n      \"type\": \"null\"\n    },\n    \"InactiveDate\": {\n      \"type\": \"null\"\n    },\n    \"Status\": {\n      \"type\": \"string\"\n    },\n    \"SitePurposeSourcingOnlyFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"SitePurposePurchasingFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"SitePurposeProcurementCardFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"SitePurposePayFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"SitePurposePrimaryPayFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"IncomeTaxReportingSiteFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"AlternateSiteName\": {\n      \"type\": \"null\"\n    },\n    \"CustomerNumber\": {\n      \"type\": \"null\"\n    },\n    \"B2BCommunicationMethodCode\": {\n      \"type\": \"string\"\n    },\n    \"B2BCommunicationMethod\": {\n      \"type\": \"string\"\n    },\n    \"B2BSupplierSiteCode\": {\n      \"type\": \"null\"\n    },\n    \"CommunicationMethodCode\": {\n      \"type\": \"null\"\n    },\n    \"CommunicationMethod\": {\n      \"type\": \"null\"\n    },\n    \"Email\": {\n      \"type\": \"null\"\n    },\n    \"FaxCountryCode\": {\n      \"type\": \"null\"\n    },\n    \"FaxAreaCode\": {\n      \"type\": \"null\"\n    },\n    \"FaxNumber\": {\n      \"type\": \"null\"\n    },\n    \"HoldAllNewPurchasingDocumentsFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"PurchasingHoldReason\": {\n      \"type\": \"null\"\n    },\n   