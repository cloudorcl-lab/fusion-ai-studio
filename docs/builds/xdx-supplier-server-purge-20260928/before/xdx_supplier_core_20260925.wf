        {
          "id": "63",
          "code": "PREPARE_SITE",
          "type": "CODE",
          "metadata": {
            "name": "prepare site",
            "sourceCode": "\nconst fields=['SupplierSite','ProcurementBUId','SupplierAddressName','SitePurposePurchasingFlag'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction state(){const s=clone(($context.$variables||{}).siteState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\nfunction snapshot(t){const p={},payload=obj(t.payload);fields.forEach(function(k){p[k]=payload[k];});return JSON.stringify({parentId:t.parentId,parentNumber:t.parentNumber,parentName:t.parentName,payload:p,addressId:t.addressId,buName:t.buName});}\nfunction valid(t){if(!key(t.parentId)||!t.parentNumber||!t.parentName)return 'Select a verified supplier parent.';const p=obj(t.payload);if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported site field.';for(const k of ['SupplierSite','SupplierAddressName'])if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>240||/[\\x00-\\x1f]/.test(p[k]))return 'Supply a valid '+k+'.';if(typeof p.ProcurementBUId!=='number'||!key(p.ProcurementBUId))return 'Select an explicit valid ProcurementBUId from the current site lookup.';if(p.SitePurposePurchasingFlag!==true)return 'SitePurposePurchasingFlag must be true in this purchasing-site flow.';return '';}\nfunction frozen(t){return t.attempt&&t.attempt.requestId===t.requestId&&t.attempt.revision===t.revision&&t.attempt.payload===snapshot(t);}\nfunction refs(t){return key(t.addressId)&&typeof t.buName==='string'&&!!t.buName&&t.referencesPayload===JSON.stringify({parentId:t.parentId,SupplierAddressName:t.payload.SupplierAddressName,ProcurementBUId:t.payload.ProcurementBUId});}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'cardWidget',title:title,description:'Supplier site request.',properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx,rows=[{cells:['Supplier number',t.parentNumber||'Not selected']},{cells:['Supplier ID',t.parentId||'Not selected']},{cells:['Supplier',t.parentName||'Not selected']}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));rows.push({cells:['Resolved address ID',t.addressId||'Not verified']},{cells:['Procurement business unit',t.buName||'Not verified']});if(t.siteId)rows.push({cells:['Supplier site ID',t.siteId]});s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Site created and verified':t.status==='pending'?'Site outcome awaiting verification':'Site draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction parent(raw){const supplier=clone(($context.$variables||{}).readState),v=obj(supplier.view),cols=v.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber'),c=cols.indexOf('Supplier');if(v.error||a<0||b<0||c<0)return {error:'Find the supplier by name and select its displayed number first.'};const literal=/\\bsupplier\\s+(?:(number|no\\.?|#|id)\\s*[:=]?\\s*)?([0-9]+)\\b/i.exec(raw);let rows=(v.rows||[]).filter(function(row){return key(row[a])&&row[b]&&row[c];});if(literal)rows=rows.filter(function(row){return String(row[String(literal[1]||'').toLowerCase()==='id'?a:b])===literal[2];});else{if(/\\bfor supplier\\s+\\S+/i.test(raw))return {error:'Find the named supplier first and use its displayed number.'};rows=rows.filter(function(row){return String(row[a])===String(supplier.selectedSupplierId||'');});}const ids=[];rows.forEach(function(row){if(ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});if(ids.length!==1)return {error:'Supplier selection is absent or ambiguous; query first.'};return {parentId:String(rows[0][a]),parentNumber:String(rows[0][b]),parentName:String(rows[0][c]),error:''};}\n\nconst s=state(),r=clone($context.$nodes.EXTRACT_READ.$output),raw=String($context.$system.$inputMessage||'').trim();let t=s.tx;\nfunction display(m){return {route:'display',state:render(s,m)};}\nfunction references(next){t.afterReferences=next;return {route:'references',state:s,parentId:Number(t.parentId),addressQ:\"AddressName='\"+t.payload.SupplierAddressName.replace(/'/g,\"''\")+\"'\"};}\nif($context.$app.$OraMessageHint!=='Query')return {route:'display',state:card(s,'Site request unavailable','Use the application Query conversation.')};\nif(/^show procurement business units for site$/i.test(raw)||r.intent==='lookup_site')return {route:'lookup',state:s};\nif(/^(please )?(delete|purge|remove)( |$)/i.test(raw))return display('Persisted site changes and deletion are unsupported.');\nconst control=/^(approve|create) site ([a-z0-9-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nif(/^cancel site$/i.test(raw)){if(t.status==='pending')return display('Site attempt may have occurred. Reconcile site; never retry.');if(t.status==='verified')return display('Verified site cannot be cancelled.');t.status='cancelled';t.approval=null;t.reviewedPayload='';return display('Site draft cancelled.');}\nif(/^reconcile site$/i.test(raw)){if(t.status!=='pending'||!frozen(t))return display('No valid uncertain site attempt exists.');return {route:'preflight',state:s,parentId:Number(t.parentId),q:\"SupplierSite='\"+t.payload.SupplierSite.replace(/'/g,\"''\")+\"'\"};}\nif(/^review site$/i.test(raw)){if(t.status!=='draft')return display('Prepare an editable site draft first.');const error=valid(t);if(error)return display(error);return references('review');}\nif(control){if(control[2]!==t.requestId||Number(control[3])!==t.revision)return display('Stale site request or revision.');if(t.status!=='draft')return display(t.status==='pending'?'Attempt pending. Reconcile site; never repeat create.':'Site request cannot create again.');const error=valid(t),exact=snapshot(t);if(error)return display(error);if(!refs(t)||t.reviewedRevision!==t.revision||t.reviewedPayload!==exact)return display('Review exact site fields and verified address/BU first.');if(control[1].toLowerCase()==='approve'){t.approval={requestId:t.requestId,revision:t.revision,payload:exact};return display('Exact site snapshot approved. To create once, enter: create site '+t.requestId+' revision '+t.revision+'.');}if(!t.approval||t.approval.requestId!==t.requestId||t.approval.revision!==t.revision||t.approval.payload!==exact)return display('Exact current site approval required.');return references('preflight');}\nconst explicit=/^prepare site request ([a-z0-9][a-z0-9-]{0,63}) for supplier (?:number )?([0-9]+) with ([\\s\\S]+)$/i.exec(raw);\nif(/^prepare site request\\b/i.test(raw)&&!explicit)return display('Use prepare site request REFERENCE for supplier NUMBER with explicit site fields.');if(explicit)r.intent='prepare_site';\nconst edit=/^(?:change|set) (SupplierSite|ProcurementBUId|SupplierAddressName|SitePurposePurchasingFlag) to ([\\s\\S]+)$/i.exec(raw);\nif(edit){const k=fields.find(function(k){return k.toLowerCase()===edit[1].toLowerCase();});r.intent='edit_site';r.sitePatch={};r.sitePatch[k]=k==='ProcurementBUId'&&key(edit[2])?Number(edit[2]):k==='SitePurposePurchasingFlag'&&/^(true|false)$/i.test(edit[2])?edit[2].toLowerCase()==='true':edit[2];}\nif(r.intent==='prepare_site'||r.intent==='edit_site'){\n if(t.status==='pending')return display('Uncertain site attempt blocks edits and new drafts.');if(r.intent==='edit_site'&&t.status!=='draft')return display('Prepare an editable site draft first.');const patch=obj(r.sitePatch);if(!Object.keys(patch).length||Object.keys(patch).some(function(k){return fields.indexOf(k)<0||(k==='ProcurementBUId'?typeof patch[k]!=='number'||!key(patch[k]):k==='SitePurposePurchasingFlag'?typeof patch[k]!=='boolean':typeof patch[k]!=='string'||!patch[k].trim());}))return display('Supply explicit supported site fields with correct types.');\n if(r.intent==='prepare_site'){const p=parent(raw);if(p.error)return display(p.error);const job=String($context.$workflow.$jobId||'').toLowerCase();if(!explicit&&!/^[a-z0-9-]+$/.test(job))return display('No valid request identity.');const id=explicit?'site-ref-'+explicit[1].toLowerCase():'site-job-'+job,used=t.usedRequestRefs===undefined?[]:t.usedRequestRefs;if(!Array.isArray(used)||used.some(function(v){return typeof v!=='string';}))return display('Site request history invalid.');if(used.indexOf(id)>=0||id===t.requestId)return display('Site request reference already used.');if(used.length>=100)return display('Site request limit reached for this conversation.');t=s.tx={requestId:id,usedRequestRefs:used.concat([id]),parentId:p.parentId,parentNumber:p.parentNumber,parentName:p.parentName,revision:0,payload:{},status:'draft',approval:null,reviewedPayload:''};}\n let changed=false;fields.forEach(function(k){if(Object.prototype.hasOwnProperty.call(patch,k)&&patch[k]!==t.payload[k]){t.payload[k]=patch[k];changed=true;}});if(changed){t.revision++;t.approval=null;t.reviewedPayload='';t.reviewedRevision=null;t.referencesPayload='';if(Object.prototype.hasOwnProperty.call(patch,'SupplierAddressName')||Object.prototype.hasOwnProperty.call(patch,'ProcurementBUId')){t.addressId='';t.buName='';}}const error=valid(t);return error?display(error+' Draft only.'):references('display');\n}\nif(/^(review|approve|create|cancel|reconcile)_site$/.test(String(r.intent||'')))return display('Use the exact site control command.');\nlet intent=r.intent;if(/^(next site|next site page)$/i.test(raw))intent='next_site';if(['list_site','search_site','detail_site','next_site'].indexOf(intent)<0)return {route:'display',state:card(s,'Site request guidance','List, search or select site detail for a verified supplier, or prepare a site draft.')};const p=parent(raw);if(p.error)return {route:'display',state:card(s,'Site parent unavailable',p.error)};let limit=r.limit===undefined?5:Number(r.limit),offset=r.offset===undefined?0:Number(r.offset),q='SupplierSiteId>0',siteId=null;\nif(intent==='next_site'){if(s.read.parentId!==p.parentId||!s.read.hasMore||!Number.isInteger(s.read.nextOffset))return {route:'display',state:card(s,'Site continuation unavailable','Select the same supplier and run its site query first.')};q=s.read.q;limit=s.read.limit;offset=s.read.nextOffset;}\nif(intent==='search_site'){const name=typeof r.name==='string'?r.name:'';if(!name.trim()||name.length>240||/[\\x00-\\x1f]/.test(name))return {route:'display',state:card(s,'Site query unavailable','Supply a valid exact SupplierSite.')};q=\"SupplierSite='\"+name.replace(/'/g,\"''\")+\"'\";}\nif(intent==='detail_site'){const literal=/\\bsite (?:id )?([0-9]+)\\b/i.exec(raw),id=literal?literal[1]:s.read.parentId===p.parentId?s.read.selectedId:'';if(!key(id))return {route:'display',state:card(s,'Site detail unavailable','Select a valid site ID for this supplier.')};siteId=Number(id);limit=1;offset=0;}\nif(!Number.isInteger(limit)||limit<1||limit>25||!Number.isInteger(offset)||offset<0)return {route:'display',state:card(s,'Site query unavailable','Use page size1 to25 and nonnegative offset.')};s.read={parentId:p.parentId,parentNumber:p.parentNumber,parentName:p.parentName,q:q,limit:limit,offset:offset,selectedId:siteId?String(siteId):'',hasMore:false,nextOffset:null};return {route:intent==='detail_site'?'detail':'list',state:s,parentId:Number(p.parentId),siteId:siteId,q:q,limit:limit,offset:offset};\n",
