ription){const cols=['SupplierContactId','ContactName','FirstName','LastName','Email','PersonProfileId','Status','InactiveDate','UserName','UserAccountStatus'];if(!items.length){read.selectedId='';return {state:card(s,'No contacts match',description)};}s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Supplier contacts',description:'Supplier '+read.parentName+' (number '+read.parentNumber+', ID '+read.parentId+'). '+description,properties:{cols:cols,rows:items.map(function(row){return {cells:cols.map(function(k){return row[k]===undefined||row[k]===null?'Not specified':String(row[k]);})};})}})+'</oraInfoDisplay>';return {state:s};}\n\nconst raw=obj($context.$nodes.FETCH_CONTACT_DETAIL.$output);if(!key(raw.SupplierContactId)||String(raw.SupplierContactId)!==read.selectedId||!raw.ContactName)return fail('Contact detail was not verified under selected supplier.');read.hasMore=false;read.nextOffset=null;return rows([raw],'Verified selected contact detail.');\n",
