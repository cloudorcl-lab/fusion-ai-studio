raw.SupplierContactId)===t.contactId&&key(raw.PersonProfileId)&&typeof raw.ContactName==='string'&&!!raw.ContactName&&raw.UserName===null&&raw.UserAccountStatus===null&&fields.every(function(k){return raw[k]===t.payload[k];})&&(!receipt.PersonProfileId||String(receipt.PersonProfileId)===String(raw.PersonProfileId));if(!match)return {state:render(s,'Independent GET did not confirm all intended fields, generated IDs and null account fields. Outcome pending; no retry.')};t.status='verified';t.personProfileId=String(raw.PersonProfileId);t.persisted={SupplierContactId:t.contactId,PersonProfileId:t.personProfileId,ContactName:raw.ContactName,UserName:null,UserAccountStatus:null};fields.forEach(function(k){t.persisted[k]=raw[k];});return {state:render(s,'Independent same-parent GET confirms all three approved fields, generated IDs and no account fields populated. Contact created once.')};\n",
