            "name": "verify address create",
            "sourceCode": "\nconst fields=['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email','AddressPurposeOrderingFlag'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction state(){const s=clone(($context.$variables||{}).addressState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\nfunction snapshot(t){const p={},payload=obj(t.payload);fields.forEach(function(k){p[k]=payload[k];});return JSON.stringify({parentId:t.parentId,parentNumber:t.parentNumber,parentName:t.parentName,payload:p});}\nfunction valid(t){if(!key(t.parentId)||!t.parentNumber||!t.parentName)return 'Select a verified supplier parent.';const p=obj(t.payload),limits={AddressName:240,CountryCode:2,AddressLine1:240,City:60,State:60,PostalCode:60,Email:320};if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported address field.';for(const k of fields){if(k==='AddressPurposeOrderingFlag'){if(p[k]!==true)return 'AddressPurposeOrderingFlag must be true for this ordering-address flow.';continue;}if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>limits[k]||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid '+k+'.';}if(p.CountryCode!=='US')return 'Only the validated US country configuration is supported for address creation in this app.';if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.Email))return 'Supply a valid address email.';return '';}\nfunction frozen(t){return t.attempt&&t.attempt.requestId===t.requestId&&t.attempt.revision===t.revision&&t.attempt.payload===snapshot(t);}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"addressCore\">'+JSON.stringify({patternId:'cardWidget',title:title,description:'Supplier address request.',properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx,rows=[{cells:['Supplier number',t.parentNumber||'Not selected']},{cells:['Supplier ID',t.parentId||'Not selected']},{cells:['Supplier',t.parentName||'Not selected']}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.addressId)rows.push({cells:['Supplier address ID',t.addressId]});if(t.addressPartyNumber)rows.push({cells:['Address party number',t.addressPartyNumber]});s.widget='<oraInfoDisplay key=\"addressCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Address created and verified':t.status==='pending'?'Address outcome awaiting verification':'Address draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction parent(raw){const supplier=clone(($context.$variables||{}).readState),view=obj(supplier.view),cols=view.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber'),c=cols.indexOf('Supplier');if(view.error||a<0||b<0||c<0)return {error:'Find the supplier by name first and select its displayed supplier number.'};const literal=/\\bsupplier\\s+(?:(number|no\\.?|#|id)\\s*[:=]?\\s*)?([0-9]+)\\b/i.exec(raw);let rows=(view.rows||[]).filter(function(row){return key(row[a])&&row[b]&&row[c];});if(literal){if(String(literal[1]||'').toLowerCase()==='id')rows=rows.filter(function(row){return String(row[a])===literal[2];});else rows=rows.filter(function(row){return String(row[b])===literal[2];});}else{if(/\\bfor supplier\\s+\\S+/i.test(raw))return {error:'Find the named supplier first, then use its displayed number.'};rows=rows.filter(function(row){return String(row[a])===String(supplier.selectedSupplierId||'');});}const ids=[];rows.forEach(function(row){if(ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});if(ids.length!==1)return {error:ids.length?'Supplier number is ambiguous.':'Supplier selection is absent or unverified. Query the supplier first.'};const row=rows[0];return {parentId:String(row[a]),parentNumber:String(row[b]),parentName:String(row[c]),error:''};}\n\nconst s=state(),t=s.tx,raw=obj($context.$nodes.GET_CREATED_ADDRESS.$output),receipt=t.createReceipt||{};\nconst match=t.status==='pending'&&frozen(t)&&key(raw.SupplierAddressId)&&String(raw.SupplierAddressId)===t.addressId&&raw.AddressPartyNumber!==undefined&&raw.AddressPartyNumber!==null&&!!String(raw.AddressPartyNumber).trim()&&fields.every(function(k){return raw[k]===t.payload[k];})&&(!receipt.AddressPartyNumber||String(receipt.AddressPartyNumber)===String(raw.AddressPartyNumber));\nif(!match)return {state:render(s,'Independent GET did not match all address fields and identifiers. Pending outcome; no retry authorized.')};t.status='verified';t.addressPartyNumber=String(raw.AddressPartyNumber);t.persisted={SupplierAddressId:t.addressId,AddressPartyNumber:t.addressPartyNumber};fields.forEach(function(k){t.persisted[k]=raw[k];});return {state:render(s,'Independent same-parent GET confirms all eight approved fields and generated identifiers. Address created once.')};\n",
