          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplierSiteId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierSite\": {\n            \"type\": \"string\"\n          },\n          \"ProcurementBUId\": {\n            \"type\": \"number\"\n          },\n          \"ProcurementBU\": {\n            \"type\": \"string\"\n          },\n          \"SupplierAddressId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierAddressName\": {\n            \"type\": \"string\"\n          },\n          \"Address\": {\n            \"type\": \"string\"\n          },\n          \"InactiveDate\": {\n            \"type\": \"null\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"SitePurposeSourcingOnlyFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"SitePurposePurchasingFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"SitePurposeProcurementCardFlag\": {\n            \"anyOf\": [\n              {\n                \"type\": \"boolean\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"SitePurposePayFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"SitePurposePrimaryPayFlag\": {\n            \"anyOf\": [\n              {\n                \"type\": \"boolean\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"IncomeTaxReportingSiteFlag\": {\n            \"anyOf\": [\n              {\n                \"type\": \"boolean\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n       