items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          },\n          \"properties\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"changeIndicator\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"changeIndicator\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": true\n      }\n    }\n  },\n  \"required\": [\n    \"SupplierContactId\",\n    \"SalutationCode\",\n    \"Salutation\",\n    \"FirstName\",\n    \"MiddleName\",\n    \"LastName\",\n    \"JobTitle\",\n    \"AdministrativeContactFlag\",\n    \"PhoneCountryCode\",\n    \"PhoneAreaCode\",\n    \"PhoneNumber\",\n    \"PhoneExtension\",\n    \"MobileCountryCode\",\n    \"MobileAreaCode\",\n    \"MobileNumber\",\n    \"FaxCountryCode\",\n    \"FaxAreaCode\",\n    \"FaxNumber\",\n    \"Email\",\n    \"Status\",\n    \"InactiveDate\",\n    \"PersonProfileId\",\n    \"CreationDate\",\n    \"CreatedBy\",\n    \"LastUpdateDate\",\n    \"LastUpdatedBy\",\n    \"DataAccessLevel\",\n    \"UserName\",\n    \"UserAccountStatus\",\n    \"ContactName\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
