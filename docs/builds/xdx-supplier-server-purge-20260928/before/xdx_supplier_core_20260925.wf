\": {\n            \"type\": \"string\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"InactiveDate\": {\n            \"type\": \"null\"\n          },\n          \"PersonProfileId\": {\n            \"type\": \"number\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"CreatedBy\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"DataAccessLevel\": {\n            \"type\": \"string\"\n          },\n          \"UserName\": {\n            \"type\": \"string\"\n          },\n          \"UserAccountStatus\": {\n            \"type\": \"string\"\n          },\n          \"ContactName\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"SupplierContactId\",\n          \"SalutationCode\",\n          \"Salutation\",\n          \"FirstName\",\n          \"MiddleName\",\n          \"LastName\",\n          \"JobTitle\",\n          \"AdministrativeContactFlag\",\n          \"PhoneCountryCode\",\n          \"PhoneAreaCode\",\n          \"PhoneNumber\",\n          \"PhoneExtension\",\n          \"MobileCountryCode\",\n          \"MobileAreaCode\",\n          \"MobileNumber\",\n          \"FaxCountryCode\",\n          \"FaxAreaCode\",\n          \"FaxNumber\",\n          \"Email\",\n          \"Status\",\n          \"InactiveDate\",\n          \"PersonProfileId\",\n          \"CreationDate\",\n          \"CreatedBy\",\n          \"LastUpdateDate\",\n          \"LastUpdatedBy\",\n          \"DataAccessLevel\",\n          \"UserName\",\n          \"UserAccountStatus\",\n          \"ContactName\"\n        ],\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
