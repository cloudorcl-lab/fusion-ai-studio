            "sourceCode": "\nconst fields=['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email','AddressPurposeOrderingFlag'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction state(){const s=clone(($context.$variables||{}).addressState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\nfunction snapshot(t){const p={},payload=obj(t.payload);fields.forEach(function(k){p[k]=payload[k];});return JSON.stringify({parentId:t.parentId,parentNumber:t.parentNumber,parentName:t.parentName,payload:p});}\nfunction valid(t){if(!key(t.parentId)||!t.parentNumber||!t.parentName)return 'Select a verified supplier parent.';const p=obj(t.payload),limits={AddressName:240,CountryCode:2,AddressLine1:240,City:60,State:60,PostalCode:60,Email:320};if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported address field.';for(const k of fields){if(k==='AddressPurposeOrderingFlag'){if(p[k]!==true)return 'AddressPurposeOrderingFlag must be true for this ordering-address flow.';continue;}if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>limits[k]||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid '+k+'.';}if(p.CountryCode!=='US')return 'Only the validated US country configuration is supported for address creation in this app.';if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.Email))return 'Supply a valid address email.';return '';}\nfunction frozen(t){return t.attempt&&t.attempt.requestId===t.requestId&&t.attempt.revision===t.revision&&t.attempt.payload===snapshot(t);}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"addressCore\">'+JSON.stringify({patternId:'cardWidget',title:title,description:'Supplier address request.',properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx,rows=[{cells:['Supplier number',t.parentNumber||'Not selected']},{cells:['Supplier ID',t.parentId||'Not selected']},{cells:['Supplier',t.parentName||'Not selected']}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.addressId)rows.push({cells:['Supplier address ID',t.addressId]});if(t.addressPartyNumber)rows.push({cells:['Address party number',t.addressPartyNumber]});s.widget='<oraInfoDisplay key=\"addressCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Address created and verified':t.status==='pending'?'Address outcome awaiting verification':'Address draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction parent(raw){const supplier=clone(($context.$variables||{}).readState),view=obj(supplier.view),cols=view.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber'),c=cols.indexOf('Supplier');if(view.error||a<0||b<0||c<0)return {error:'Find the supplier by name first and select its displayed supplier number.'};const literal=/\\bsupplier\\s+(?:(number|no\\.?|#|id)\\s*[:=]?\\s*)?([0-9]+)\\b/i.exec(raw);let rows=(view.rows||[]).filter(function(row){return key(row[a])&&row[b]&&row[c];});if(literal){if(String(literal[1]||'').toLowerCase()==='id')rows=rows.filter(function(row){return String(row[a])===literal[2];});else rows=rows.filter(function(row){return String(row[b])===literal[2];});}else{if(/\\bfor supplier\\s+\\S+/i.test(raw))return {error:'Find the named supplier first, then use its displayed number.'};rows=rows.filter(function(row){return String(row[a])===String(supplier.selectedSupplierId||'');});}const ids=[];rows.forEach(function(row){if(ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});if(ids.length!==1)return {error:ids.length?'Supplier number is ambiguous.':'Supplier selection is absent or unverified. Query the supplier first.'};const row=rows[0];return {parentId:String(row[a]),parentNumber:String(row[b]),parentName:String(row[c]),error:''};}\n\nconst s=state(),r=clone($context.$nodes.EXTRACT_READ.$output),raw=String($context.$system.$inputMessage||'').trim();let t=s.tx;\nfunction display(m){return {route:'display',state:render(s,m)};}\nif($context.$app.$OraMessageHint!=='Query')return {route:'display',state:card(s,'Address request unavailable','Use the application Query conversation.')};\nif(/^(please )?(delete|purge|remove)( |$)/i.test(raw))return display('Persisted address changes and deletion are unsupported.');\nconst control=/^(approve|create) address ([a-z0-9-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nif(/^cancel address$/i.test(raw)){if(t.status==='pending')return display('An address attempt may have occurred. Reconcile address; never retry.');if(t.status==='verified')return display('Address already verified; cancellation cannot change the record.');t.status='cancelled';t.approval=null;t.reviewedPayload='';return display('Address draft cancelled.');}\nif(/^reconcile address$/i.test(raw)){if(t.status!=='pending'||!frozen(t))return display('No valid uncertain address attempt exists.');return {route:'preflight',state:s,parentId:Number(t.parentId),q:\"AddressName='\"+t.payload.AddressName.replace(/'/g,\"''\")+\"'\"};}\nif(/^review address$/i.test(raw)){if(t.status!=='draft')return display('Prepare an editable address draft first.');const error=valid(t);if(error)return display(error);t.reviewedPayload=snapshot(t);t.reviewedRevision=t.revision;t.approval=null;return display('Review supplier parent and every submitted field. To approve exactly, enter: approve address '+t.requestId+' revision '+t.revision+'. Approval alone does not create.');}\nif(control){if(control[2]!==t.requestId||Number(control[3])!==t.revision)return display('Stale address request or revision. No create authorized.');if(t.status!=='draft')return display(t.status==='pending'?'Attempt pending. Reconcile address; never repeat create.':'Address request cannot create again.');const error=valid(t),exact=snapshot(t);if(error)return display(error);if(t.reviewedRevision!==t.revision||t.reviewedPayload!==exact)return display('Review the exact current address and parent first.');if(control[1].toLowerCase()==='approve'){t.approval={requestId:t.requestId,revision:t.revision,payload:exact};return display('Exact address snapshot approved. To create once, enter: create address '+t.requestId+' revision '+t.revision+'.');}if(!t.approval||t.approval.requestId!==t.requestId||t.approval.revision!==t.revision||t.approval.payload!==exact)return display('Exact current address approval required.');return {route:'preflight',state:s,parentId:Number(t.parentId),q:\"AddressName='\"+t.payload.AddressName.replace(/'/g,\"''\")+\"'\"};}\nconst explicit=/^prepare address request ([a-z0-9][a-z0-9-]{0,63}) for supplier (?:number )?([0-9]+) with ([\\s\\S]+)$/i.exec(raw);\nif(/^prepare address request\\b/i.test(raw)&&!explicit)return display('Use prepare address request REFERENCE for supplier NUMBER with explicit address fields.');\nif(explicit)r.intent='prepare_address';\nconst edit=/^(?:change|set) (AddressName|CountryCode|AddressLine1|City|State|PostalCode|Email|AddressPurposeOrderingFlag) to ([\\s\\S]+)$/i.exec(raw);\nif(edit){const k=fields.find(function(k){return k.toLowerCase()===edit[1].toLowerCase();});r.intent='edit_address';r.addressPatch={};r.addressPatch[k]=k==='AddressPurposeOrderingFlag'&&/^(true|false)$/i.test(edit[2])?edit[2].toLowerCase()==='true':edit[2];}\nif(r.intent==='prepare_address'||r.intent==='edit_address'){\n if(t.status==='pending')return display('Uncertain address attempt blocks edits and new drafts.');\n if(r.intent==='edit_address'&&t.status!=='draft')return display('Prepare an editable address draft first.');\n const patch=obj(r.addressPatch);if(!Object.keys(patch).length||Object.keys(patch).some(function(k){return fields.indexOf(k)<0||(k==='AddressPurposeOrderingFlag'?typeof patch[k]!=='boolean':typeof patch[k]!=='string'||!patch[k].trim());}))return display('Supply only explicit supported address fields with correct types.');\n if(r.intent==='prepare_address'){const selected=parent(raw);if(selected.error)return display(selected.error);const runtime=String($context.$workflow.$jobId||'').toLowerCase();if(!explicit&&!/^[a-z0-9-]+$/.test(runtime))return display('No valid request identity.');const requestId=explicit?'adr-ref-'+explicit[1].toLowerCase():'adr-job-'+runtime,used=t.usedRequestRefs===undefined?[]:t.usedRequestRefs;if(!Array.isArray(used)||used.some(function(v){return typeof v!=='string';}))return display('Address request history invalid.');if(used.indexOf(requestId)>=0||requestId===t.requestId)return display('Address request reference already used. Choose a new reference.');if(used.length>=100)return display('Address request limit reached for this conversation.');t=s.tx={requestId:requestId,usedRequestRefs:used.concat([requestId]),parentId:selected.parentId,parentNumber:selected.parentNumber,parentName:selected.parentName,revision:0,payload:{},status:'draft',approval:null,reviewedPayload:''};}\n let changed=false;fields.forEach(function(k){if(Object.prototype.hasOwnProperty.call(patch,k)&&patch[k]!==t.payload[k]){t.payload[k]=patch[k];changed=true;}});if(changed){t.revision++;t.approval=null;t.reviewedPayload='';t.reviewedRevision=null;}return display((valid(t)||'Required address fields supplied.')+' Draft only; enter review address when ready.');\n}\nif(/^(review|approve|create|cancel|reconcile)_address$/.test(String(r.intent||'')))return display('Use the exact address review, approve, create, cancel or reconcile command.');\nlet intent=r.intent;if(/^(next address|next address page)$/i.test(raw))intent='next_address';\nif(['list_address','search_address','detail_address','next_address'].indexOf(intent)<0)return {route:'display',state:card(s,'Address request guidance','Supported: list/search/detail addresses or prepare an address draft for a verified supplier.')};\nconst selected=parent(raw);if(selected.error)return {route:'display',state:card(s,'Address parent unavailable',selected.error)};\nlet limit=r.limit===undefined?5:Number(r.limit),offset=r.offset===undefined?0:Number(r.offset),q='SupplierAddressId>0',addressId=null;\nif(intent==='next_address'){if(s.read.parentId!==selected.parentId||!s.read.hasMore||!Number.isInteger(s.read.nextOffset))return {route:'display',state:card(s,'Address continuation unavailable','Select the same supplier and run its address query first.')};q=s.read.q;limit=s.read.limit;offset=s.read.nextOffset;}\nif(intent==='search_address'){const name=typeof r.name==='string'?r.name:'';if(!name.trim()||name.length>240||/[\\x00-\\x1f]/.test(name))return {route:'display',state:card(s,'Address query unavailable','Supply a valid exact address name.')};q=\"AddressName='\"+name.replace(/'/g,\"''\")+\"'\";}\nif(intent==='detail_address'){const literal=/\\baddress (?:id )?([0-9]+)\\b/i.exec(raw);const id=literal?literal[1]:s.read.parentId===selected.parentId?s.read.selectedId:'';if(!key(id))return {route:'display',state:card(s,'Address detail unavailable','Choose an address ID returned under the selected supplier.')};addressId=Number(id);limit=1;offset=0;}\nif(!Number.isInteger(limit)||limit<1||limit>25||!Number.isInteger(offset)||offset<0)return {route:'display',state:card(s,'Address query unavailable','Use page size1 to25 and nonnegative offset.')};\ns.read={parentId:selected.parentId,parentNumber:selected.parentNumber,parentName:selected.parentName,q:q,limit:limit,offset:offset,selectedId:addressId?String(addressId):'',hasMore:false,nextOffset:null};\nreturn {route:intent==='detail_address'?'detail':'list',state:s,parentId:Number(selected.parentId),addressId:addressId,q:q,limit:limit,offset:offset};\n",
