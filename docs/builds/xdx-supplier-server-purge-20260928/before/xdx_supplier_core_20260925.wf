        {
          "id": "6",
          "code": "PREPARE_READ",
          "type": "CODE",
          "metadata": {
            "name": "prepare read",
            "sourceCode": "\nconst fields=['Supplier','BusinessRelationship','TaxOrganizationType'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction snapshot(p){const o={};fields.forEach(function(k){o[k]=p[k];});return JSON.stringify(o);}\nfunction valid(p){if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported supplier field.';for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>(k==='Supplier'?360:80)||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid '+k+'.';}return '';}\nfunction render(s,message){const rows=fields.map(function(k){return {cells:[k,s.payload&&s.payload[k]!==undefined?s.payload[k]:'Not supplied']};});if(s.supplierId)rows.push({cells:['Supplier ID',s.supplierId]});if(s.supplierNumber)rows.push({cells:['Supplier number',s.supplierNumber]});if(s.supplierPartyId)rows.push({cells:['Supplier party ID',s.supplierPartyId]});s.view={widget:'<oraInfoDisplay key=\"supplierTransaction\">'+JSON.stringify({patternId:'multiRecordWidget',title:s.status==='verified'?'Supplier created and verified':s.status==='pending'?'Supplier outcome awaiting verification':'Supplier draft',description:message+(s.requestId?' Request '+s.requestId+', revision '+s.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>'};return s;}\nfunction frozen(s){return s.attempt&&s.attempt.requestId===s.requestId&&s.attempt.revision===s.revision&&s.attempt.payload===snapshot(s.payload||{});}\n\nconst previous=clone(($context.$variables||{}).readState),init=$context.$app.$OraMessageHint==='InitDisplay';\nlet r=init?{intent:'list',limit:5,offset:0}:clone($context.$nodes.EXTRACT_READ.$output);\nconst message=String($context.$system.$inputMessage||'').trim();\nif(!init&&/^(next|next page)$/i.test(message))r={intent:'next'};\nlet q='SupplierId>0',limit=r.limit===undefined?5:Number(r.limit),offset=r.offset===undefined?0:Number(r.offset),supplierId=null,error='';\nif(r.intent==='next'){q=previous.q;limit=previous.limit;offset=previous.nextOffset;if(!previous.view||previous.view.error||!previous.view.hasMore||!Number.isInteger(offset)||offset<0||!q)error='No next page is available. Run a supplier query first.';}\nelse if(r.intent==='search'){const name=typeof r.name==='string'?r.name:'';if(!name.trim()||name.length>360||/[\\x00-\\x1f]/.test(name))error='Supply a valid exact supplier name.';else q=\"Supplier='\"+name.replace(/'/g,\"''\")+\"'\";}\nelse if(r.intent==='detail'){\nconst resolved=(function(){\nconst fields=['Supplier','BusinessRelationship','TaxOrganizationType'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction snapshot(p){const o={};fields.forEach(function(k){o[k]=p[k];});return JSON.stringify(o);}\nfunction valid(p){if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported supplier field.';for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>(k==='Supplier'?360:80)||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid '+k+'.';}return '';}\nfunction render(s,message){const rows=fields.map(function(k){return {cells:[k,s.payload&&s.payload[k]!==undefined?s.payload[k]:'Not supplied']};});if(s.supplierId)rows.push({cells:['Supplier ID',s.supplierId]});if(s.supplierNumber)rows.push({cells:['Supplier number',s.supplierNumber]});if(s.supplierPartyId)rows.push({cells:['Supplier party ID',s.supplierPartyId]});s.view={widget:'<oraInfoDisplay key=\"supplierTransaction\">'+JSON.stringify({patternId:'multiRecordWidget',title:s.status==='verified'?'Supplier created and verified':s.status==='pending'?'Supplier outcome awaiting verification':'Supplier draft',description:message+(s.requestId?' Request '+s.requestId+', revision '+s.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>'};return s;}\nfunction frozen(s){return s.attempt&&s.attempt.requestId===s.requestId&&s.attempt.revision===s.revision&&s.attempt.payload===snapshot(s.payload||{});}\n\nconst state=clone(($context.$variables||{}).readState),raw=String($context.$system.$inputMessage||'');\nconst literal=/\\bsupplier\\s+(?:(number|no\\.?|#|id)\\s*[:=]?\\s*)?([0-9]+)\\b/i.exec(raw);\nif(obj(state.view).error)return {supplierId:null,error:'Previous supplier result was not verified. Query again.'};\nif(!literal&&/\\bfor supplier\\s+\\S+/i.test(raw))return {supplierId:null,error:'Find the named supplier first, then select its displayed number.'};\nif(!literal)return {supplierId:key(state.selectedSupplierId)?Number(state.selectedSupplierId):null,error:key(state.selectedSupplierId)?'':'Choose a verified supplier first.'};\nif(String(literal[1]||'').toLowerCase()==='id')return {supplierId:key(literal[2])?Number(literal[2]):null,error:key(literal[2])?'':'Invalid supplier ID.'};\nconst view=obj(state.view),cols=view.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber');\nconst ids=[];if(!view.error&&a>=0&&b>=0)(view.rows||[]).forEach(function(row){if(String(row[b])===literal[2]&&key(row[a])&&ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});\nreturn ids.length===1?{supplierId:Number(ids[0]),error:''}:{supplierId:null,error:ids.length?'Supplier number is ambiguous.':'Supplier number is not in verified results. Find by name first.'};\n\n})();supplierId=resolved.supplierId;error=resolved.error;limit=1;offset=0;\n}else if(r.intent!=='list')error='Supported supplier reads are list, exact-name search, next page and selected detail.';\nif(!error&&(!Number.isInteger(limit)||limit<1||limit>25||!Number.isInteger(offset)||offset<0))error='Use a page size from 1 to 25 and nonnegative offset.';\nreturn {q:q,limit:limit,offset:offset,supplierId:supplierId,error:error,intent:r.intent,previous:previous,guidanceWidget:'<oraInfoDisplay key=\"supplierGuidance\">'+JSON.stringify({patternId:'cardWidget',title:'Supplier request guidance',description:'The supplier request did not execute.',properties:{subject:'Request not executed',summary:error}})+'</oraInfoDisplay>'};\n",
