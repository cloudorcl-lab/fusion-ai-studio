          "metadata": {
            "name": "shape detail",
            "sourceCode": "\nconst fields=['Supplier','BusinessRelationship','TaxOrganizationType'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction snapshot(p){const o={};fields.forEach(function(k){o[k]=p[k];});return JSON.stringify(o);}\nfunction valid(p){if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported supplier field.';for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>(k==='Supplier'?360:80)||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid '+k+'.';}return '';}\nfunction render(s,message){const rows=fields.map(function(k){return {cells:[k,s.payload&&s.payload[k]!==undefined?s.payload[k]:'Not supplied']};});if(s.supplierId)rows.push({cells:['Supplier ID',s.supplierId]});if(s.supplierNumber)rows.push({cells:['Supplier number',s.supplierNumber]});if(s.supplierPartyId)rows.push({cells:['Supplier party ID',s.supplierPartyId]});s.view={widget:'<oraInfoDisplay key=\"supplierTransaction\">'+JSON.stringify({patternId:'multiRecordWidget',title:s.status==='verified'?'Supplier created and verified':s.status==='pending'?'Supplier outcome awaiting verification':'Supplier draft',description:message+(s.requestId?' Request '+s.requestId+', revision '+s.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>'};return s;}\nfunction frozen(s){return s.attempt&&s.attempt.requestId===s.requestId&&s.attempt.revision===s.revision&&s.attempt.payload===snapshot(s.payload||{});}\n\nconst r=$context.$nodes.PREPARE_READ.$output.result;\nfunction fail(message){return {state:{q:r.q,limit:r.limit,nextOffset:null,selectedSupplierId:'',view:{error:message,widget:'<oraInfoDisplay key=\"supplierRead\">'+JSON.stringify({patternId:'cardWidget',title:'Supplier query unavailable',description:'No supplier result was verified.',properties:{subject:'Unable to verify the result',summary:message}})+'</oraInfoDisplay>'}}};}\nfunction shaped(view,selected,next){const labels={SupplierId:'Supplier ID',SupplierNumber:'Supplier number',Supplier:'Supplier',SupplierType:'Supplier type',BusinessRelationship:'Business relationship',InactiveDate:'Inactive date',Status:'Status',AlternateName:'Alternate name',TaxOrganizationType:'Tax organization type',CorporateWebsite:'Corporate website'};const widget=view.rows.length?{patternId:'multiRecordWidget',title:view.title,description:view.description,properties:{cols:view.columns.map(function(k){return labels[k]||k;}),rows:view.rows.map(function(row){return {cells:row.map(function(v){return v===null||v===undefined?'Not specified':String(v);})};})}}:{patternId:'cardWidget',title:view.title,description:view.description,properties:{subject:'No suppliers match',summary:'Try another exact supplier name or list suppliers.'}};view.widget='<oraInfoDisplay key=\"supplierRead\">'+JSON.stringify(widget)+'</oraInfoDisplay>';return {state:{q:r.q,limit:r.limit,nextOffset:next,selectedSupplierId:selected,view:view}};}\n\nconst raw=obj($context.$nodes.FETCH_SUPPLIER_DETAIL.$output);\nif(!key(raw.SupplierId)||Number(raw.SupplierId)!==r.supplierId||typeof raw.Supplier!=='string'||!raw.Supplier||typeof raw.SupplierNumber!=='string'||!raw.SupplierNumber)return fail('Supplier detail could not be verified. No record is selected.');\nconst cols=['SupplierId','SupplierNumber','Supplier','SupplierType','BusinessRelationship','InactiveDate','Status','AlternateName','TaxOrganizationType','CorporateWebsite'];\nreturn shaped({kind:'detail',title:'Supplier detail',columns:cols,rows:[cols.map(function(k){return raw[k]===undefined?null:raw[k];})],error:'',hasMore:false,description:'Verified scalar supplier profile; child resources are separate.'},String(raw.SupplierId),null);\n",
            "returnType": "object"
          },
