            "y": 5650
          },
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\"\n    },\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"supplierId\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"integer\"\n    },\n    \"offset\": {\n      \"type\": \"integer\"\n    },\n    \"patch\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"Supplier\": {\n          \"type\": \"string\"\n        },\n        \"BusinessRelationship\": {\n          \"type\": \"string\"\n        },\n        \"TaxOrganizationType\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"addressPatch\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"AddressName\": {\n          \"type\": \"string\"\n        },\n        \"CountryCode\": {\n          \"type\": \"string\"\n        },\n        \"AddressLine1\": {\n          \"type\": \"string\"\n        },\n        \"City\": {\n          \"type\": \"string\"\n        },\n        \"State\": {\n          \"type\": \"string\"\n        },\n        \"PostalCode\": {\n          \"type\": \"string\"\n        },\n        \"Email\": {\n          \"type\": \"string\"\n        },\n        \"AddressPurposeOrderingFlag\": {\n          \"type\": \"boolean\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"sitePatch\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"SupplierSite\": {\n          \"type\": \"string\"\n        },\n        \"ProcurementBUId\": {\n          \"type\": \"number\"\n        },\n        \"SupplierAddressName\": {\n          \"type\": \"string\"\n        },\n        \"SitePurposePurchasingFlag\": {\n          \"type\": \"boolean\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"contactPatch\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"FirstName\": {\n          \"type\": \"string\"\n        },\n        \"LastName\": {\n          \"type\": \"string\"\n        },\n        \"Email\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\n    \"intent\",\n    \"name\",\n    \"supplierId\",\n    \"limit\",\n    \"offset\",\n    \"patch\",\n    \"addressPatch\",\n    \"sitePatch\",\n    \"contactPatch\"\n  ],\n  \"additionalProperties\": false\n}\n"
        },
        {
          "id": "4",
          "code": "PREPARE_TRANSACTION",
          "type": "CODE",
          "metadata": {
            "name": "prepare transaction",
            "sourceCode": "\nconst fields=['Supplier','BusinessRelationship','TaxOrganizationType'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction snapshot(p){const o={};fields.forEach(function(k){o[k]=p[k];});return JSON.stringify(o);}\nfunction valid(p){if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported supplier field.';for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>(k==='Supplier'?360:80)||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid '+k+'.';}return '';}\nfunction render(s,message){const rows=fields.map(function(k){return {cells:[k,s.payload&&s.payload[k]!==undefined?s.payload[k]:'Not supplied']};});if(s.supplierId)rows.push({cells:['Supplier ID',s.supplierId]});if(s.supplierNumber)rows.push({cells:['Supplier number',s.supplierNumber]});if(s.supplierPartyId)rows.push({cells:['Supplier party ID',s.supplierPartyId]});s.view={widget:'<oraInfoDisplay key=\"supplierTransaction\">'+JSON.stringify({patternId:'multiRecordWidget',title:s.status==='verified'?'Supplier created and verified':s.status==='pending'?'Supplier outcome awaiting verification':'Supplier draft',description:message+(s.requestId?' Request '+s.requestId+', revision '+s.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>'};return s;}\nfunction frozen(s){return s.attempt&&s.attempt.requestId===s.requestId&&s.attempt.revision===s.revision&&s.attempt.payload===snapshot(s.payload||{});}\n\nlet s=clone(($context.$variables||{}).transactionState);\nconst r=clone($context.$nodes.EXTRACT_READ.$output),raw=String($context.$system.$inputMessage||'').trim();\nfunction display(m){return {route:'display',state:render(s,m)};}\nif($context.$app.$OraMessageHint==='InitDisplay')return {route:'read',state:s};\nif($context.$app.$OraMessageHint!=='Query')return display('Unsupported application request.');\nif(/^show (?:contact details|(?:the )?details? of contact (?:id )?[1-9][0-9]{0,15})(?: for supplier (?:number |id )?[1-9][0-9]{0,15})?[.!]?$/i.test(raw))return {route:'contact',state:s};\nif(/^(review|cancel|reconcile) contact$/i.test(raw)||/^(approve|create) contact /i.test(raw)||/^prepare contact request /i.test(raw)||/^(change|set) (?:contact )?(FirstName|LastName) to /i.test(raw)||/^(change|set) contact Email to /i.test(raw))return {route:'contact',state:s};\nif(/^(review|cancel|reconcile) site$/i.test(raw)||/^(approve|create) site /i.test(raw)||/^prepare site request /i.test(raw)||/^(change|set) (SupplierSite|ProcurementBUId|SupplierAddressName|SitePurposePurchasingFlag) to /i.test(raw)||/^show procurement business units for site$/i.test(raw))return {route:'site',state:s};\nif(/^(review|cancel|reconcile) address$/i.test(raw)||/^(approve|create) address /i.test(raw)||/^prepare address request /i.test(raw)||/^(change|set) (AddressName|CountryCode|AddressLine1|City|State|PostalCode|Email|AddressPurposeOrderingFlag) to /i.test(raw))return {route:'address',state:s};\nfor(const resource of ['contact','site','address'])if(String(r.intent||'').endsWith('_'+resource))return {route:resource,state:s};\nif(/^(please )?(delete|purge|remove)( |$)/i.test(raw))return display('Persisted changes and deletion are not supported.');\nconst control=/^(approve|create) supplier ([a-z0-9-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nif(/^cancel supplier$/i.test(raw)){if(s.status==='pending')return display('A write may have occurred. Reconcile supplier; no retry.');if(s.status==='verified')return display('Supplier already verified; cancellation cannot change the record.');s.status='cancelled';s.approval=null;s.reviewedPayload='';return display('Draft cancelled. No create authorized.');}\nif(/^reconcile supplier$/i.test(raw)){if(s.status!=='pending'||!frozen(s))return display('No valid uncertain attempt is available.');return {route:'preflight',state:s,q:\"Supplier='\"+s.payload.Supplier.replace(/'/g,\"''\")+\"'\"};}\nif(/^review supplier$/i.test(raw)){if(s.status!=='draft'||!s.requestId)return display('Prepare an editable supplier draft first.');const error=valid(s.payload||{});if(error)return display(error);s.reviewedPayload=snapshot(s.payload);s.reviewedRevision=s.revision;s.approval=null;return display('Review every submitted field. To approve exactly, enter: approve supplier '+s.requestId+' revision '+s.revision+'. Approval alone does not create.');}\nif(control){if(control[2]!==s.requestId||Number(control[3])!==s.revision)return display('Stale request or revision. No create authorized.');if(s.status!=='draft')return display(s.status==='pending'?'Attempt pending. Reconcile supplier; never repeat create.':'Draft cannot create again.');const error=valid(s.payload||{}),payload=snapshot(s.payload||{});if(error)return display(error);if(s.reviewedRevision!==s.revision||s.reviewedPayload!==payload)return display('Review the exact current payload first.');if(control[1].toLowerCase()==='approve'){s.approval={requestId:s.requestId,revision:s.revision,payload:payload};return display('Exact snapshot approved. To create once, enter: create supplier '+s.requestId+' revision '+s.revision+'.');}if(!s.approval||s.approval.requestId!==s.requestId||s.approval.revision!==s.revision||s.approval.payload!==payload)return display('Exact current approval required.');return {route:'preflight',state:s,q:\"Supplier='\"+s.payload.Supplier.replace(/'/g,\"''\")+\"'\"};}\nconst edit=/^(?:change|set) (Supplier|BusinessRelationship|TaxOrganizationType) to ([\\s\\S]+)$/i.exec(raw);\nconst explicitPrepare=/^prepare supplier request ([a-z0-9][a-z0-9-]{0,63}) with ([\\s\\S]+)$/i.exec(raw);\nif(/^prepare supplier request\\b/i.test(raw)&&!explicitPrepare)return display('Use prepare supplier request REFERENCE with explicit supplier field values; reference is 1 to 64 letters, digits or hyphens.');\nif(explicitPrepare)r.intent='prepare_supplier';\nif(edit){r.intent='edit_supplier';r.patch={};r.patch[fields.find(function(k){return k.toLowerCase()===edit[1].toLowerCase();})]=edit[2];}\nif(r.intent==='prepare_supplier'||r.intent==='edit_supplier'){\n if(s.status==='pending')return display('An uncertain attempt blocks edits and new drafts. Reconcile supplier.');\n if(r.intent==='edit_supplier'&&s.status!=='draft')return display('Prepare an editable supplier draft first.');\n const patch=obj(r.patch);if(!Object.keys(patch).length||Object.keys(patch).some(function(k){return fields.indexOf(k)<0||typeof patch[k]!=='string'||!patch[k].trim();}))return display('Supply only explicit nonblank supplier business fields.');\n if(r.intent==='prepare_supplier'){const runtimeId=String($context.$workflow.$jobId||'').toLowerCase();if(!explicitPrepare&&!/^[a-z0-9-]+$/.test(runtimeId))return display('No valid request identity; draft not prepared.');const requestId=explicitPrepare?'ref-'+explicitPrepare[1].toLowerCase():'job-'+runtimeId;const used=s.usedRequestRefs===undefined?[]:s.usedRequestRefs;if(!Array.isArray(used)||used.some(function(v){return typeof v!=='string';}))return display('Request history is invalid. No draft reset permitted.');if(used.indexOf(requestId)>=0||s.requestId===requestId)return display('Request reference already used in this conversation. Choose a new reference.');if(used.length>=100)return display('Conversation request limit reached. No further draft can be prepared here.');s={requestId:requestId,usedRequestRefs:used.concat([requestId]),revision:0,payload:{},status:'draft',approval:null,reviewedPayload:''};}\n let changed=false;fields.forEach(function(k){if(Object.prototype.hasOwnProperty.call(patch,k)&&patch[k]!==s.payload[k]){s.payload[k]=patch[k];changed=true;}});\n if(changed){s.revision++;s.approval=null;s.reviewedPayload='';s.reviewedRevision=null;}\n return display((valid(s.payload)||'Required fields supplied.')+' Draft only; enter review supplier when ready.');\n}\nif(/_(supplier)$/.test(String(r.intent||'')))return display('Use the exact review, approve, create or cancel command.');\nreturn {route:'read',state:s};\n",
