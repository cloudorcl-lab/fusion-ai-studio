        {
          "id": "27",
          "code": "VERIFY_SUPPLIER_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "verify supplier create",
            "sourceCode": "\nconst fields=['Supplier','BusinessRelationship','TaxOrganizationType'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction clone(x){return JSON.parse(JSON.stringify(obj(x)));}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''))&&Number.isSafeInteger(Number(x));}\nfunction snapshot(p){const o={};fields.forEach(function(k){o[k]=p[k];});return JSON.stringify(o);}\nfunction valid(p){if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;}))return 'Unsupported supplier field.';for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>(k==='Supplier'?360:80)||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid '+k+'.';}return '';}\nfunction render(s,message){const rows=fields.map(function(k){return {cells:[k,s.payload&&s.payload[k]!==undefined?s.payload[k]:'Not supplied']};});if(s.supplierId)rows.push({cells:['Supplier ID',s.supplierId]});if(s.supplierNumber)rows.push({cells:['Supplier number',s.supplierNumber]});if(s.supplierPartyId)rows.push({cells:['Supplier party ID',s.supplierPartyId]});s.view={widget:'<oraInfoDisplay key=\"supplierTransaction\">'+JSON.stringify({patternId:'multiRecordWidget',title:s.status==='verified'?'Supplier created and verified':s.status==='pending'?'Supplier outcome awaiting verification':'Supplier draft',description:message+(s.requestId?' Request '+s.requestId+', revision '+s.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>'};return s;}\nfunction frozen(s){return s.attempt&&s.attempt.requestId===s.requestId&&s.attempt.revision===s.revision&&s.attempt.payload===snapshot(s.payload||{});}\n\nconst s=clone(($context.$variables||{}).transactionState),raw=obj($context.$nodes.GET_CREATED_SUPPLIER.$output);\nconst receipt=s.createReceipt||{};\nconst match=s.status==='pending'&&frozen(s)&&key(raw.SupplierId)&&String(raw.SupplierId)===s.supplierId&&key(raw.SupplierPartyId)&&typeof raw.SupplierNumber==='string'&&!!raw.SupplierNumber.trim()&&fields.every(function(k){return raw[k]===s.payload[k];})&&(!receipt.SupplierNumber||receipt.SupplierNumber===raw.SupplierNumber)&&(!receipt.SupplierPartyId||String(receipt.SupplierPartyId)===String(raw.SupplierPartyId));\nif(!match)return {state:render(s,'Persisted fields or identifiers did not match. Outcome remains pending; no retry authorized.')};\ns.status='verified';s.supplierNumber=raw.SupplierNumber;s.supplierPartyId=String(raw.SupplierPartyId);s.persisted={SupplierId:s.supplierId,SupplierNumber:s.supplierNumber,SupplierPartyId:s.supplierPartyId};fields.forEach(function(k){s.persisted[k]=raw[k];});return {state:render(s,'Independent GET confirms every intended field and generated identifier. Created once.')};\n",
            "returnType": "object"
          },
