message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx,rows=[{cells:['Supplier number',t.parentNumber||'Not selected']},{cells:['Supplier ID',t.parentId||'Not selected']},{cells:['Supplier',t.parentName||'Not selected']}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.addressId)rows.push({cells:['Supplier address ID',t.addressId]});if(t.addressPartyNumber)rows.push({cells:['Address party number',t.addressPartyNumber]});s.widget='<oraInfoDisplay key=\"addressCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Address created and verified':t.status==='pending'?'Address outcome awaiting verification':'Address draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction parent(raw){const supplier=clone(($context.$variables||{}).readState),view=obj(supplier.view),cols=view.columns||[],a=cols.indexOf('SupplierId'),b=cols.indexOf('SupplierNumber'),c=cols.indexOf('Supplier');if(view.error||a<0||b<0||c<0)return {error:'Find the supplier by name first and select its displayed supplier number.'};const literal=/\\bsupplier\\s+(?:(number|no\\.?|#|id)\\s*[:=]?\\s*)?([0-9]+)\\b/i.exec(raw);let rows=(view.rows||[]).filter(function(row){return key(row[a])&&row[b]&&row[c];});if(literal){if(String(literal[1]||'').toLowerCase()==='id')rows=rows.filter(function(row){return String(row[a])===literal[2];});else rows=rows.filter(function(row){return String(row[b])===literal[2];});}else{if(/\\bfor supplier\\s+\\S+/i.test(raw))return {error:'Find the named supplier first, then use its displayed number.'};rows=rows.filter(function(row){return String(row[a])===String(supplier.selectedSupplierId||'');});}const ids=[];rows.forEach(function(row){if(ids.indexOf(String(row[a]))<0)ids.push(String(row[a]));});if(ids.length!==1)return {err