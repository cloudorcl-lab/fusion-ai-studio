        {
          "id": "831",
          "code": "COMPARE_ADDRESS_VERIFICATION",
          "type": "CODE",
          "metadata": {
            "name": "Compare Persisted Supplier Address",
            "description": "Compares all four intended fields, parent scope and generated keys with the independent GET.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) { if (value === undefined || value === null) return ''; return String(value).replace(/[\\u0000-\\u001F\\u007F|]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max); }\nvar normalized = $context.$nodes.NORMALIZE_ADDRESS_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(normalized.state));\nvar operation = state.operations[state.operations.length - 1];\nvar output = $context.$nodes.VERIFY_CREATED_ADDRESS && $context.$nodes.VERIFY_CREATED_ADDRESS.$output;\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN'; operation.status = 'VERIFY_UNKNOWN'; state.verification = { status: 'RECONCILE_REQUIRED', checks: [] };\n  return { state: state, prompt: 'The create returned address identifiers, but the independent parent-scoped GET failed. Reconcile before any retry.' };\n}\nvar matches = output.items.filter(function (item) {\n  return clean(item.AddressName, 240) === clean(operation.payload.AddressName, 240) && clean(item.AddressLine1, 240) === clean(operation.payload.AddressLine1, 240) && clean(item.CountryCode, 20) === clean(operation.payload.CountryCode, 20) && clean(item.Email, 320) === clean(operation.payload.Email, 320) && String(item.SupplierAddressId) === operation.responseIdentifiers.SupplierAddressId && String(item.AddressPartyNumber) === operation.responseIdentifiers.AddressPartyNumber;\n});\nif (matches.length !== 1) {\n  state.phase = 'PARTIAL'; operation.status = 'VERIFY_MISMATCH'; state.verification = { status: 'MISMATCH', checks: ['AddressName', 'AddressLine1', 'CountryCode', 'Email', 'SupplierAddressId', 'AddressPartyNumber'] };\n  return { state: state, prompt: 'The independent address GET did not match every intended field and generated key. Reconcile before continuing.' };\n}\nvar persisted = matches[0];\nstate.phase = 'COMPLETE'; operation.status = 'VERIFIED'; operation.verification = 'PASSED'; state.queryResults = [JSON.parse(JSON.stringify(persisted))]; state.selectionKeys = [String(persisted.SupplierAddressId)]; state.query.status = 'READY'; state.verification = { status: 'PASSED', checks: ['AddressName', 'AddressLine1', 'CountryCode', 'Email', 'SupplierAddressId', 'AddressPartyNumber'] };\nreturn { state: state, prompt: 'Supplier address created and independently verified.\\nField | Value\\n--- | ---\\nSupplier | ' + clean(state.selectedSupplier.Supplier, 360) + ' (' + clean(state.selectedSupplier.SupplierNumber, 80) + ')\\nAddress name | ' + clean(persisted.AddressName, 240) + '\\nAddress | ' + clean(persisted.AddressLine1, 240) + '\\nCountry | ' + clean(persisted.CountryCode, 20) + '\\nEmail | ' + clean(persisted.Email, 320) + '\\nVerification | Exact approved fields and generated address keys matched.' };"
          },
          "outcomes": {
            "success": "832"
          },
