            "returnType": "object",
            "sourceCode": "var normalized=$context.$nodes.NORMALIZE_SITE_ASSIGNMENT_CREATE.$output.result;var state=JSON.parse(JSON.stringify(normalized.state));var operation=state.operations[state.operations.length-1];var output=$context.$nodes.VERIFY_CREATED_SITE_ASSIGNMENT&&$context.$nodes.VERIFY_CREATED_SITE_ASSIGNMENT.$output;if(!output||!Array.isArray(output.items)){state.phase='UNKNOWN';operation.status='VERIFY_UNKNOWN';state.verification={status:'RECONCILE_REQUIRED',checks:[]};return {state:state,prompt:'The create returned identifiers, but the independent site assignment GET failed. Reconcile before any retry.'};}var matches=output.items.filter(function(item){return String(item.ClientBUId)===String(operation.payload.ClientBUId)&&String(item.BillToBUId)===String(operation.payload.BillToBUId)&&String(item.AssignmentId)===operation.responseIdentifiers.AssignmentId;});if(matches.length!==1){state.phase='PARTIAL';operation.status='VERIFY_MISMATCH';state.verification={status:'MISMATCH',checks:[\"ClientBUId\",\"BillToBUId\",\"AssignmentId\"]};return {state:state,prompt:'The independent site assignment GET did not match every approved field and generated key. Reconcile before continuing.'};}var persisted=matches[0];state.phase='COMPLETE';operation.status='VERIFIED';operation.verification='PASSED';state.queryResults=[JSON.parse(JSON.stringify(persisted))];state.selectionKeys=[String(persisted.AssignmentId)];state.query.status='READY';state.verification={status:'PASSED',checks:[\"ClientBUId\",\"BillToBUId\",\"AssignmentId\"]};return {state:state,prompt:'Site assignment created and independently verified.'};"
          },
