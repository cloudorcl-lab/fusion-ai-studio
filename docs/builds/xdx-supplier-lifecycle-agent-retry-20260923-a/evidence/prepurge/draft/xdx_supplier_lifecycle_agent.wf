            "returnType": "object",
            "sourceCode": "var prepared = $context.$nodes.PREPARE_ADDRESS_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(prepared.state));\nvar operation = state.operations[state.operations.length - 1];\nvar output = $context.$nodes.CREATE_SUPPLIER_ADDRESS && $context.$nodes.CREATE_SUPPLIER_ADDRESS.$output;\nif (!output || output.SupplierAddressId === undefined || output.SupplierAddressId === null || output.AddressPartyNumber === undefined || output.AddressPartyNumber === null || !output.AddressName) {\n  state.phase = 'UNKNOWN'; operation.status = 'UNKNOWN'; operation.responseIdentifiers = null;\n  state.verification = { status: 'RECONCILE_REQUIRED', checks: [] };\n  return { state: state, action: 'RETURN', prompt: 'The address create outcome is unknown. Reconcile by the exact approved address name under this supplier before any retry.' };\n}\noperation.status = 'RETURNED';\noperation.responseIdentifiers = { SupplierAddressId: String(output.SupplierAddressId), AddressPartyNumber: String(output.AddressPartyNumber) };\nstate.phase = 'VERIFYING';\nstate.query = { kind: 'ADDRESSES', term: operation.payload.AddressName, filter: 'SupplierAddressId=' + String(output.SupplierAddressId), parentId: String(operation.targetParentId), targetKind: 'ADDRESSES', limit: 2, offset: 0, hasMore: false, status: 'PENDING', resource: 'addresses' };\nstate.verification = { status: 'PENDING', checks: [] };\nreturn { state: state, action: 'VERIFY', prompt: '' };"
