            "returnType": "object",
            "sourceCode": "var prepared = $context.$nodes.PREPARE_CONTACT_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(prepared.state));\nvar operation = state.operations[state.operations.length - 1];\nvar output = $context.$nodes.CREATE_SUPPLIER_CONTACT && $context.$nodes.CREATE_SUPPLIER_CONTACT.$output;\nif (!output || output.SupplierContactId === undefined || output.SupplierContactId === null || output.PersonProfileId === undefined || output.PersonProfileId === null || !output.FirstName || !output.LastName || !output.Email) {\n  state.phase = 'UNKNOWN'; operation.status = 'UNKNOWN'; operation.responseIdentifiers = null;\n  state.verification = { status: 'RECONCILE_REQUIRED', checks: [] };\n  return { state: state, action: 'RETURN', prompt: 'The contact create outcome is unknown. Reconcile by the exact approved email under this supplier before any retry.' };\n}\noperation.status = 'RETURNED'; operation.responseIdentifiers = { SupplierContactId: String(output.SupplierContactId), PersonProfileId: String(output.PersonProfileId) };\nstate.phase = 'VERIFYING';\nstate.query = { kind: 'CONTACTS', term: operation.payload.Email, filter: 'SupplierContactId=' + String(output.SupplierContactId), parentId: String(operation.targetParentId), targetKind: 'CONTACTS', limit: 2, offset: 0, hasMore: false, status: 'PENDING', resource: 'contacts' };\nstate.verification = { status: 'PENDING', checks: [] };\nreturn { state: state, action: 'VERIFY', prompt: '' };"
