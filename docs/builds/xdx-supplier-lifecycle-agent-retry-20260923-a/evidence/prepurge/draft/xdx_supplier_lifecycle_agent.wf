        {
          "id": "727",
          "code": "NORMALIZE_READ_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "Normalize Supplier Read Result",
            "description": "Normalizes one BO GET result into typed state and a deterministic four-column response; execution failure remains distinct from an empty collection.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) {\n  if (value === undefined || value === null) return '';\n  return String(value).replace(/[\\u0000-\\u001F\\u007F|]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max);\n}\nfunction cell(value) { var text = clean(value, 120); return text || '—'; }\nfunction table(headers, rows) {\n  var lines = [headers.join(' | '), headers.map(function () { return '---'; }).join(' | ')];\n  rows.forEach(function (row, index) { lines.push((index + 1) + ') ' + row.map(cell).join(' | ')); });\n  return lines.join('\\n');\n}\nvar prepared = $context.$nodes.PREPARE_SUPPLIER_RESULT && $context.$nodes.PREPARE_SUPPLIER_RESULT.$output ? $context.$nodes.PREPARE_SUPPLIER_RESULT.$output.result : null;\nvar reduced = prepared && /^(LIST_ADDRESSES|LIST_SITES|LIST_CONTACTS)$/.test(prepared.action) ? prepared : $context.$nodes.REDUCE_LIFECYCLE.$output.result;\nvar state = JSON.parse(JSON.stringify(reduced.state));\nvar action = reduced.action;\nvar nodeByAction = {\n  SEARCH_NAME: 'FIND_SUPPLIERS_BY_NAME',\n  SEARCH_NUMBER: 'FIND_SUPPLIERS_BY_NUMBER',\n  LIST_ADDRESSES: 'LIST_SUPPLIER_ADDRESSES',\n  LIST_SITES: 'LIST_SUPPLIER_SITES',\n  LIST_CONTACTS: 'LIST_SUPPLIER_CONTACTS',\n  LIST_PROCUREMENT_BUS: 'LIST_PROCUREMENT_BUS',\n  LIST_BUSINESS_CLASSIFICATIONS: 'LIST_SUPPLIER_BUSINESS_CLASSIFICATIONS',\n  LIST_CONTACT_ADDRESSES: 'LIST_SUPPLIER_CONTACT_ADDRESSES',\n  LIST_CONTACT_DATA_ACCESS: 'LIST_SUPPLIER_CONTACT_DATA_ACCESS',\n  LIST_CONTACT_ROLES: 'LIST_SUPPLIER_CONTACT_ROLES',\n  LIST_MERGE_HISTORY: 'LIST_SUPPLIER_MERGE_HISTORY',\n  LIST_PRODUCTS_SERVICES: 'LIST_SUPPLIER_PRODUCTS_SERVICES',\n  LIST_PRODUCTS_SERVICES_VIEW: 'LIST_SUPPLIER_PRODUCTS_SERVICES_VIEW',\n  LIST_SITE_ASSIGNMENTS: 'LIST_SUPPLIER_SITE_ASSIGNMENTS',\n  LIST_SPEND_AUTHORIZATION: 'LIST_SUPPLIER_SPEND_AUTHORIZATION',\n  LIST_PRODUCT_SERVICE_CATEGORIES: 'LIST_PRODUCT_SERVICE_CATEGORIES'\n};\nvar node = $context.$nodes[nodeByAction[action]];\nvar output = node && node.$output ? node.$output : null;\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN';\n  state.query.status = 'ERROR';\n  state.query.hasMore = false;\n  state.verification = { status: 'READ_ERROR', checks: [] };\n  return { state: state, prompt: 'The supplier query could not be completed. No result was treated as an empty list; retry or refine the request.' };\n}\nvar sourceItems = action === 'LIST_PROCUREMENT_BUS' ? output.items.filter(function (item) { return String(item.ProcurementBUId) === String(state.query.term); }) : output.items;\nvar items = sourceItems.slice(0, state.query.limit);\nstate.queryResults = JSON.parse(JSON.stringify(items));\nstate.query.offset = Number.isInteger(output.offset) ? output.offset : state.query.offset;\nstate.query.limit = Number.isInteger(output.limit) && output.limit > 0 ? Math.min(output.limit, 25) : state.query.limit;\nstate.query.hasMore = output.hasMore === true;\nstate.query.status = items.length ? 'READY' : 'EMPTY';\nstate.verification = { status: 'READ_COMPLETE', checks: ['parent-scope', 'four-column-projection'] };\nif (!items.length) {\n  state.phase = 'QUERY';\n  var emptyLabel = action === 'SEARCH_NAME' || action === 'SEARCH_NUMBER' ? 'suppliers matched' : state.query.resource + ' were found for the selected supplier';\n  return { state: state, prompt: 'No ' + emptyLabel + '. This was a successful empty result, not an execution error.' };\n}\nvar prompt;\nif (action === 'SEARCH_NAME' || action === 'SEARCH_NUMBER') {\n  state.selectionKeys = items.map(function (item) { return String(item.SupplierId); });\n  if (items.length === 1) {\n    state.selectedSupplier = JSON.parse(JSON.stringify(items[0]));\n    state.phase = 'GATHER';\n  } else {\n    state.phase = 'SELECT';\n  }\n  prompt = table(['Supplier number', 'Supplier', 'Type', 'Relationship'], items.map(function (item) {\n    return [item.SupplierNumber, item.Supplier, item.SupplierType, item.BusinessRelationship];\n  }));\n  prompt += items.length === 1 ? '\\nSelected the only matching supplier. You can show addresses, sites, or contacts.' : '\\nReply select 1 or select ' + items.length + ' to choose a supplier.';\n} else if (action === 'LIST_ADDRESSES') {\n  state.phase = 'GATHER';\n  state.selectionKeys = items.map(function (item) { return String(item.SupplierAddressId); });\n  prompt = table(['Address', 'City', 'State', 'Country'], items.map(function (item) { return [item.AddressName, item.City, item.State, item.Country]; }));\n  prompt += '\\nReply select address N to retain one address.';\n} else if (action === 'LIST_SITES') {\n  state.phase = 'GATHER';\n  state.selectionKeys = items.map(function (item) { return String(item.SupplierSiteId); });\n  prompt = table(['Site', 'Procurement BU', 'Address', 'Status'], items.map(function (item) { return [item.SupplierSite, item.ProcurementBU, item.SupplierAddressName, item.Status]; }));\n  prompt += '\\nReply select site N to retain one site.';\n} else if (action === 'LIST_PROCUREMENT_BUS') {\n  state.phase = 'GATHER';\n  state.selectionKeys = items.map(function (item) { return String(item.ProcurementBUId); });\n  prompt = table(['Procurement BU', 'BU ID', 'Action'], items.map(function (item) { return [item.ProcurementBU, item.ProcurementBUId, item.AgentAction]; }));\n  prompt += '\\nReply select business unit N to retain one business unit.';\n} else if (action === 'LIST_CONTACTS') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.SupplierContactId); });\n  prompt = table(['Contact', 'Job title', 'Email', 'Status'], items.map(function (item) { return [item.ContactName || ((item.FirstName || '') + ' ' + (item.LastName || '')), item.JobTitle, item.Email, item.Status]; }));\n  prompt += '\\nReply select contact N to retain one contact.';\n} else if (action === 'LIST_BUSINESS_CLASSIFICATIONS') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.ClassificationId); });\n  prompt = table(['Classification', 'Status', 'Expiration'], items.map(function (item) { return [item.Classification, item.Status, item.CertificateExpirationDate]; }));\n} else if (action === 'LIST_CONTACT_ADDRESSES') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.SupplierContactAddressId); });\n  prompt = table(['Address', 'Created'], items.map(function (item) { return [item.AddressName, item.CreationDate]; }));\n} else if (action === 'LIST_CONTACT_DATA_ACCESS') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.AccessCode) + ':' + String(item.AccessValue); });\n  prompt = table(['Access', 'Value', 'Business unit', 'Site'], items.map(function (item) { return [item.AccessCode, item.AccessValue, item.BUName, item.SupplierSite]; }));\n  prompt += '\\nThis resource is read-only; no access was provisioned.';\n} else if (action === 'LIST_CONTACT_ROLES') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.RoleId); });\n  prompt = table(['Role', 'Description'], items.map(function (item) { return [item.RoleName, item.Description]; }));\n  prompt += '\\nThis resource is read-only; no role or account was provisioned.';\n} else if (action === 'LIST_MERGE_HISTORY') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.MergeRequestId); });\n  prompt = table(['From supplier', 'To supplier', 'Created'], items.map(function (item) { return [item.FromVendorName, item.ToVendorName, item.CreationDate]; }));\n} else if (action === 'LIST_PRODUCTS_SERVICES') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.SupplierProductsServicesId); });\n  prompt = table(['Category', 'Type', 'Description'], items.map(function (item) { return [item.CategoryName, item.CategoryType, item.CategoryDescription]; }));\n} else if (action === 'LIST_PRODUCTS_SERVICES_VIEW') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.SupplierProductsServicesId); });\n  prompt = table(['Category', 'Path', 'Type', 'Description'], items.map(function (item) { return [item.CategoryName, item.CategoryPath, item.CategoryType, item.CategoryDescription]; }));\n  prompt += '\\nThis is the read-only products and services view.';\n} else if (action === 'LIST_SITE_ASSIGNMENTS') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.AssignmentId); });\n  prompt = table(['Client BU', 'Bill-to BU', 'Ship-to', 'Inactive'], items.map(function (item) { return [item.ClientBU, item.BillToBU, item.ShipToLocationCode, item.InactiveDate]; }));\n} else if (action === 'LIST_SPEND_AUTHORIZATION') {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.AuthorizationRequestId); });\n  prompt = table(['Request', 'Status', 'Requested', 'Procurement BU'], items.map(function (item) { return [item.RequestNumber, item.RequestStatus, item.RequestedDate, item.ProcurementBU]; }));\n  prompt += '\\nThis resource is read-only; no submit or resubmit action is enabled.';\n} else {\n  state.phase = 'GATHER'; state.selectionKeys = items.map(function (item) { return String(item.CategoryId); });\n  prompt = table(['Category', 'Type', 'Description'], items.map(function (item) { return [item.CategoryName, item.CategoryType, item.Description]; }));\n  prompt += '\\nReply select category N to retain one category.';\n}\nif (state.query.hasMore) prompt += '\\nMore results are available. Reply next to load the next page.';\nreturn { state: state, prompt: prompt };\n"
          },
