            "sourceCode": "var prepared = $context.$nodes.PREPARE_SITE_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(prepared.state));\nvar operation = state.operations[state.operations.length - 1];\nvar output = $context.$nodes.CREATE_SUPPLIER_SITE && $context.$nodes.CREATE_SUPPLIER_SITE.$output;\nif (!output || output.SupplierSiteId === undefined || output.SupplierSiteId === null || !output.SupplierSite) {\n  state.phase = 'UNKNOWN'; operation.status = 'UNKNOWN'; operation.responseIdentifiers = null;\n  state.verification = { status: 'RECONCILE_REQUIRED', checks: [] };\n  return { state: state, action: 'RETURN', prompt: 'The site create outcome is unknown. Reconcile by the exact approved site code under this supplier before any retry.' };\n}\noperation.status = 'RETURNED'; operation.responseIdentifiers = { SupplierSiteId: String(output.SupplierSiteId) };\nstate.phase = 'VERIFYING';\nstate.query = { kind: 'SITES', term: operation.payload.SupplierSite, filter: 'SupplierSiteId=' + String(output.SupplierSiteId), parentId: String(operation.targetParentId), targetKind: 'SITES', limit: 2, offset: 0, hasMore: false, status: 'PENDING', resource: 'sites' };\nstate.verification = { status: 'PENDING', checks: [] };\nreturn { state: state, action: 'VERIFY', prompt: '' };"
          },
