        {
          "id": "801",
          "code": "PREPARE_SUPPLIER_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Guarded Supplier Create",
            "description": "Validates the exact three-field approved supplier payload, blocks duplicates and marks execution before POST.",
            "returnType": "object",
            "sourceCode": "function samePayload(left, right) {\n  return JSON.stringify(left) === JSON.stringify(right);\n}\nvar reduced = $context.$nodes.REDUCE_LIFECYCLE.$output.result;\nvar state = JSON.parse(JSON.stringify(reduced.state));\nvar output = $context.$nodes.CHECK_SUPPLIER_DUPLICATE && $context.$nodes.CHECK_SUPPLIER_DUPLICATE.$output;\nvar operation = state.operations && state.operations.length ? state.operations[state.operations.length - 1] : null;\nvar approved = state.approvedSnapshot;\nvar payload = approved && approved.normalizedPayload;\nvar keys = payload && typeof payload === 'object' ? Object.keys(payload) : [];\nif (!operation || operation.status !== 'APPROVED' || !approved || approved.requestId !== state.requestId || approved.revision !== state.revision || !samePayload(payload, state.draft.requiredFields) || keys.slice().sort().join('|') !== 'BusinessRelationship|Supplier|TaxOrganizationType') {\n  state.phase = 'VALIDATION_ERROR';\n  state.approvedSnapshot = null;\n  if (operation) operation.status = 'STALE_APPROVAL_BLOCKED';\n  return { state: state, action: 'RETURN', prompt: 'The approved supplier payload is stale or contains fields outside the required transaction allowlist. Review again; no create was scheduled.' };\n}\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN';\n  operation.status = 'PREFLIGHT_UNKNOWN';\n  return { state: state, action: 'RETURN', prompt: 'The duplicate preflight could not be completed. Reconcile the exact supplier name before any create or retry.' };\n}\nif (output.items.length > 0) {\n  state.phase = 'VALIDATION_ERROR';\n  operation.status = 'DUPLICATE_BLOCKED';\n  return { state: state, action: 'RETURN', prompt: 'A supplier already matches the approved name. No create was submitted. Choose a different unique supplier name.' };\n}\nstate.phase = 'EXECUTING';\noperation.status = 'SUBMISSION_STARTED';\nreturn { state: state, action: 'CREATE', prompt: '' };"
          },
