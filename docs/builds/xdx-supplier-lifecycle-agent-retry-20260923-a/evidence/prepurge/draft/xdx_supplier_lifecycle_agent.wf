        {
          "id": "864",
          "code": "COMPARE_CONTACT_VERIFICATION",
          "type": "CODE",
          "metadata": {
            "name": "Compare Persisted Supplier Contact",
            "description": "Compares the approved email, generated keys and no-account side effect with the independent GET.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) { if (value === undefined || value === null) return ''; return String(value).replace(/[\\u0000-\\u001F\\u007F|]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max); }\nvar normalized = $context.$nodes.NORMALIZE_CONTACT_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(normalized.state));\nvar operation = state.operations[state.operations.length - 1];\nvar output = $context.$nodes.VERIFY_CREATED_CONTACT && $context.$nodes.VERIFY_CREATED_CONTACT.$output;\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN'; operation.status = 'VERIFY_UNKNOWN'; state.verification = { status: 'RECONCILE_REQUIRED', checks: [] };\n  return { state: state, prompt: 'The create returned contact identifiers, but the independent parent-scoped GET failed. Reconcile before any retry.' };\n}\nvar matches = output.items.filter(function (item) {\n  return clean(item.FirstName, 150) === clean(operation.payload.FirstName, 150) && clean(item.LastName, 150) === clean(operation.payload.LastName, 150) && clean(item.Email, 320).toLowerCase() === clean(operation.payload.Email, 320).toLowerCase() && String(item.SupplierContactId) === operation.responseIdentifiers.SupplierContactId && String(item.PersonProfileId) === operation.responseIdentifiers.PersonProfileId && (item.UserName === undefined || item.UserName === null || clean(item.UserName, 320) === '') && (item.UserAccountStatus === undefined || item.UserAccountStatus === null || clean(item.UserAccountStatus, 80) === '');\n});\nif (matches.length !== 1) {\n  state.phase = 'PARTIAL'; operation.status = 'VERIFY_MISMATCH'; state.verification = { status: 'MISMATCH', checks: ['FirstName', 'LastName', 'Email', 'SupplierContactId', 'PersonProfileId', 'NoUserAccount'] };\n  return { state: state, prompt: 'The independent contact GET did not match the approved identity, generated keys or no-account requirement. Reconcile before continuing.' };\n}\nvar persisted = matches[0];\nstate.phase = 'COMPLETE'; operation.status = 'VERIFIED'; operation.verification = 'PASSED'; state.queryResults = [JSON.parse(JSON.stringify(persisted))]; state.selectionKeys = [String(persisted.SupplierContactId)]; state.query.status = 'READY'; state.verification = { status: 'PASSED', checks: ['FirstName', 'LastName', 'Email', 'SupplierContactId', 'PersonProfileId', 'NoUserAccount'] };\nreturn { state: state, prompt: 'Supplier contact created and independently verified.\\nField | Value\\n--- | ---\\nSupplier | ' + clean(state.selectedSupplier.Supplier, 360) + ' (' + clean(state.selectedSupplier.SupplierNumber, 80) + ')\\nFirst name | ' + clean(persisted.FirstName, 150) + '\\nLast name | ' + clean(persisted.LastName, 150) + '\\nEmail | ' + clean(persisted.Email, 320) + '\\nAccount provisioning | none observed\\nVerification | Exact approved identity and generated contact/person keys matched.' };"
