        {
          "id": "821",
          "code": "PREPARE_ADDRESS_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Guarded Address Create",
            "description": "Validates the exact four-field approved address payload, parent and duplicate preflight before POST.",
            "returnType": "object",
            "sourceCode": "function samePayload(left, right) { return JSON.stringify(left) === JSON.stringify(right); }\nvar reduced = $context.$nodes.REDUCE_LIFECYCLE.$output.result;\nvar state = JSON.parse(JSON.stringify(reduced.state));\nvar output = $context.$nodes.CHECK_ADDRESS_DUPLICATE && $context.$nodes.CHECK_ADDRESS_DUPLICATE.$output;\nvar operation = state.operations && state.operations.length ? state.operations[state.operations.length - 1] : null;\nvar approved = state.approvedSnapshot;\nvar payload = approved && approved.normalizedPayload;\nvar keys = payload && typeof payload === 'object' ? Object.keys(payload) : [];\nvar parentId = state.selectedSupplier && state.selectedSupplier.SupplierId !== undefined ? String(state.selectedSupplier.SupplierId) : '';\nif (!operation || operation.resource !== 'address' || operation.status !== 'APPROVED' || !approved || approved.requestId !== state.requestId || approved.revision !== state.revision || !samePayload(payload, state.draft.requiredFields) || keys.slice().sort().join('|') !== 'AddressLine1|AddressName|CountryCode|Email' || !parentId || String(operation.targetParentId) !== parentId || !approved.targetParent || String(approved.targetParent.SupplierId) !== parentId) {\n  state.phase = 'VALIDATION_ERROR'; state.approvedSnapshot = null;\n  if (operation) operation.status = 'STALE_APPROVAL_BLOCKED';\n  return { state: state, action: 'RETURN', prompt: 'The approved address payload or parent is stale or outside the required transaction allowlist. Review again; no create was scheduled.' };\n}\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN'; operation.status = 'PREFLIGHT_UNKNOWN';\n  return { state: state, action: 'RETURN', prompt: 'The address duplicate preflight could not be completed. Reconcile the exact address name under this supplier before any create or retry.' };\n}\nif (output.items.length > 0) {\n  state.phase = 'VALIDATION_ERROR'; operation.status = 'DUPLICATE_BLOCKED';\n  return { state: state, action: 'RETURN', prompt: 'An address already matches the approved name under this supplier. No create was submitted.' };\n}\nstate.phase = 'EXECUTING'; operation.status = 'SUBMISSION_STARTED';\nreturn { state: state, action: 'CREATE', prompt: '' };"
          },
