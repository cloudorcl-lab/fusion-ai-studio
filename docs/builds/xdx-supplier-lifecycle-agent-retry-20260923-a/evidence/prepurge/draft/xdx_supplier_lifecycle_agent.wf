        {
          "id": "811",
          "code": "COMPARE_SUPPLIER_VERIFICATION",
          "type": "CODE",
          "metadata": {
            "name": "Compare Persisted Supplier",
            "description": "Compares the exact intended Supplier, BusinessRelationship and TaxOrganizationType plus generated keys with the independent GET.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) {\n  if (value === undefined || value === null) return '';\n  return String(value).replace(/[\\u0000-\\u001F\\u007F|]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max);\n}\nvar normalized = $context.$nodes.NORMALIZE_SUPPLIER_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(normalized.state));\nvar operation = state.operations[state.operations.length - 1];\nvar output = $context.$nodes.VERIFY_CREATED_SUPPLIER && $context.$nodes.VERIFY_CREATED_SUPPLIER.$output;\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN';\n  operation.status = 'VERIFY_UNKNOWN';\n  state.verification = { status: 'RECONCILE_REQUIRED', checks: [] };\n  return { state: state, prompt: 'The create returned identifiers, but the independent supplier GET failed. Reconcile before any retry.' };\n}\nvar matches = output.items.filter(function (item) {\n  return clean(item.Supplier, 360) === clean(operation.payload.Supplier, 360) && clean(item.BusinessRelationship, 120) === clean(operation.payload.BusinessRelationship, 120) && clean(item.TaxOrganizationType, 120) === clean(operation.payload.TaxOrganizationType, 120) && String(item.SupplierId) === operation.responseIdentifiers.SupplierId && String(item.SupplierNumber) === operation.responseIdentifiers.SupplierNumber;\n});\nif (matches.length !== 1) {\n  state.phase = 'PARTIAL';\n  operation.status = 'VERIFY_MISMATCH';\n  state.verification = { status: 'MISMATCH', checks: ['Supplier', 'BusinessRelationship', 'TaxOrganizationType', 'SupplierId', 'SupplierNumber'] };\n  return { state: state, prompt: 'The create returned identifiers, but the independent supplier GET did not match every intended field and generated key. Reconcile before continuing.' };\n}\nvar persisted = matches[0];\nstate.phase = 'COMPLETE';\noperation.status = 'VERIFIED';\noperation.verification = 'PASSED';\nstate.selectedSupplier = JSON.parse(JSON.stringify(persisted));\nstate.queryResults = [JSON.parse(JSON.stringify(persisted))];\nstate.selectionKeys = [String(persisted.SupplierId)];\nstate.query.status = 'READY';\nstate.verification = { status: 'PASSED', checks: ['Supplier', 'BusinessRelationship', 'TaxOrganizationType', 'SupplierId', 'SupplierNumber'] };\nreturn { state: state, prompt: 'Supplier created and independently verified.\\nField | Value\\n--- | ---\\nSupplier | ' + clean(persisted.Supplier, 360) + '\\nBusiness relationship | ' + clean(persisted.BusinessRelationship, 120) + '\\nTax organization type | ' + clean(persisted.TaxOrganizationType, 120) + '\\nSupplier number | ' + clean(persisted.SupplierNumber, 80) + '\\nVerification | Supplier matched the exact approved payload; generated keys were captured.' };"
          },
