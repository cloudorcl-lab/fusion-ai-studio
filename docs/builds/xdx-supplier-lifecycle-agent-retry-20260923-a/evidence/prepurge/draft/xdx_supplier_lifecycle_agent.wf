            "sourceCode": "function samePayload(left, right) { return JSON.stringify(left) === JSON.stringify(right); }\nvar reduced=$context.$nodes.REDUCE_LIFECYCLE.$output.result; var state=JSON.parse(JSON.stringify(reduced.state)); var output=$context.$nodes.CHECK_SITE_ASSIGNMENT_DUPLICATE && $context.$nodes.CHECK_SITE_ASSIGNMENT_DUPLICATE.$output; var operation=state.operations&&state.operations.length?state.operations[state.operations.length-1]:null; var approved=state.approvedSnapshot; var payload=approved&&approved.normalizedPayload; var keys=payload&&typeof payload==='object'?Object.keys(payload):[]; var parentId=state.selectedSupplier&&state.selectedSupplier.SupplierId!==undefined?String(state.selectedSupplier.SupplierId):'';\nif(!operation||operation.resource!=='siteassignment'||operation.status!=='APPROVED'||!approved||approved.requestId!==state.requestId||approved.revision!==state.revision||!samePayload(payload,state.draft.requiredFields)||keys.slice().sort().join('|')!=='BillToBUId|ClientBUId'||!parentId||String(operation.targetParentId)!==parentId||!approved.targetParent||String(approved.targetParent.SupplierId)!==parentId || !operation.targetSecondaryParentId || !approved.targetSite || String(operation.targetSecondaryParentId) !== String(approved.targetSite.SupplierSiteId)){state.phase='VALIDATION_ERROR';state.approvedSnapshot=null;if(operation)operation.status='STALE_APPROVAL_BLOCKED';return {state:state,action:'RETURN',prompt:'The approved site assignment transaction is stale or outside the required-field allowlist. Review again; no create was scheduled.'};}\nif(!output||!Array.isArray(output.items)){state.phase='UNKNOWN';operation.status='PREFLIGHT_UNKNOWN';return {state:state,action:'RETURN',prompt:'The site assignment duplicate preflight could not be completed. Reconcile before any create or retry.'};}\nif(output.items.length>0){state.phase='VALIDATION_ERROR';operation.status='DUPLICATE_BLOCKED';return {state:state,action:'RETURN',prompt:'The selected supplier already has this site assignment. No create was submitted.'};}\nstate.phase='EXECUTING';operation.status='SUBMISSION_STARTED';return {state:state,action:'CREATE',prompt:''};"
          },
