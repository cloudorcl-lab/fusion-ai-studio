            "sourceCode": "var normalized=$context.$nodes.NORMALIZE_CONTACT_ADDRESS_CREATE.$output.result;var state=JSON.parse(JSON.stringify(normalized.state));var operation=state.operations[state.operations.length-1];var output=$context.$nodes.VERIFY_CREATED_CONTACT_ADDRESS&&$context.$nodes.VERIFY_CREATED_CONTACT_ADDRESS.$output;if(!output||!Array.isArray(output.items)){state.phase='UNKNOWN';operation.status='VERIFY_UNKNOWN';state.verification={status:'RECONCILE_REQUIRED',checks:[]};return {state:state,prompt:'The create returned identifiers, but the independent contact-address association GET failed. Reconcile before any retry.'};}var matches=output.items.filter(function(item){return String(item.SupplierAddressId)===String(operation.payload.SupplierAddressId)&&String(item.SupplierContactAddressId)===operation.responseIdentifiers.SupplierContactAddressId;});if(matches.length!==1){state.phase='PARTIAL';operation.status='VERIFY_MISMATCH';state.verification={status:'MISMATCH',checks:[\"SupplierAddressId\",\"SupplierContactAddressId\"]};return {state:state,prompt:'The independent contact-address association GET did not match every approved field and generated key. Reconcile before continuing.'};}var persisted=matches[0];state.phase='COMPLETE';operation.status='VERIFIED';operation.verification='PASSED';state.queryResults=[JSON.parse(JSON.stringify(persisted))];state.selectionKeys=[String(persisted.SupplierContactAddressId)];state.query.status='READY';state.verification={status:'PASSED',checks:[\"SupplierAddressId\",\"SupplierContactAddressId\"]};return {state:state,prompt:'Contact-address association created and independently verified.'};"
