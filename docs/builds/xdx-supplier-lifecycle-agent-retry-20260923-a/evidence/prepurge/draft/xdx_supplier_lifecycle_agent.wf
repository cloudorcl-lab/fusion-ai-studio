        {
          "id": "841",
          "code": "PREPARE_SITE_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Guarded Site Create",
            "description": "Validates the approved site payload, parent, BU/address provenance and duplicate preflight.",
            "returnType": "object",
            "sourceCode": "function samePayload(left, right) { return JSON.stringify(left) === JSON.stringify(right); }\nvar reduced = $context.$nodes.REDUCE_LIFECYCLE.$output.result;\nvar state = JSON.parse(JSON.stringify(reduced.state));\nvar output = $context.$nodes.CHECK_SITE_DUPLICATE && $context.$nodes.CHECK_SITE_DUPLICATE.$output;\nvar operation = state.operations && state.operations.length ? state.operations[state.operations.length - 1] : null;\nvar approved = state.approvedSnapshot;\nvar payload = approved && approved.normalizedPayload;\nvar keys = payload && typeof payload === 'object' ? Object.keys(payload) : [];\nvar parentId = state.selectedSupplier && state.selectedSupplier.SupplierId !== undefined ? String(state.selectedSupplier.SupplierId) : '';\nvar provenance = state.fieldProvenance || {};\nif (!operation || operation.resource !== 'site' || operation.status !== 'APPROVED' || !approved || approved.requestId !== state.requestId || approved.revision !== state.revision || !samePayload(payload, state.draft.requiredFields) || keys.slice().sort().join('|') !== 'ProcurementBUId|SitePurposePurchasingFlag|SupplierAddressName|SupplierSite' || String(payload.SitePurposePurchasingFlag).toLowerCase() !== 'true' || !parentId || String(operation.targetParentId) !== parentId || !approved.targetParent || String(approved.targetParent.SupplierId) !== parentId || !provenance.ProcurementBUId || provenance.ProcurementBUId.source !== 'REFERENCE' || !provenance.SupplierAddressName || provenance.SupplierAddressName.source !== 'REFERENCE') {\n  state.phase = 'VALIDATION_ERROR'; state.approvedSnapshot = null;\n  if (operation) operation.status = 'STALE_APPROVAL_BLOCKED';\n  return { state: state, action: 'RETURN', prompt: 'The approved site payload, supplier, procurement BU or address is stale or outside the required business allowlist. Review again; no create was scheduled.' };\n}\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN'; operation.status = 'PREFLIGHT_UNKNOWN';\n  return { state: state, action: 'RETURN', prompt: 'The site duplicate preflight could not be completed. Reconcile the exact site code under this supplier before any create or retry.' };\n}\nif (output.items.length > 0) {\n  state.phase = 'VALIDATION_ERROR'; operation.status = 'DUPLICATE_BLOCKED';\n  return { state: state, action: 'RETURN', prompt: 'A site already matches the approved code under this supplier. No create was submitted.' };\n}\nstate.phase = 'EXECUTING'; operation.status = 'SUBMISSION_STARTED';\nreturn { state: state, action: 'CREATE', prompt: '' };"
          },
