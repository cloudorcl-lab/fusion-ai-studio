            "returnType": "object",
            "sourceCode": "var normalized=$context.$nodes.NORMALIZE_CLASSIFICATION_CREATE.$output.result;var state=JSON.parse(JSON.stringify(normalized.state));var operation=state.operations[state.operations.length-1];var output=$context.$nodes.VERIFY_CREATED_CLASSIFICATION&&$context.$nodes.VERIFY_CREATED_CLASSIFICATION.$output;if(!output||!Array.isArray(output.items)){state.phase='UNKNOWN';operation.status='VERIFY_UNKNOWN';state.verification={status:'RECONCILE_REQUIRED',checks:[]};return {state:state,prompt:'The create returned identifiers, but the independent business classification GET failed. Reconcile before any retry.'};}var matches=output.items.filter(function(item){return String(item.ClassificationCode)===String(operation.payload.ClassificationCode)&&String(item.ClassificationId)===operation.responseIdentifiers.ClassificationId;});if(matches.length!==1){state.phase='PARTIAL';operation.status='VERIFY_MISMATCH';state.verification={status:'MISMATCH',checks:[\"ClassificationCode\",\"ClassificationId\"]};return {state:state,prompt:'The independent business classification GET did not match every approved field and generated key. Reconcile before continuing.'};}var persisted=matches[0];state.phase='COMPLETE';operation.status='VERIFIED';operation.verification='PASSED';state.queryResults=[JSON.parse(JSON.stringify(persisted))];state.selectionKeys=[String(persisted.ClassificationId)];state.query.status='READY';state.verification={status:'PASSED',checks:[\"ClassificationCode\",\"ClassificationId\"]};return {state:state,prompt:'Business classification created and independently verified.'};"
