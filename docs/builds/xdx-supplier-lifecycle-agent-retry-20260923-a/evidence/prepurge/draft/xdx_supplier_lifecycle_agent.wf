            "description": "Captures generated supplier keys or marks the result unknown before any retry.",
            "returnType": "object",
            "sourceCode": "var prepared = $context.$nodes.PREPARE_SUPPLIER_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(prepared.state));\nvar operation = state.operations[state.operations.length - 1];\nvar output = $context.$nodes.CREATE_SUPPLIER && $context.$nodes.CREATE_SUPPLIER.$output;\nif (!output || output.SupplierId === undefined || output.SupplierId === null || output.SupplierNumber === undefined || output.SupplierNumber === null || !output.Supplier) {\n  state.phase = 'UNKNOWN';\n  operation.status = 'UNKNOWN';\n  operation.responseIdentifiers = null;\n  state.verification = { status: 'RECONCILE_REQUIRED', checks: [] };\n  return { state: state, action: 'RETURN', prompt: 'The supplier create outcome is unknown. Reconcile by the exact approved supplier name before any retry; no additional create was scheduled.' };\n}\noperation.status = 'RETURNED';\noperation.responseIdentifiers = { SupplierId: String(output.SupplierId), SupplierNumber: String(output.SupplierNumber) };\nstate.selectedSupplier = { SupplierId: String(output.SupplierId), SupplierNumber: String(output.SupplierNumber), Supplier: String(output.Supplier) };\nstate.phase = 'VERIFYING';\nstate.query = { kind: 'SUPPLIER_NAME', term: operation.payload.Supplier, filter: \"Supplier='\" + String(operation.payload.Supplier).replace(/'/g, \"''\") + \"'\", parentId: '', targetKind: '', limit: 2, offset: 0, hasMore: false, status: 'PENDING', resource: 'suppliers' };\nstate.verification = { status: 'PENDING', checks: [] };\nreturn { state: state, action: 'VERIFY', prompt: '' };"
          },
