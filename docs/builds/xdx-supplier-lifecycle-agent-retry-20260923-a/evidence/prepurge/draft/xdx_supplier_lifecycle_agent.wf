        {
          "id": "851",
          "code": "COMPARE_SITE_VERIFICATION",
          "type": "CODE",
          "metadata": {
            "name": "Compare Persisted Supplier Site",
            "description": "Compares the approved site fields and generated key with the independent GET.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) { if (value === undefined || value === null) return ''; return String(value).replace(/[\\u0000-\\u001F\\u007F|]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max); }\nvar normalized = $context.$nodes.NORMALIZE_SITE_CREATE.$output.result;\nvar state = JSON.parse(JSON.stringify(normalized.state));\nvar operation = state.operations[state.operations.length - 1];\nvar output = $context.$nodes.VERIFY_CREATED_SITE && $context.$nodes.VERIFY_CREATED_SITE.$output;\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN'; operation.status = 'VERIFY_UNKNOWN'; state.verification = { status: 'RECONCILE_REQUIRED', checks: [] };\n  return { state: state, prompt: 'The create returned a site identifier, but the independent parent-scoped GET failed. Reconcile before any retry.' };\n}\nvar matches = output.items.filter(function (item) {\n  return clean(item.SupplierSite, 240) === clean(operation.payload.SupplierSite, 240) && String(item.ProcurementBUId) === String(operation.payload.ProcurementBUId) && clean(item.SupplierAddressName, 240) === clean(operation.payload.SupplierAddressName, 240) && String(item.SitePurposePurchasingFlag).toLowerCase() === String(operation.payload.SitePurposePurchasingFlag).toLowerCase() && String(item.SupplierSiteId) === operation.responseIdentifiers.SupplierSiteId;\n});\nif (matches.length !== 1) {\n  state.phase = 'PARTIAL'; operation.status = 'VERIFY_MISMATCH'; state.verification = { status: 'MISMATCH', checks: ['SupplierSite', 'ProcurementBUId', 'SupplierAddressName', 'SitePurposePurchasingFlag', 'SupplierSiteId'] };\n  return { state: state, prompt: 'The independent site GET did not match every intended field, relationship and generated key. Reconcile before continuing.' };\n}\nvar persisted = matches[0];\nstate.phase = 'COMPLETE'; operation.status = 'VERIFIED'; operation.verification = 'PASSED'; state.queryResults = [JSON.parse(JSON.stringify(persisted))]; state.selectionKeys = [String(persisted.SupplierSiteId)]; state.query.status = 'READY'; state.verification = { status: 'PASSED', checks: ['SupplierSite', 'ProcurementBUId', 'SupplierAddressName', 'SitePurposePurchasingFlag', 'SupplierSiteId'] };\nreturn { state: state, prompt: 'Supplier site created and independently verified.\\nField | Value\\n--- | ---\\nSupplier | ' + clean(state.selectedSupplier.Supplier, 360) + ' (' + clean(state.selectedSupplier.SupplierNumber, 80) + ')\\nSite | ' + clean(persisted.SupplierSite, 240) + '\\nProcurement BU | ' + clean(persisted.ProcurementBU, 240) + ' (' + clean(persisted.ProcurementBUId, 80) + ')\\nAddress | ' + clean(persisted.SupplierAddressName, 240) + '\\nPurchasing purpose | ' + clean(persisted.SitePurposePurchasingFlag, 20) + '\\nVerification | Exact approved fields, relationships and generated site key matched.' };"
