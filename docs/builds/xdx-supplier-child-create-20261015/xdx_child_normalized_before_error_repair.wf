                    "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),dispatch=state.siteDispatch||{},attempt=(state.attempts||[]).filter(function(a){return a.kind==='site'&&a.requestId===dispatch.requestId&&a.revision===dispatch.revision;})[0];function done(op){state.nextOperation=op;return {state:state,operation:op};}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}function stop(message){dispatch.moreAssignments=false;if(attempt)attempt.status='assignments-incomplete';if(state.draft&&attempt&&state.draft.requestId===attempt.requestId)state.draft.status='assignments-incomplete';state.response={message:message,requestId:attempt&&attempt.requestId,revision:attempt&&attempt.revision,SupplierSiteId:attempt&&attempt.SupplierSiteId,site:attempt&&attempt.site,attempt:attempt};return done('display');}\nconst row=attempt&&attempt.assignments[dispatch.assignmentIndex],r=$context.$nodes.XDX_CREATE_SITE_ASSIGNMENTS.XDX_CREATE_ASSIGNMENT_ONCE.$output;if(!row||row.status!=='reserved')return stop('Site created; assignments incomplete. The current assignment response could not be matched to a reservation. No further write is permitted.');const id=r&&decimal(r.AssignmentId);if(!id){row.status='uncertain';return stop('Site created; assignments incomplete. The assignment response did not establish its generated ID. It will not be replayed; reconcile before continuing.');}row.status='accepted';row.AssignmentId=id;row.verification='pending';dispatch.AssignmentId=id;return done('assignment_verify');",
