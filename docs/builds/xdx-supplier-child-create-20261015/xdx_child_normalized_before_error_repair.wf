        {
          "id": "23",
          "code": "XDX_ACCEPT_CREATE_VERIFICATION",
          "type": "CODE",
          "metadata": {
            "name": "XDX Accept Create Verification",
            "returnType": "object",
            "sourceCode": "const response=$context.$nodes.XDX_VERIFY_CREATED_SUPPLIER.$output;\nconst state=JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst pending=state.pending||{};\nconst attempt=state.attempts.filter(function(a){return a.requestId===pending.requestId && a.revision===pending.revision;})[0];\nif(!attempt || attempt.status!=='accepted')throw new Error('No accepted supplier attempt matches verification');\nconst fields=['Supplier','SupplierType','BusinessRelationship','TaxOrganizationType'];\nconst matches=response && response.SupplierId===attempt.SupplierId && typeof response.SupplierNumber==='string' && fields.every(function(k){return response[k]===attempt.payload[k];});\nattempt.verification=matches?'verified':'mismatch-or-unavailable';\nif(!matches){state.response={message:'The supplier was created, but its saved details could not be verified against every requested field. It will not be created again.',requestId:attempt.requestId,revision:attempt.revision,SupplierId:attempt.SupplierId,SupplierNumber:attempt.SupplierNumber,expected:attempt.payload};return {state:state};}\nattempt.SupplierNumber=response.SupplierNumber;state.selection=JSON.parse(JSON.stringify(response));state.draft=null;delete state.dispatch;\nstate.response={message:'Supplier created and independently verified.',supplier:state.selection,requestId:attempt.requestId,revision:attempt.revision,verification:'verified'};return {state:state};\r\n",
            "errorNodeId": "26"
          },
