            "name": "XDX Handle Create Error",
            "returnType": "object",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst dispatch=state.dispatch;\nconst attempt=dispatch && state.attempts.filter(function(a){return a.requestId===dispatch.requestId && a.revision===dispatch.revision;})[0];\nif(attempt && attempt.status==='reserved')attempt.status='uncertain';\nif(state.draft && attempt && state.draft.requestId===attempt.requestId)state.draft.status=attempt.status;\nstate.response={message:'The creation request failed or its outcome is uncertain. It will not be submitted again automatically. Reconcile the supplier before another write.',requestId:attempt&&attempt.requestId,revision:attempt&&attempt.revision};return {state:state};\r\n"
