patch.moreAssignments?'assignments-pending':'complete';if(state.draft&&state.draft.requestId===attempt.requestId)state.draft.status=attempt.status;state.nextOperation=dispatch.moreAssignments?'site_assignments_create':'display';state.response={message:dispatch.moreAssignments?'Site created and independently verified. Assignment creation is pending.':'Site created and independently verified. No source assignments were required.',attempt:attempt,site:attempt.site,SupplierSiteId:attempt.SupplierSiteId,requestId:attempt.requestId,revision:attempt.revision};return {state:state,operation:state.nextOperation};",
