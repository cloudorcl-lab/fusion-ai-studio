          "code": "XDX_VERIFY_CHILD_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "XDX VERIFY CHILD RESULT",
            "returnType": "object",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),p=state.childDispatch||{},a=state.attempts.filter(function(a){return a.kind===p.kind&&a.requestId===p.requestId&&a.revision===p.revision;})[0],address=p.kind==='address',key=address?'SupplierAddressId':'SupplierContactId',r=$context.$nodes[address?'XDX_GET_CREATED_ADDRESS':'XDX_GET_CREATED_CONTACT'].$output;\n if(!a||a.status!=='accepted')throw new Error('No matching accepted child attempt exists.');\n function decimal(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0?String(v):typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}\n const fields=address?['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email','AddressPurposeOrderingFlag']:['FirstName','LastName','Email'];\n const generatedMatch=r&&(address?(a.AddressPartyNumber===undefined||String(r.AddressPartyNumber)===String(a.AddressPartyNumber)):(a.PersonProfileId===undefined||decimal(r.PersonProfileId)===decimal(a.PersonProfileId)));\n const matches=generatedMatch&&r&&decimal(r[key])===a[key]&&String(a.suppliers_Id)===String(p.suppliers_Id)&&fields.every(function(f){return r[f]===a.payload[f];})&&(address||Object.prototype.hasOwnProperty.call(r,'PersonProfileId')&&!!decimal(r.PersonProfileId)&&Object.prototype.hasOwnProperty.call(r,'UserName')&&r.UserName===null&&Object.prototype.hasOwnProperty.call(r,'UserAccountStatus')&&r.UserAccountStatus===null);\n a.verification=matches?'verified':'mismatch-or-unavailable';state.nextOperation='display';state.response={message:matches?(address?'Address':'Contact')+' created and independently verified.':'The '+p.kind+' was created, but its saved required fields or relationships could not be verified. It will not be created again.',kind:p.kind,requestId:a.requestId,revision:a.revision,supplier:state.draft&&state.draft.supplier,attempt:JSON.parse(JSON.stringify(a)),verification:a.verification};\n if(matches){state.response.item=JSON.parse(JSON.stringify(r));const resource=address?'addresses':'contacts';state.childSelections=state.childSelections||{};state.childSelections[resource]={suppliers_Id:p.suppliers_Id,item:JSON.parse(JSON.stringify(r))};state.draft=null;delete state.childDispatch;}return {state:state,operation:'display'};",
            "errorNodeId": "164"
          },
