          "code": "XDX_PREPARE_SITE_SOURCE",
          "type": "CODE",
          "metadata": {
            "name": "XDX PREPARE SITE SOURCE",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function literal(v){return \"'\"+v.replace(/'/g,\"''\")+\"'\";}const request=state.pending||{},r=request.siteRequest||{},supplier=state.selection;if(state.draft)return done('display','A draft already exists. Edit or cancel it before starting another.');if(!supplier||!key(supplier.SupplierId)||String(supplier.SupplierId)!==request.suppliers_Id)return done('display','Choose the supplier whose site you want to copy.');const name=request.newName;if(typeof name!=='string'||!name.trim()||name.length>240||/[\\x00-\\x1f]/.test(name))return done('display','What name should the new site have? Use up to 240 characters.');const p={supplier:JSON.parse(JSON.stringify(supplier)),suppliers_Id:request.suppliers_Id,newName:name,limit:25,offset:0,assignments:[],assignmentsComplete:false};state.sitePreparation=p;const mode=r.mode,term=typeof r.term==='string'?r.term.trim():'';if(mode==='selection'){const selected=state.childSelections&&state.childSelections.sites;if(!selected||selected.suppliers_Id!==p.suppliers_Id||!selected.item||!key(selected.item.SupplierSiteId))return done('display','Select a source site under this supplier first.');p.siteId=String(selected.item.SupplierSiteId);return done('site_source_get');}if(mode==='id'){if(!/^[1-9][0-9]{0,17}$/.test(term))return done('display','Supply the source site ID under this supplier.');p.siteId=term;return done('site_source_get');}if(['exact','contains'].indexOf(mode)<0||!term||term.length>240||/[\\x00-\\x1f]/.test(term)||mode==='contains'&&/[%_\\\\]/.test(term))return done('display','Supply an exact source site name or a simple name to search.');p.q='SupplierSite'+(mode==='exact'?'=':' like ')+literal(mode==='exact'?term:'%'+term+'%');return done('site_source_list');",
            "returnType": "object"
          },
