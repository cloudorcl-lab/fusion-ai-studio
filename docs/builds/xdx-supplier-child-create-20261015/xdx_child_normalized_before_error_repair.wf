            "sourceCode": "const response=$context.$nodes.XDX_LIST_SUPPLIER_CONTACTS.$output;const state=JSON.parse(JSON.stringify($context.$variables.supplierState));const p=state.childPending||{};state.nextOperation='display';\nfunction fail(){state.response={message:'The contacts response could not be verified. Your draft is unchanged.'};return {state:state,operation:'display'};}\nfunction valid(row){return row&&Number.isSafeInteger(row.SupplierContactId)&&row.SupplierContactId>0&&typeof row.Status==='string';}\nif(!response||!Array.isArray(response.items)||!Number.isSafeInteger(response.count)||response.count!==response.items.length||response.count>p.limit||response.limit!==p.limit||response.offset!==p.offset||typeof response.hasMore!=='boolean'||response.hasMore&&response.count===0)return fail();const seen={};if(response.items.some(function(row){if(!valid(row)||seen[row.SupplierContactId])return true;seen[row.SupplierContactId]=true;return false;}))return fail();const rows=response.items.filter(function(row){return p.includeInactive||row.Status==='ACTIVE';});state.childSearches=state.childSearches||{};state.childSearches.contacts={resource:'contacts',suppliers_Id:p.suppliers_Id,supplier:p.supplier,q:p.q,limit:p.limit,offset:p.offset,nextOffset:p.offset+response.count,hasMore:response.hasMore,includeInactive:p.includeInactive};state.childCandidates=state.childCandidates||{};state.childCandidates.contacts={suppliers_Id:p.suppliers_Id,items:rows};state.childSelections=state.childSelections||{};delete state.childSelections.contacts;if(rows.length===1&&!response.hasMore)state.childSelections.contacts={suppliers_Id:p.suppliers_Id,item:rows[0]};state.response={message:rows.length?'Supplier contacts.':'No matching contacts on this page.',resource:'contacts',supplier:p.supplier,items:rows,hasMore:response.hasMore,nextCommand:response.hasMore?'Next contacts page':'',returnedCount:rows.length};\nstate.activeRead='contacts';return {state:state,operation:'display'};",
