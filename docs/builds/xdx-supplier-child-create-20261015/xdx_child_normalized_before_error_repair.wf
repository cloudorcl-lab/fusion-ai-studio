            "sourceCode": "const childPhase=$context.$variables.supplierState.nextOperation;\nif([\"child_build\"].indexOf(childPhase)<0)return {state:JSON.parse(JSON.stringify($context.$variables.supplierState)),operation:childPhase};\nconst state=JSON.parse(JSON.stringify($context.$variables.supplierState)),p=state.childPreparation||{},address=p.kind==='address',fields=address?['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email']:['FirstName','LastName','Email'];\n function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}\n if(['address','contact'].indexOf(p.kind)<0||!p.supplier||String(p.supplier.SupplierId)!==p.suppliers_Id||state.draft)return done('display','The child draft could not be initialized. Existing requests remain unchanged.');\n if(p.mode==='template'&&(!p.source||p.sourceParentId!==p.suppliers_Id||!p.sourceId))return done('display','The template must be verified under the selected supplier.');\n const payload={};fields.forEach(function(f){payload[f]=p.mode==='template'&&p.source&&typeof p.source[f]==='string'?p.source[f]:null;});if(address)payload.AddressName=null;\n const patch=p.patch||{};if(Object.keys(patch).some(function(f){return fields.indexOf(f)<0;}))return done('display','Only the required child creation fields may be supplied.');Object.keys(patch).forEach(function(f){if(patch[f]!==null)payload[f]=patch[f];});if(address)payload.AddressPurposeOrderingFlag=true;\n const conversation=$context.$workflow&&$context.$workflow.$conversationId,sequence=state.nextRequestSequence,requestId='REQ-'+conversation+'-'+sequence;\n if(typeof conversation!=='string'||!/^[A-Za-z0-9_-]+$/.test(conversation)||requestId.length>96||!Number.isSafeInteger(sequence)||sequence<1||sequence>=9007199254740991)return done('display','A unique child draft request could not be initialized.');\n const draft={kind:p.kind,mode:p.mode,requestId:requestId,revision:1,status:'editing',suppliers_Id:p.suppliers_Id,supplier:p.supplier,payload:payload,source:p.source||null,sourceId:p.sourceId||null,sourceParentId:p.sourceParentId||null};\n state.draft=draft;state.nextRequestSequence=sequence+1;delete state.childPreparation;state.nextOperation='child_validate';state.response={message:'A proposed '+draft.kind+' draft is ready for required-field validation. Nothing has been created.',kind:draft.kind,mode:draft.mode,supplier:draft.supplier,payload:payload,requestId:requestId,revision:1};return {state:state,operation:'child_validate'};"
