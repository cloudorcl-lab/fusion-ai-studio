            "name": "XDX ACCEPT ADDRESS NAME CHECK",
            "returnType": "object",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),d=state.draft,p=state.childNameCheck||{},r=$context.$nodes.XDX_CHECK_NEW_ADDRESS_NAME.$output;\n function done(op,message){state.nextOperation=op;state.response={message:message,kind:d&&d.kind,mode:d&&d.mode,supplier:d&&d.supplier,payload:d&&d.payload,requestId:d&&d.requestId,revision:d&&d.revision,source:d&&d.source};if(d){state.response.reviewCommand='Review request '+d.requestId+' revision '+d.revision;state.response.cancelCommand='Cancel request '+d.requestId+' revision '+d.revision;}return {state:state,operation:op,requestId:d&&d.requestId,revision:d&&d.revision};}\n if(!d||d.kind!=='address'||d.requestId!==p.requestId||d.revision!==p.revision||d.suppliers_Id!==p.suppliers_Id||d.payload.AddressName!==p.name)return done('display','The address changed during its name check. Review the current draft.');\n if(!r||!Array.isArray(r.items)||r.count!==r.items.length||typeof r.hasMore!=='boolean'||r.limit!==p.limit||r.offset!==p.offset||r.items.length||r.hasMore){delete d.duplicateCheckedRevision;delete state.childConfirmation;return done('display',r&&Array.isArray(r.items)&&(r.items.length||r.hasMore)?'That address name is already in use under this supplier. Choose a different name.':'The address-name check could not be verified. No create was submitted.');}\n d.duplicateCheckedRevision=d.revision;if(state.childConfirmation)return done('child_reserve','The exact reviewed address request is ready to reserve.');return done('display','Address draft prepared. Nothing has been created. Review the current revision before confirming.');"
