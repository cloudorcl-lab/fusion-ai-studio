          "inputs": [
            {
              "id": "4_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You render the fixed opening of the Supplier Workspace. Follow the output instruction exactly."
            },
            {
              "id": "4_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate exactly one oraInfoDisplay element with key supplierWelcome. Its JSON must have patternId cardWidget and properties with subject Supplier Workspace and summary exactly: Get started by searching for a supplier. Just say: “Find a supplier like Dell.” Return the raw element without markdown fences or additional text. Do not look up supplier data or add actions."
            }
          ],
          "diagram": {
            "x": 7177.5,
            "y": 5650
          },
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_CARD"
              ],
              "enableActions": false,
              "enableCommunications": false,
              "customNotes": "Render only the fixed getting-started supplier guidance in one cardWidget."
            }
          }
        },
        {
          "id": "1",
          "code": "XDX_PARSE_CONTROL",
          "type": "CODE",
          "metadata": {
            "name": "XDX Parse Control",
            "sourceCode": "const raw = $context.$system.$inputMessage;\nif (typeof raw !== 'string' || raw.length > 4000 || !raw.trim()) return {kind:'invalid',canExecute:false};\nconst message = raw.trim();\nconst match = /^(Review|Confirm|Cancel) request ([A-Za-z0-9][A-Za-z0-9_-]{0,95}) revision ([1-9][0-9]{0,15})$/.exec(message);\nif (match) {\n  const revision = Number(match[3]);\n  if (revision <= 9007199254740991) return {kind:'control',action:match[1].toLowerCase(),requestId:match[2],revision:revision,canExecute:false};\n}\nconst continuation=/^(?:Continue|Resume) (?:missing )?assignments(?: for request ([A-Za-z0-9][A-Za-z0-9_-]{0,95}))?$/i.exec(message);if(continuation)return {kind:'continuation',requestId:continuation[1]||null,canExecute:false};\nreturn {kind:'language',message:message,canExecute:false};",
            "returnType": "object"
          },
          "outcomes": {
            "success": "7"
          },
          "inputs": [],
          "diagram": {
            "x": 6727.5,
            "y": 5650
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "7",
          "code": "XDX_INIT_SUPPLIER_STATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX Initialize Supplier State",
            "returnType": "object",
            "sourceCode": "let state = $context.$variables && $context.$variables.supplierState;\nif (state === undefined || state === null || state === '') return {selection:null,draft:null,attempts:[],nextRequestSequence:1};\nif (typeof state === 'string') state = JSON.parse(state);\nif (!state || typeof state !== 'object' || Array.isArray(state) || !Array.isArray(state.attempts) || !Object.prototype.hasOwnProperty.call(state,'draft') || !Object.prototype.hasOwnProperty.call(state,'selection')) throw new Error('Conversation state is invalid; existing transaction history must not be reset.');\nreturn JSON.parse(JSON.stringify(state));"
          },
          "outcomes": {
            "success": "8"
          },
          "inputs": [],
          "diagram": {
            "x": 6727.5,
            "y": 5872
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "8",
          "code": "XDX_INITIALIZE_CONVERSATION",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "XDX Initialize Conversation"
          },
          "outcomes": {
            "success": "6"
          },
          "inputs": [
            {
              "id": "8_supplierState",
              "name": "supplierState",
              "value": "{{$context.$nodes.XDX_INIT_SUPPLIER_STATE.$output.result}}"
            }
          ],
          "diagram": {
            "x": 6727.5,
            "y": 6094
          }
        },
        {
          "id": "6",
          "code": "XDX_EVALUATE_CONTROL",
          "type": "CODE",
          "metadata": {
            "name": "XDX Evaluate Control",
            "sourceCode": "const command = $context.$nodes.XDX_PARSE_CONTROL.$output.result;\nconst original = $context.$variables && $context.$variables.supplierState;\nif (!original || typeof original !== 'object' || !Array.isArray(original.attempts)) return {operation:'display',state:original || null,reason:'Conversation state is not ready; no request can be submitted.'};\nconst state = JSON.parse(JSON.stringify(original));\nconst result = {operation:'display',state:state,reason:''};\nif(command&&command.kind==='continuation'){\n const matches=state.attempts.filter(function(a){return a.kind==='site'&&a.SupplierSiteId&&a.siteVerification==='verified'&&a.status!=='complete'&&(!command.requestId?!a.continuationOf:a.requestId===command.requestId);});\n if(matches.length!==1){result.reason='Specify the request ID for the incomplete site assignments. No new write was submitted.';return result;}\n const candidate=matches[0],originId=candidate.continuationOf||candidate.requestId,origin=state.attempts.filter(function(a){return a.requestId===originId&&a.kind==='site'&&!a.continuationOf;})[0];\n if(!origin){result.reason='The original site request could not be identified. No new write was submitted.';return result;}\n if(state.draft&&state.draft.requestId!==originId&&state.draft.kind!=='site_continuation'&&!state.attempts.some(function(a){return a.requestId===state.draft.requestId&&a.continuationOf===originId;})){result.reason='Finish or cancel the other draft before preparing this continuation.';return result;}\n if(state.draft&&state.draft.kind==='site_continuation'&&state.draft.originRequestId!==originId){result.reason='Finish or cancel the other continuation draft first.';return result;}\n state.continuationRequest={mode:'prepare',originRequestId:originId};result.operation='site_reconcile';result.reason='Checking the existing site and all existing assignment pairs before preparing a separate continuation.';return result;\n}\nif (!command || command.kind !== 'control') { result.operation = command && command.kind === 'language' ? 'language' : 'display'; return result; }\nconst draft = state.draft;\nconst attempt = state.attempts.filter(function(item){return item.requestId === command.requestId;});\nif (attempt.length) {if(['address','contact'].indexOf(attempt[0].kind)>=0)result.kind=attempt[0].kind;result.reason='This request already has a recorded attempt; it will not be submitted again.';result.attempts=attempt;return result;}\nif (!draft || draft.requestId !== command.requestId || draft.revision !== command.revision) {result.reason='That request or revision is not current. Review the current draft.';return result;}\nresult.requestId=draft.requestId;result.revision=draft.revision;\nif (draft.status !== 'editing' && draft.status !== 'reviewed') {result.reason='This draft cannot be changed or submitted in its current state.';return result;}\nif (command.action === 'cancel'&&draft.kind==='site_continuation'){state.draft=null;delete state.continuationRequest;result.reason='Continuation cancelled. The existing site and assignments remain unchanged; no additional assignment was submitted.';return result;}\nif (command.action === 'cancel') {state.draft=null;delete state.childConfirmation;result.reason='Draft cancelled. No '+(draft.kind||'supplier')+' was created.';return result;}\nif(draft.kind==='address'||draft.kind==='contact'){\n  const address=draft.kind==='address',fields=address?['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email','AddressPurposeOrderingFlag']:['FirstName','LastName','Email'],p=draft.payload;\n  if(!p||Object.keys(p).length!==fields.length||Object.keys(p).some(function(f){return fields.indexOf(f)<0;})||draft.fieldsVerifiedRevision!==draft.revision||address&&draft.duplicateCheckedRevision!==draft.revision||!draft.supplier||String(draft.supplier.SupplierId)!==draft.suppliers_Id||draft.mode==='template'&&(!draft.source||draft.sourceParentId!==draft.suppliers_Id||!draft.sourceId)){result.reason='Complete and validate the required child fields and parent before review.';return result;}\n  result.kind=draft.kind;result.mode=draft.mode;result.supplier=draft.supplier;result.payload=JSON.parse(JSON.stringify(p));result.source=draft.source;\n  if(command.action==='review'){draft.status='reviewed';draft.reviewedRevision=draft.revision;result.confirmCommand='Confirm request '+draft.requestId+' revision '+draft.revision;result.reason='Review this exact proposed '+draft.kind+' under the displayed supplier. Nothing has been created.';return result;}\n  if(command.action!=='confirm'||draft.status!=='reviewed'||draft.reviewedRevision!==draft.revision){result.reason='Review the current child revision before confirming.';return result;}\n  state.childConfirmation={kind:draft.kind,requestId:draft.requestId,revision:draft.revision,suppliers_Id:draft.suppliers_Id,payload:JSON.parse(JSON.stringify(p))};result.operation='child_preflight';result.reason='Rechecking the exact reviewed child request before reservation.';return result;\n }\nif(draft.kind==='site_continuation'){\n const pairs=draft.assignments,seen={};\n if(!draft.originRequestId||!draft.SupplierSiteId||!draft.suppliers_Id||draft.reconciled!==true||!Array.isArray(pairs)||!pairs.length||pairs.some(function(p){if(!p||Object.keys(p).length!==2||!Number.isSafeInteger(p.ClientBUId)||p.ClientBUId<=0||!Number.isSafeInteger(p.BillToBUId)||p.BillToBUId<=0)return true;const k=p.ClientBUId+':'+p.BillToBUId;if(seen[k])return true;seen[k]=true;return false;})){result.reason='Reconcile the site assignments again before reviewing a continuation.';return result;}\n if(command.action==='review'){draft.status='reviewed';draft.reviewedRevision=draft.revision;result.assignments=JSON.parse(JSON.stringify(pairs));result.site=draft.site;result.SupplierSiteId=draft.SupplierSiteId;result.writeCount=pairs.length;result.writeOrder='Create and independently verify only the missing assignment pairs, serially. The existing site is retained.';result.confirmCommand='Confirm request '+draft.requestId+' revision '+draft.revision;result.reason='Review this separate continuation for the missing assignments. No new write has been submitted.';return result;}\n if(command.action!=='confirm'||draft.status!=='reviewed'||draft.reviewedRevision!==draft.revision){result.reason='Review the current continuation revision before confirming.';return result;}\n state.continuationRequest={mode:'confirm',originRequestId:draft.originRequestId,requestId:draft.requestId,revision:draft.revision,assignments:JSON.parse(JSON.stringify(pairs))};result.operation='site_reconcile';result.reason='Rechecking existing assignments before reserving this missing-only continuation.';return result;\n}\nif(draft.kind==='site'){\n function siteKey(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}\n const p=draft.payload,fields=['SupplierSite','ProcurementBUId','SupplierAddressName','SitePurposePurchasingFlag'];\n const pairs=draft.assignments,seen={};\n if(!p||Object.keys(p).length!==4||Object.keys(p).some(function(k){return fields.indexOf(k)<0;})||typeof p.SupplierSite!=='string'||!p.SupplierSite.trim()||p.SupplierSite.length>240||/[\\x00-\\x1f]/.test(p.SupplierSite)||!siteKey(p.ProcurementBUId)||typeof p.SupplierAddressName!=='string'||!p.SupplierAddressName.trim()||p.SupplierAddressName.length>240||p.SitePurposePurchasingFlag!==true||!draft.supplier||!siteKey(draft.supplier.SupplierId)||!draft.source||!siteKey(draft.source.SupplierSiteId)||draft.source.Status!=='ACTIVE'||draft.source.ProcurementBUId!==p.ProcurementBUId||draft.source.SitePurposePurchasingFlag!==true||!draft.address||draft.address.Status!=='ACTIVE'||draft.address.SupplierAddressId!==draft.source.SupplierAddressId||draft.address.AddressName!==p.SupplierAddressName||draft.source.SupplierAddressName!==p.SupplierAddressName||draft.assignmentsComplete!==true||draft.eligibilityVerified!==true||draft.duplicateCheckedRevision!==draft.revision||!Array.isArray(pairs)||pairs.some(function(pair){if(!pair||Object.keys(pair).length!==2||!siteKey(pair.ClientBUId)||!siteKey(pair.BillToBUId))return true;const key=pair.ClientBUId+':'+pair.BillToBUId;if(seen[key])return true;seen[key]=true;return false;})){\n result.reason='The site draft needs verified source/address/assignment pairs and a current name check before review.';return result;\n }\n if(command.action==='review'){\n draft.status='reviewed';draft.reviewedRevision=draft.revision;result.payload=JSON.parse(JSON.stringify(p));result.source=JSON.parse(JSON.stringify(draft.source));result.supplier=draft.supplier;result.address=draft.address;result.assignments=JSON.parse(JSON.stringify(pairs));result.writeCount=1+pairs.length;result.writeOrder='Create site, independently verify it, then create and verify each assignment serially.';result.confirmCommand='Confirm request '+draft.requestId+' revision '+draft.revision;result.reason='Review the proposed site and exact assignments. Nothing has been created.';return result;\n }\n if(command.action!=='confirm'||draft.status!=='reviewed'||draft.reviewedRevision!==draft.revision){result.reason='Review the current site revision before confirming it.';return result;}\n state.siteConfirmation={requestId:draft.requestId,revision:draft.revision,payload:JSON.parse(JSON.stringify(p)),assignments:JSON.parse(JSON.stringify(pairs)),suppliers_Id:String(draft.supplier.SupplierId),sourceSiteId:String(draft.source.SupplierSiteId),addressId:String(draft.address.SupplierAddressId)};\n result.operation='site_preflight';result.reason='Rechecking the reviewed site source, address, assignments and name before reserving creation.';return result;\n}\r\n\nconst fields=['Supplier','SupplierType','BusinessRelationship','TaxOrganizationType'];\nconst payload=draft.payload;\nconst keys=payload && typeof payload==='object' && !Array.isArray(payload) ? Object.keys(payload) : [];\nif (draft.classificationsVerified!==true || draft.kind!=='supplier' || !draft.source || ['ACTIVE','INACTIVE'].indexOf(draft.source.Status)<0 || !draft.source.SupplierId || keys.length!==fields.length || keys.some(function(key){return fields.indexOf(key)<0;}) || fields.some(function(key){return typeof payload[key]!=='string' || !payload[key].trim() || payload[key].length>(key==='Supplier'?360:80);}) || draft.duplicateCheckedRevision!==draft.revision) {result.reason='The draft needs a verified source, all approved fields, and a current duplicate-name check before review.';return result;}\nif (command.action==='review') {draft.status='reviewed';draft.reviewedRevision=draft.revision;result.payload=JSON.parse(JSON.stringify(payload));result.source=JSON.parse(JSON.stringify(draft.source));result.confirmCommand='Confirm request '+draft.requestId+' revision '+draft.revision;result.reason='Review the proposed supplier. Nothing has been created.';return result;}\nif (command.action!=='confirm' || draft.status!=='reviewed' || draft.reviewedRevision!==draft.revision) {result.reason='Review the current revision before confirming it.';return result;}\nconst frozen={requestId:draft.requestId,revision:draft.revision,kind:'supplier',status:'reserved',sourceSupplierId:draft.source.SupplierId,payload:JSON.parse(JSON.stringify(payload))};\nstate.attempts.push(frozen);draft.status='reserved';result.operation='create_supplier';result.attempt=JSON.parse(JSON.stringify(frozen));result.reason='Request reserved; persist this state before dispatch.';\nreturn result;\r\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "18"
          },
          "inputs": [],
          "diagram": {
            "x": 6727.5,
            "y": 6316
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "18",
          "code": "XDX_PRESENT_CONTROL_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "XDX Present Control Result",
            "sourceCode": "const evaluation=$context.$nodes.XDX_EVALUATE_CONTROL.$output.result;\nconst state=JSON.parse(JSON.stringify(evaluation.state));\nstate.nextOperation=evaluation.operation;\nstate.response={message:evaluation.reason||'Describe a supplier search or draft change.'};\n['kind','mode','requestId','revision','payload','source','confirmCommand','attempts','supplier','address','assignments','writeCount','writeOrder','site','SupplierSiteId','continuationCommand'].forEach(function(k){if(Object.prototype.hasOwnProperty.call(evaluation,k))state.response[k]=evaluation[k];});\nif(Array.isArray(state.response.attempts))state.response.attempts=state.response.attempts.map(function(attempt){const shown=JSON.parse(JSON.stringify(attempt));if(shown.kind==='supplier')delete shown.sourceSupplierId;return shown;});\nif(evaluation.operation==='create_supplier')state.dispatch=JSON.parse(JSON.stringify(evaluation.attempt));\nreturn {operation:evaluation.operation,state:state};\r\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "9"
          },
          "inputs": [],
