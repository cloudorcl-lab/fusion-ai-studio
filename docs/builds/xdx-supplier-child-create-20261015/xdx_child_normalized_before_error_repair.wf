          "type": "CODE",
          "metadata": {
            "name": "XDX ACCEPT GET SITES",
            "sourceCode": "const response=$context.$nodes.XDX_GET_SUPPLIER_SITES.$output;const state=JSON.parse(JSON.stringify($context.$variables.supplierState));const p=state.childPending||{};state.nextOperation='display';\nfunction fail(){state.response={message:'The sites response could not be verified. Your draft is unchanged.'};return {state:state,operation:'display'};}\nfunction valid(row){return row&&Number.isSafeInteger(row.SupplierSiteId)&&row.SupplierSiteId>0&&typeof row.Status==='string';}\nif(!valid(response)||String(response.SupplierSiteId)!==p.itemId)return fail();if(!p.includeInactive&&response.Status!=='ACTIVE'){state.response={message:'This site is inactive. Ask explicitly to view inactive records.'};return {state:state,operation:'display'};}state.childSelections=state.childSelections||{};state.childSelections.sites={suppliers_Id:p.suppliers_Id,item:response};state.response={message:'Supplier site details.',resource:'sites',supplier:p.supplier,item:response};\nstate.activeRead='sites';return {state:state,operation:'display'};",
