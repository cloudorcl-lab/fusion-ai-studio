            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function copy(v){return JSON.parse(JSON.stringify(v));}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}\nconst p=state.continuationPreparation,origin=state.attempts.filter(function(a){return a.requestId===p.originRequestId;})[0],r=$context.$nodes.XDX_READ_CONTINUATION_SITE.$output,b=origin.payload;if(!r||decimal(r.SupplierSiteId)!==p.SupplierSiteId||r.SupplierSite!==b.SupplierSite||decimal(r.ProcurementBUId)!==String(b.ProcurementBUId)||r.SupplierAddressName!==b.SupplierAddressName||r.SitePurposePurchasingFlag!==true||decimal(r.SupplierAddressId)!==origin.addressId)return done('display','The existing site no longer matches the verified request. No continuation was submitted.');p.site={SupplierSiteId:p.SupplierSiteId,SupplierSite:r.SupplierSite,ProcurementBUId:b.ProcurementBUId,SupplierAddressName:r.SupplierAddressName,SupplierAddressId:origin.addressId,SitePurposePurchasingFlag:true};p.paging=true;return done('continuation_pairs');"
