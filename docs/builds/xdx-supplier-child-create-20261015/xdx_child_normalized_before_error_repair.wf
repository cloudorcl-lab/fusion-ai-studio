          "type": "CODE",
          "metadata": {
            "name": "XDX RECHECK SITE REVIEW",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function copy(v){return JSON.parse(JSON.stringify(v));}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}\nconst c=state.siteConfirmation,draft=state.draft;if(!c||!draft||draft.kind!=='site'||draft.status!=='reviewed'||draft.requestId!==c.requestId||draft.revision!==c.revision||draft.reviewedRevision!==c.revision||!Array.isArray(state.attempts)||state.attempts.some(function(a){return a.requestId===c.requestId;}))return done('display','Review the current site draft before confirming; a recorded attempt cannot be submitted again.');if(String(draft.supplier.SupplierId)!==c.suppliers_Id||String(draft.source.SupplierSiteId)!==c.sourceSiteId||String(draft.address.SupplierAddressId)!==c.addressId||JSON.stringify(draft.payload)!==JSON.stringify(c.payload)||JSON.stringify(draft.assignments)!==JSON.stringify(c.assignments))return done('display','The site draft changed after review. Review its current revision.');state.sitePreparation={mode:'confirm',confirmation:copy(c),supplier:copy(draft.supplier),suppliers_Id:c.suppliers_Id,siteId:c.sourceSiteId,newName:c.payload.SupplierSite,assignments:[],assignmentsComplete:false,limit:25,offset:0};return done('site_source_get');",
