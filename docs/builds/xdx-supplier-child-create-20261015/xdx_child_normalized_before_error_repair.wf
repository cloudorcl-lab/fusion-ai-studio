                    "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),dispatch=state.siteDispatch||{},attempt=(state.attempts||[]).filter(function(a){return a.kind==='site'&&a.requestId===dispatch.requestId&&a.revision===dispatch.revision;})[0];function done(op){state.nextOperation=op;return {state:state,operation:op};}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}function stop(message){dispatch.moreAssignments=false;if(attempt)attempt.status='assignments-incomplete';if(state.draft&&attempt&&state.draft.requestId===attempt.requestId)state.draft.status='assignments-incomplete';state.response={message:message,requestId:attempt&&attempt.requestId,revision:attempt&&attempt.revision,SupplierSiteId:attempt&&attempt.SupplierSiteId,site:attempt&&attempt.site,attempt:attempt};return done('display');}\nconst row=attempt&&attempt.assignments[dispatch.assignmentIndex],r=$context.$nodes.XDX_CREATE_SITE_ASSIGNMENTS.XDX_VERIFY_CREATED_ASSIGNMENT.$output;if(!row||row.status!=='accepted')return stop('Site created; assignments incomplete. Assignment verification did not match its recorded attempt.');const good=r&&decimal(r.AssignmentId)===row.AssignmentId&&decimal(r.ClientBUId)===String(row.payload.ClientBUId)&&decimal(r.BillToBUId)===String(row.payload.BillToBUId);row.verification=good?'verified':'mismatch';if(!good)return stop('Site created; assignments incomplete. The accepted assignment did not match both reviewed BU values on independent readback. No further assignment was submitted.');row.status='verified';dispatch.assignmentIndex++;dispatch.moreAssignments=dispatch.assignmentIndex<attempt.assignments.length;attempt.status=dispatch.moreAssignments?'assignments-pending':'complete';if(state.draft&&state.draft.requestId===attempt.requestId)state.draft.status=attempt.status;return done(dispatch.moreAssignments?'assignment_next':'display');",
