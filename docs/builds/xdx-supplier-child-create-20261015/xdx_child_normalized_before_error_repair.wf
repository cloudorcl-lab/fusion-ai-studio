            "sourceCode": "const response=$context.$nodes.XDX_GET_SUPPLIER_ADDRESSES.$output;const state=JSON.parse(JSON.stringify($context.$variables.supplierState));const p=state.childPending||{};state.nextOperation='display';\nfunction fail(){state.response={message:'The addresses response could not be verified. Your draft is unchanged.'};return {state:state,operation:'display'};}\nfunction valid(row){return row&&Number.isSafeInteger(row.SupplierAddressId)&&row.SupplierAddressId>0&&typeof row.Status==='string';}\nif(!valid(response)||String(response.SupplierAddressId)!==p.itemId)return fail();if(!p.includeInactive&&response.Status!=='ACTIVE'){state.response={message:'This address is inactive. Ask explicitly to view inactive records.'};return {state:state,operation:'display'};}state.childSelections=state.childSelections||{};state.childSelections.addresses={suppliers_Id:p.suppliers_Id,item:response};state.response={message:'Supplier address details.',resource:'addresses',supplier:p.supplier,item:response};\nstate.activeRead='addresses';return {state:state,operation:'display'};",
