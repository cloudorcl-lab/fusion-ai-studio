            "sourceCode": "const childPhase=$context.$variables.supplierState.nextOperation;\nif([\"child_reserve\"].indexOf(childPhase)<0)return {state:JSON.parse(JSON.stringify($context.$variables.supplierState)),operation:childPhase};\nconst state=JSON.parse(JSON.stringify($context.$variables.supplierState)),d=state.draft,c=state.childConfirmation;\n function stop(message){state.nextOperation='display';state.response={message:message};delete state.childConfirmation;return {state:state,operation:'display'};}\n if(!d||!c||['address','contact'].indexOf(d.kind)<0||d.status!=='reviewed'||d.requestId!==c.requestId||d.revision!==c.revision||d.reviewedRevision!==c.revision||d.fieldsVerifiedRevision!==d.revision||d.kind!==c.kind||d.suppliers_Id!==c.suppliers_Id||JSON.stringify(d.payload)!==JSON.stringify(c.payload)||d.kind==='address'&&d.duplicateCheckedRevision!==d.revision||state.attempts.some(function(a){return a.requestId===d.requestId||a.kind===d.kind&&a.suppliers_Id===d.suppliers_Id&&JSON.stringify(a.payload)===JSON.stringify(d.payload);}))return stop('The reviewed child request is no longer eligible. Review the current draft; recorded attempts are never replayed.');\n const attempt={kind:d.kind,mode:d.mode,requestId:d.requestId,revision:d.revision,status:'reserved',suppliers_Id:d.suppliers_Id,payload:JSON.parse(JSON.stringify(d.payload)),sourceId:d.sourceId||null,verification:'pending'};state.attempts.push(attempt);d.status='reserved';state.childDispatch=JSON.parse(JSON.stringify(attempt));delete state.childConfirmation;state.nextOperation='create_'+d.kind;state.response={message:'The reviewed '+d.kind+' request is reserved for one creation attempt.',kind:d.kind,requestId:d.requestId,revision:d.revision};return {state:state,operation:state.nextOperation};"
