        {
          "id": "22",
          "code": "XDX_ACCEPT_CREATE_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "XDX Accept Create Result",
            "returnType": "object",
            "sourceCode": "const response=$context.$nodes.XDX_CREATE_SUPPLIER_ONCE.$output;\nconst state=JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst dispatch=state.dispatch;\nconst attempt=dispatch && state.attempts.filter(function(a){return a.requestId===dispatch.requestId && a.revision===dispatch.revision;})[0];\nif(!attempt || attempt.status!=='reserved')throw new Error('No reserved supplier attempt matches this result');\nconst result={operation:'display',state:state};\nif(!response || typeof response.SupplierId!=='number' || !Number.isSafeInteger(response.SupplierId) || response.SupplierId<=0){attempt.status='uncertain';if(state.draft)state.draft.status='uncertain';state.response={message:'The creation outcome is uncertain. This request will not be submitted again. Reconcile the supplier before taking another action.',requestId:attempt.requestId,revision:attempt.revision};return result;}\nattempt.status='accepted';attempt.SupplierId=response.SupplierId;attempt.SupplierNumber=typeof response.SupplierNumber==='string'?response.SupplierNumber:null;attempt.verification='pending';\nif(state.draft)state.draft.status='accepted';\nstate.pending={purpose:'verify_created',suppliers_Id:String(response.SupplierId),requestId:attempt.requestId,revision:attempt.revision};\nstate.response={message:'The supplier was accepted. Checking the saved fields.',requestId:attempt.requestId,revision:attempt.revision,SupplierId:attempt.SupplierId,SupplierNumber:attempt.SupplierNumber};result.operation='verify';return result;\r\n",
            "errorNodeId": "24"
          },
          "outcomes": {
            "success": "31"
          },
