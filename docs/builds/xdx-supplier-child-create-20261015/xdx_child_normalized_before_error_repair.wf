          "code": "XDX_ACCEPT_CHILD_SOURCE",
          "type": "CODE",
          "metadata": {
            "name": "XDX ACCEPT CHILD SOURCE",
            "returnType": "object",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),p=state.childPreparation||{},address=p.kind==='address',node=address?(p.itemId?'XDX_READ_ADDRESS_TEMPLATE':'XDX_FIND_ADDRESS_TEMPLATE'):(p.itemId?'XDX_READ_CONTACT_TEMPLATE':'XDX_FIND_CONTACT_TEMPLATE'),response=$context.$nodes[node].$output,idField=address?'SupplierAddressId':'SupplierContactId';\n function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}\n let row=response;if(!p.itemId){if(!response||!Array.isArray(response.items)||response.count!==response.items.length||response.hasMore!==false||response.limit!==p.limit||response.offset!==p.offset||response.items.length!==1){state.childTemplateCandidates={kind:p.kind,suppliers_Id:p.suppliers_Id,items:response&&Array.isArray(response.items)?response.items:[]};return done('display','Choose exactly one source '+p.kind+' under this supplier, then repeat the template request with its ID. Nothing was created.');}row=response.items[0];}\n if(!row||!(typeof row[idField]==='number'&&Number.isSafeInteger(row[idField])&&row[idField]>0||typeof row[idField]==='string'&&/^[1-9][0-9]{0,17}$/.test(row[idField]))||p.itemId&&String(row[idField])!==p.itemId||row.Status!=='ACTIVE')return done('display','The source '+p.kind+' could not be verified under this supplier. No draft was created.');\n p.source=JSON.parse(JSON.stringify(row));p.sourceId=String(row[idField]);p.sourceParentId=p.suppliers_Id;return done('child_build');"
          },
