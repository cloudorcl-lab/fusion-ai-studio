            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));let operation=state.nextOperation||'display';\nfunction done(){state.nextOperation=operation;return {operation:operation,state:state};}\nfunction stop(message){operation='display';state.response={message:message};return done();}\nif(operation!=='children' && (!state.pending||state.pending.purpose!=='children'))return done();\nif(operation!=='children')return done();\nconst request=state.pending.childRequest||{},resource=request.resource;\nconst defs={sites:['SupplierSiteId','SupplierSite'],contacts:['SupplierContactId','ContactName'],addresses:['SupplierAddressId','AddressName']};const def=defs[resource];\nif(!def)return stop('Choose sites, contacts or addresses.');\nfunction key(v){return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)||typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}\nfunction literal(v){return \"'\"+v.replace(/'/g,\"''\")+\"'\";}\nlet p={resource:resource,suppliers_Id:state.pending.suppliers_Id,supplier:state.selection,includeInactive:request.includeInactive===true,limit:25,offset:0,q:def[0]+' > 0'};\nif(request.childMode==='next'){\n const cursor=state.childSearches&&state.childSearches[resource];\n if(!cursor||cursor.hasMore!==true||!Number.isSafeInteger(cursor.nextOffset)||cursor.nextOffset<0||!key(cursor.suppliers_Id)||typeof cursor.q!=='string'||cursor.limit!==25)return stop('There is no next '+resource+' page to retrieve.');\n p=JSON.parse(JSON.stringify(cursor));p.offset=cursor.nextOffset;operation=resource+'_list';state.childPending=p;return done();\n}\nif(!key(p.suppliers_Id)||!state.selection||String(state.selection.SupplierId)!==String(p.suppliers_Id))return stop('Search for and select the supplier whose '+resource+' you want.');\np.suppliers_Id=String(p.suppliers_Id);const term=typeof request.childTerm==='string'?request.childTerm.trim():'';\nif(request.childMode==='id'||request.childMode==='selection'){\n let id=term;\n if(request.childMode==='selection'){const selected=state.childSelections&&state.childSelections[resource];if(!selected||selected.suppliers_Id!==p.suppliers_Id)return stop('Choose a '+resource+' record from this supplier first.');id=selected.item[def[0]];}\n if(!key(id))return stop('Choose a valid '+resource+' record under this supplier.');p.itemId=String(id);operation=resource+'_get';\n}else{\n if(request.childMode==='exact'||request.childMode==='contains'){\n  if(!term||term.length>360||/[\\x00-\\x1f]/.test(term))return stop('Supply a valid '+resource+' name.');\n  if(request.childMode==='contains'&&/[%_\\\\]/.test(term))return stop('Use an exact name for this '+resource+' search.');\n  p.q=def[1]+(request.childMode==='exact'?' = ':' like ')+literal(request.childMode==='exact'?term:'%'+term+'%');\n }\n operation=resource+'_list';\n}\nstate.childPending=p;return done();",
