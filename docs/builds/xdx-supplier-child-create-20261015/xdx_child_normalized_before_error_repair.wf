            "name": "XDX CAPTURE CHILD CREATION",
            "returnType": "object",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),p=state.childDispatch||{},a=state.attempts.filter(function(a){return a.kind===p.kind&&a.requestId===p.requestId&&a.revision===p.revision;})[0],address=p.kind==='address',key=address?'SupplierAddressId':'SupplierContactId',r=$context.$nodes[address?'XDX_CREATE_ADDRESS_ONCE':'XDX_CREATE_CONTACT_ONCE'].$output;\n if(!a||a.status!=='reserved')throw new Error('No matching reserved child attempt exists.');\n function decimal(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0?String(v):typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}\n const id=r&&decimal(r[key]);if(!id){a.status='uncertain';if(state.draft)state.draft.status='uncertain';state.nextOperation='display';state.response={message:'The '+p.kind+' creation outcome is uncertain. This request will not be submitted again. Reconcile it before another write.',kind:p.kind,attempt:a,requestId:a.requestId,revision:a.revision};return {state:state,operation:'display'};}\n a.status='accepted';a[key]=id;if(address&&r.AddressPartyNumber!==undefined)a.AddressPartyNumber=r.AddressPartyNumber;if(!address&&r.PersonProfileId!==undefined)a.PersonProfileId=r.PersonProfileId;a.verification='pending';state.draft.status='accepted';state.childDispatch.itemId=id;state.nextOperation='verify_'+p.kind;state.response={message:'The '+p.kind+' was accepted. Checking the independently saved fields.',kind:p.kind,attempt:a,requestId:a.requestId,revision:a.revision};return {state:state,operation:state.nextOperation};",
