            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function copy(v){return JSON.parse(JSON.stringify(v));}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}\nconst p=state.continuationPreparation,request=p&&p.request,origin=p&&state.attempts.filter(function(a){return a.requestId===p.originRequestId&&!a.continuationOf;})[0];if(!p||!p.complete||!origin||!p.site)return done('display','Complete assignment reconciliation is required before continuation. No new write was submitted.');const lineage=state.attempts.filter(function(a){return a.kind==='site'&&a.suppliers_Id===p.suppliers_Id&&a.SupplierSiteId===p.SupplierSiteId;});const missing=[],existing=[];let unresolved=false;function pairKey(pair){return String(pair.ClientBUId)+':'+String(pair.BillToBUId);}for(let i=0;i<origin.assignments.length;i++){const pair=origin.assignments[i].payload,k=pairKey(pair),found=p.rows.filter(function(row){return pairKey(row)===k;});if(found.length===1){existing.push(found[0]);continue;}if(lineage.some(function(a){return a.assignments.some(function(row){return pairKey(row.payload)===k&&['reserved','uncertain','accepted','verified'].indexOf(row.status)>=0;});})){unresolved=true;continue;}missing.push(copy(pair));}origin.reconciliation={complete:true,existing:existing,missing:copy(missing),unresolved:unresolved};if(unresolved)return done('display','Site created; assignments incomplete. A previously attempted pair is still unresolved or no longer present. No retry is permitted until its outcome is reconciled.');if(!missing.length){origin.status='complete';if(state.draft&&(state.draft.requestId===origin.requestId||state.draft.originRequestId===origin.requestId||lineage.some(function(a){return a.requestId===state.draft.requestId;})))state.draft=null;state.response={message:'The existing site and all required assignment pairs are verified. No new write was submitted.',site:p.site,SupplierSiteId:p.SupplierSiteId,assignments:existing,requestId:origin.requestId};return done('display');}\n if(request.mode==='confirm'){\n const draft=state.draft;function keys(pairs){return pairs.map(pairKey).sort().join('|');}if(!draft||draft.kind!=='site_continuation'||draft.requestId!==request.requestId||draft.revision!==request.revision||draft.status!=='reviewed'||draft.reviewedRevision!==request.revision||draft.originRequestId!==origin.requestId||draft.SupplierSiteId!==p.SupplierSiteId||draft.suppliers_Id!==p.suppliers_Id||state.attempts.some(function(a){return a.requestId===draft.requestId;}))return done('display','The continuation changed or has already been attempted. Review its current state.');\n if(keys(missing)!==keys(request.assignments)||keys(draft.assignments)!==keys(request.assignments)){draft.revision++;draft.status='editing';draft.assignments=missing;draft.reconciled=true;delete draft.reviewedRevision;state.response={message:'The missing assignment pairs changed. Review this revised continuation before confirming. No new write was submitted.',requestId:draft.requestId,revision:draft.revision,site:p.site,SupplierSiteId:p.SupplierSiteId,assignments:missing,writeCount:missing.length,reviewCommand:'Review request '+draft.requestId+' revision '+draft.revision};return done('display');}\n const attempt={kind:'site',continuationOf:origin.requestId,requestId:draft.requestId,revision:draft.revision,status:'assignments-pending',suppliers_Id:p.suppliers_Id,SupplierSiteId:p.SupplierSiteId,sourceSiteId:origin.sourceSiteId,addressId:origin.addressId,payload:copy(origin.payload),site:copy(p.site),siteVerification:'verified',assignments:missing.map(function(pair){return {payload:copy(pair),status:'pending'};})};state.attempts.push(attempt);draft.status='reserved';state.siteDispatch={requestId:attempt.requestId,revision:attempt.revision,suppliers_Id:attempt.suppliers_Id,SupplierSiteId:attempt.SupplierSiteId,addressId:attempt.addressId,assignmentIndex:0,moreAssignments:true};delete state.continuationRequest;delete state.continuationPreparation;return done('continuation_create');\n }\n const conversation=$context.$workflow&&$context.$workflow.$conversationId,sequence=state.nextRequestSequence,id='REQ-'+conversation+'-'+sequence;if(typeof conversation!=='string'||!/^[A-Za-z0-9_-]+$/.test(conversation)||id.length>96||!Number.isSafeInteger(sequence)||sequence<1||sequence>=9007199254740991)return done('display','A unique continuation request could not be initialized. No new write was submitted.');const draft={kind:'site_continuation',requestId:id,revision:1,status:'editing',originRequestId:origin.requestId,suppliers_Id:p.suppliers_Id,SupplierSiteId:p.SupplierSiteId,site:copy(p.site),assignments:missing,reconciled:true};state.draft=draft;state.nextRequestSequence=sequence+1;state.response={message:'Separate continuation prepared for only the missing assignment pairs. The existing site and completed pairs are retained. No new write was submitted.',requestId:id,revision:1,site:p.site,SupplierSiteId:p.SupplierSiteId,assignments:missing,writeCount:missing.length,writeOrder:'Create and independently verify only these missing assignment pairs, serially.',reviewCommand:'Review request '+id+' revision 1'};return done('display');"
