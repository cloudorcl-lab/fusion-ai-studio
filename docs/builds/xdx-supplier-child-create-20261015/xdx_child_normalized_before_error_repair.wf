                    "returnType": "object",
                    "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function copy(v){return JSON.parse(JSON.stringify(v));}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}\nconst p=state.continuationPreparation,r=$context.$nodes.XDX_LOAD_EXISTING_ASSIGNMENTS.XDX_EXISTING_ASSIGNMENT_PAGE.$output;function fail(){p.paging=false;p.complete=false;return done('display','Existing assignments could not be completely reconciled. No new write was submitted.');}if(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.limit!==25||r.offset!==p.offset||typeof r.hasMore!=='boolean'||r.hasMore&&r.count===0||r.items.some(function(x){return !x||!decimal(x.AssignmentId)||!decimal(x.ClientBUId)||!decimal(x.BillToBUId);}))return fail();for(let i=0;i<r.items.length;i++){const row=r.items[i],k=decimal(row.ClientBUId)+':'+decimal(row.BillToBUId);if(p.seen[k])return fail();p.seen[k]=true;p.rows.push({AssignmentId:decimal(row.AssignmentId),ClientBUId:decimal(row.ClientBUId),BillToBUId:decimal(row.BillToBUId)});}p.offset+=r.count;p.pages++;if(r.hasMore&&p.pages>=100)return fail();p.paging=r.hasMore;p.complete=!r.hasMore;return done(r.hasMore?'continuation_pairs':'continuation_build');"
