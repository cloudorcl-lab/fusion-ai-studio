          "metadata": {
            "name": "XDX App Stage",
            "returnType": "object",
            "sourceCode": "const hint = $context.$app && $context.$app.$OraMessageHint;\nreturn {stage: hint === 'InitDisplay' ? 'InitDisplay' : hint === 'Query' ? 'Query' : 'Unsupported'};"
          },
