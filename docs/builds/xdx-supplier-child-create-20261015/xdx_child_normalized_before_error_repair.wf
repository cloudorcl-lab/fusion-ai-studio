                {
                  "id": "sitepageaccept_84",
                  "code": "XDX_ACCUMULATE_SITE_ASSIGNMENTS",
                  "type": "CODE",
                  "metadata": {
                    "name": "XDX Accumulate Site Assignments",
                    "returnType": "object",
                    "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));const p=state.sitePreparation||{};function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function literal(v){return \"'\"+v.replace(/'/g,\"''\")+\"'\";}\nconst r=$context.$nodes.XDX_LOAD_SITE_ASSIGNMENTS.XDX_SITE_ASSIGNMENT_PAGE.$output;function fail(){p.assignmentPaging=false;p.assignmentsComplete=false;return done('display','The complete source assignments could not be verified. No draft was created.');}if(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.limit!==25||r.offset!==p.assignmentOffset||typeof r.hasMore!=='boolean'||r.hasMore&&r.count===0||r.items.some(function(row){return !row||!key(row.AssignmentId)||!key(row.ClientBUId)||!key(row.BillToBUId);}))return fail();for(let i=0;i<r.items.length;i++){const row=r.items[i],pair=row.ClientBUId+':'+row.BillToBUId;if(p.assignmentSeen[pair])return fail();p.assignmentSeen[pair]=true;p.assignments.push(row);}p.assignmentOffset+=r.count;p.assignmentPages++;if(r.hasMore&&p.assignmentPages>=100)return fail();p.assignmentPaging=r.hasMore;p.assignmentsComplete=!r.hasMore;return done(r.hasMore?'site_assignments':'site_name_check');"
                  },
