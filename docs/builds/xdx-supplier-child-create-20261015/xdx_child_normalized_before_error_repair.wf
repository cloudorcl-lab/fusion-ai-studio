            "name": "XDX ACCEPT SITE NAME CHECK",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));const p=state.sitePreparation||{};function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function literal(v){return \"'\"+v.replace(/'/g,\"''\")+\"'\";}\nconst r=$context.$nodes.XDX_CHECK_NEW_SITE_NAME.$output;if(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.limit!==1||r.offset!==0||typeof r.hasMore!=='boolean')return done('display','The new site name could not be checked.');if(r.count||r.hasMore){p.nameConflict=true;return done('display','A site with that name already exists under this supplier. Choose a different name; nothing was created.');}p.nameChecked=p.newName;p.nameConflict=false;if(p.editingRequestId){const draft=state.draft;if(!draft||draft.kind!=='site'||draft.requestId!==p.editingRequestId||draft.revision!==p.editingRevision||draft.payload.SupplierSite!==p.newName)return done('display','The site draft changed while checking its name; review the current draft.');draft.duplicateCheckedRevision=draft.revision;state.nextOperation='display';state.response={message:'Site name updated. Review the new revision before confirming.',requestId:draft.requestId,revision:draft.revision,payload:draft.payload,assignments:draft.assignments,writeCount:1+draft.assignments.length,reviewCommand:'Review request '+draft.requestId+' revision '+draft.revision};return {state:state,operation:'display'};}return done('site_build');",
