        {
          "id": "17",
          "code": "XDX_ACCEPT_NAME_CHECK",
          "type": "CODE",
          "metadata": {
            "name": "XDX Accept Name Check",
            "sourceCode": "const response=$context.$nodes.XDX_CHECK_SUPPLIER_NAME.$output;\nconst state=JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst draft=state.draft,pending=state.pending||{};\nfunction finish(message){state.response={message:message,requestId:draft&&draft.requestId,revision:draft&&draft.revision,payload:draft&&draft.payload};return {operation:'display',state:state};}\nif(!draft || draft.requestId!==pending.requestId || draft.revision!==pending.revision || draft.payload.Supplier!==pending.name)return finish('The draft changed during the name check. Review the current draft again.');\ndelete draft.duplicateCheckedRevision;\nif(!response || !Array.isArray(response.items) || !Number.isSafeInteger(response.count) || response.count!==response.items.length || response.limit!==1 || response.offset!==0 || typeof response.hasMore!=='boolean')return finish('The duplicate-name check failed. This draft cannot be reviewed yet.');\nif(response.count!==0 || response.hasMore)return finish('That supplier name is already in use or the check was incomplete. Choose a different new name.');\nif(!draft.classificationsVerified)return finish('Verify the classification choices before reviewing this draft.');\ndraft.duplicateCheckedRevision=draft.revision;\nconst result=finish('Draft prepared. Nothing has been created. Review the exact request and revision to continue.');\nstate.response.source=draft.source;state.response.reviewCommand='Review request '+draft.requestId+' revision '+draft.revision;state.response.cancelCommand='Cancel request '+draft.requestId+' revision '+draft.revision;return result;\r\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "30"
          },
          "inputs": [],
          "diagram": {
            "x": 7852.5,
