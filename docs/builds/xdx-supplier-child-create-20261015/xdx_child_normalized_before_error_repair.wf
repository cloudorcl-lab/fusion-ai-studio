          "code": "XDX_CAPTURE_SITE_CREATION",
          "type": "CODE",
          "metadata": {
            "name": "XDX CAPTURE SITE CREATION",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function copy(v){return JSON.parse(JSON.stringify(v));}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}\nconst dispatch=state.siteDispatch||{},attempt=(state.attempts||[]).filter(function(a){return a.kind==='site'&&a.requestId===dispatch.requestId&&a.revision===dispatch.revision;})[0];function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}\nconst r=$context.$nodes.XDX_CREATE_SITE_ONCE.$output;if(!attempt||attempt.status!=='reserved')return done('display','The site outcome could not be matched to its reserved request. No further write is permitted.');const siteId=r&&decimal(r.SupplierSiteId);if(!siteId){state.nextOperation='display';attempt.status='uncertain';dispatch.moreAssignments=false;if(state.draft&&state.draft.requestId===attempt.requestId)state.draft.status='uncertain';state.response={message:'The site creation response did not establish its generated ID. Its outcome is uncertain; no assignment was started and the site will not be submitted again.',attempt:attempt,requestId:attempt.requestId,revision:attempt.revision};return {state:state,operation:'display'};}attempt.status='accepted';attempt.SupplierSiteId=siteId;attempt.siteVerification='pending';dispatch.SupplierSiteId=siteId;if(state.draft&&state.draft.requestId===attempt.requestId)state.draft.status='accepted';return done('site_verify');",
            "returnType": "object",
            "errorNodeId": "102"
          },
