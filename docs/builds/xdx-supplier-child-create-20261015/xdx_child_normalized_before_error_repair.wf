        {
          "id": "54",
          "code": "XDX_ACCEPT_LIST_SITES",
          "type": "CODE",
          "metadata": {
            "name": "XDX ACCEPT LIST SITES",
            "sourceCode": "const response=$context.$nodes.XDX_LIST_SUPPLIER_SITES.$output;const state=JSON.parse(JSON.stringify($context.$variables.supplierState));const p=state.childPending||{};state.nextOperation='display';\nfunction fail(){state.response={message:'The sites response could not be verified. Your draft is unchanged.'};return {state:state,operation:'display'};}\nfunction valid(row){return row&&Number.isSafeInteger(row.SupplierSiteId)&&row.SupplierSiteId>0&&typeof row.Status==='string';}\nif(!response||!Array.isArray(response.items)||!Number.isSafeInteger(response.count)||response.count!==response.items.length||response.count>p.limit||response.limit!==p.limit||response.offset!==p.offset||typeof response.hasMore!=='boolean'||response.hasMore&&response.count===0)return fail();const seen={};if(response.items.some(function(row){if(!valid(row)||seen[row.SupplierSiteId])return true;seen[row.SupplierSiteId]=true;return false;}))return fail();const rows=response.items.filter(function(row){return p.includeInactive||row.Status==='ACTIVE';});state.childSearches=state.childSearches||{};state.childSearches.sites={resource:'sites',suppliers_Id:p.suppliers_Id,supplier:p.supplier,q:p.q,limit:p.limit,offset:p.offset,nextOffset:p.offset+response.count,hasMore:response.hasMore,includeInactive:p.includeInactive};state.childCandidates=state.childCandidates||{};state.childCandidates.sites={suppliers_Id:p.suppliers_Id,items:rows};state.childSelections=state.childSelections||{};delete state.childSelections.sites;if(rows.length===1&&!response.hasMore)state.childSelections.sites={suppliers_Id:p.suppliers_Id,item:rows[0]};state.response={message:rows.length?'Supplier sites.':'No matching sites on this page.',resource:'sites',supplier:p.supplier,items:rows,hasMore:response.hasMore,nextCommand:response.hasMore?'Next sites page':'',returnedCount:rows.length};\nstate.activeRead='sites';return {state:state,operation:'display'};",
            "returnType": "object"
          },
          "outcomes": {
            "success": "55"
          },
