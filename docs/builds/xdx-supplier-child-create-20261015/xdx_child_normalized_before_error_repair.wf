            "sourceCode": "function finalize(){state.nextOperation=result.operation;return result;}\nlet extractedIntent = $context.$nodes.XDX_INTERPRET_SUPPLIER_REQUEST.$output;\nconst selectedDetail = /^\\s*(?:show|get|view)\\s+(?:the\\s+)?details\\s+(?:for|of)\\s+the\\s+selected\\s+(site|contact|address)\\s*[.!?]?\\s*$/i.exec($context.$system.$inputMessage||'');\nconst explicitChildDetail = /^\\s*(?:show|get|view)\\s+(site|contact|address)\\s+details\\s+for\\s+\\1\\s+ID\\s+([1-9][0-9]{0,17})\\s+for\\s+supplier\\s+(number|ID)\\s+([1-9][0-9]{0,17})\\s*[.!?]?\\s*$/i.exec($context.$system.$inputMessage||'');\nlet intent = selectedDetail ? {intent:'children',resource:{site:'sites',contact:'contacts',address:'addresses'}[selectedDetail[1].toLowerCase()],matchMode:'selection',term:'',childMode:'selection',childTerm:'',includeInactive:false} : explicitChildDetail ? {intent:'children',resource:{site:'sites',contact:'contacts',address:'addresses'}[explicitChildDetail[1].toLowerCase()],matchMode:explicitChildDetail[3].toLowerCase()==='number'?'number':'id',term:explicitChildDetail[4],childMode:'id',childTerm:explicitChildDetail[2],includeInactive:false} : extractedIntent;\nconst state = JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst result = {operation:'display',state:state};\nstate.response={message:'Describe the supplier you want to find, or the change to your current draft.'};\nfunction stop(message){state.response={message:message};return finalize();}\nfunction literal(value){return \"'\"+value.replace(/'/g,\"''\")+\"'\";}\nfunction key(value){return (typeof value==='string' && /^[1-9][0-9]{0,17}$/.test(value)) || (typeof value==='number' && value>0 && value<=9007199254740991 && Math.floor(value)===value);}\nconst actions=['search','detail','template','edit','choices','children','site_template','child_create','next','unsupported'];\nconst activeChild=state.draft&&['address','contact'].indexOf(state.draft.kind)>=0?state.draft:null;\n const raw=$context.$system.$inputMessage||'',fieldEdit=/^\\s*(?:change|set)\\s+(AddressName|CountryCode|AddressLine1|City|State|PostalCode|Email|FirstName|LastName)\\s+to\\s+([\\s\\S]+?)\\s*$/i.exec(raw)||/^\\s*(AddressName|CountryCode|AddressLine1|City|State|PostalCode|Email|FirstName|LastName)\\s*:\\s*([\\s\\S]+?)\\s*$/i.exec(raw);\n if(activeChild&&(fieldEdit||intent&&intent.intent==='edit')){\n  const d=activeChild,fields=d.kind==='address'?['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email']:['FirstName','LastName','Email'];\n  if(['editing','reviewed'].indexOf(d.status)<0||state.attempts.some(function(a){return a.requestId===d.requestId;}))return stop('This child request cannot be edited after an attempt.');\n  let patch={};if(fieldEdit){const f=fields.filter(function(f){return f.toLowerCase()===fieldEdit[1].toLowerCase();})[0];if(!f)return stop('That field does not belong to the active '+d.kind+' draft.');patch[f]=fieldEdit[2];}else{patch=intent.childPatch;if(!patch||typeof patch!=='object'||Array.isArray(patch)||Object.keys(patch).some(function(f){return fields.indexOf(f)<0&&patch[f]!==null;}))return stop('Supply only required fields for the active '+d.kind+' draft.');}\n  const changes=Object.keys(patch).filter(function(f){return patch[f]!==null;});if(!changes.length||changes.some(function(f){return typeof patch[f]!=='string'||!patch[f].trim();}))return stop('Specify the required draft field and its replacement value.');\n  if(!Number.isSafeInteger(d.revision)||d.revision>=9007199254740991)return stop('Cancel this draft before starting a new revision.');changes.forEach(function(f){d.payload[f]=patch[f];});d.revision++;d.status='editing';delete d.reviewedRevision;delete d.fieldsVerifiedRevision;delete d.duplicateCheckedRevision;delete state.childConfirmation;result.operation='child_validate';return finalize();\n }\nif(!intent || actions.indexOf(intent.intent)<0 || typeof intent.includeInactive!=='boolean')return stop('Please describe the supplier search or draft change.');\nif(intent.intent==='unsupported')return finalize();\nfunction lookup(purpose){const date=$context.$system.$currentDate;if(typeof date!=='string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(date))return stop('The current business date is unavailable. Your draft is retained.');state.pending={purpose:purpose,activeDate:date,limit:100,offset:0};if(purpose==='classifications'){state.pending.requestId=state.draft.requestId;state.pending.revision=state.draft.revision;}result.operation='classifications';return finalize();}\nif(intent.intent==='choices')return lookup('choices');\nif(intent.intent==='edit'&&state.draft&&state.draft.kind==='site'){\n const draft=state.draft;if(['editing','reviewed'].indexOf(draft.status)<0||state.attempts.some(function(a){return a.requestId===draft.requestId;}))return stop('This site request cannot be edited after an attempt.');\n const patch=intent.patch;if(!patch||typeof patch!=='object'||Array.isArray(patch)||Object.keys(patch).some(function(k){return k!=='SupplierSite'&&patch[k]!==null;}))return stop('Change the new site name; the source address, procurement BU and reviewed assignment pairs remain attached to this source.');\n const name=patch.SupplierSite;if(typeof name!=='string'||!name.trim()||name.length>240||/[\\x00-\\x1f]/.test(name))return stop('Provide a new site name of up to 240 characters.');\n if(!Number.isSafeInteger(draft.revision)||draft.revision>=9007199254740991)return stop('Cancel this draft and start again; its revision cannot advance.');\n draft.payload.SupplierSite=name;draft.revision++;draft.status='editing';delete draft.reviewedRevision;delete draft.duplicateCheckedRevision;delete state.siteConfirmation;\n state.sitePreparation={suppliers_Id:String(draft.supplier.SupplierId),supplier:draft.supplier,source:draft.source,address:draft.address,newName:name,assignmentsComplete:draft.assignmentsComplete,editingRequestId:draft.requestId,editingRevision:draft.revision};\n result.operation='site_name_check';return finalize();\n}\nif(intent.intent==='edit'){\n const draft=state.draft;\n if(!draft || ['editing','reviewed'].indexOf(draft.status)<0 || state.attempts.some(function(a){return a.requestId===draft.requestId;}))return stop('There is no editable supplier draft. Start by choosing a supplier template.');\n const patch=intent.patch,fields=['Supplier','SupplierType','BusinessRelationship','TaxOrganizationType'];\n if(!patch || typeof patch!=='object' || Array.isArray(patch) || Object.keys(patch).some(function(k){return fields.indexOf(k)<0 && !(k==='SupplierSite' && patch[k]===null);}))return stop('Only the new supplier name and the three reviewed classifications can be edited.');\n const changes=Object.keys(patch).filter(function(k){return patch[k]!==null;});\n if(!changes.length)return stop('Tell me which draft field to change.');\n if(changes.some(function(k){return typeof patch[k]!=='string' || !patch[k].trim() || patch[k].length>(k==='Supplier'?360:80);}))return stop('Supply a nonempty name of up to 360 characters and classification values of up to 80 characters.');\n if(!Number.isSafeInteger(draft.revision) || draft.revision>=9007199254740991)return stop('The draft revision cannot be advanced. Cancel this draft and start again.');\n const classificationsUnchanged=changes.every(function(k){return k==='Supplier' || patch[k]===draft.payload[k];});const wasVerified=draft.classificationsVerified===true;\n changes.forEach(function(k){draft.payload[k]=patch[k];});draft.revision+=1;draft.status='editing';delete draft.reviewedRevision;delete draft.duplicateCheckedRevision;\n draft.classificationsVerified=(wasVerified && classificationsUnchanged) || ['SupplierType','BusinessRelationship','TaxOrganizationType'].every(function(k){return draft.payload[k]===draft.source[k];});\n state.response={message:'Draft updated. Review the new revision before confirming.',requestId:draft.requestId,revision:draft.revision,payload:draft.payload};\n if(!draft.classificationsVerified)return lookup('classifications');\n if(!draft.payload.Supplier || !draft.payload.Supplier.trim())return stop('Classifications updated. What name should the new supplier have?');\n state.pending={purpose:'duplicate',q:'Supplier='+literal(draft.payload.Supplier),limit:1,offset:0,requestId:draft.requestId,revision:draft.revision,name:draft.payload.Supplier};result.operation='duplicate';return finalize();\n}\nif(intent.intent==='next' && ['sites','contacts','addresses'].indexOf(state.activeRead)>=0){state.pending={purpose:'children',childRequest:{resource:state.activeRead,childMode:'next',childTerm:''}};result.operation='children';return finalize();}\nif(intent.intent==='next'){\n const search=state.search;\n if(!search || search.hasMore!==true || !Number.isSafeInteger(search.nextOffset) || search.nextOffset<0 || typeof search.q!=='string' || !Number.isSafeInteger(search.limit) || search.limit<1 || search.limit>25)return stop('There is no next supplier page to retrieve.');\n state.pending={purpose:'search',q:search.q,limit:search.limit,offset:search.nextOffset,includeInactive:search.includeInactive===true};result.operation='list';return finalize();\n}\nif((intent.intent==='template'||intent.intent==='site_template'||intent.intent==='child_create') && state.draft)return stop('A draft already exists. Edit it, or cancel its exact request and revision before starting another.');\nconst selectedTemplateParent=(intent.intent==='template'||intent.intent==='site_template'||intent.intent==='child_create') && /\\b(?:based on|from|for)\\s+(?:the\\s+)?selected supplier\\b/i.test($context.$system.$inputMessage||'');\nconst selectedReference=selectedTemplateParent || intent.intent==='child_create'&&/\\bselected (?:address|contact)\\b/i.test($context.$system.$inputMessage||'') || intent.intent==='children' && /\\bselected (?:supplier|site|contact|address)\\b/i.test($context.$system.$inputMessage||'');\nconst mode=selectedReference?'selection':intent.matchMode;\nconst term=typeof intent.term==='string'?intent.term.trim():'';\nconst newName=typeof intent.newName==='string'?intent.newName:'';\nif(newName.length>360)return stop('The new supplier name must be at most 360 characters.');\nconst pending={purpose:intent.intent,newName:newName,includeInactive:intent.intent==='template' || intent.includeInactive===true && /\\binactive\\b/i.test($context.$system.$inputMessage||'')};\nif(intent.intent==='child_create'){\n  if(!/\\b(?:create|new|copy|clone|prepare)\\b/i.test($context.$system.$inputMessage||''))return stop('An explicit request to prepare a new address or contact is required.');\n  const kind=intent.resource==='addresses'?'address':intent.resource==='contacts'?'contact':null,creationMode=intent.creationMode;\n  if(!kind||['direct','template'].indexOf(creationMode)<0)return stop('Choose direct-entry or same-supplier template creation for an address or contact.');\n  const fields=kind==='address'?['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email']:['FirstName','LastName','Email'],patch=intent.childPatch||{};\n  if(typeof patch!=='object'||Array.isArray(patch)||Object.keys(patch).some(function(f){return fields.indexOf(f)<0&&patch[f]!==null;}))return stop('Supply only the required fields for this child.');\n  const clean={};fields.forEach(function(f){if(Object.prototype.hasOwnProperty.call(patch,f)&&patch[f]!==null)clean[f]=patch[f];});if(kind==='address'&&newName)clean.AddressName=newName;\n  const selectedSource=/\\bselected (?:address|contact)\\b/i.test($context.$system.$inputMessage||'');pending.childCreateRequest={kind:kind,mode:creationMode,patch:clean,sourceMode:selectedSource?'selection':intent.childMode,sourceTerm:typeof intent.childTerm==='string'?intent.childTerm:''};\n }\nif(intent.intent==='site_template'){\n if(newName.length>240)return stop('The new site name must be at most 240 characters.');\n const sm=intent.childMode||'contains',st=typeof intent.childTerm==='string'?intent.childTerm:'';\n if(['exact','contains','id','selection'].indexOf(sm)<0)return stop('Choose a source site by name, site ID or the selected site.');\n pending.siteRequest={mode:sm,term:st};\n}\nif(intent.intent==='children'){\n const resource=intent.resource;\n if(['sites','contacts','addresses'].indexOf(resource)<0)return stop('Ask for supplier sites, contacts or addresses.');\n const selectedChild=/\\bselected (?:site|contact|address)\\b/i.test($context.$system.$inputMessage||'');\n const childMode=selectedChild?'selection':intent.childMode||'all';\n if(['all','exact','contains','id','selection','next'].indexOf(childMode)<0)return stop('Describe which '+resource+' to show.');\n pending.childRequest={resource:resource,childMode:childMode,childTerm:typeof intent.childTerm==='string'?intent.childTerm:'',includeInactive:pending.includeInactive};\n state.pending=pending;\n if(childMode==='next'){result.operation='children';return finalize();}\n}\nif(mode==='selection'){\n if(!state.selection || !key(state.selection.SupplierId))return stop('Search for and select a supplier first.');\n pending.suppliers_Id=String(state.selection.SupplierId);state.pending=pending;result.operation='get';return finalize();\n}\nif(mode==='id'){\n if(!key(term))return stop('Supply a valid internal supplier ID, or search by supplier name or displayed supplier number.');\n pending.suppliers_Id=term;state.pending=pending;result.operation='get';return finalize();\n}\nif(['contains','exact','number'].indexOf(mode)<0 || !term || term.length>360 || /[\\x00-\\x1f]/.test(term))return stop('Supply a supplier name or displayed supplier number to search.');\nif(mode==='contains' && /[%_\\\\]/.test(term))return stop('For this name, use an exact supplier-name search or the displayed supplier number.');\nlet q=mode==='number'?'SupplierNumber='+literal(term):mode==='exact'?'Supplier='+literal(term):'Supplier like '+literal('%'+term+'%');\nif(!pending.includeInactive){const date=$context.$system.$currentDate;if(typeof date!=='string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(date))return stop('The current business date is unavailable. The supplier search was not run.');q+=\" and (InactiveDate is null or InactiveDate > '\"+date+\"')\";}\npending.q=q;pending.limit=25;pending.offset=0;state.pending=pending;result.operation='list';return finalize();\r\n",
