        {
          "id": "49",
          "code": "XDX_ACCEPT_SUPPLIER_CLASSIFICATIONS",
          "type": "CODE",
          "metadata": {
            "name": "XDX Accept Supplier Classifications",
            "returnType": "object",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst pending=state.pending||{},draft=state.draft;\nconst output=$context.$nodes.XDX_READ_SUPPLIER_CLASSIFICATIONS.$output;\nconst groups={SupplierType:'POZ_VENDOR_TYPE',BusinessRelationship:'ORA_POZ_BUSINESS_RELATIONSHIP',TaxOrganizationType:'POZ_ORGANIZATION_TYPE'};\nconst fields=Object.keys(groups),choices={};\nfunction done(message){state.nextOperation='display';state.response={message:message};return {operation:'display',state:state};}\nif(!output || !Array.isArray(output.items) || output.count!==output.items.length || output.hasMore!==false || output.limit!==100 || output.offset!==0)return done('The classification choices could not be retrieved completely. Your draft is retained; try the choice request again.');\nconst seen={};\nfor(let i=0;i<output.items.length;i++){\n const row=output.items[i];\n if(!row || typeof row.LookupType!=='string' || typeof row.LookupCode!=='string' || !row.LookupCode.trim() || typeof row.Meaning!=='string' || !row.Meaning.trim())return done('The classification response was invalid. Your draft is retained.');\n const field=fields.filter(function(k){return groups[k]===row.LookupType;})[0];\n const key=row.LookupType+':'+row.LookupCode;\n if(!field || seen[key])return done('The classification response was ambiguous. Your draft is retained.');\n seen[key]=true;if(!choices[field])choices[field]=[];choices[field].push({code:row.LookupCode,label:row.Meaning});\n}\nif(fields.some(function(k){return !choices[k] || !choices[k].length;}))return done('Some classification choices were unavailable. Your draft is retained.');\nif(pending.purpose==='choices'){const r=done('Available supplier classifications are listed below. Tell me which field and value to use.');r.state.response.choices=choices;return r;}\nif(pending.purpose!=='classifications' || !draft || draft.requestId!==pending.requestId || draft.revision!==pending.revision || draft.status!=='editing' || state.attempts.some(function(a){return a.requestId===draft.requestId;}))return done('The draft changed before classification validation. Review your current draft.');\nconst normalized={},invalid=[];\nfields.forEach(function(k){const value=draft.payload[k];const matches=typeof value==='string'?choices[k].filter(function(c){return c.label.toLowerCase()===value.trim().toLowerCase() || c.code.toLowerCase()===value.trim().toLowerCase();}):[];if(matches.length!==1)invalid.push(k);else normalized[k]=matches[0].label;});\nif(invalid.length){draft.classificationsVerified=false;const r=done('Choose an available value for '+invalid.join(', ')+'. Your draft changes are retained.');r.state.response.choices=choices;r.state.response.payload=draft.payload;return r;}\nfields.forEach(function(k){draft.payload[k]=normalized[k];});draft.classificationsVerified=true;\nif(typeof draft.payload.Supplier!=='string' || !draft.payload.Supplier.trim())return done('Classifications updated. What name should the new supplier have?');\nstate.pending={purpose:'duplicate',q:\"Supplier='\"+draft.payload.Supplier.replace(/'/g,\"''\")+\"'\",limit:1,offset:0,requestId:draft.requestId,revision:draft.revision,name:draft.payload.Supplier};\nstate.nextOperation='duplicate';state.response={message:'Classifications updated. Checking the new supplier name before review.',requestId:draft.requestId,revision:draft.revision,payload:draft.payload};\nreturn {operation:'duplicate',state:state};\r\n"
          },
