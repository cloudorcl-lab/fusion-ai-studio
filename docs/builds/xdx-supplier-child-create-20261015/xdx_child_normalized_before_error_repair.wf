            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),p=state.pending||{},request=p.childCreateRequest,parent=state.selection;\n function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}\n function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}\n if(!request||['address','contact'].indexOf(request.kind)<0||['direct','template'].indexOf(request.mode)<0||!parent||!key(parent.SupplierId)||String(parent.SupplierId)!==p.suppliers_Id)return done('display','Choose the supplier for this new child record. Your current draft is unchanged.');\n if(state.draft)return done('display','A draft already exists. Edit or cancel its exact request and revision first.');\n const prep={kind:request.kind,mode:request.mode,suppliers_Id:p.suppliers_Id,supplier:JSON.parse(JSON.stringify(parent)),patch:JSON.parse(JSON.stringify(request.patch||{})),limit:25,offset:0};state.childPreparation=prep;\n if(request.mode==='direct')return done('child_build');\n const resource=request.kind==='address'?'addresses':'contacts',keyField=request.kind==='address'?'SupplierAddressId':'SupplierContactId',nameField=request.kind==='address'?'AddressName':'ContactName';const mode=request.sourceMode,term=request.sourceTerm;\n if(mode==='selection'){const selected=state.childSelections&&state.childSelections[resource];if(!selected||selected.suppliers_Id!==prep.suppliers_Id||!selected.item||!key(selected.item[keyField]))return done('display','Select a source '+request.kind+' under this supplier first.');prep.itemId=String(selected.item[keyField]);return done(request.kind+'_source_get');}\n if(mode==='id'){if(typeof term!=='string'||!/^[1-9][0-9]{0,17}$/.test(term))return done('display','Supply the source '+request.kind+' ID under this supplier.');prep.itemId=term;return done(request.kind+'_source_get');}\n if(['exact','contains'].indexOf(mode)<0||typeof term!=='string'||!term.trim()||term.length>360||/[\\x00-\\x1f]/.test(term)||mode==='contains'&&/[%_\\\\]/.test(term))return done('display','Choose the source '+request.kind+' by exact name, simple search, or its current same-supplier selection.');\n prep.q=nameField+(mode==='exact'?'=':' like ')+\"'\"+(mode==='exact'?term:'%'+term+'%').replace(/'/g,\"''\")+\"'\";return done(request.kind+'_source_list');"
