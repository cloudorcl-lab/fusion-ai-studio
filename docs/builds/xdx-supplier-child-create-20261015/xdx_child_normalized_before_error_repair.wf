        {
          "id": "14",
          "code": "XDX_ACCEPT_SUPPLIER_SEARCH",
          "type": "CODE",
          "metadata": {
            "name": "XDX Accept Supplier Search",
            "returnType": "object",
            "sourceCode": "function finalize(){state.nextOperation=result.operation;return result;}\nconst response=$context.$nodes.XDX_SEARCH_SUPPLIERS.$output;\nconst state=JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst pending=state.pending||{};\nconst result={operation:'display',state:state};\nfunction stop(message){state.response={message:message};return finalize();}\nfunction validKey(value){return typeof value==='number' && value>0 && value<=9007199254740991 && Math.floor(value)===value;}\nif(!response || !Array.isArray(response.items) || !Number.isSafeInteger(response.count) || response.count!==response.items.length || response.count>pending.limit || typeof response.hasMore!=='boolean' || response.offset!==pending.offset || response.limit!==pending.limit || (response.hasMore && response.count===0))return stop('The supplier search returned an incomplete or invalid response. No supplier was selected.');\nconst keys={};\nif(response.items.some(function(row){if(!row || !validKey(row.SupplierId) || typeof row.SupplierNumber!=='string' || typeof row.Supplier!=='string' || typeof row.Status!=='string' || keys[String(row.SupplierId)])return true;keys[String(row.SupplierId)]=true;return false;}))return stop('Supplier identity could not be verified. No supplier was selected.');\nconst rows=response.items.filter(function(row){return pending.includeInactive===true || row.Status==='ACTIVE';});\nif(pending.purpose!=='children'){state.activeRead='suppliers';state.search={q:pending.q,limit:pending.limit,offset:pending.offset,nextOffset:pending.offset+response.count,hasMore:response.hasMore,includeInactive:pending.includeInactive===true};}\nstate.candidates=JSON.parse(JSON.stringify(rows));\nstate.response={message:rows.length?'Supplier search results.':'No suppliers matched on this page.',suppliers:state.candidates,hasMore:response.hasMore,nextCommand:response.hasMore?'Next page':'',returnedCount:rows.length};\nif(rows.length!==1 || response.hasMore){if(pending.purpose==='template' || pending.purpose==='detail' || pending.purpose==='children' || (pending.purpose==='site_template'||pending.purpose==='child_create'))state.response.message=rows.length?'Choose a supplier by its displayed supplier number before continuing.':'No matching supplier was found on this page.';return finalize();}\nif(pending.purpose==='template' || pending.purpose==='detail' || pending.purpose==='children' || (pending.purpose==='site_template'||pending.purpose==='child_create')){state.pending.suppliers_Id=String(rows[0].SupplierId);result.operation='get';return finalize();}\nstate.selection=JSON.parse(JSON.stringify(rows[0]));return finalize();\r\n"
          },
