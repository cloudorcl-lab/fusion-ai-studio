            "name": "XDX PREPARE SITE CONTINUATION",
            "returnType": "object",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function copy(v){return JSON.parse(JSON.stringify(v));}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}\nconst request=state.continuationRequest,origin=request&&(state.attempts||[]).filter(function(a){return a.kind==='site'&&a.requestId===request.originRequestId&&!a.continuationOf;})[0];if(!origin||origin.siteVerification!=='verified'||!decimal(origin.SupplierSiteId)||!decimal(origin.suppliers_Id)||!Array.isArray(origin.assignments))return done('display','The original accepted site is not ready for assignment reconciliation. No new write was submitted.');if(request.mode==='confirm'){const draft=state.draft;if(!draft||draft.kind!=='site_continuation'||draft.requestId!==request.requestId||draft.revision!==request.revision||draft.reviewedRevision!==request.revision||draft.status!=='reviewed'||state.attempts.some(function(a){return a.requestId===request.requestId;}))return done('display','Review the current continuation before confirming. Recorded attempts are never replayed.');}state.continuationPreparation={request:copy(request),suppliers_Id:origin.suppliers_Id,SupplierSiteId:origin.SupplierSiteId,originRequestId:origin.requestId,rows:[],seen:{},offset:0,pages:0,paging:false,complete:false};return done('continuation_site_get');"
