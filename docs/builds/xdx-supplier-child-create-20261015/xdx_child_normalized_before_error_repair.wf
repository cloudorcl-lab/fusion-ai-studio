        {
          "id": "117",
          "code": "XDX_PRESENT_SITE_COMPLETION",
          "type": "CODE",
          "metadata": {
            "name": "XDX PRESENT SITE COMPLETION",
            "returnType": "object",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),dispatch=state.siteDispatch||{},attempt=(state.attempts||[]).filter(function(a){return a.kind==='site'&&a.requestId===dispatch.requestId&&a.revision===dispatch.revision;})[0];function done(op){state.nextOperation=op;return {state:state,operation:op};}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}function stop(message){dispatch.moreAssignments=false;if(attempt)attempt.status='assignments-incomplete';if(state.draft&&attempt&&state.draft.requestId===attempt.requestId)state.draft.status='assignments-incomplete';state.response={message:message,requestId:attempt&&attempt.requestId,revision:attempt&&attempt.revision,SupplierSiteId:attempt&&attempt.SupplierSiteId,site:attempt&&attempt.site,attempt:attempt};if(attempt)state.response.continuationCommand='Continue assignments for request '+(attempt.continuationOf||attempt.requestId);return done('display');}\nif(!attempt)return stop('The site request journal could not be read. No new write was submitted.');const complete=attempt.siteVerification==='verified'&&attempt.assignments.every(function(a){return a.status==='verified'&&a.verification==='verified';});if(!complete){if(state.response&&state.response.message&&state.response.message.indexOf('Site created; assignments incomplete.')===0)return done('display');return stop('Site created; assignments incomplete. Retain the created site and verified assignments. Reconcile existing pairs before separately reviewing a continuation.');}attempt.status='complete';dispatch.moreAssignments=false;if(state.draft&&state.draft.requestId===attempt.requestId)state.draft=null;state.response={message:'Site created and independently verified. All '+attempt.assignments.length+' assignment pairs were created and independently verified.',requestId:attempt.requestId,revision:attempt.revision,SupplierSiteId:attempt.SupplierSiteId,site:attempt.site,assignments:attempt.assignments.map(function(a){return {AssignmentId:a.AssignmentId,ClientBUId:a.payload.ClientBUId,BillToBUId:a.payload.BillToBUId,verification:a.verification};}),attempt:attempt};return done('display');"
