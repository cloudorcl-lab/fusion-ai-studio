ype\": \"string\"\n    },\n    \"CustomerNumber\": {\n      \"type\": \"null\"\n    },\n    \"StandardIndustryClass\": {\n      \"type\": \"null\"\n    },\n    \"IndustryCategory\": {\n      \"type\": \"null\"\n    },\n    \"IndustrySubcategory\": {\n      \"type\": \"null\"\n    },\n    \"NationalInsuranceNumber\": {\n      \"type\": \"null\"\n    },\n    \"NationalInsuranceNumberExistsFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"CorporateWebsite\": {\n      \"type\": \"null\"\n    },\n    \"YearEstablished\": {\n      \"type\": \"null\"\n    },\n    \"MissionStatement\": {\n      \"type\": \"null\"\n    },\n    \"YearIncorporated\": {\n      \"type\": \"null\"\n    },\n    \"ChiefExecutiveTitle\": {\n      \"type\": \"null\"\n    },\n    \"ChiefExecutiveName\": {\n      \"type\": \"null\"\n    },\n    \"PrincipalTitle\": {\n      \"type\": \"null\"\n    },\n    \"PrincipalName\": {\n      \"type\": \"null\"\n    },\n    \"FiscalYearEndMonthCode\": {\n      \"type\": \"null\"\n    },\n    \"FiscalYearEndMonth\": {\n      \"type\": \"null\"\n    },\n    \"CurrentFiscalYearPotentialRevenue\": {\n      \"type\": \"null\"\n    },\n    \"PreferredFunctionalCurrencyCode\": {\n      \"type\": \"null\"\n    },\n    \"PreferredFunctionalCurrency\": {\n      \"type\": \"null\"\n    },\n    \"TaxRegistrationCountryCode\": {\n      \"type\": \"null\"\n    },\n    \"TaxRegistrationCountry\": {\n      \"type\": \"null\"\n    },\n    \"TaxRegistrationNumber\": {\n      \"type\": \"null\"\n    },\n    \"TaxpayerCountryCode\": {\n      \"type\": \"null\"\n    },\n    \"TaxpayerCountry\": {\n      \"type\": \"null\"\n    },\n    \"TaxpayerId\": {\n      \"type\": \"null\"\n    },\n    \"TaxpayerIdExistsFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"FederalReportableFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"FederalIncomeTaxTypeCode\": {\n      \"type\": \"null\"\n    },\n    \"FederalIncomeTaxType\": {\n      \"type\": \"null\"\n    },\n    \"StateReportableFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"TaxReportingName\": {\n      \"type\": \"null\"\n    },\n    \"NameControl\": {\n      \"type\": \"null\"\n    },\n    \"VerificationDate\": {\n      \"type\": \"null\"\n    },\n    \"UseWithholdingTaxFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"WithholdingTaxGroupId\": {\n      \"type\": \"null\"\n    },\n    \"WithholdingTaxGroup\": {\n      \"type\": \"null\"\n    },\n    \"BusinessClassificationNotApplicableFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"SpendAuthReviewStatus\": {\n      \"type\": \"null\"\n    },\n    \"SpendAuthReviewStatusDisplay\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxId\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxCompanyName\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxLegalName\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxCompanyPrimaryURL\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxNAICSCode\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxCountry\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxEIN\": {\n      \"type\": \"null\"\n    },\n    \"DataFoxLastSyncDate\": {\n      \"type\": \"null\"\n    },\n    \"OBNEnabledFlag\": {\n      \"type\": \"null\"\n    },\n    \"OnOFACListFlag\": {\n      \"type\": \"null\"\n    },\n    \"OFACSources\": {\n      \"type\": \"null\"\n    },\n    \"SupplierRegId\": {\n      \"type\": \"null\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          },\n          \"properties\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"changeIndicator\": {\n                \"type\": \"string\"\n         