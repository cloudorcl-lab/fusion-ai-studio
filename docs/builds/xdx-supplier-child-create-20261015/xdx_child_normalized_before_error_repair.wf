        {
          "id": "71",
          "code": "XDX_BUILD_SITE_DRAFT",
          "type": "CODE",
          "metadata": {
            "name": "XDX Build Site Draft",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst p=state.sitePreparation||{};\nfunction done(message){state.nextOperation='display';state.response={message:message};return {state:state,operation:'display'};}\nfunction id(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}\nif(state.draft&&p.mode!=='confirm')return done('A draft already exists. Edit it or cancel its exact request and revision before starting another.');\nconst source=p.source,address=p.address,parent=p.supplier,rows=p.assignments;\nif(!parent||!id(parent.SupplierId)||String(parent.SupplierId)!==p.suppliers_Id||!source||!id(source.SupplierSiteId)||source.Status!=='ACTIVE'||source.SitePurposePurchasingFlag!==true||!id(source.ProcurementBUId)||!id(source.SupplierAddressId))return done('Choose an active purchasing site under the selected supplier. Nothing was created.');\nif(!address||address.Status!=='ACTIVE'||address.SupplierAddressId!==source.SupplierAddressId||address.AddressName!==source.SupplierAddressName||p.addressParentId!==p.suppliers_Id)return done('The source site address could not be verified under this supplier. Nothing was created.');\nif(p.assignmentsComplete!==true||!Array.isArray(rows)||p.assignmentParentId!==p.suppliers_Id||p.assignmentSiteId!==String(source.SupplierSiteId))return done('The complete source assignments must be resolved before preparing this site.');\nconst seen={};if(rows.some(function(row){if(!row||!id(row.AssignmentId)||!id(row.ClientBUId)||!id(row.BillToBUId))return true;const pair=String(row.ClientBUId)+':'+String(row.BillToBUId);if(seen[pair])return true;seen[pair]=true;return false;}))return done('The source assignment pairs are incomplete or ambiguous. Nothing was created.');\nconst name=typeof p.newName==='string'?p.newName:'';\nif(!name.trim()||name.length>240||/[\\x00-\\x1f]/.test(name))return done('Provide a new site name of up to 240 characters.');\nif(p.nameChecked!==name||p.nameConflict!==false)return done('A complete name-conflict check is required for the proposed site.');\nif(p.mode==='confirm'){\n const c=p.confirmation,draft=state.draft;\n if(!c||!draft||draft.kind!=='site'||draft.status!=='reviewed'||draft.requestId!==c.requestId||draft.revision!==c.revision||draft.reviewedRevision!==c.revision||!Array.isArray(state.attempts)||state.attempts.some(function(a){return a.requestId===c.requestId;}))return done('This site request is no longer eligible for submission. Review the current draft; recorded attempts are never replayed.');\n const pairs=rows.map(function(row){return {ClientBUId:row.ClientBUId,BillToBUId:row.BillToBUId};});\n const payload={SupplierSite:name,ProcurementBUId:source.ProcurementBUId,SupplierAddressName:address.AddressName,SitePurposePurchasingFlag:true};\n function pairKeys(values){return values.map(function(row){return row.ClientBUId+':'+row.BillToBUId;}).sort().join('|');}\n if(c.suppliers_Id!==p.suppliers_Id||c.sourceSiteId!==String(source.SupplierSiteId)||String(draft.supplier.SupplierId)!==c.suppliers_Id||String(draft.source.SupplierSiteId)!==c.sourceSiteId)return done('The source supplier or site no longer matches the reviewed request. Nothing was created.');\n if(JSON.stringify(draft.payload)!==JSON.stringify(c.payload)||pairKeys(draft.assignments)!==pairKeys(c.assignments))return done('The draft changed after confirmation. Review it again.');\n if(c.addressId!==String(address.SupplierAddressId)||JSON.stringify(payload)!==JSON.stringify(c.payload)||pairKeys(pairs)!==pairKeys(c.assignments)){\n  draft.revision++;draft.status='editing';draft.source=source;draft.address=address;draft.payload=payload;draft.assignments=pairs;draft.sourceAssignmentIds=rows.map(function(row){return row.AssignmentId;});draft.assignmentsComplete=true;draft.eligibilityVerified=true;draft.duplicateCheckedRevision=draft.revision;delete draft.reviewedRevision;delete state.siteConfirmation;delete state.sitePreparation;\n  state.nextOperation='display';state.response={message:'The source changed after review. Review the updated site and assignment pairs before confirming. Nothing was created.',requestId:draft.requestId,revision:draft.revision,payload:payload,supplier:draft.supplier,source:source,address:address,assignments:pairs,writeCount:1+pairs.length,reviewCommand:'Review request '+draft.requestId+' revision '+draft.revision};return {state:state,operation:'display'};\n }\n const attempt={kind:'site',requestId:draft.requestId,revision:draft.revision,status:'reserved',suppliers_Id:c.suppliers_Id,sourceSiteId:c.sourceSiteId,addressId:c.addressId,payload:JSON.parse(JSON.stringify(c.payload)),assignments:c.assignments.map(function(pair){return {payload:JSON.parse(JSON.stringify(pair)),status:'pending'};}),siteVerification:'pending'};\n state.attempts.push(attempt);draft.status='reserved';state.siteDispatch={requestId:attempt.requestId,revision:attempt.revision,suppliers_Id:attempt.suppliers_Id,addressId:attempt.addressId,payload:JSON.parse(JSON.stringify(attempt.payload)),assignmentIndex:0,moreAssignments:false};delete state.siteConfirmation;delete state.sitePreparation;state.nextOperation='create_site';state.response={message:'The reviewed site request is reserved for one creation attempt.',requestId:attempt.requestId,revision:attempt.revision};return {state:state,operation:'create_site'};\n}\nconst conversation=$context.$workflow&&$context.$workflow.$conversationId,sequence=state.nextRequestSequence,requestId='REQ-'+conversation+'-'+sequence;\nif(typeof conversation!=='string'||! /^[A-Za-z0-9_-]+$/.test(conversation)||requestId.length>96||!Number.isSafeInteger(sequence)||sequence<1||sequence>=9007199254740991)return done('A unique site draft could not be initialized. Nothing was created.');\nconst pairs=rows.map(function(row){return {ClientBUId:row.ClientBUId,BillToBUId:row.BillToBUId};});\nconst draft={kind:'site',requestId:requestId,revision:1,status:'editing',supplier:parent,source:source,address:address,payload:{SupplierSite:name,ProcurementBUId:source.ProcurementBUId,SupplierAddressName:address.AddressName,SitePurposePurchasingFlag:true},assignments:pairs,sourceAssignmentIds:rows.map(function(row){return row.AssignmentId;}),assignmentsComplete:true,duplicateCheckedRevision:1,eligibilityVerified:true};\nstate.draft=draft;state.nextRequestSequence=sequence+1;state.nextOperation='display';state.response={message:'Site draft prepared. Nothing has been created.',requestId:requestId,revision:1,payload:draft.payload,supplier:parent,source:source,address:address,assignments:pairs,writeCount:1+pairs.length,writeOrder:'Create site, independently verify it, then create and verify each assignment serially.',omitted:'Generated IDs and optional settings, including DFFs and KFFs, are not copied.',reviewCommand:'Review request '+requestId+' revision 1'};\nreturn {state:state,operation:'display'};\r\n",
            "returnType": "object"
          },
