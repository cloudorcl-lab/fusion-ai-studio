e\",\n    \"FederalIncomeTaxType\",\n    \"StateReportableFlag\",\n    \"TaxReportingName\",\n    \"NameControl\",\n    \"VerificationDate\",\n    \"UseWithholdingTaxFlag\",\n    \"WithholdingTaxGroupId\",\n    \"WithholdingTaxGroup\",\n    \"BusinessClassificationNotApplicableFlag\",\n    \"SpendAuthReviewStatus\",\n    \"SpendAuthReviewStatusDisplay\",\n    \"DataFoxId\",\n    \"DataFoxCompanyName\",\n    \"DataFoxLegalName\",\n    \"DataFoxCompanyPrimaryURL\",\n    \"DataFoxNAICSCode\",\n    \"DataFoxCountry\",\n    \"DataFoxEIN\",\n    \"DataFoxLastSyncDate\",\n    \"OBNEnabledFlag\",\n    \"OnOFACListFlag\",\n    \"OFACSources\",\n    \"SupplierRegId\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
