        {
          "id": "15",
          "code": "XDX_ACCEPT_SUPPLIER_DETAIL",
          "type": "CODE",
          "metadata": {
            "name": "XDX Accept Supplier Detail",
            "returnType": "object",
            "sourceCode": "function finalize(){state.nextOperation=result.operation;return result;}\nconst response=$context.$nodes.XDX_READ_SUPPLIER.$output;\nconst state=JSON.parse(JSON.stringify($context.$variables.supplierState));\nconst pending=state.pending||{};\nconst result={operation:'display',state:state};\nfunction stop(message){state.response={message:message};return finalize();}\nif(!response || typeof response.SupplierId!=='number' || !Number.isSafeInteger(response.SupplierId) || response.SupplierId<=0 || String(response.SupplierId)!==pending.suppliers_Id || typeof response.Supplier!=='string' || typeof response.SupplierNumber!=='string' || typeof response.Status!=='string')return stop('The supplier detail could not be verified. The draft was not changed.');\nif(pending.purpose!=='template' && response.Status!=='ACTIVE' && pending.includeInactive!==true)return stop('This supplier is inactive. Ask explicitly to view inactive suppliers.');\nstate.selection=JSON.parse(JSON.stringify(response));\nif(pending.purpose==='child_create'){result.operation='child_prepare';return finalize();}\nif(pending.purpose==='children'){result.operation='children';return finalize();}\nif(pending.purpose==='site_template'){result.operation='site_template';return finalize();}\nstate.activeRead='suppliers';\nif(pending.purpose!=='template'){state.response={message:'Supplier details.',supplier:state.selection};return finalize();}\nif(['ACTIVE','INACTIVE'].indexOf(response.Status)<0)return stop('The source supplier status could not be verified.');\nif(state.draft)return stop('A draft already exists. Edit or cancel it before starting another.');\nconst fields=['SupplierType','BusinessRelationship','TaxOrganizationType'];\nconst missing=fields.filter(function(k){return typeof response[k]!=='string' || !response[k].trim() || response[k].length>80;});\nconst conversation=$context.$workflow && $context.$workflow.$conversationId;\nconst sequence=state.nextRequestSequence;\nconst requestId='REQ-'+conversation+'-'+sequence;\nif(typeof conversation!=='string' || !/^[A-Za-z0-9_-]+$/.test(conversation) || requestId.length>96 || !Number.isSafeInteger(sequence) || sequence<1 || sequence>=9007199254740991)return stop('A unique draft request could not be initialized. Nothing was created.');\nconst name=typeof pending.newName==='string'?pending.newName:'';\nif(name.length>360)return stop('The new supplier name must be at most 360 characters.');\nconst draft={kind:'supplier',requestId:requestId,revision:1,status:'editing',source:JSON.parse(JSON.stringify(response)),payload:{Supplier:name,SupplierType:missing.indexOf('SupplierType')<0?response.SupplierType:null,BusinessRelationship:response.BusinessRelationship,TaxOrganizationType:response.TaxOrganizationType},classificationsVerified:missing.length===0};\nstate.nextRequestSequence=sequence+1;state.draft=draft;\nstate.response={message:missing.length?'Choose values for '+missing.join(', ')+'. The new supplier remains a draft.':'Review the inherited classifications and enter the new supplier name.',requestId:draft.requestId,revision:1,payload:draft.payload,source:draft.source};\nif(missing.length || !name.trim())return finalize();\nstate.pending={purpose:'duplicate',q:\"Supplier='\"+name.replace(/'/g,\"''\")+\"'\",limit:1,offset:0,requestId:draft.requestId,revision:draft.revision,name:name};result.operation='duplicate';return finalize();\r\n"
          },
