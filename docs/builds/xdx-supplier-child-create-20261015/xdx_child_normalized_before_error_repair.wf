          "metadata": {
            "name": "XDX HANDLE SITE WRITE ERROR",
            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState));function done(op,message){state.nextOperation=op;if(message)state.response={message:message};return {state:state,operation:op};}function copy(v){return JSON.parse(JSON.stringify(v));}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}\nconst dispatch=state.siteDispatch||{},attempt=(state.attempts||[]).filter(function(a){return a.kind==='site'&&a.requestId===dispatch.requestId&&a.revision===dispatch.revision;})[0];function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}\nif(attempt){if(attempt.status==='reserved')attempt.status='uncertain';attempt.siteVerification=attempt.SupplierSiteId?'readback-pending':attempt.siteVerification;dispatch.moreAssignments=false;if(state.draft&&state.draft.requestId===attempt.requestId)state.draft.status=attempt.status;}state.nextOperation='display';state.response={message:attempt&&attempt.SupplierSiteId?'The site was accepted, but verification could not finish. Assignments have not started. The site will not be created again.':'The site creation outcome is uncertain. No assignment was started and this site request will not be submitted again. Reconcile it before any further write.',requestId:attempt&&attempt.requestId,revision:attempt&&attempt.revision,SupplierSiteId:attempt&&attempt.SupplierSiteId,attempt:attempt};state.response.errorText=state.response.message+' Site ID: '+(state.response.SupplierSiteId||'unresolved')+'. '+(state.response.continuationCommand||'');return {state:state,operation:'display'};",
