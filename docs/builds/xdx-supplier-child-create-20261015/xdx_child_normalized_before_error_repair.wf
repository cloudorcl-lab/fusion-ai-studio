            "name": "XDX VALIDATE CHILD DRAFT",
            "returnType": "object",
            "sourceCode": "const childPhase=$context.$variables.supplierState.nextOperation;\nif([\"child_validate\",\"child_preflight\"].indexOf(childPhase)<0)return {state:JSON.parse(JSON.stringify($context.$variables.supplierState)),operation:childPhase};\nconst state=JSON.parse(JSON.stringify($context.$variables.supplierState)),d=state.draft;\n function done(op,message){state.nextOperation=op;state.response={message:message};if(d){state.response.kind=d.kind;state.response.mode=d.mode;state.response.supplier=d.supplier;state.response.payload=d.payload;state.response.requestId=d.requestId;state.response.revision=d.revision;state.response.source=d.source;state.response.reviewCommand='Review request '+d.requestId+' revision '+d.revision;state.response.cancelCommand='Cancel request '+d.requestId+' revision '+d.revision;}return {state:state,operation:op,requestId:d&&d.requestId,revision:d&&d.revision};}\n if(!d||['address','contact'].indexOf(d.kind)<0||['editing','reviewed'].indexOf(d.status)<0||state.attempts.some(function(a){return a.requestId===d.requestId;}))return done('display','This child request cannot be changed after an attempt.');\n const address=d.kind==='address',fields=address?['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email','AddressPurposeOrderingFlag']:['FirstName','LastName','Email'],p=d.payload,limits={AddressName:240,CountryCode:2,AddressLine1:240,City:60,State:60,PostalCode:60,Email:320,FirstName:150,LastName:150};\n if(!p||Object.keys(p).length!==fields.length||Object.keys(p).some(function(f){return fields.indexOf(f)<0;}))return done('display','The draft has unsupported fields; only the required creation fields are allowed.');\n const missing=fields.filter(function(f){return f!=='AddressPurposeOrderingFlag'&&(typeof p[f]!=='string'||!p[f].trim());});if(missing.length)return done('display','Provide '+missing.join(', ')+'. This remains an uncreated '+d.kind+' draft.');\n if(address&&p.CountryCode!=='US')return done('display','This complete address creation flow currently supports US addresses only. Choose a US source or supply the required US address fields. Nothing has been created.');\n if(fields.some(function(f){return f!=='AddressPurposeOrderingFlag'&&(p[f].length>limits[f]||/[\\x00-\\x1f]/.test(p[f]));})||!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.Email)||address&&(!/^[A-Z]{2}$/.test(p.CountryCode)||p.AddressPurposeOrderingFlag!==true))return done('display','Provide valid required-field values within their documented lengths and a valid email address.');\n if(!d.supplier||!Number.isSafeInteger(d.supplier.SupplierId)||d.supplier.SupplierId<=0||String(d.supplier.SupplierId)!==d.suppliers_Id||['direct','template'].indexOf(d.mode)<0||d.mode==='template'&&(!d.source||d.sourceParentId!==d.suppliers_Id||!d.sourceId))return done('display','The supplier and same-parent template identity must be verified before review.');\n if(d.mode==='template'&&(address&&p.AddressName===d.source.AddressName||!address&&p.FirstName===d.source.FirstName&&p.LastName===d.source.LastName&&p.Email===d.source.Email))return done('display','Give this new '+d.kind+' a distinctive identity before review. The source record will not be changed.');\n if(state.attempts.some(function(a){return a.kind===d.kind&&a.suppliers_Id===d.suppliers_Id&&JSON.stringify(a.payload)===JSON.stringify(p);}))return done('display','An identical child payload already has a recorded attempt. Reconcile that attempt; it will not be submitted again.');\n d.fieldsVerifiedRevision=d.revision;\n if(address){state.childNameCheck={suppliers_Id:d.suppliers_Id,q:\"AddressName='\"+p.AddressName.replace(/'/g,\"''\")+\"'\",limit:1,offset:0,requestId:d.requestId,revision:d.revision,name:p.AddressName};return done('address_name_check','Checking the proposed address name under its supplier. Nothing has been created.');}\n if(state.childConfirmation)return done('child_reserve','The exact reviewed contact request is ready to reserve.');\n return done('display','Contact draft prepared. Nothing has been created. Review the current revision before confirming.');"
