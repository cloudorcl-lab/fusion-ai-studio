            "sourceCode": "const state=JSON.parse(JSON.stringify($context.$variables.supplierState)),dispatch=state.siteDispatch||{},attempt=(state.attempts||[]).filter(function(a){return a.kind==='site'&&a.requestId===dispatch.requestId&&a.revision===dispatch.revision;})[0];function done(op){state.nextOperation=op;return {state:state,operation:op};}function key(v){return typeof v==='number'&&Number.isSafeInteger(v)&&v>0;}function decimal(v){if(typeof v==='number')return key(v)?String(v):null;return typeof v==='string'&&/^[1-9][0-9]{0,17}$/.test(v)?v:null;}function stop(message){dispatch.moreAssignments=false;if(attempt)attempt.status='assignments-incomplete';if(state.draft&&attempt&&state.draft.requestId===attempt.requestId)state.draft.status='assignments-incomplete';state.response={message:message,requestId:attempt&&attempt.requestId,revision:attempt&&attempt.revision,SupplierSiteId:attempt&&attempt.SupplierSiteId,site:attempt&&attempt.site,attempt:attempt};if(attempt)state.response.continuationCommand='Continue assignments for request '+(attempt.continuationOf||attempt.requestId);state.response.errorText=state.response.message+' Site ID: '+(state.response.SupplierSiteId||'unresolved')+'. '+(state.response.continuationCommand||'');return done('display');}\nconst row=attempt&&attempt.assignments[dispatch.assignmentIndex];if(row&&row.status==='reserved')row.status='uncertain';if(row&&row.status==='accepted')row.verification='readback-pending';return stop('Site created; assignments incomplete. The current assignment failed or could not be verified. Completed assignments remain intact. No automatic retry or further assignment was submitted. Reconcile existing pairs before separately reviewing a continuation.');"
