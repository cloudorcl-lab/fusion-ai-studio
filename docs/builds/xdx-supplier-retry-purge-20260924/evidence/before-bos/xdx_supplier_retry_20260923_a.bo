      {
        "name": "FindSuppliersByPartialName",
        "description": "Find suppliers by a validated nonempty name fragment; bounded paging and business identity fields only.",
        "operationId": "getall_suppliers",
        "operationType": "GET",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers?q=Supplier like '%{supplierName}%'&fields=SupplierId,SupplierNumber,Supplier,SupplierType,BusinessRelationship,InactiveDate&onlyData=true&orderBy=SupplierId:asc&limit={limit}&offset={offset}",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "supplierName",
            "dataType": "string",
            "description": "Nonempty validated name fragment; escape apostrophes by doubling; reject query syntax and URL delimiters.",
            "id": 2,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "limit",
            "dataType": "integer",
            "description": "Positive bounded page size, maximum 100.",
            "id": 3,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "25"
          },
          {
            "name": "offset",
            "dataType": "integer",
            "description": "Nonnegative page offset.",
            "id": 4,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "0"
          }
        ],
        "sampleQueries": [
