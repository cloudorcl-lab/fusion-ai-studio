      {
        "name": "ListSupplierSites",
        "description": "Read sites under a current resolved supplier with bounded paging.",
        "operationId": "getall_suppliers-sites",
        "operationType": "GET",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers/{suppliers_Id}/child/sites?q={filter}&fields=SupplierSiteId,SupplierSite,ProcurementBUId,ProcurementBU,SupplierAddressId,SupplierAddressName,Status,SitePurposePurchasingFlag&onlyData=true&orderBy=SupplierSiteId:asc&limit={limit}&offset={offset}",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "suppliers_Id",
            "dataType": "string",
            "description": "Current supplier key resolved before site lookup.",
            "id": 13,
            "isToken": true,
            "location": "path",
            "source": "openapi",
            "defaultValue": ""
          },
          {
            "name": "filter",
            "dataType": "string",
            "description": "Trusted deterministic rowmatch only.",
