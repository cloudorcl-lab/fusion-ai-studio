   \"AlternateSiteName\": {\n            \"type\": \"null\"\n          },\n          \"CustomerNumber\": {\n            \"type\": \"null\"\n          },\n          \"B2BCommunicationMethodCode\": {\n            \"type\": \"string\"\n          },\n          \"B2BCommunicationMethod\": {\n            \"type\": \"string\"\n          },\n          \"B2BSupplierSiteCode\": {\n            \"type\": \"null\"\n          },\n          \"CommunicationMethodCode\": {\n            \"type\": \"null\"\n          },\n          \"CommunicationMethod\": {\n            \"type\": \"null\"\n          },\n          \"Email\": {\n            \"type\": \"null\"\n          },\n          \"FaxCountryCode\": {\n            \"type\": \"null\"\n          },\n          \"FaxAreaCode\": {\n            \"type\": \"null\"\n          },\n          \"FaxNumber\": {\n            \"type\": \"null\"\n          },\n          \"HoldAllNewPurchasingDocumentsFlag\": {\n            \"anyOf\": [\n              {\n                \"type\": \"boolean\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"PurchasingHoldReason\": {\n            \"type\": \"null\"\n          },\n          \"AllNewPurchasingDocumentsHoldDate\": {\n            \"type\": \"null\"\n          },\n          \"AllNewPurchasingDocumentsHoldBy\": {\n            \"type\": \"null\"\n          },\n          \"RequiredAcknowledgmentCode\": {\n            \"type\": \"null\"\n          },\n          \"RequiredAcknowledgment\": {\n            \"type\": \"null\"\n          },\n          \"AcknowledgmentWithinDays\": {\n            \"type\": \"null\"\n          },\n          \"CarrierId\": {\n            \"type\": \"null\"\n          },\n          \"Carrier\": {\n            \"type\": \"null\"\n          },\n          \"ModeOfTransportCode\": {\n            \"type\": \"null\"\n          },\n          \"ModeOfTransport\": {\n            \"type\": \"null\"\n          },\n  