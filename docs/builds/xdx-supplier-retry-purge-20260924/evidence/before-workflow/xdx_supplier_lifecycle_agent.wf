          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplierAddressId\": {\n            \"type\": \"number\"\n          },\n          \"AddressName\": {\n            \"type\": \"string\"\n          },\n          \"CountryCode\": {\n            \"type\": \"string\"\n          },\n          \"Country\": {\n            \"type\": \"string\"\n          },\n          \"AddressLine1\": {\n            \"type\": \"string\"\n          },\n          \"AddressLine2\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"AddressLine3\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"AddressLine4\": {\n            \"type\": \"null\"\n          },\n          \"City\": {\n            \"type\": \"string\"\n          },\n          \"State\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"PostalCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"PostalCodeExtension\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Province\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"County\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Building\": {\n            \"type\": \"null\"\n          },\n          \"FloorNumber\": {\n            \"type\": \"null\"\n          },\n          \"PhoneticAddress\": {\n            \"type\": \"null\"\n          },\n          \"LanguageCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Language\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Addressee\": {\n            \"type\": \"null\"\n          },\n          \"GlobalLocationNumber\": {\n            \"type\": \"null\"\n          },\n          \"AdditionalAddressAttribute1\": {\n            \"type\": \"null\"\n          },\n          \"AdditionalAddressAttribute2\": {\n            \"type\": \"null\"\n          },\n          \"AdditionalAddressAttribute3\": {\n            \"type\": \"null\"\n          },\n          \"AdditionalAddressAttribute4\": {\n            \"type\": \"null\"\n          },\n          \"AdditionalAddressAttribute5\": {\n            \"type\": \"null\"\n          },\n          \"FormattedAddress\": {\n            \"type\": \"string\"\n          },\n          \"AddressPurposeOrderingFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"AddressPurposeRemitToFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"AddressPurposeRFQOrBiddingFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"PhoneCountryCode\": {\n            \"type\": \"null\"\n          },\n          \"PhoneAreaCode\": {\n            \"type\": \"null\"\n          },\n          \"PhoneNumber\": {\n            \"type\": \"null\"\n          },\n          \"PhoneExtension\": {\n            \"type\": \"null\"\n          },\n          \"FaxCountryCode\": {\n            \"type\": \"null\"\n          },\n          \"FaxAreaCode\": {\n            \"type\": \"null\"\n          },\n          \"FaxNumber\": {\n            \"type\": \"null\"\n          },\n          \"Email\": {\n            \"type\": \"null\"\n          },\n          \"InactiveDate\": {\n            \"type\": \"string\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"CreatedBy\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"AddressPartyNumber\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"SupplierAddressId\",\n          \"AddressName\",\n          \"CountryCode\",\n          \"Country\",\n          \"AddressLine1\",\n          \"AddressLine2\",\n          \"AddressLine3\",\n          \"AddressLine4\",\n          \"City\",\n          \"State\",\n          \"PostalCode\",\n          \"PostalCodeExtension\",\n          \"Province\",\n          \"County\",\n          \"Building\",\n          \"FloorNumber\",\n          \"PhoneticAddress\",\n          \"LanguageCode\",\n          \"Language\",\n          \"Addressee\",\n          \"GlobalLocationNumber\",\n          \"AdditionalAddressAttribute1\",\n          \"AdditionalAddressAttribute2\",\n          \"AdditionalAddressAttribute3\",\n          \"AdditionalAddressAttribute4\",\n          \"AdditionalAddressAttribute5\",\n          \"FormattedAddress\",\n          \"AddressPurposeOrderingFlag\",\n          \"AddressPurposeRemitToFlag\",\n          \"AddressPurposeRFQOrBiddingFlag\",\n          \"PhoneCountryCode\",\n          \"PhoneAreaCode\",\n          \"PhoneNumber\",\n          \"PhoneExtension\",\n          \"FaxCountryCode\",\n          \"FaxAreaCode\",\n          \"FaxNumber\",\n          \"Email\",\n          \"InactiveDate\",\n          \"Status\",\n          \"CreationDate\",\n          \"CreatedBy\",\n          \"LastUpdateDate\",\n          \"LastUpdatedBy\",\n          \"AddressPartyNumber\"\n        ],\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
