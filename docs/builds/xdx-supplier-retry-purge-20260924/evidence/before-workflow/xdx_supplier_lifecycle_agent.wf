          "code": "XDX_FORMAT_PRODUCTS_READ",
          "type": "CODE",
          "metadata": {
            "name": "XDX FORMAT PRODUCTS READ",
            "returnType": "object",
            "sourceCode": "\nconst parent=$context.$nodes.XDX_RESOLVE_SUPPLIER.$output.result,r=$context.$nodes.XDX_FETCH_PRODUCTS_READ.$output;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||typeof r.hasMore!=='boolean')return {display:'Products/services query failed or returned an invalid page. No write occurred.'};\nconst description='Supplier '+parent.supplierName+'. '+(r.items.length?r.items.length+' product/service association(s).':'No products/services found.')+(r.hasMore?' Next offset: '+(Number(parent.offset)+r.count)+'.':'');\nreturn {display:'<oraInfoDisplay key=\"products-services-list\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Supplier products and services',description,properties:{cols:['Category','Category type'],selectMode:'none',rows:r.items.map(x=>({cells:[x.CategoryName||'—',x.CategoryType==='BROWSING'?'Browsing':x.CategoryType||'—']}))}})+'</oraInfoDisplay>'};\n"
          },
