          "metadata": {
            "name": "XDX REDUCE ASSIGNMENT DRAFT",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"site-assignment-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Site assignment draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Supplier site',c.SupplierSite],['Client business unit',c.ClientBU],['Bill-to business unit',c.BillToBU]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\nconst req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result,old=$context.$variables.xdxAssignmentDraft,ledger=$context.$variables.xdxAssignmentWrites||{};\nconst blank={candidate:{Supplier:'',SupplierSite:'',ClientBU:'',BillToBU:''},revision:0,reviewedRevision:0,reviewedCandidate:'',snapshot:null,approvedRevision:0,approvedSnapshot:''};let state=old&&old.candidate?JSON.parse(JSON.stringify(old)):blank;const revision=state.revision;\nif(req.action==='prepare')state=JSON.parse(JSON.stringify(blank));const before=JSON.stringify(state.candidate);\nif(req.action==='prepare'||req.action==='edit'){const patch=req.assignmentPatch||{};for(const k of ['Supplier','SupplierSite','ClientBU','BillToBU'])if(typeof patch[k]==='string')state.candidate[k]=patch[k].trim();}\nconst p=state.candidate,canonical=JSON.stringify(p);if(req.action==='prepare'||before!==canonical){state.revision=revision+1;state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';}\nconst safe=x=>typeof x==='string'&&x.length>0&&Array.from(x).every(c=>c.charCodeAt(0)>=32&&![34,92,38,35,63,37].includes(c.charCodeAt(0)));\nconst valid=safe(p.Supplier)&&p.Supplier.length<=360&&safe(p.SupplierSite)&&p.SupplierSite.length<=240&&safe(p.ClientBU)&&p.ClientBU.length<=240&&safe(p.BillToBU)&&p.BillToBU.length<=240;const businessKey=JSON.stringify([p.Supplier.toLowerCase(),p.SupplierSite.toLowerCase(),p.ClientBU.toLowerCase()]);const prior=Object.values(ledger).find(x=>x.businessKey===businessKey)||null;\nlet resolve=false,mode=req.action,message='Site assignment draft saved. No assignment has been created.';\nif(req.action==='review'){state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';resolve=valid;message=valid?'Resolving supplier, site and both business units.':'Complete supplier, site and both business unit names before review.';}\nif(req.action==='approve'){const m=/^Approve site-assignment revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());if(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.snapshot){state.approvedRevision=state.revision;state.approvedSnapshot=JSON.stringify(state.snapshot);message='Site assignment revision '+state.revision+' approved without writing. To create, enter: Create site-assignment revision '+state.revision+'.';}else message='Approval rejected. Review the current complete site assignment draft and approve its exact revision. No write occurred.';}\nif(req.action==='create'){const m=/^Create site-assignment revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());resolve=!!(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.approvedRevision===state.revision&&state.snapshot&&state.approvedSnapshot===JSON.stringify(state.snapshot));message='Creation requires approval of the exact current reviewed site assignment revision. No write occurred.';if(prior)mode='reconcile';}\nif(req.action==='reconcile'){resolve=!!prior;message='No previous site assignment attempt exists for this draft. No write occurred.';}if(resolve&&mode==='reconcile'&&prior)state.candidate=JSON.parse(JSON.stringify(prior.candidate));return {state,resolve,mode,ledger,prior,businessKey,filter:\"Supplier='\"+state.candidate.Supplier.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "193"
          },
