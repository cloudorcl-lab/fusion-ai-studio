        {
          "id": "63",
          "code": "XDX_BIND_SITE_PARENT",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND SITE PARENT",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_SITE_DRAFT.$output.result;\nconst r=$context.$nodes.XDX_RESOLVE_SITE_PARENT.$output;\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst valid=!!(item&&item.Supplier===p.state.candidate.Supplier&&/^[1-9][0-9]*$/.test(String(item.SupplierId))&&(!p.prior||String(p.prior.snapshot.supplierId)===String(item.SupplierId)));\nreturn {valid:valid,supplierId:valid?String(item.SupplierId):'',filter:\"AddressName='\"+p.state.candidate.SupplierAddressName.replace(/'/g,\"''\")+\"'\",message:'The supplier could not be resolved uniquely or its identity changed. No site write occurred.'};\n",
