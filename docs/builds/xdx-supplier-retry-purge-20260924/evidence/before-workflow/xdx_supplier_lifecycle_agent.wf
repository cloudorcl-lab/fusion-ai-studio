        {
          "id": "219",
          "code": "XDX_CONFIRM_ASSIGNMENT_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX CONFIRM ASSIGNMENT CREATE",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"site-assignment-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Site assignment draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Supplier site',c.SupplierSite],['Client business unit',c.ClientBU],['Bill-to business unit',c.BillToBU]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst bound=$context.$nodes.XDX_BIND_ASSIGNMENT_REFERENCES.$output.result,decision=$context.$nodes.XDX_DECIDE_ASSIGNMENT_CREATE.$output.result,post=$context.$nodes.XDX_CREATE_ASSIGNMENT.$output,r=$context.$nodes.XDX_VERIFY_ASSIGNMENT.$output;\nconst ledger=JSON.parse(JSON.stringify(decision.ledger));if(post&&/^[1-9][0-9]*$/.test(String(post.AssignmentId)))ledger[bound.key].assignmentId=String(post.AssignmentId);\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst match=!!(item&&post&&['ClientBUId','BillToBUId'].every(k=>String(item[k])===String(bound.snapshot.payload[k])&&String(post[k])===String(bound.snapshot.payload[k]))&&/^[1-9][0-9]*$/.test(String(post.AssignmentId))&&String(item.AssignmentId)===String(post.AssignmentId));\nif(match)ledger[bound.key].status='confirmed';return {confirmed:match,ledger,display:show(bound.state,match?'Site assignment created and independently verified.':'Site assignment creation is not independently confirmed. Do not retry POST; reconcile the existing attempt.')};",
            "returnType": "object"
          },
          "outcomes": {
            "success": "220"
          },
          "inputs": [],
          "diagram": {
            "x": 10568.75,
            "y": 10978
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
