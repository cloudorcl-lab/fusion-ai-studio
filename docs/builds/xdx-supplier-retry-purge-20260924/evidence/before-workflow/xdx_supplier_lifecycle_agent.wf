        {
          "id": "249",
          "code": "XDX_NORMALIZE_REQUEST",
          "type": "CODE",
          "metadata": {
            "name": "XDX Normalize Request",
            "sourceCode": "const candidate = $context.$nodes.XDX_EXTRACT_SEARCH.$output || {};\nconst request = JSON.parse(JSON.stringify(candidate));\nconst raw = String($context.$system.$inputMessage || '').trim();\nconst aliases = {'supplier':'suppliers','address':'addresses','site':'sites','contact':'contacts','classification':'classifications','contact-address':'contactAddresses','products-services':'productsAndServices','products/services':'productsAndServices','site-assignment':'siteAssignments'};\nconst revisionCommand = /^(Approve|Create) (supplier|address|site|contact|classification|contact-address|products-services|products\\/services|site-assignment) revision ([1-9][0-9]*)\\.?$/i.exec(raw);\nconst reviewCommand = /^Review (?:the )?(?:exact )?(supplier|address|site|contact|classification|contact-address|products-services|products\\/services|site-assignment) draft(?: again)?\\.?$/i.exec(raw);\nif (!revisionCommand && !reviewCommand) return request;\nrequest.action = revisionCommand ? revisionCommand[1].toLowerCase() : 'review';\nrequest.resource = aliases[(revisionCommand ? revisionCommand[2] : reviewCommand[1]).toLowerCase()];\nrequest.supplierName = '';\n['draftPatch','addressPatch','sitePatch','contactPatch','classificationPatch','linkPatch','productPatch','assignmentPatch'].forEach(function(name) {\n  const patch = request[name];\n  if (patch && typeof patch === 'object') Object.keys(patch).forEach(function(key) {patch[key] = null;});\n});\nrequest.readContext = {ContactEmail:null,SupplierSite:null};\nreturn request;\r\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "20"
          },
          "inputs": [],
          "diagram": {
            "x": 16475,
            "y": 5650
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
