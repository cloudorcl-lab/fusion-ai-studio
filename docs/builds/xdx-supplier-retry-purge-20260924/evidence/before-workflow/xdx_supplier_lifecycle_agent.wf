        {
          "id": "38",
          "code": "XDX_REDUCE_ADDRESS_DRAFT",
          "type": "CODE",
          "metadata": {
            "name": "XDX REDUCE ADDRESS DRAFT",
            "sourceCode": "\nconst req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result;\nconst old=$context.$variables.xdxAddressDraft;\nconst blank={supplierName:'',payload:{AddressName:'',AddressLine1:'',CountryCode:'',Email:'',AddressPurposeOrderingFlag:false},revision:0,reviewedRevision:0,reviewedPayload:'',approvedRevision:0,approvedPayload:''};\nlet state=old&&old.payload?JSON.parse(JSON.stringify(old)):blank;\nconst revision=state.revision||0;\nif(req.action==='prepare')state=JSON.parse(JSON.stringify(blank));\nconst before=JSON.stringify({supplierName:state.supplierName,payload:state.payload});\nif(req.action==='prepare'||req.action==='edit'){\n const patch=req.addressPatch||{};\n if(typeof patch.Supplier==='string')state.supplierName=patch.Supplier.trim();\n for(const k of ['AddressName','AddressLine1','CountryCode','Email'])if(typeof patch[k]==='string')state.payload[k]=patch[k].trim();\n if(typeof patch.AddressPurposeOrderingFlag==='boolean')state.payload.AddressPurposeOrderingFlag=patch.AddressPurposeOrderingFlag;\n}\nconst canonical=JSON.stringify({supplierName:state.supplierName,payload:state.payload});\nif(req.action==='prepare'||canonical!==before){state.revision=revision+1;state.reviewedRevision=0;state.reviewedPayload='';state.approvedRevision=0;state.approvedPayload='';}\nconst p=state.payload;const errors=[];\nfor(const pair of [['Supplier',state.supplierName,360],['Address name',p.AddressName,240],['Address line',p.AddressLine1,240],['Email',p.Email,320]])if(!pair[1]||pair[1].length>pair[2]||/[\\x00-\\x1f\"\\\\&#?%]/.test(pair[1]))errors.push(pair[0]+' is required and must be within supported length and characters.');\nif(!/^[A-Z]{2}$/.test(p.CountryCode))errors.push('Country code requires two uppercase letters.');\nif(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.Email))errors.push('A valid address email is required.');\nif(p.AddressPurposeOrderingFlag!==true)errors.push('Explicit purchasing purpose must be true.');\nlet message='Address draft saved. No address has been created.';\nif(req.action==='review'){\n if(errors.length)message='Complete the required address fields before review. No address has been created.';\n else{state.reviewedRevision=state.revision;state.reviewedPayload=canonical;message='Review this supplier and exact five-field address payload. To approve without creating, enter: Approve address revision '+state.revision+'.';}\n}\nif(req.action==='approve'){\n const m=/^Approve address revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());\n if(!errors.length&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedPayload===canonical){state.approvedRevision=state.revision;state.approvedPayload=canonical;message='Address revision '+state.revision+' is approved. No address has been created. To create this exact approved address, enter: Create address revision '+state.revision+'.';}\n else message='Approval was not accepted. Review the current complete address draft and approve its exact revision. No write was performed.';\n}\nconst fields=[['Supplier',state.supplierName],['Address name',p.AddressName],['Address line',p.AddressLine1],['Country code',p.CountryCode],['Email',p.Email],['Purchasing purpose',p.AddressPurposeOrderingFlag===true?'Yes':'Required']];\nconst display='<oraInfoDisplay key=\"address-result\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Address draft revision '+state.revision,description:'Exact supplier and address payload review',properties:{subtitle:message+(errors.length?' '+errors.join(' '):''),cols:['Field','Value'],selectMode:'none',rows:fields.map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';\nreturn {state:state,valid:errors.length===0,errors:errors,display:display};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "39"
          },
          "inputs": [],
          "diagram": {
            "x": 22550,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
