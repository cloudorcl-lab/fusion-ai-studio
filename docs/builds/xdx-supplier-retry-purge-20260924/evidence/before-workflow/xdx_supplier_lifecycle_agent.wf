 }\n            },\n            \"required\": [\n              \"changeIndicator\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": true\n      }\n    }\n  },\n  \"required\": [\n    \"SupplierId\",\n    \"SupplierPartyId\",\n    \"Supplier\",\n    \"SupplierNumber\",\n    \"AlternateName\",\n    \"TaxOrganizationTypeCode\",\n    \"TaxOrganizationType\",\n    \"SupplierTypeCode\",\n    \"SupplierType\",\n    \"InactiveDate\",\n    \"Status\",\n    \"BusinessRelationshipCode\",\n    \"BusinessRelationship\",\n    \"RelationshipDisplay\",\n    \"RequestNumber\",\n    \"ParentSupplierId\",\n    \"ParentSupplier\",\n    \"ParentSupplierNumber\",\n    \"CreationDate\",\n    \"CreatedBy\",\n    \"LastUpdateDate\",\n    \"LastUpdatedBy\",\n    \"CreationSourceCode\",\n    \"CreationSource\",\n    \"DataFoxScore\",\n    \"DataFoxScoringCriteria\",\n    \"Alias\",\n    \"DUNSNumber\",\n    \"OneTimeSupplierFlag\",\n    \"RegistryId\",\n    \"CustomerNumber\",\n    \"StandardIndustryClass\",\n    \"IndustryCategory\",\n    \"IndustrySubcategory\",\n    \"NationalInsuranceNumber\",\n    \"NationalInsuranceNumberExistsFlag\",\n    \"CorporateWebsite\",\n    \"YearEstablished\",\n    \"MissionStatement\",\n    \"YearIncorporated\",\n    \"ChiefExecutiveTitle\",\n    \"ChiefExecutiveName\",\n    \"PrincipalTitle\",\n    \"PrincipalName\",\n    \"FiscalYearEndMonthCode\",\n    \"FiscalYearEndMonth\",\n    \"CurrentFiscalYearPotentialRevenue\",\n    \"PreferredFunctionalCurrencyCode\",\n    \"PreferredFunctionalCurrency\",\n    \"TaxRegistrationCountryCode\",\n    \"TaxRegistrationCountry\",\n    \"TaxRegistrationNumber\",\n    \"TaxpayerCountryCode\",\n    \"TaxpayerCountry\",\n    \"TaxpayerId\",\n    \"TaxpayerIdExistsFlag\",\n    \"FederalReportableFlag\",\n    \"FederalIncomeTaxTypeCode\",