        {
          "id": "33",
          "code": "XDX_CONFIRM_SUPPLIER_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX Confirm Supplier Create",
            "sourceCode": "const prepared=$context.$nodes.XDX_PREPARE_SUPPLIER_CREATE.$output.result;\nconst decision=$context.$nodes.XDX_DECIDE_SUPPLIER_CREATE.$output.result;\nconst posted=$context.$nodes.XDX_CREATE_SUPPLIER.$output;\nconst read=$context.$nodes.XDX_VERIFY_SUPPLIER.$output;\nconst ledger=JSON.parse(JSON.stringify(decision.ledger));\nconst rows=read && read.items;\nconst keys=['SupplierId','SupplierNumber','SupplierPartyId'];\nconst one=Array.isArray(rows) && rows.length===1 && Number(read.count)===1 && read.hasMore===false;\nconst persisted=one && keys.every(k=>posted && String(posted[k]||'') && String(rows[0][k])===String(posted[k])) && ['Supplier','BusinessRelationship','TaxOrganizationType'].every(k=>rows[0][k]===prepared.payload[k]);\nlet message='Supplier creation is not fully confirmed. Another POST is blocked. Reconcile the prior attempt by read before continuing.';\nif(persisted){ledger[prepared.key].status='confirmed';ledger[prepared.key].supplierId=String(rows[0].SupplierId);ledger[prepared.key].supplierNumber=String(rows[0].SupplierNumber);message='Supplier created once and independently confirmed. Supplier number: '+rows[0].SupplierNumber+'.';}\nconst display='<oraInfoDisplay key=\"supplier-create-confirmation\">'+JSON.stringify({title:'Supplier creation',patternId:'multiRecordWidget',description:'Supplier creation and independent verification result',properties:{subtitle:message,selectMode:'none',cols:['Supplier','Supplier number','Business relationship','Tax organization type'],rows:[{cells:[prepared.payload.Supplier,persisted?String(rows[0].SupplierNumber):'Not confirmed',prepared.payload.BusinessRelationship,prepared.payload.TaxOrganizationType]}]}})+'</oraInfoDisplay>';\nreturn {confirmed:!!persisted,ledger:ledger,message:message,display:display};\r\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "34"
          },
          "inputs": [],
          "diagram": {
            "x": 18275,
            "y": 7870
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
