        {
          "id": "175",
          "code": "XDX_BIND_PRODUCT_REFERENCES",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND PRODUCT REFERENCES",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"products-services-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Products/services draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Category',c.CategoryName],['Category type','Browsing']].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst p=$context.$nodes.XDX_REDUCE_PRODUCT_DRAFT.$output.result,parent=$context.$nodes.XDX_BIND_PRODUCT_PARENT.$output.result,r=$context.$nodes.XDX_RESOLVE_PRODUCT_CATEGORY.$output;const state=JSON.parse(JSON.stringify(p.state)),c=state.candidate,item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;let valid=!!(item&&item.CategoryName===c.CategoryName&&item.CategoryType==='SUPPLIER'&&Number.isSafeInteger(Number(item.CategoryId))&&Number(item.CategoryId)>0);const snapshot={supplierId:parent.supplierId,payload:{ProductsServicesCategoryId:valid?Number(item.CategoryId):0,CategoryType:'BROWSING'}};let message='The category is missing, ambiguous or not a supplier browsing category. No association write occurred.';\nif(valid&&p.mode!=='review'){const approved=p.mode==='reconcile'&&p.prior?p.prior.snapshot:state.snapshot;valid=JSON.stringify(snapshot)===JSON.stringify(approved);message='Supplier or category changed since review. Review and approve again. No association write occurred.';}\nif(valid&&p.mode==='review'){state.snapshot=snapshot;state.reviewedRevision=state.revision;state.reviewedCandidate=JSON.stringify(c);state.approvedRevision=0;state.approvedSnapshot='';message='Review this supplier and category. The request contains only the category reference and Browsing type. To approve without writing, enter: Approve products-services revision '+state.revision+'.';}\nreturn {valid,review:valid&&p.mode==='review',state,snapshot,key:'products-services:'+snapshot.supplierId+':'+snapshot.payload.ProductsServicesCategoryId,filter:'ProductsServicesCategoryId='+snapshot.payload.ProductsServicesCategoryId,display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "176"
          },
          "inputs": [],
          "diagram": {
