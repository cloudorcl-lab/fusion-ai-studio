        {
          "id": "156",
          "code": "XDX_DECIDE_LINK_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX DECIDE LINK CREATE",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_LINK_DRAFT.$output.result,bound=$context.$nodes.XDX_BIND_LINK_REFERENCES.$output.result,r=$context.$nodes.XDX_CHECK_LINK_DUPLICATE.$output;\nconst ledger=JSON.parse(JSON.stringify(p.ledger)),prior=ledger[bound.key]||p.prior;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.hasMore!==false)return {canPost:false,ledger,message:'Association lookup is incomplete. No association write occurred.'};\nif(prior||p.mode==='reconcile'){const item=r.items.length===1?r.items[0]:null;const match=!!(item&&String(item.SupplierAddressId)===String(bound.snapshot.payload.SupplierAddressId)&&/^[1-9][0-9]*$/.test(String(item.SupplierContactAddressId))&&(!prior||!prior.associationId||String(prior.associationId)===String(item.SupplierContactAddressId)));if(match)ledger[bound.key]=Object.assign({},prior,{status:'confirmed',associationId:String(item.SupplierContactAddressId)});return {canPost:false,ledger,message:match?'The previous contact-address association is independently confirmed. No repeat POST occurred.':'The previous association attempt remains unresolved. Another POST is blocked; reconcile instead.'};}\nif(r.items.length)return {canPost:false,ledger,message:'This address is already associated with this contact. No POST occurred.'};\nledger[bound.key]={status:'pending',businessKey:p.businessKey,candidate:p.state.candidate,snapshot:bound.snapshot,revision:p.state.revision};return {canPost:true,ledger,message:'Approved association attempt recorded before POST.'};\n",
            "returnType": "object"
          },
