          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplierContactId\": {\n            \"type\": \"number\"\n          },\n          \"PersonProfileId\": {\n            \"type\": \"number\"\n          },\n          \"ContactName\": {\n            \"type\": \"string\"\n          },\n          \"FirstName\": {\n            \"type\": \"string\"\n          },\n          \"LastName\": {\n            \"type\": \"string\"\n          },\n          \"Email\": {\n            \"type\": \"string\"\n          },\n          \"JobTitle\": {\n            \"type\": \"null\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"UserName\": {\n            \"type\": \"string\"\n          },\n          \"UserAccountStatus\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"SupplierContactId\",\n          \"PersonProfileId\",\n          \"ContactName\",\n          \"FirstName\",\n          \"LastName\",\n          \"Email\",\n          \"JobTitle\",\n          \"Status\",\n          \"UserName\",\n          \"UserAccountStatus\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
