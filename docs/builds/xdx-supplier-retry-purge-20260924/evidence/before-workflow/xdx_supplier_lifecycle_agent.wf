\"AdditionalAddressAttribute4\",\n          \"AdditionalAddressAttribute5\",\n          \"FormattedAddress\",\n          \"AddressPurposeOrderingFlag\",\n          \"AddressPurposeRemitToFlag\",\n          \"AddressPurposeRFQOrBiddingFlag\",\n          \"PhoneCountryCode\",\n          \"PhoneAreaCode\",\n          \"PhoneNumber\",\n          \"PhoneExtension\",\n          \"FaxCountryCode\",\n          \"FaxAreaCode\",\n          \"FaxNumber\",\n          \"Email\",\n          \"InactiveDate\",\n          \"Status\",\n          \"CreationDate\",\n          \"CreatedBy\",\n          \"LastUpdateDate\",\n          \"LastUpdatedBy\",\n          \"AddressPartyNumber\"\n        ],\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
