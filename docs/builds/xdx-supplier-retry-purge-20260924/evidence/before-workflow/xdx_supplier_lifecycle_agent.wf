        {
          "id": "126",
          "code": "XDX_CONFIRM_CLASSIFICATION_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX CONFIRM CLASSIFICATION CREATE",
            "sourceCode": "function show(state,message){const p=state.candidate;return '<oraInfoDisplay key=\"classification-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Classification draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['Classification code',p.ClassificationCode]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst bound=$context.$nodes.XDX_BIND_CLASSIFICATION_PARENT.$output.result,decision=$context.$nodes.XDX_DECIDE_CLASSIFICATION_CREATE.$output.result,post=$context.$nodes.XDX_CREATE_CLASSIFICATION.$output,r=$context.$nodes.XDX_VERIFY_CLASSIFICATION.$output;\nconst ledger=JSON.parse(JSON.stringify(decision.ledger));\nif(post&&/^[1-9][0-9]*$/.test(String(post.ClassificationId)))ledger[bound.key].classificationId=String(post.ClassificationId);\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst match=!!(item&&post&&item.ClassificationCode===bound.snapshot.payload.ClassificationCode&&/^[1-9][0-9]*$/.test(String(post.ClassificationId))&&String(item.ClassificationId)===String(post.ClassificationId));\nif(match)ledger[bound.key].status='confirmed';\nreturn {confirmed:match,ledger,display:show(bound.state,match?'Classification created and independently verified under the approved supplier.':'Classification creation is not independently confirmed. Do not retry POST; reconcile the existing attempt.')};\n",
            "returnType": "object"
          },
