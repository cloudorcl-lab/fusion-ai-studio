        {
          "id": "233",
          "code": "XDX_BIND_LINK_READ_CONTACT",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND LINK READ CONTACT",
            "returnType": "object",
            "sourceCode": "\nconst r=$context.$nodes.XDX_RESOLVE_LINK_READ_CONTACT.$output,q=$context.$nodes.XDX_PREPARE_LINK_READ.$output.result;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.hasMore!==false)return {valid:false,reason:'Contact lookup failed or is incomplete. No contact addresses were queried.'};\nconst exact=r.items.filter(x=>String(x.Email||'').toLowerCase()===q.email.toLowerCase());\nif(exact.length!==1)return {valid:false,reason:'Select one unique contact email under this supplier before querying its addresses.'};\nconst id=String(exact[0].SupplierContactId||'');\nif(!/^[1-9][0-9]*$/.test(id))return {valid:false,reason:'The contact returned no valid key. No contact addresses were queried.'};\nreturn {valid:true,contactId:id,email:exact[0].Email};\n"
          },
          "outcomes": {
            "success": "234"
          },
          "inputs": [],
