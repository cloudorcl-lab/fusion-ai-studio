        {
          "id": "201",
          "code": "XDX_BIND_ASSIGNMENT_SITE",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND ASSIGNMENT ADDRESS",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_ASSIGNMENT_DRAFT.$output.result,r=$context.$nodes.XDX_RESOLVE_ASSIGNMENT_SITE.$output;\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst valid=!!(item&&item.SupplierSite===p.state.candidate.SupplierSite&&item.Status==='ACTIVE'&&/^[1-9][0-9]*$/.test(String(item.SupplierSiteId)));\nreturn {valid,siteId:valid?String(item.SupplierSiteId):'',filter:\"ProcurementBU='\"+p.state.candidate.ClientBU.replace(/'/g,\"''\")+\"'\",message:'The supplier site is missing, ambiguous or inactive under this supplier. No assignment write occurred.'};",
            "returnType": "object"
          },
