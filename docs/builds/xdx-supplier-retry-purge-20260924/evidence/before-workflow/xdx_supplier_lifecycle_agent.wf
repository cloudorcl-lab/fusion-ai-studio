        {
          "id": "205",
          "code": "XDX_BIND_ASSIGNMENT_REFERENCES",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND ASSIGNMENT REFERENCES",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"site-assignment-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Site assignment draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Supplier site',c.SupplierSite],['Client business unit',c.ClientBU],['Bill-to business unit',c.BillToBU]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\nfunction resolveBU(r,name){let valid=!!(r&&Array.isArray(r.items)&&r.items.length>0&&r.count===r.items.length&&r.hasMore===false);const ids={};if(valid)for(const row of r.items){if(row.ProcurementBU!==name||!Number.isSafeInteger(Number(row.ProcurementBUId))||Number(row.ProcurementBUId)<=0)valid=false;ids[String(row.ProcurementBUId)]=true;}if(Object.keys(ids).length!==1)valid=false;return {valid,id:valid?Number(Object.keys(ids)[0]):null};}\n\nconst p=$context.$nodes.XDX_REDUCE_ASSIGNMENT_DRAFT.$output.result,parent=$context.$nodes.XDX_BIND_ASSIGNMENT_PARENT.$output.result,site=$context.$nodes.XDX_BIND_ASSIGNMENT_SITE.$output.result,client=$context.$nodes.XDX_BIND_ASSIGNMENT_CLIENT_BU.$output.result,r=$context.$nodes.XDX_RESOLVE_ASSIGNMENT_BILL_BU.$output;\nconst state=JSON.parse(JSON.stringify(p.state)),c=state.candidate,b=resolveBU(r,c.BillToBU);let valid=b.valid;\nconst snapshot={supplierId:parent.supplierId,siteId:site.siteId,payload:{ClientBUId:client.clientBUId,BillToBUId:b.id}};\nlet message='The bill-to business unit is missing or ambiguous in the complete lookup. No assignment write occurred.';\nif(valid&&p.mode!=='review'){const approved=p.mode==='reconcile'&&p.prior?p.prior.snapshot:state.snapshot;valid=JSON.stringify(snapshot)===JSON.stringify(approved);message='The supplier, site or business units changed since review. Review and approve again. No assignment write occurred.';}\nif(valid&&p.mode==='review'){state.snapshot=snapshot;state.reviewedRevision=state.revision;state.reviewedCandidate=JSON.stringify(c);state.approvedRevision=0;state.approvedSnapshot='';message='Review this supplier site and the two business unit roles. The request contains only the two resolved BU references. To approve without writing, enter: Approve site-assignment revision '+state.revision+'.';}\nreturn {valid,review:valid&&p.mode==='review',state,snapshot,key:'site-assignment:'+snapshot.supplierId+':'+snapshot.siteId+':'+snapshot.payload.ClientBUId,filter:'ClientBUId='+snapshot.payload.ClientBUId,display:show(state,message)};",
            "returnType": "object"
          },
          "outcomes": {
            "success": "206"
          },
          "inputs": [],
          "diagram": {
            "x": 11243.75,
            "y": 8980
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
