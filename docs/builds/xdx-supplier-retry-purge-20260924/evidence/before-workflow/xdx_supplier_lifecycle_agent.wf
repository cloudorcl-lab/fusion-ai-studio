        {
          "id": "223",
          "code": "XDX_BIND_ASSIGNMENT_CLIENT_BU",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND ASSIGNMENT CLIENT BU",
            "returnType": "object",
            "sourceCode": "function resolveBU(r,name){let valid=!!(r&&Array.isArray(r.items)&&r.items.length>0&&r.count===r.items.length&&r.hasMore===false);const ids={};if(valid)for(const row of r.items){if(row.ProcurementBU!==name||!Number.isSafeInteger(Number(row.ProcurementBUId))||Number(row.ProcurementBUId)<=0)valid=false;ids[String(row.ProcurementBUId)]=true;}if(Object.keys(ids).length!==1)valid=false;return {valid,id:valid?Number(Object.keys(ids)[0]):null};}\nconst p=$context.$nodes.XDX_REDUCE_ASSIGNMENT_DRAFT.$output.result,r=$context.$nodes.XDX_RESOLVE_ASSIGNMENT_CLIENT_BU.$output,b=resolveBU(r,p.state.candidate.ClientBU);return {valid:b.valid,clientBUId:b.id,filter:\"ProcurementBU='\"+p.state.candidate.BillToBU.replace(/'/g,\"''\")+\"'\",message:'The client business unit is missing or ambiguous in the complete lookup. No assignment write occurred.'};"
          },
          "outcomes": {
            "success": "224"
          },
          "inputs": [],
          "diagram": {
