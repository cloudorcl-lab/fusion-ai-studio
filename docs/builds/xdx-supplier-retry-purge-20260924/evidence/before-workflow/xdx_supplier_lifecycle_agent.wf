            "sourceCode": "\nconst x=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result||{},site=String((x.readContext||{}).SupplierSite||'').trim();\nif(!site||site.length>240||/[\\x00-\\x1f&?#{}%]/.test(site))return {valid:false,reason:'Specify one exact site name under the selected supplier before listing assignments.'};\nreturn {valid:true,site,filter:\"SupplierSite='\"+site.replace(/'/g,\"''\")+\"'\"};\n"
          },
