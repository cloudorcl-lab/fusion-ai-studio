          "id": "93",
          "code": "XDX_BIND_CONTACT_PARENT",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND CONTACT PARENT",
            "sourceCode": "\nfunction show(state,message){const p=state.candidate;return '<oraInfoDisplay key=\"contact-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Contact draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['First name',p.FirstName],['Last name',p.LastName],['Email',p.Email]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst p=$context.$nodes.XDX_REDUCE_CONTACT_DRAFT.$output.result,r=$context.$nodes.XDX_RESOLVE_CONTACT_PARENT.$output;\nconst state=JSON.parse(JSON.stringify(p.state)),c=state.candidate;\nconst item=r&&Array.isArray(r.items)&&r.items.length===1&&r.count===1&&r.hasMore===false?r.items[0]:null;\nlet valid=!!(item&&item.Supplier===c.Supplier&&/^[1-9][0-9]*$/.test(String(item.SupplierId)));\nconst payload={FirstName:c.FirstName,LastName:c.LastName,Email:c.Email};\nconst snapshot={supplierId:item?String(item.SupplierId):'',payload};\nlet message='The supplier could not be resolved uniquely. No contact write occurred.';\nif(valid&&p.mode!=='review'){const approved=p.mode==='reconcile'&&p.prior?p.prior.snapshot:state.snapshot;valid=JSON.stringify(snapshot)===JSON.stringify(approved);message='The supplier identity or payload changed since review. Review and approve again. No write occurred.';}\nif(valid&&p.mode==='review'){state.snapshot=snapshot;state.reviewedRevision=state.revision;state.reviewedCandidate=JSON.stringify(c);state.approvedRevision=0;state.approvedSnapshot='';message='Review this supplier and exact three-field contact payload. No user account will be requested. To approve without writing, enter: Approve contact revision '+state.revision+'.';}\nreturn {valid,review:valid&&p.mode==='review',state,snapshot,key:'contact:'+snapshot.supplierId+':'+c.Email.toLowerCase(),filter:\"Email='\"+c.Email.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
