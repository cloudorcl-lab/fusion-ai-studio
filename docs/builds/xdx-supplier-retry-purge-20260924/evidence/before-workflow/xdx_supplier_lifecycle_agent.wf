        {
          "id": "182",
          "code": "XDX_DECIDE_PRODUCT_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX DECIDE PRODUCT CREATE",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_PRODUCT_DRAFT.$output.result,bound=$context.$nodes.XDX_BIND_PRODUCT_REFERENCES.$output.result,r=$context.$nodes.XDX_CHECK_PRODUCT_DUPLICATE.$output;const ledger=JSON.parse(JSON.stringify(p.ledger)),prior=ledger[bound.key]||p.prior;if(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.hasMore!==false)return {canPost:false,ledger,message:'Products/services lookup is incomplete. No association write occurred.'};\nif(prior||p.mode==='reconcile'){const item=r.items.length===1?r.items[0]:null;const match=!!(item&&String(item.ProductsServicesCategoryId)===String(bound.snapshot.payload.ProductsServicesCategoryId)&&item.CategoryType==='BROWSING'&&/^[1-9][0-9]*$/.test(String(item.SupplierProductsServicesId))&&(!prior||!prior.associationId||String(prior.associationId)===String(item.SupplierProductsServicesId)));if(match)ledger[bound.key]=Object.assign({},prior,{status:'confirmed',associationId:String(item.SupplierProductsServicesId)});return {canPost:false,ledger,message:match?'The previous products/services association is independently confirmed. No repeat POST occurred.':'The previous products/services attempt remains unresolved. Another POST is blocked; reconcile instead.'};}\nif(r.items.length)return {canPost:false,ledger,message:'This category is already associated with this supplier. No POST occurred.'};ledger[bound.key]={status:'pending',businessKey:p.businessKey,candidate:p.state.candidate,snapshot:bound.snapshot,revision:p.state.revision};return {canPost:true,ledger,message:'Approved association attempt recorded before POST.'};\n",
            "returnType": "object"
          },
