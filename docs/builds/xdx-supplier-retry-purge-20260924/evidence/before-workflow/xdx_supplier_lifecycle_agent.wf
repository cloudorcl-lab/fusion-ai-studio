        {
          "id": "41",
          "code": "XDX_PREPARE_ADDRESS_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX PREPARE ADDRESS CREATE",
            "sourceCode": "\nconst req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result;\nconst draft=$context.$variables.xdxAddressDraft;\nconst saved=$context.$variables.xdxAddressWrites;\nconst ledger=saved&&typeof saved==='object'?JSON.parse(JSON.stringify(saved)):{};\nconst bad={canQuery:false,ledger:ledger,message:'Prepare, review and approve the current complete address draft first. No address was created.'};\nif(!draft||!draft.payload||!draft.supplierName)return bad;\nconst p=draft.payload;\nconst payload={AddressName:p.AddressName,AddressLine1:p.AddressLine1,CountryCode:p.CountryCode,Email:p.Email,AddressPurposeOrderingFlag:p.AddressPurposeOrderingFlag};\nconst canonical=JSON.stringify({supplierName:draft.supplierName,payload:payload});\nconst businessKey=JSON.stringify([draft.supplierName.trim().toLowerCase(),String(p.AddressName).trim().toLowerCase()]);\nconst prior=Object.keys(ledger).map(k=>ledger[k]).filter(x=>x.businessKey===businessKey)[0];\nif(req.action==='reconcile'){\n if(!prior)return {canQuery:false,ledger:ledger,message:'No recorded address attempt exists for this draft. No write was performed.'};\n return {canQuery:true,mode:'reconcile',ledger:ledger,businessKey:businessKey,supplierName:prior.supplierName,payload:prior.payload,revision:prior.revision,prior:prior,filter:\"Supplier='\"+prior.supplierName.replace(/'/g,\"''\")+\"'\"};\n}\nconst m=/^Create address revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());\nif(!m||Number(m[1])!==draft.revision||draft.approvedRevision!==draft.revision||draft.approvedPayload!==canonical||draft.reviewedPayload!==canonical)return bad;\nfor(const pair of [[draft.supplierName,360],[p.AddressName,240],[p.AddressLine1,240],[p.Email,320]])if(typeof pair[0]!=='string'||!pair[0]||pair[0].length>pair[1]||/[\\x00-\\x1f\"\\\\&#?%]/.test(pair[0]))return bad;\nif(!/^[A-Z]{2}$/.test(p.CountryCode)||! /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.Email)||p.AddressPurposeOrderingFlag!==true)return bad;\nreturn {canQuery:true,mode:prior?'reconcile':'create',ledger:ledger,businessKey:businessKey,supplierName:draft.supplierName,payload:payload,revision:draft.revision,prior:prior||null,filter:\"Supplier='\"+draft.supplierName.replace(/'/g,\"''\")+\"'\"};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "42"
          },
          "inputs": [],
