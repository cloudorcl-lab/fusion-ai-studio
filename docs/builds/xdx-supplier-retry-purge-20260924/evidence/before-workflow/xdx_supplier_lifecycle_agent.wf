        {
          "id": "99",
          "code": "XDX_DECIDE_CONTACT_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX DECIDE CONTACT CREATE",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_CONTACT_DRAFT.$output.result,bound=$context.$nodes.XDX_BIND_CONTACT_PARENT.$output.result,r=$context.$nodes.XDX_CHECK_CONTACT_DUPLICATE.$output;\nconst ledger=JSON.parse(JSON.stringify(p.ledger)),prior=ledger[bound.key]||p.prior;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.hasMore!==false)return {canPost:false,ledger,message:'Contact lookup is incomplete. No contact write occurred.'};\nif(prior||p.mode==='reconcile'){const item=r.items.length===1?r.items[0]:null,payload=bound.snapshot.payload;const match=!!(item&&Object.keys(payload).every(k=>item[k]===payload[k])&&['SupplierContactId','PersonProfileId'].every(k=>/^[1-9][0-9]*$/.test(String(item[k])))&&item.UserName===null&&item.UserAccountStatus===null&&(!prior.contactId||String(prior.contactId)===String(item.SupplierContactId))&&(!prior.personProfileId||String(prior.personProfileId)===String(item.PersonProfileId)));if(match)ledger[bound.key]=Object.assign({},prior,{status:'confirmed',contactId:String(item.SupplierContactId),personProfileId:String(item.PersonProfileId)});return {canPost:false,ledger,message:match?'The previous contact attempt is independently confirmed with no user account. No repeat POST occurred.':'The previous contact attempt remains unresolved. Another POST is blocked; reconcile instead.'};}\nif(r.items.length)return {canPost:false,ledger,message:'A contact with this email already exists under this supplier. No POST occurred.'};\nledger[bound.key]={status:'pending',businessKey:p.businessKey,candidate:p.state.candidate,snapshot:bound.snapshot,revision:p.state.revision};\nreturn {canPost:true,ledger,message:'Approved contact attempt recorded before POST.'};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "100"
          },
