{
  "workflowId": "300000333987487",
  "workflowCode": "XDX_SUPPLIER_LIFECYCLE_AGENT",
  "name": "XDX Supplier Lifecycle Agent",
  "description": "Required-field supplier lifecycle with explicit review and persisted confirmation.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
