        {
          "id": "21",
          "code": "XDX_REDUCE_SUPPLIER_DRAFT",
          "type": "CODE",
          "metadata": {
            "name": "XDX Reduce Supplier Draft",
            "sourceCode": "const request = $context.$nodes.XDX_NORMALIZE_REQUEST.$output.result || {};\nconst action = request.action;\nconst raw = String($context.$system.$inputMessage || '').trim();\nconst prior = $context.$variables && $context.$variables.xdxSupplierDraft;\nconst empty = {revision:0,payload:{Supplier:'',BusinessRelationship:'',TaxOrganizationType:''},reviewedRevision:0,reviewedPayload:'',approvedRevision:0,approvedPayload:''};\nlet state = prior && typeof prior === 'object' && Number.isInteger(prior.revision) && prior.payload ? JSON.parse(JSON.stringify(prior)) : empty;\nif (action !== 'prepare' && state.revision === 0) return {state:state,valid:false,message:'No persisted supplier draft is available. Start a new supplier draft; no approval or write occurred.',approvalAccepted:false};\nif (action === 'prepare') { const revision = state.revision; state = empty; state.revision = revision; }\nconst fields = ['Supplier','BusinessRelationship','TaxOrganizationType'];\nconst patch = request.draftPatch || {};\nconst payload = {Supplier:String(state.payload.Supplier || ''),BusinessRelationship:String(state.payload.BusinessRelationship || ''),TaxOrganizationType:String(state.payload.TaxOrganizationType || '')};\nlet changed = action === 'prepare';\nif (action === 'prepare' || action === 'edit') {\n  fields.forEach(function(field) {\n    if (typeof patch[field] !== 'string') return;\n    let value = patch[field].trim();\n    if (field === 'BusinessRelationship' && value.toLowerCase() === 'spend authorized') value = 'Spend Authorized';\n    if (field === 'TaxOrganizationType' && value.toLowerCase() === 'corporation') value = 'Corporation';\n    if (payload[field] !== value) changed = true;\n    payload[field] = value;\n  });\n}\nif (changed) {\n  state.revision += 1;\n  state.payload = payload;\n  state.reviewedRevision = 0; state.reviewedPayload = '';\n  state.approvedRevision = 0; state.approvedPayload = '';\n}\nconst errors = [];\nif (!state.payload.Supplier || state.payload.Supplier.length > 360 || /[\\x00-\\x1f]/.test(state.payload.Supplier)) errors.push('Supplier name is required and must contain at most 360 characters without control characters.');\nif (state.payload.BusinessRelationship !== 'Spend Authorized') errors.push('Business relationship must be explicitly set to the validated value Spend Authorized.');\nif (state.payload.TaxOrganizationType !== 'Corporation') errors.push('Tax organization type must be explicitly set to the validated value Corporation.');\nconst canonical = JSON.stringify({Supplier:state.payload.Supplier,BusinessRelationship:state.payload.BusinessRelationship,TaxOrganizationType:state.payload.TaxOrganizationType});\nlet message = changed ? 'Draft updated. Any previous approval is invalid. No supplier has been created.' : 'Draft unchanged. No supplier has been created.';\nlet approvalAccepted = false;\nif (action === 'review') {\n  if (errors.length) message = 'Complete the required fields before review. No supplier has been created.';\n  else {state.reviewedRevision=state.revision;state.reviewedPayload=canonical;message='Review these exact three fields. To approve this draft without creating it, enter: Approve supplier revision '+state.revision+'.';}\n}\nif (action === 'approve') {\n  const match = /^Approve supplier revision ([1-9][0-9]*)\\.?$/i.exec(raw);\n  if (!errors.length && match && Number(match[1]) === state.revision && state.reviewedRevision === state.revision && state.reviewedPayload === canonical) {\n    state.approvedRevision=state.revision;state.approvedPayload=canonical;approvalAccepted=true;\n    message='Supplier draft revision '+state.revision+' is approved. No supplier has been created. To create this exact approved payload, enter: Create supplier revision '+state.revision+'.';\n  } else message='Approval was not accepted. Review the current complete draft and approve its exact revision. No supplier has been created.';\n}\nreturn {state:state,valid:errors.length===0,errors:errors,message:message,approvalAccepted:approvalAccepted,canonicalPayload:canonical,revision:state.revision,approvedRevision:state.approvedRevision};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "22"
          },
          "inputs": [],
          "diagram": {
            "x": 17825,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "22",
