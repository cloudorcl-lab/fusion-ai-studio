        {
          "id": "53",
          "code": "XDX_CONFIRM_ADDRESS_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX CONFIRM ADDRESS CREATE",
            "sourceCode": "\nconst p=$context.$nodes.XDX_PREPARE_ADDRESS_CREATE.$output.result;\nconst parent=$context.$nodes.XDX_BIND_ADDRESS_PARENT.$output.result;\nconst decision=$context.$nodes.XDX_DECIDE_ADDRESS_CREATE.$output.result;\nconst post=$context.$nodes.XDX_CREATE_ADDRESS.$output;\nconst r=$context.$nodes.XDX_VERIFY_ADDRESS.$output;\nconst ledger=JSON.parse(JSON.stringify(decision.ledger));\nconst item=r&&Array.isArray(r.items)&&r.items.length===1&&r.count===1&&r.hasMore===false?r.items[0]:null;\nconst match=item&&post&&Object.keys(p.payload).every(k=>item[k]===p.payload[k])&&['SupplierAddressId','AddressPartyNumber'].every(k=>post[k]&&String(post[k])===String(item[k]));\nif(match)ledger[parent.key]=Object.assign({},ledger[parent.key],{status:'confirmed',addressId:String(item.SupplierAddressId),addressPartyNumber:String(item.AddressPartyNumber)});\nconst message=match?'Address created and independently verified under the approved supplier.':'Address creation is not independently confirmed. Do not retry POST; reconcile this attempt.';\nconst display='<oraInfoDisplay key=\"address-result\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Address confirmation',description:'Independent supplier-scoped address verification',properties:{subtitle:message,cols:['Supplier','Address','Country','Purchasing purpose'],selectMode:'none',rows:[{cells:[p.supplierName,p.payload.AddressName,p.payload.CountryCode,match?'Yes':'Not confirmed']}]}})+'</oraInfoDisplay>';\nreturn {confirmed:!!match,ledger:ledger,message:message,display:display};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "54"
          },
          "inputs": [],
          "diagram": {
            "x": 14056.25,
            "y": 8536
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
