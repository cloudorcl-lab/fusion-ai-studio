        {
          "id": "247",
          "code": "XDX_FORMAT_ASSIGNMENT_READ",
          "type": "CODE",
          "metadata": {
            "name": "XDX FORMAT ASSIGNMENT READ",
            "returnType": "object",
            "sourceCode": "\nconst p=$context.$nodes.XDX_RESOLVE_SUPPLIER.$output.result,s=$context.$nodes.XDX_BIND_ASSIGNMENT_READ_SITE.$output.result,r=$context.$nodes.XDX_FETCH_ASSIGNMENT_READ.$output;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||typeof r.hasMore!=='boolean')return {display:'Site-assignment query failed or returned an invalid page. No write occurred.'};\nconst description='Supplier '+p.supplierName+'. Site '+s.site+'. '+(r.items.length?r.items.length+' assignment(s).':'No assignments found.')+(r.hasMore?' Next offset: '+(Number(p.offset)+r.count)+'.':'');\nreturn {display:'<oraInfoDisplay key=\"site-assignment-list\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Supplier site assignments',description,properties:{cols:['Client business unit','Bill-to business unit','Status'],selectMode:'none',rows:r.items.map(x=>({cells:[x.ClientBU||'—',x.BillToBU||'—',x.Status||'—']}))}})+'</oraInfoDisplay>'};\n"
          },
          "outcomes": {
            "success": "248"
          },
          "inputs": [],
          "diagram": {
            "x": 44600,
            "y": 8980
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
