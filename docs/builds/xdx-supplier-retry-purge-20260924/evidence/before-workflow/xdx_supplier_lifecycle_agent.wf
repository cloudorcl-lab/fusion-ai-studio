          "type": "CODE",
          "metadata": {
            "name": "XDX FORMAT LINK READ",
            "returnType": "object",
            "sourceCode": "\nconst p=$context.$nodes.XDX_RESOLVE_SUPPLIER.$output.result,c=$context.$nodes.XDX_BIND_LINK_READ_CONTACT.$output.result,r=$context.$nodes.XDX_FETCH_LINK_READ.$output;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||typeof r.hasMore!=='boolean')return {display:'Contact-address query failed or returned an invalid page. No write occurred.'};\nconst description='Supplier '+p.supplierName+'. Contact '+c.email+'. '+(r.items.length?r.items.length+' linked address(es).':'No linked addresses found.')+(r.hasMore?' Next offset: '+(Number(p.offset)+r.count)+'.':'');\nreturn {display:'<oraInfoDisplay key=\"contact-address-list\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Supplier contact addresses',description,properties:{cols:['Address'],selectMode:'none',rows:r.items.map(x=>({cells:[x.AddressName||'—']}))}})+'</oraInfoDisplay>'};\n"
          },
