          "code": "XDX_CONFIRM_CONTACT_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX CONFIRM CONTACT CREATE",
            "sourceCode": "\nfunction show(state,message){const p=state.candidate;return '<oraInfoDisplay key=\"contact-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Contact draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['First name',p.FirstName],['Last name',p.LastName],['Email',p.Email]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst bound=$context.$nodes.XDX_BIND_CONTACT_PARENT.$output.result,decision=$context.$nodes.XDX_DECIDE_CONTACT_CREATE.$output.result,post=$context.$nodes.XDX_CREATE_CONTACT.$output,r=$context.$nodes.XDX_VERIFY_CONTACT.$output;\nconst ledger=JSON.parse(JSON.stringify(decision.ledger));\nif(post&&/^[1-9][0-9]*$/.test(String(post.SupplierContactId)))ledger[bound.key].contactId=String(post.SupplierContactId);\nif(post&&/^[1-9][0-9]*$/.test(String(post.PersonProfileId)))ledger[bound.key].personProfileId=String(post.PersonProfileId);\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null,payload=bound.snapshot.payload;\nconst match=!!(item&&post&&Object.keys(payload).every(k=>item[k]===payload[k])&&['SupplierContactId','PersonProfileId'].every(k=>/^[1-9][0-9]*$/.test(String(post[k]))&&String(item[k])===String(post[k]))&&item.UserName===null&&item.UserAccountStatus===null);\nif(match)ledger[bound.key].status='confirmed';\nreturn {confirmed:match,ledger,display:show(bound.state,match?'Contact created and independently verified with all three approved identity values and generated keys. No user account was provisioned.':'Contact creation or account state is not independently confirmed. Do not retry POST; reconcile the existing attempt.')};\n",
            "returnType": "object"
          },
