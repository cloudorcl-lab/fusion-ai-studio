            "name": "XDX REDUCE CONTACT DRAFT",
            "sourceCode": "\nfunction show(state,message){const p=state.candidate;return '<oraInfoDisplay key=\"contact-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Contact draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['First name',p.FirstName],['Last name',p.LastName],['Email',p.Email]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result,old=$context.$variables.xdxContactDraft,ledger=$context.$variables.xdxContactWrites||{};\nconst blank={candidate:{Supplier:'',FirstName:'',LastName:'',Email:''},revision:0,reviewedRevision:0,reviewedCandidate:'',snapshot:null,approvedRevision:0,approvedSnapshot:''};\nlet state=old&&old.candidate?JSON.parse(JSON.stringify(old)):blank;\nconst revision=state.revision;\nif(req.action==='prepare')state=JSON.parse(JSON.stringify(blank));\nconst before=JSON.stringify(state.candidate);\nif(req.action==='prepare'||req.action==='edit'){const patch=req.contactPatch||{};for(const k of ['Supplier','FirstName','LastName','Email'])if(typeof patch[k]==='string')state.candidate[k]=patch[k].trim();}\nconst p=state.candidate,canonical=JSON.stringify(p);\nif(req.action==='prepare'||before!==canonical){state.revision=revision+1;state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';}\nconst valid=['Supplier','FirstName','LastName','Email'].every(k=>typeof p[k]==='string'&&p[k].length>0&&p[k].length<=({Supplier:360,FirstName:150,LastName:150,Email:320})[k]&&!/[\\x00-\\x1f\"\\\\&#?%]/.test(p[k]))&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.Email);\nconst businessKey=JSON.stringify([p.Supplier.toLowerCase(),p.Email.toLowerCase()]);\nconst prior=Object.keys(ledger).map(k=>ledger[k]).filter(x=>x.businessKey===businessKey)[0]||null;\nlet resolve=false,mode=req.action,message='Contact draft saved. No contact has been created.';\nif(req.action==='review'){state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';resolve=valid;message=valid?'Resolving the exact supplier.':'Complete supplier, first name, last name and valid email before review.';}\nif(req.action==='approve'){const m=/^Approve contact revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());if(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.snapshot){state.approvedRevision=state.revision;state.approvedSnapshot=JSON.stringify(state.snapshot);message='Contact revision '+state.revision+' approved without writing. To create this exact contact, enter: Create contact revision '+state.revision+'.';}else message='Approval rejected. Review the current complete contact draft and approve its exact revision. No write occurred.';}\nif(req.action==='create'){const m=/^Create contact revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());resolve=!!(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.approvedRevision===state.revision&&state.snapshot&&state.approvedSnapshot===JSON.stringify(state.snapshot));message='Creation requires approval of the exact current reviewed contact revision. No write occurred.';if(prior)mode='reconcile';}\nif(req.action==='reconcile'){resolve=!!prior;message='No previous contact attempt exists for this draft. No write occurred.';}\nif(resolve&&mode==='reconcile'&&prior)state.candidate=JSON.parse(JSON.stringify(prior.candidate));\nreturn {state,resolve,mode,ledger,prior,businessKey,filter:\"Supplier='\"+state.candidate.Supplier.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
