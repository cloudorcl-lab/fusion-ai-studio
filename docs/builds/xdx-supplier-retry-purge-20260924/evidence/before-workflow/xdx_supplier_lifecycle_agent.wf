        },
        {
          "id": "243",
          "code": "XDX_BIND_ASSIGNMENT_READ_SITE",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND ASSIGNMENT READ SITE",
            "returnType": "object",
            "sourceCode": "\nconst r=$context.$nodes.XDX_RESOLVE_ASSIGNMENT_READ_SITE.$output,q=$context.$nodes.XDX_PREPARE_ASSIGNMENT_READ.$output.result;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.hasMore!==false)return {valid:false,reason:'Site lookup failed or is incomplete. No assignments were queried.'};\nconst exact=r.items.filter(x=>String(x.SupplierSite||'').toLowerCase()===q.site.toLowerCase());\nif(exact.length!==1)return {valid:false,reason:'Select one unique site name under this supplier before querying assignments.'};\nconst id=String(exact[0].SupplierSiteId||'');\nif(!/^[1-9][0-9]*$/.test(id))return {valid:false,reason:'The site returned no valid key. No assignments were queried.'};\nreturn {valid:true,siteId:id,site:exact[0].SupplierSite};\n"
          },
          "outcomes": {
            "success": "244"
          },
          "inputs": [],
          "diagram": {
