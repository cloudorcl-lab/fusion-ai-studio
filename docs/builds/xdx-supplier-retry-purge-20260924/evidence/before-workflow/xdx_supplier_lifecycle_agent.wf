            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_LINK_DRAFT.$output.result,r=$context.$nodes.XDX_RESOLVE_LINK_ADDRESS.$output;\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst valid=!!(item&&item.AddressName===p.state.candidate.SupplierAddressName&&item.Status==='ACTIVE'&&Number.isSafeInteger(Number(item.SupplierAddressId))&&Number(item.SupplierAddressId)>0);\nreturn {valid,addressId:valid?String(item.SupplierAddressId):'',filter:\"Email='\"+p.state.candidate.ContactEmail.replace(/'/g,\"''\")+\"'\",message:'The supplier address is missing, ambiguous or inactive under this supplier. No association write occurred.'};\n",
