            "name": "XDX FORMAT CLASSIFICATIONS",
            "returnType": "object",
            "sourceCode": "\nconst parent=$context.$nodes.XDX_RESOLVE_SUPPLIER.$output.result,r=$context.$nodes.XDX_FETCH_CLASSIFICATIONS.$output;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||typeof r.hasMore!=='boolean')return {display:'Classification query failed or returned an invalid page. No write occurred.'};\nconst description='Supplier '+parent.supplierName+'. '+(r.items.length?r.items.length+' classification(s).':'No classifications found.')+(r.hasMore?' Next offset: '+(Number(parent.offset)+r.count)+'.':'');\nreturn {display:'<oraInfoDisplay key=\"classification-list\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Supplier business classifications',description,properties:{cols:['Classification','Code','Status'],selectMode:'none',rows:r.items.map(x=>({cells:[x.Classification||'—',x.ClassificationCode||'—',x.Status||'—']}))}})+'</oraInfoDisplay>'};\n"
          },
