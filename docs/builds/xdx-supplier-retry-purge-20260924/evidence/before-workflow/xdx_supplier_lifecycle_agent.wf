        {
          "id": "149",
          "code": "XDX_BIND_LINK_REFERENCES",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND LINK REFERENCES",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"contact-address-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Contact-address draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Contact email',c.ContactEmail],['Supplier address',c.SupplierAddressName]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst p=$context.$nodes.XDX_REDUCE_LINK_DRAFT.$output.result,parent=$context.$nodes.XDX_BIND_LINK_PARENT.$output.result,address=$context.$nodes.XDX_BIND_LINK_ADDRESS.$output.result,r=$context.$nodes.XDX_RESOLVE_LINK_CONTACT.$output;\nconst state=JSON.parse(JSON.stringify(p.state)),c=state.candidate,item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nlet valid=!!(item&&item.Email===c.ContactEmail&&item.Status==='ACTIVE'&&/^[1-9][0-9]*$/.test(String(item.SupplierContactId)));\nconst snapshot={supplierId:parent.supplierId,contactId:valid?String(item.SupplierContactId):'',payload:{SupplierAddressId:Number(address.addressId)}};\nlet message='The contact is missing, ambiguous or inactive under this supplier. No association write occurred.';\nif(valid&&p.mode!=='review'){const approved=p.mode==='reconcile'&&p.prior?p.prior.snapshot:state.snapshot;valid=JSON.stringify(snapshot)===JSON.stringify(approved);message='The supplier, contact or address changed since review. Review and approve again. No association write occurred.';}\nif(valid&&p.mode==='review'){state.snapshot=snapshot;state.reviewedRevision=state.revision;state.reviewedCandidate=JSON.stringify(c);state.approvedRevision=0;state.approvedSnapshot='';message='Review this supplier, contact and existing address. The request contains only the resolved address reference. To approve without writing, enter: Approve contact-address revision '+state.revision+'.';}\nreturn {valid,review:valid&&p.mode==='review',state,snapshot,key:'contact-address:'+snapshot.supplierId+':'+snapshot.contactId+':'+snapshot.payload.SupplierAddressId,filter:'SupplierAddressId='+snapshot.payload.SupplierAddressId,display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "150"
          },
          "inputs": [],
          "diagram": {
            "x": 16700,
            "y": 8314
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
