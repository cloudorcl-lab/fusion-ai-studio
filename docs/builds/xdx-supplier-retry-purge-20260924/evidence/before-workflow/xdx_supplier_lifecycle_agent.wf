        {
          "id": "197",
          "code": "XDX_BIND_ASSIGNMENT_PARENT",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND ASSIGNMENT PARENT",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_ASSIGNMENT_DRAFT.$output.result,r=$context.$nodes.XDX_RESOLVE_ASSIGNMENT_PARENT.$output;\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst valid=!!(item&&item.Supplier===p.state.candidate.Supplier&&/^[1-9][0-9]*$/.test(String(item.SupplierId))&&(!p.prior||String(p.prior.snapshot.supplierId)===String(item.SupplierId)));\nreturn {valid,supplierId:valid?String(item.SupplierId):'',filter:\"SupplierSite='\"+p.state.candidate.SupplierSite.replace(/'/g,\"''\")+\"'\",message:'The supplier is missing, ambiguous or changed. No assignment write occurred.'};",
