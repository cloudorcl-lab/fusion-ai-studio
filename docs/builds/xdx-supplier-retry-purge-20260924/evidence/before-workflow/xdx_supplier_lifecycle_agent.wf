            "y": 9646
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"ClientBUId\": {\n            \"type\": \"string\"\n          },\n          \"ClientBU\": {\n            \"type\": \"string\"\n          },\n          \"BillToBUId\": {\n            \"type\": \"string\"\n          },\n          \"BillToBU\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"AssignmentId\",\n          \"ClientBUId\",\n          \"ClientBU\",\n          \"BillToBUId\",\n          \"BillToBU\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "212",
          "code": "XDX_DECIDE_ASSIGNMENT_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX DECIDE ASSIGNMENT CREATE",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_ASSIGNMENT_DRAFT.$output.result,bound=$context.$nodes.XDX_BIND_ASSIGNMENT_REFERENCES.$output.result,r=$context.$nodes.XDX_CHECK_ASSIGNMENT_DUPLICATE.$output;\nconst ledger=JSON.parse(JSON.stringify(p.ledger)),prior=ledger[bound.key]||p.prior;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.hasMore!==false)return {canPost:false,ledger,message:'Assignment lookup is incomplete. No assignment write occurred.'};\nif(prior||p.mode==='reconcile'){const item=r.items.length===1?r.items[0]:null;const match=!!(item&&String(item.ClientBUId)===String(bound.snapshot.payload.ClientBUId)&&String(item.BillToBUId)===String(bound.snapshot.payload.BillToBUId)&&/^[1-9][0-9]*$/.test(String(item.AssignmentId))&&(!prior||!prior.assignmentId||String(prior.assignmentId)===String(item.AssignmentId)));if(match)ledger[bound.key]=Object.assign({},prior,{status:'confirmed',assignmentId:String(item.AssignmentId)});return {canPost:false,ledger,message:match?'The previous site assignment is independently confirmed. No repeat POST occurred.':'The previous assignment attempt remains unresolved. Another POST is blocked; reconcile instead.'};}\nif(r.items.length)return {canPost:false,ledger,message:'This client business unit already has an assignment under this site. No POST occurred.'};\nledger[bound.key]={status:'pending',businessKey:p.businessKey,candidate:p.state.candidate,snapshot:bound.snapshot,revision:p.state.revision};return {canPost:true,ledger,message:'Approved assignment attempt recorded before POST.'};",
            "returnType": "object"
          },
          "outcomes": {
            "success": "213"
          },
          "inputs": [],
          "diagram": {
            "x": 10793.75,
            "y": 9868
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
