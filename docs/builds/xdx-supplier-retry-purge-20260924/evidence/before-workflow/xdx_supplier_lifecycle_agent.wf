          "metadata": {
            "name": "XDX BIND SITE ADDRESS",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_SITE_DRAFT.$output.result;\nconst r=$context.$nodes.XDX_RESOLVE_SITE_ADDRESS.$output;\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst valid=!!(item&&item.AddressName===p.state.candidate.SupplierAddressName&&item.AddressPurposeOrderingFlag===true&&item.Status==='ACTIVE'&&/^[1-9][0-9]*$/.test(String(item.SupplierAddressId)));\nreturn {valid:valid,addressId:valid?String(item.SupplierAddressId):'',filter:\"ProcurementBU='\"+p.state.candidate.ProcurementBU.replace(/'/g,\"''\")+\"'\",message:'The selected purchasing address is missing, ambiguous or inactive under this supplier. No site write occurred.'};\n",
