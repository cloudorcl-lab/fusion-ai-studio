        {
          "id": "75",
          "code": "XDX_DECIDE_SITE_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX DECIDE SITE CREATE",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_SITE_DRAFT.$output.result;\nconst bound=$context.$nodes.XDX_BIND_SITE_REFERENCES.$output.result;\nconst r=$context.$nodes.XDX_CHECK_SITE_DUPLICATE.$output;\nconst ledger=JSON.parse(JSON.stringify(p.ledger));\nconst prior=ledger[bound.key]||p.prior;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.hasMore!==false)return {canPost:false,ledger:ledger,message:'Site lookup is incomplete. No site write occurred.'};\nif(prior||p.mode==='reconcile'){\n const item=r.items.length===1?r.items[0]:null, payload=bound.snapshot.payload;\n const match=!!(item&&Object.keys(payload).every(k=>k==='ProcurementBUId'?String(item[k])===String(payload[k]):item[k]===payload[k])&&String(item.SupplierAddressId)===bound.snapshot.addressId&&/^[1-9][0-9]*$/.test(String(item.SupplierSiteId))&&(!prior.siteId||String(prior.siteId)===String(item.SupplierSiteId)));\n if(match)ledger[bound.key]=Object.assign({},prior,{status:'confirmed',siteId:String(item.SupplierSiteId)});\n return {canPost:false,ledger:ledger,message:match?'The previous site attempt is confirmed by an independent GET. No repeat POST occurred.':'The previous site attempt remains unresolved. Another POST is blocked; reconcile instead.'};\n}\nif(r.items.length)return {canPost:false,ledger:ledger,message:'A same-name site already exists under this supplier. No POST occurred.'};\nledger[bound.key]={status:'pending',businessKey:p.businessKey,candidate:p.state.candidate,snapshot:bound.snapshot,revision:p.state.revision};\nreturn {canPost:true,ledger:ledger,message:'Approved site attempt recorded before POST.'};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "76"
          },
          "inputs": [],
          "diagram": {
            "x": 9387.5,
            "y": 9202
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
