        {
          "id": "10",
          "code": "XDX_RESOLVE_SUPPLIER",
          "type": "CODE",
          "metadata": {
            "name": "XDX Resolve Supplier",
            "sourceCode": "const request = $context.$nodes.XDX_PREPARE_SEARCH.$output.result;\nconst response = $context.$nodes.XDX_FETCH_SUPPLIERS.$output;\nif (!response || !Array.isArray(response.items)) return {valid:false, reason:'Supplier lookup failed; no child lookup was performed.', supplierId:''};\nif (response.hasMore !== false) return {valid:false, reason:'Supplier lookup is incomplete; narrow the supplier name before querying supplier details.', supplierId:''};\nconst exact = response.items.filter(function(r){return String(r.Supplier || '').toLowerCase() === request.originalName.toLowerCase();});\nif (exact.length !== 1) return {valid:false, reason:'Select one exact supplier name before querying supplier details.', supplierId:''};\nconst supplierId = String(exact[0].SupplierId || '');\nif (!/^[0-9]+$/.test(supplierId)) return {valid:false, reason:'The supplier did not return a valid key; no child lookup was performed.', supplierId:''};\nreturn {valid:true,supplierId:supplierId,supplierName:exact[0].Supplier,limit:request.childLimit,offset:request.childOffset};\r\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "11"
          },
          "inputs": [],
          "diagram": {
            "x": 45725,
            "y": 6982
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
