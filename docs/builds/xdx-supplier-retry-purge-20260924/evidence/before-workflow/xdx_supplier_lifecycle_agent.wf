        {
          "id": "44",
          "code": "XDX_BIND_ADDRESS_PARENT",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND ADDRESS PARENT",
            "sourceCode": "\nconst p=$context.$nodes.XDX_PREPARE_ADDRESS_CREATE.$output.result;\nconst r=$context.$nodes.XDX_RESOLVE_ADDRESS_PARENT.$output;\nconst item=r&&Array.isArray(r.items)&&r.items.length===1&&r.count===1&&r.hasMore===false?r.items[0]:null;\nconst ok=!!(item&&String(item.Supplier)===p.supplierName&&/^[1-9][0-9]*$/.test(String(item.SupplierId))&&(!p.prior||String(p.prior.supplierId)===String(item.SupplierId)));\nif(!ok)return {valid:false,message:'The approved supplier could not be resolved uniquely, or its identity changed. No address write was performed.'};\nreturn {valid:true,supplierId:String(item.SupplierId),supplierNumber:String(item.SupplierNumber),key:'address:'+String(item.SupplierId)+':'+p.payload.AddressName.trim().toLowerCase(),filter:\"AddressName='\"+p.payload.AddressName.replace(/'/g,\"''\")+\"'\"};\n",
            "returnType": "object"
