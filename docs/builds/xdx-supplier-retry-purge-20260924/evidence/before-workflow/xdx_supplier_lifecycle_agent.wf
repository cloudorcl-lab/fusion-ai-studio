        {
          "id": "115",
          "code": "XDX_BIND_CLASSIFICATION_PARENT",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND CLASSIFICATION PARENT",
            "sourceCode": "function show(state,message){const p=state.candidate;return '<oraInfoDisplay key=\"classification-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Classification draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['Classification code',p.ClassificationCode]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\nconst p=$context.$nodes.XDX_REDUCE_CLASSIFICATION_DRAFT.$output.result,r=$context.$nodes.XDX_RESOLVE_CLASSIFICATION_PARENT.$output;\nconst state=JSON.parse(JSON.stringify(p.state)),c=state.candidate;\nconst item=r&&Array.isArray(r.items)&&r.items.length===1&&r.count===1&&r.hasMore===false?r.items[0]:null;\nlet valid=!!(item&&item.Supplier===c.Supplier&&/^[1-9][0-9]*$/.test(String(item.SupplierId)));\nconst payload={ClassificationCode:c.ClassificationCode};\nconst snapshot={supplierId:item?String(item.SupplierId):'',payload};\nlet message='The supplier could not be resolved uniquely. No classification write occurred.';\nif(valid&&p.mode!=='review'){const approved=p.mode==='reconcile'&&p.prior?p.prior.snapshot:state.snapshot;valid=JSON.stringify(snapshot)===JSON.stringify(approved);message='The supplier identity or payload changed since review. Review and approve again. No write occurred.';}\nif(valid&&p.mode==='review'){state.snapshot=snapshot;state.reviewedRevision=state.revision;state.reviewedCandidate=JSON.stringify(c);state.approvedRevision=0;state.approvedSnapshot='';message='Review this supplier and exact one-field classification payload. To approve without writing, enter: Approve classification revision '+state.revision+'.';}\nreturn {valid,review:valid&&p.mode==='review',state,snapshot,key:'classification:'+snapshot.supplierId+':'+c.ClassificationCode,filter:\"ClassificationCode='\"+c.ClassificationCode.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "116"
          },
          "inputs": [],
          "diagram": {
