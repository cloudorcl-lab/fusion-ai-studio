        },
        {
          "id": "111",
          "code": "XDX_REDUCE_CLASSIFICATION_DRAFT",
          "type": "CODE",
          "metadata": {
            "name": "XDX REDUCE CLASSIFICATION DRAFT",
            "sourceCode": "function show(state,message){const p=state.candidate;return '<oraInfoDisplay key=\"classification-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Classification draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['Classification code',p.ClassificationCode]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\nconst req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result,old=$context.$variables.xdxClassificationDraft,ledger=$context.$variables.xdxClassificationWrites||{};\nconst blank={candidate:{Supplier:'',ClassificationCode:''},revision:0,reviewedRevision:0,reviewedCandidate:'',snapshot:null,approvedRevision:0,approvedSnapshot:''};\nlet state=old&&old.candidate?JSON.parse(JSON.stringify(old)):blank;\nconst revision=state.revision;\nif(req.action==='prepare')state=JSON.parse(JSON.stringify(blank));\nconst before=JSON.stringify(state.candidate);\nif(req.action==='prepare'||req.action==='edit'){const patch=req.classificationPatch||{};for(const k of ['Supplier','ClassificationCode'])if(typeof patch[k]==='string')state.candidate[k]=patch[k].trim();}\nconst p=state.candidate,canonical=JSON.stringify(p);\nif(req.action==='prepare'||before!==canonical){state.revision=revision+1;state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';}\nconst valid=typeof p.Supplier==='string'&&p.Supplier.length>0&&p.Supplier.length<=360&&!/[\\x00-\\x1f\"\\\\&#?%]/.test(p.Supplier)&&p.ClassificationCode==='SMALL_BUSINESS';\nconst businessKey=JSON.stringify([p.Supplier.toLowerCase(),p.ClassificationCode]);\nconst prior=Object.keys(ledger).map(k=>ledger[k]).filter(x=>x.businessKey===businessKey)[0]||null;\nlet resolve=false,mode=req.action,message='Classification draft saved. No classification has been created.';\nif(req.action==='review'){state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';resolve=valid;message=valid?'Resolving the exact supplier.':'Complete supplier and the supported classification code SMALL_BUSINESS before review.';}\nif(req.action==='approve'){const m=/^Approve classification revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());if(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.snapshot){state.approvedRevision=state.revision;state.approvedSnapshot=JSON.stringify(state.snapshot);message='Classification revision '+state.revision+' approved without writing. To create this exact classification, enter: Create classification revision '+state.revision+'.';}else message='Approval rejected. Review the current complete classification draft and approve its exact revision. No write occurred.';}\nif(req.action==='create'){const m=/^Create classification revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());resolve=!!(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.approvedRevision===state.revision&&state.snapshot&&state.approvedSnapshot===JSON.stringify(state.snapshot));message='Creation requires approval of the exact current reviewed classification revision. No write occurred.';if(prior)mode='reconcile';}\nif(req.action==='reconcile'){resolve=!!prior;message='No previous classification attempt exists for this draft. No write occurred.';}\nif(resolve&&mode==='reconcile'&&prior)state.candidate=JSON.parse(JSON.stringify(prior.candidate));\nreturn {state,resolve,mode,ledger,prior,businessKey,filter:\"Supplier='\"+state.candidate.Supplier.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "112"
          },
          "inputs": [],
          "diagram": {
            "x": 13325,
            "y": 6094
