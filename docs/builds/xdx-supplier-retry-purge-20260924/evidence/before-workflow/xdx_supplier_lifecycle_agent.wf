          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"ClientBUId\": {\n            \"type\": \"string\"\n          },\n          \"ClientBU\": {\n            \"type\": \"string\"\n          },\n          \"BillToBUId\": {\n            \"type\": \"string\"\n          },\n          \"BillToBU\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"AssignmentId\",\n          \"ClientBUId\",\n          \"ClientBU\",\n          \"BillToBUId\",\n          \"BillToBU\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\"\n  ],\n  \"additionalProperties\": false\n}"
