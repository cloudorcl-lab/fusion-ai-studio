        {
          "id": "80",
          "code": "XDX_CONFIRM_SITE_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX CONFIRM SITE CREATE",
            "sourceCode": "\nfunction show(state,message){\n const p=state.candidate;\n return '<oraInfoDisplay key=\"site-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Site draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['Site name',p.SupplierSite],['Procurement business unit',p.ProcurementBU],['Supplier address',p.SupplierAddressName],['Purchasing purpose',p.SitePurposePurchasingFlag===true?'Yes':'Required']].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';\n}\n\nconst bound=$context.$nodes.XDX_BIND_SITE_REFERENCES.$output.result;\nconst decision=$context.$nodes.XDX_DECIDE_SITE_CREATE.$output.result;\nconst post=$context.$nodes.XDX_CREATE_SITE.$output;\nconst r=$context.$nodes.XDX_VERIFY_SITE.$output;\nconst ledger=JSON.parse(JSON.stringify(decision.ledger));\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst payload=bound.snapshot.payload;\nconst match=!!(item&&post&&Object.keys(payload).every(k=>k==='ProcurementBUId'?String(item[k])===String(payload[k]):item[k]===payload[k])&&String(item.SupplierAddressId)===bound.snapshot.addressId&&/^[1-9][0-9]*$/.test(String(post.SupplierSiteId))&&String(item.SupplierSiteId)===String(post.SupplierSiteId));\nif(match)ledger[bound.key]=Object.assign({},ledger[bound.key],{status:'confirmed',siteId:String(item.SupplierSiteId)});\nreturn {confirmed:match,ledger:ledger,display:show(bound.state,match?'Site created and independently verified with the approved supplier, address and business unit.':'Site creation is not independently confirmed. Do not retry POST; reconcile the existing attempt.')};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "81"
          },
