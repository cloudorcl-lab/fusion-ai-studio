        {
          "id": "121",
          "code": "XDX_DECIDE_CLASSIFICATION_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX DECIDE CLASSIFICATION CREATE",
            "sourceCode": "\nconst p=$context.$nodes.XDX_REDUCE_CLASSIFICATION_DRAFT.$output.result,bound=$context.$nodes.XDX_BIND_CLASSIFICATION_PARENT.$output.result,r=$context.$nodes.XDX_CHECK_CLASSIFICATION_DUPLICATE.$output;\nconst ledger=JSON.parse(JSON.stringify(p.ledger)),prior=ledger[bound.key]||p.prior;\nif(!r||!Array.isArray(r.items)||r.count!==r.items.length||r.hasMore!==false)return {canPost:false,ledger,message:'Classification lookup is incomplete. No classification write occurred.'};\nif(prior||p.mode==='reconcile'){const item=r.items.length===1?r.items[0]:null;const match=!!(item&&item.ClassificationCode===bound.snapshot.payload.ClassificationCode&&/^[1-9][0-9]*$/.test(String(item.ClassificationId))&&(!prior.classificationId||String(prior.classificationId)===String(item.ClassificationId)));if(match)ledger[bound.key]=Object.assign({},prior,{status:'confirmed',classificationId:String(item.ClassificationId)});return {canPost:false,ledger,message:match?'The previous classification attempt is independently confirmed. No repeat POST occurred.':'The previous classification attempt remains unresolved. Another POST is blocked; reconcile instead.'};}\nif(r.items.length)return {canPost:false,ledger,message:'This classification code already exists under this supplier. No POST occurred.'};\nledger[bound.key]={status:'pending',businessKey:p.businessKey,candidate:p.state.candidate,snapshot:bound.snapshot,revision:p.state.revision};\nreturn {canPost:true,ledger,message:'Approved classification attempt recorded before POST.'};\n",
            "returnType": "object"
          },
          "outcomes": {
