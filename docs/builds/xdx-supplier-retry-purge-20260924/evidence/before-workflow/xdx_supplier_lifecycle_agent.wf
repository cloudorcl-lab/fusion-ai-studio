        },
        {
          "id": "23",
          "code": "XDX_SUPPLIER_DRAFT_RESPONSE",
          "type": "LLM",
          "metadata": {
            "name": "XDX Supplier Draft Response"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "23_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Present only this deterministic draft result: {{$context.$nodes.XDX_REDUCE_SUPPLIER_DRAFT.$output.result}}. Emit one oraInfoDisplay multiRecordWidget titled Supplier draft revision followed by its revision number. properties.cols=[Field,Value], with exactly three rows[].cells: Supplier name from state.payload.Supplier, Business relationship from state.payload.BusinessRelationship, Tax organization type from state.payload.TaxOrganizationType. Empty fields display Required. properties.subtitle must preserve the complete result.message and every result.errors item. selectMode none. State whether approval is currently valid by comparing approvedRevision to revision and requiring revision>0; never infer approval from user sentiment. Never change a field value, infer a default, hide an error, claim creation, provide a write action or mention internal node names. The exact approval phrase and revision in message must be reproduced unchanged when review is ready. Only a review is being performed; no BO write exists. Return only the business widget."
            }
          ],
          "diagram": {
            "x": 17825,
            "y": 6538
          },
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MULTIRECORD"
              ],
              "enableCommunications": false,
              "enableActions": false,
              "customNotes": "Two columns Field and Value for the exact required supplier payload. Preserve revision, validation and no-write approval instructions."
            }
          }
        },
        {
          "id": "24",
          "code": "XDX_PREPARE_SUPPLIER_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX Prepare Supplier Create",
            "sourceCode": "const req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result;\nconst draft=$context.$variables.xdxSupplierDraft;\nconst saved=$context.$variables.xdxSupplierWrites;\nconst ledger=saved && typeof saved==='object' ? JSON.parse(JSON.stringify(saved)) : {};\nconst raw=String($context.$system.$inputMessage||'').trim();\nconst p=draft && draft.payload;\nconst invalid={canQuery:false,ledger:ledger,message:'No current approved supplier payload is available. Prepare, review and approve the exact supplier draft first. No supplier was created.'};\nif(!p || !p.Supplier) return invalid;\nconst key='supplier:'+String(p.Supplier).trim().toLowerCase();\nconst prior=Object.prototype.hasOwnProperty.call(ledger,key)?ledger[key]:null;\nif(req.action==='reconcile'){\n if(!prior) return {canQuery:false,ledger:ledger,message:'There is no recorded create attempt for this supplier draft. No write was performed.'};\n return {canQuery:true,mode:'reconcile',ledger:ledger,key:key,payload:prior.payload,filter:\"Supplier='\"+prior.payload.Supplier.replace(/'/g,\"''\")+\"'\",revision:prior.revision};\n}\nconst match=/^Create supplier revision ([1-9][0-9]*)\\.?$/i.exec(raw);\nconst payload={Supplier:p.Supplier,BusinessRelationship:p.BusinessRelationship,TaxOrganizationType:p.TaxOrganizationType};\nconst canonical=JSON.stringify(payload);\nif(!match || Number(match[1])!==draft.revision || draft.approvedRevision!==draft.revision || draft.approvedPayload!==canonical || draft.reviewedPayload!==canonical) return invalid;\nif(typeof p.Supplier!=='string' || p.Supplier.length>360 || /[\\x00-\\x1f\"\\\\&#?%]/.test(p.Supplier) || p.BusinessRelationship!=='Spend Authorized' || p.TaxOrganizationType!=='Corporation') return {canQuery:false,ledger:ledger,message:'The approved values are not safe for this supplier operation. Review supported values before creating. No write was performed.'};\nreturn {canQuery:true,mode:prior?'reconcile':'create',ledger:ledger,key:key,payload:payload,filter:\"Supplier='\"+p.Supplier.replace(/'/g,\"''\")+\"'\",revision:draft.revision};\r\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "25"
          },
          "inputs": [],
          "diagram": {
            "x": 18725,
            "y": 6094
