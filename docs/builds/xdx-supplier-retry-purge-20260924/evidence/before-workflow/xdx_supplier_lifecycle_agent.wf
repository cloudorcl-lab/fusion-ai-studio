": [\n          \"SupplierSiteId\",\n          \"SupplierSite\",\n          \"ProcurementBUId\",\n          \"ProcurementBU\",\n          \"SupplierAddressId\",\n          \"SupplierAddressName\",\n          \"Address\",\n          \"InactiveDate\",\n          \"Status\",\n          \"SitePurposeSourcingOnlyFlag\",\n          \"SitePurposePurchasingFlag\",\n          \"SitePurposeProcurementCardFlag\",\n          \"SitePurposePayFlag\",\n          \"SitePurposePrimaryPayFlag\",\n          \"IncomeTaxReportingSiteFlag\",\n          \"AlternateSiteName\",\n          \"CustomerNumber\",\n          \"B2BCommunicationMethodCode\",\n          \"B2BCommunicationMethod\",\n          \"B2BSupplierSiteCode\",\n          \"CommunicationMethodCode\",\n          \"CommunicationMethod\",\n          \"Email\",\n          \"FaxCountryCode\",\n          \"FaxAreaCode\",\n          \"FaxNumber\",\n          \"HoldAllNewPurchasingDocumentsFlag\",\n          \"PurchasingHoldReason\",\n          \"AllNewPurchasingDocumentsHoldDate\",\n          \"AllNewPurchasingDocumentsHoldBy\",\n          \"RequiredAcknowledgmentCode\",\n          \"RequiredAcknowledgment\",\n          \"AcknowledgmentWithinDays\",\n          \"CarrierId\",\n          \"Carrier\",\n          \"ModeOfTransportCode\",\n          \"ModeOfTransport\",\n          \"ServiceLevelCode\",\n          \"ServiceLevel\",\n          \"FreightTermsCode\",\n          \"FreightTerms\",\n          \"PayOnReceiptFlag\",\n          \"FOBCode\",\n          \"FOB\",\n          \"CountryOfOriginCode\",\n          \"CountryOfOrigin\",\n          \"BuyerManagedTransportationCode\",\n          \"BuyerManagedTransportation\",\n          \"PayOnUseFlag\",\n          \"AgingOnsetPointCode\",\n          \"AgingOnsetPoint\",\n          \"AgingPeriodDays\",\n          \"ConsumptionAdviceFrequencyCode\",\n          \"ConsumptionAdviceFrequency\",\n          \"ConsumptionAdviceSummaryCode\",\n          \"ConsumptionAdviceSummary\",\n          \"AlternatePaySiteId\",\n          \"AlternatePaySite\",\n          \"InvoiceSummaryLevelCode\",\n          \"InvoiceSummaryLevel\",\n          \"GaplessInvoiceNumberingFlag\",\n          \"SellingCompanyIdentifier\",\n          \"CreateDebitMemoFromReturnFlag\",\n          \"ShipToExceptionCode\",\n          \"ShipToException\",\n          \"ReceiptRoutingId\",\n          \"ReceiptRouting\",\n          \"OverReceiptTolerance\",\n          \"OverReceiptActionCode\",\n          \"OverReceiptAction\",\n          \"EarlyReceiptToleranceInDays\",\n          \"LateReceiptToleranceInDays\",\n          \"AllowSubstituteReceiptsCode\",\n          \"AllowSubstituteReceipts\",\n          \"AllowUnorderedReceiptsFlag\",\n          \"ReceiptDateExceptionCode\",\n          \"ReceiptDateException\",\n          \"InvoiceCurrencyCode\",\n          \"InvoiceCurrency\",\n          \"InvoiceAmountLimit\",\n          \"InvoiceMatchOptionCode\",\n          \"InvoiceMatchOption\",\n          \"MatchApprovalLevelCode\",\n          \"MatchApprovalLevel\",\n          \"QuantityTolerancesId\",\n          \"QuantityTolerances\",\n          \"AmountTolerancesId\",\n          \"AmountTolerances\",\n          \"InvoiceChannelCode\",\n          \"InvoiceChannel\",\n          \"PaymentCurrencyCode\",\n          \"PaymentCurrency\",\n          \"PaymentPriority\",\n          \"PayGroupCode\",\n          \"PayGroup\",\n          \"HoldAllInvoicesFlag\",\n          \"HoldUnmatchedInvoicesCode\",\n          \"HoldUnmatchedInvoices\",\n          \"HoldUnvalidatedInvoicesFlag\",\n          \"PaymentHoldDate\",\n          \"PaymentHoldReason\",\n          \"PaymentTermsId\",\n          \"PaymentTerms\",\n          \"PaymentTermsDateBasisCode\",\n          \"PaymentTermsDateBasis\",\n          \"PayDateBasisCode\",\n          \"PayDateBasis\",\n          \"BankChargeDeductionTypeCode\",\n          \"BankChargeDeductionType\",\n          \"AlwaysTakeDiscountCode\",\n          \"AlwaysTakeDiscount\",\n          \"ExcludeFreightFromDiscountCode\",\n          \"ExcludeFreightFromDiscount\",\n          \"ExcludeTaxFromDiscountCode\",\n          \"ExcludeTaxFromDiscount\",\n          \"CreateInterestInvoicesCode\",\n          \"CreateInterestInvoices\",\n          \"CreationDate\",\n          \"CreatedBy\",\n          \"LastUpdateDate\",\n          \"LastUpdatedBy\",\n          \"OverrideB2BCommunicationforSpecialHandlingOrdersFlag\"\n        ],\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
