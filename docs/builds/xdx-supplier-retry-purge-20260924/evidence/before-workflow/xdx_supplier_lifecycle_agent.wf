        {
          "id": "27",
          "code": "XDX_DECIDE_SUPPLIER_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX Decide Supplier Create",
            "returnType": "object",
            "sourceCode": "const p=$context.$nodes.XDX_PREPARE_SUPPLIER_CREATE.$output.result;\nconst response=$context.$nodes.XDX_CHECK_SUPPLIER_DUPLICATE.$output;\nconst ledger=JSON.parse(JSON.stringify(p.ledger));\nconst items=response && response.items;\nconst complete=Array.isArray(items) && response.hasMore===false && Number(response.count)===items.length;\nlet message='Supplier duplicate check did not return a complete valid result. No supplier was created; retry the read only.';\nlet canPost=false;\nlet confirmed=false;\nif(complete && p.mode==='reconcile'){\n const found=items.length===1 && String(items[0].SupplierId||'') && String(items[0].SupplierNumber||'') && ['Supplier','BusinessRelationship','TaxOrganizationType'].every(k=>items[0][k]===p.payload[k]);\n if(found){ledger[p.key].status='confirmed';ledger[p.key].supplierId=String(items[0].SupplierId);ledger[p.key].supplierNumber=String(items[0].SupplierNumber);confirmed=true;message='The prior supplier attempt is confirmed by an independent read. No POST was repeated.';}\n else message='The prior supplier attempt is unresolved. Another POST is blocked. Reconcile again by read or obtain operator investigation.';\n}else if(complete && items.length>0){message='A supplier with this name already exists. Creation is blocked to prevent a duplicate. No POST was performed.';}\nelse if(complete && items.length===0 && p.mode==='create'){\n canPost=true;\n ledger[p.key]={status:'pending',revision:p.revision,payload:p.payload};\n message='Create attempt is recorded pending independent confirmation.';\n}\nreturn {canPost:canPost,confirmed:confirmed,ledger:ledger,payload:p.payload,filter:p.filter,message:message};\r\n"
          },
          "outcomes": {
            "success": "28"
          },
          "inputs": [],
          "diagram": {
            "x": 18500,
            "y": 6760
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
