        {
          "id": "136",
          "code": "XDX_REDUCE_LINK_DRAFT",
          "type": "CODE",
          "metadata": {
            "name": "XDX REDUCE LINK DRAFT",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"contact-address-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Contact-address draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Contact email',c.ContactEmail],['Supplier address',c.SupplierAddressName]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\nconst req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result,old=$context.$variables.xdxLinkDraft,ledger=$context.$variables.xdxLinkWrites||{};\nconst blank={candidate:{Supplier:'',ContactEmail:'',SupplierAddressName:''},revision:0,reviewedRevision:0,reviewedCandidate:'',snapshot:null,approvedRevision:0,approvedSnapshot:''};\nlet state=old&&old.candidate?JSON.parse(JSON.stringify(old)):blank;\nconst revision=state.revision;\nif(req.action==='prepare')state=JSON.parse(JSON.stringify(blank));\nconst before=JSON.stringify(state.candidate);\nif(req.action==='prepare'||req.action==='edit'){const patch=req.linkPatch||{};for(const k of ['Supplier','ContactEmail','SupplierAddressName'])if(typeof patch[k]==='string')state.candidate[k]=patch[k].trim();}\nconst p=state.candidate,canonical=JSON.stringify(p);\nif(req.action==='prepare'||before!==canonical){state.revision=revision+1;state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';}\nconst safe=x=>typeof x==='string'&&x.length>0&&!/[\\x00-\\x1f\"\\\\&#?%]/.test(x);\nconst valid=safe(p.Supplier)&&p.Supplier.length<=360&&safe(p.SupplierAddressName)&&p.SupplierAddressName.length<=240&&safe(p.ContactEmail)&&p.ContactEmail.length<=320&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.ContactEmail);\nconst businessKey=JSON.stringify([p.Supplier.toLowerCase(),p.ContactEmail.toLowerCase(),p.SupplierAddressName.toLowerCase()]);\nconst prior=Object.keys(ledger).map(k=>ledger[k]).filter(x=>x.businessKey===businessKey)[0]||null;\nlet resolve=false,mode=req.action,message='Contact-address draft saved. No association has been created.';\nif(req.action==='review'){state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';resolve=valid;message=valid?'Resolving the exact supplier.':'Complete supplier, contact email and supplier address name before review.';}\nif(req.action==='approve'){const m=/^Approve contact-address revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());if(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.snapshot){state.approvedRevision=state.revision;state.approvedSnapshot=JSON.stringify(state.snapshot);message='Contact-address revision '+state.revision+' approved without writing. To create this exact link, enter: Create contact-address revision '+state.revision+'.';}else message='Approval rejected. Review the current complete contact-address draft and approve its exact revision. No write occurred.';}\nif(req.action==='create'){const m=/^Create contact-address revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());resolve=!!(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.approvedRevision===state.revision&&state.snapshot&&state.approvedSnapshot===JSON.stringify(state.snapshot));message='Creation requires approval of the exact current reviewed contact-address revision. No write occurred.';if(prior)mode='reconcile';}\nif(req.action==='reconcile'){resolve=!!prior;message='No previous link attempt exists for this draft. No write occurred.';}\nif(resolve&&mode==='reconcile'&&prior)state.candidate=JSON.parse(JSON.stringify(prior.candidate));\nreturn {state,resolve,mode,ledger,prior,businessKey,filter:\"Supplier='\"+state.candidate.Supplier.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "137"
          },
          "inputs": [],
          "diagram": {
            "x": 17375,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
