        {
          "id": "69",
          "code": "XDX_BIND_SITE_REFERENCES",
          "type": "CODE",
          "metadata": {
            "name": "XDX BIND SITE REFERENCES",
            "sourceCode": "\nfunction show(state,message){\n const p=state.candidate;\n return '<oraInfoDisplay key=\"site-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Site draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['Site name',p.SupplierSite],['Procurement business unit',p.ProcurementBU],['Supplier address',p.SupplierAddressName],['Purchasing purpose',p.SitePurposePurchasingFlag===true?'Yes':'Required']].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';\n}\n\nconst p=$context.$nodes.XDX_REDUCE_SITE_DRAFT.$output.result;\nconst parent=$context.$nodes.XDX_BIND_SITE_PARENT.$output.result;\nconst address=$context.$nodes.XDX_BIND_SITE_ADDRESS.$output.result;\nconst r=$context.$nodes.XDX_RESOLVE_SITE_BU.$output;\nconst state=JSON.parse(JSON.stringify(p.state)),c=state.candidate;\nlet valid=!!(r&&Array.isArray(r.items)&&r.items.length>0&&r.count===r.items.length&&r.hasMore===false);\nconst ids={};\nif(valid)for(const row of r.items){if(row.ProcurementBU!==c.ProcurementBU||!/^[1-9][0-9]*$/.test(String(row.ProcurementBUId)))valid=false;ids[String(row.ProcurementBUId)]=true;}\nif(Object.keys(ids).length!==1)valid=false;\nconst payload={SupplierSite:c.SupplierSite,ProcurementBUId:Number(Object.keys(ids)[0]),SupplierAddressName:c.SupplierAddressName,SitePurposePurchasingFlag:true};\nconst snapshot={supplierId:parent.supplierId,addressId:address.addressId,payload:payload};\nlet message='The procurement business unit could not be resolved uniquely from a complete result. No site write occurred.';\nif(valid&&p.mode!=='review'){\n const approved=p.mode==='reconcile'&&p.prior?p.prior.snapshot:state.snapshot;\n valid=JSON.stringify(snapshot)===JSON.stringify(approved);\n message='The supplier, address or business unit changed since review. Review and approve again. No site write occurred.';\n}\nif(valid&&p.mode==='review'){\n state.snapshot=snapshot;state.reviewedRevision=state.revision;state.reviewedCandidate=JSON.stringify(c);state.approvedRevision=0;state.approvedSnapshot='';\n message='Review the resolved supplier, address and business unit with this exact four-field site payload. To approve without writing, enter: Approve site revision '+state.revision+'.';\n}\nreturn {valid:valid,review:valid&&p.mode==='review',state:state,snapshot:snapshot,key:'site:'+parent.supplierId+':'+c.SupplierSite.toLowerCase(),filter:\"SupplierSite='\"+c.SupplierSite.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "70"
          },
          "inputs": [],
          "diagram": {
            "x": 9893.75,
            "y": 8314
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
