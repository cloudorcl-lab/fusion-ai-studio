        {
          "id": "189",
          "code": "XDX_CONFIRM_PRODUCT_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX CONFIRM PRODUCT CREATE",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"products-services-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Products/services draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Category',c.CategoryName],['Category type','Browsing']].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst bound=$context.$nodes.XDX_BIND_PRODUCT_REFERENCES.$output.result,decision=$context.$nodes.XDX_DECIDE_PRODUCT_CREATE.$output.result,post=$context.$nodes.XDX_CREATE_PRODUCT.$output,r=$context.$nodes.XDX_VERIFY_PRODUCT.$output;const ledger=JSON.parse(JSON.stringify(decision.ledger));if(post&&/^[1-9][0-9]*$/.test(String(post.SupplierProductsServicesId)))ledger[bound.key].associationId=String(post.SupplierProductsServicesId);const item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;const match=!!(item&&post&&String(item.ProductsServicesCategoryId)===String(bound.snapshot.payload.ProductsServicesCategoryId)&&String(post.ProductsServicesCategoryId)===String(bound.snapshot.payload.ProductsServicesCategoryId)&&item.CategoryType==='BROWSING'&&post.CategoryType==='BROWSING'&&/^[1-9][0-9]*$/.test(String(post.SupplierProductsServicesId))&&String(item.SupplierProductsServicesId)===String(post.SupplierProductsServicesId));if(match)ledger[bound.key].status='confirmed';return {confirmed:match,ledger,display:show(bound.state,match?'Products/services association created and independently verified.':'Products/services creation is not independently confirmed. Do not retry POST; reconcile the existing attempt.')};\n",
            "returnType": "object"
          },
