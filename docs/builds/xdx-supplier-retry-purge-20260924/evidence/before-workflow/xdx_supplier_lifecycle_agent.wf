        {
          "id": "59",
          "code": "XDX_REDUCE_SITE_DRAFT",
          "type": "CODE",
          "metadata": {
            "name": "XDX REDUCE SITE DRAFT",
            "sourceCode": "\nfunction show(state,message){\n const p=state.candidate;\n return '<oraInfoDisplay key=\"site-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Site draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',p.Supplier],['Site name',p.SupplierSite],['Procurement business unit',p.ProcurementBU],['Supplier address',p.SupplierAddressName],['Purchasing purpose',p.SitePurposePurchasingFlag===true?'Yes':'Required']].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';\n}\n\nconst req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result;\nconst old=$context.$variables.xdxSiteDraft;\nconst ledger=$context.$variables.xdxSiteWrites||{};\nconst blank={candidate:{Supplier:'',SupplierSite:'',ProcurementBU:'',SupplierAddressName:'',SitePurposePurchasingFlag:false},revision:0,reviewedRevision:0,reviewedCandidate:'',snapshot:null,approvedRevision:0,approvedSnapshot:''};\nlet state=old&&old.candidate?JSON.parse(JSON.stringify(old)):blank;\nconst revision=state.revision;\nif(req.action==='prepare')state=JSON.parse(JSON.stringify(blank));\nconst before=JSON.stringify(state.candidate);\nif(req.action==='prepare'||req.action==='edit'){\n const patch=req.sitePatch||{};\n for(const k of ['Supplier','SupplierSite','ProcurementBU','SupplierAddressName'])if(typeof patch[k]==='string')state.candidate[k]=patch[k].trim();\n if(typeof patch.SitePurposePurchasingFlag==='boolean')state.candidate.SitePurposePurchasingFlag=patch.SitePurposePurchasingFlag;\n}\nconst p=state.candidate,canonical=JSON.stringify(p);\nif(req.action==='prepare'||before!==canonical){state.revision=revision+1;state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';}\nconst valid=['Supplier','SupplierSite','ProcurementBU','SupplierAddressName'].every(k=>typeof p[k]==='string'&&p[k].length>0&&p[k].length<=(k==='Supplier'?360:240)&&!/[\\x00-\\x1f\"\\\\&#?%]/.test(p[k]))&&p.SitePurposePurchasingFlag===true;\nconst businessKey=JSON.stringify([p.Supplier.toLowerCase(),p.SupplierSite.toLowerCase()]);\nconst prior=Object.keys(ledger).map(k=>ledger[k]).filter(x=>x.businessKey===businessKey)[0]||null;\nlet resolve=false,mode=req.action,message='Site draft saved. No site has been created.';\nif(req.action==='review'){\n state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';\n resolve=valid;message=valid?'Resolving the exact site references.':'Complete supplier, site, business unit, address and purchasing purpose before review.';\n}\nif(req.action==='approve'){\n const m=/^Approve site revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());\n if(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.snapshot){state.approvedRevision=state.revision;state.approvedSnapshot=JSON.stringify(state.snapshot);message='Site revision '+state.revision+' approved without writing. To create exactly this reviewed site, enter: Create site revision '+state.revision+'.';}\n else message='Approval rejected. Review the current complete site draft and approve its exact revision. No write occurred.';\n}\nif(req.action==='create'){\n const m=/^Create site revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());\n resolve=!!(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.approvedRevision===state.revision&&state.snapshot&&state.approvedSnapshot===JSON.stringify(state.snapshot));\n message='Creation requires approval of the exact current reviewed site revision. No write occurred.';\n if(prior)mode='reconcile';\n}\nif(req.action==='reconcile'){resolve=!!prior;message='No previous site attempt exists for this draft. No write occurred.';}\nif(resolve&&mode==='reconcile'&&prior){state.candidate=JSON.parse(JSON.stringify(prior.candidate));}\nreturn {state:state,resolve:resolve,mode:mode,ledger:ledger,prior:prior,businessKey:businessKey,filter:\"Supplier='\"+state.candidate.Supplier.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "60"
          },
          "inputs": [],
          "diagram": {
            "x": 10625,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
