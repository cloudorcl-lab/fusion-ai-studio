            "sourceCode": "\nconst x=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result||{},email=String((x.readContext||{}).ContactEmail||'').trim();\nif(!email||email.length>320||!/^([^\\s@]+)@([^\\s@]+)\\.([^\\s@]+)$/.test(email)||/[\\x00-\\x1f&?#{}%]/.test(email))return {valid:false,reason:'Specify one exact contact email under the selected supplier before listing contact addresses.'};\nreturn {valid:true,email,filter:\"Email='\"+email.replace(/'/g,\"''\")+\"'\"};\n"
          },
