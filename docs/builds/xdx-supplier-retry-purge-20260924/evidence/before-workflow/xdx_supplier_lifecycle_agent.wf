        {
          "id": "163",
          "code": "XDX_CONFIRM_LINK_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "XDX CONFIRM LINK CREATE",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"contact-address-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Contact-address draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Contact email',c.ContactEmail],['Supplier address',c.SupplierAddressName]].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst bound=$context.$nodes.XDX_BIND_LINK_REFERENCES.$output.result,decision=$context.$nodes.XDX_DECIDE_LINK_CREATE.$output.result,post=$context.$nodes.XDX_CREATE_LINK.$output,r=$context.$nodes.XDX_VERIFY_LINK.$output;\nconst ledger=JSON.parse(JSON.stringify(decision.ledger));if(post&&/^[1-9][0-9]*$/.test(String(post.SupplierContactAddressId)))ledger[bound.key].associationId=String(post.SupplierContactAddressId);\nconst item=r&&r.count===1&&r.hasMore===false&&Array.isArray(r.items)&&r.items.length===1?r.items[0]:null;\nconst match=!!(item&&post&&String(item.SupplierAddressId)===String(bound.snapshot.payload.SupplierAddressId)&&String(post.SupplierAddressId)===String(bound.snapshot.payload.SupplierAddressId)&&/^[1-9][0-9]*$/.test(String(post.SupplierContactAddressId))&&String(item.SupplierContactAddressId)===String(post.SupplierContactAddressId));\nif(match)ledger[bound.key].status='confirmed';return {confirmed:match,ledger,display:show(bound.state,match?'Contact-address association created and independently verified.':'Association creation is not independently confirmed. Do not retry POST; reconcile the existing attempt.')};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "164"
          },
          "inputs": [],
          "diagram": {
