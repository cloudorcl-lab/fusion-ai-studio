        {
          "id": "166",
          "code": "XDX_REDUCE_PRODUCT_DRAFT",
          "type": "CODE",
          "metadata": {
            "name": "XDX REDUCE PRODUCT DRAFT",
            "sourceCode": "function show(state,message){const c=state.candidate;return '<oraInfoDisplay key=\"products-services-review\">'+JSON.stringify({patternId:'multiRecordWidget',title:'Products/services draft revision '+state.revision,description:message,properties:{cols:['Field','Value'],selectMode:'none',rows:[['Supplier',c.Supplier],['Category',c.CategoryName],['Category type','Browsing']].map(x=>({cells:[x[0],x[1]||'Required']}))}})+'</oraInfoDisplay>';}\n\nconst req=$context.$nodes.XDX_NORMALIZE_REQUEST.$output.result,old=$context.$variables.xdxProductDraft,ledger=$context.$variables.xdxProductWrites||{};\nconst blank={candidate:{Supplier:'',CategoryName:''},revision:0,reviewedRevision:0,reviewedCandidate:'',snapshot:null,approvedRevision:0,approvedSnapshot:''};let state=old&&old.candidate?JSON.parse(JSON.stringify(old)):blank;const revision=state.revision;\nif(req.action==='prepare')state=JSON.parse(JSON.stringify(blank));const before=JSON.stringify(state.candidate);\nif(req.action==='prepare'||req.action==='edit'){const patch=req.productPatch||{};for(const k of ['Supplier','CategoryName'])if(typeof patch[k]==='string')state.candidate[k]=patch[k].trim();}\nconst p=state.candidate,canonical=JSON.stringify(p);if(req.action==='prepare'||before!==canonical){state.revision=revision+1;state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';}\nconst safe=x=>typeof x==='string'&&x.length>0&&Array.from(x).every(c=>c.charCodeAt(0)>=32&&!['\"','\\\\','&','#','?','%'].includes(c));\nconst valid=safe(p.Supplier)&&p.Supplier.length<=360&&safe(p.CategoryName)&&p.CategoryName.length<=250;const businessKey=JSON.stringify([p.Supplier.toLowerCase(),p.CategoryName.toLowerCase()]);const prior=Object.values(ledger).find(x=>x.businessKey===businessKey)||null;\nlet resolve=false,mode=req.action,message='Products/services draft saved. No association has been created.';\nif(req.action==='review'){state.reviewedRevision=0;state.reviewedCandidate='';state.snapshot=null;state.approvedRevision=0;state.approvedSnapshot='';resolve=valid;message=valid?'Resolving supplier and category.':'Complete supplier and category name before review.';}\nif(req.action==='approve'){const m=/^Approve products-services revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());if(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.snapshot){state.approvedRevision=state.revision;state.approvedSnapshot=JSON.stringify(state.snapshot);message='Products/services revision '+state.revision+' approved without writing. To create, enter: Create products-services revision '+state.revision+'.';}else message='Approval rejected. Review the current complete products/services draft and approve its exact revision. No write occurred.';}\nif(req.action==='create'){const m=/^Create products-services revision ([1-9][0-9]*)\\.?$/i.exec(String($context.$system.$inputMessage||'').trim());resolve=!!(valid&&m&&Number(m[1])===state.revision&&state.reviewedRevision===state.revision&&state.reviewedCandidate===canonical&&state.approvedRevision===state.revision&&state.snapshot&&state.approvedSnapshot===JSON.stringify(state.snapshot));message='Creation requires approval of the exact current reviewed products/services revision. No write occurred.';if(prior)mode='reconcile';}\nif(req.action==='reconcile'){resolve=!!prior;message='No previous products/services attempt exists for this draft. No write occurred.';}if(resolve&&mode==='reconcile'&&prior)state.candidate=JSON.parse(JSON.stringify(prior.candidate));return {state,resolve,mode,ledger,prior,businessKey,filter:\"Supplier='\"+state.candidate.Supplier.replace(/'/g,\"''\")+\"'\",display:show(state,message)};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "167"
          },
          "inputs": [],
          "diagram": {
            "x": 21875,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
