        {
          "id": "3",
          "code": "EXTRACT_READ",
          "type": "LLM",
          "metadata": {
            "name": "extract read",
            "modelConfiguration": {
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "provider": "CERT_PREMIUM",
              "model": "OCI_GPT_5_MINI",
              "modelProperties": {
                "reasoning_effort": "high",
                "max_completion_tokens": 12000
