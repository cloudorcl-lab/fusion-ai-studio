            "name": "prepare contact",
            "returnType": "object",
            "sourceCode": "\nconst fields=['FirstName','LastName','Email'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''));}\nfunction snapshot(t){return JSON.stringify({parentId:t.parentId,payload:fields.reduce(function(o,k){o[k]=t.payload[k];return o;},{})});}\nfunction valid(t){if(!key(t.parentId))return 'Select a valid supplier parent.';const p=t.payload||{},limits={FirstName:150,LastName:150,Email:320};for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>limits[k]||Array.from(p[k]).some(function(c){return c.charCodeAt(0)<32;}))return 'Invalid '+k+'.';}const parts=p.Email.split('@');if(parts.length!==2||!parts[0]||!parts[1]||parts[1].indexOf('.')<1||parts[1].endsWith('.')||Array.from(p.Email).some(function(c){return c.charCodeAt(0)<=32;}))return 'Supply a valid contact email.';return '';}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'cardWidget',title:title,properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx||{},rows=[{cells:['Supplier ID',String(t.parentId||'Not supplied')]},{cells:['Supplier',String(t.parentName||'Not yet verified')]}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.contactId)rows.push({cells:['SupplierContactId',t.contactId]});if(t.personProfileId)rows.push({cells:['PersonProfileId',t.personProfileId]});if(t.status==='verified'){rows.push({cells:['ContactName',String(t.persisted.ContactName||'Not specified')]});rows.push({cells:['UserName',t.persisted.UserName===null?'Not specified':String(t.persisted.UserName)]});rows.push({cells:['UserAccountStatus',t.persisted.UserAccountStatus===null?'Not specified':String(t.persisted.UserAccountStatus)]});}s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Contact created and verified':'Contact draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction escaped(t){const p={};fields.forEach(function(k){p[k]=JSON.stringify(t.payload[k]).slice(1,-1);});return p;}\nfunction state(){const s=obj(($context.$variables||{}).contactState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\n\nlet s=state(),t=s.tx;const r=obj($context.$nodes.EXTRACT_READ.$output),raw=String($context.$system.$inputMessage||'').trim(),lower=raw.toLowerCase();\nfunction show(m){return {route:'display',state:render(s,m)};}\nfunction fetch(operation,parentId){return {route:'parent',operation:operation,parentId:parentId,state:s};}\nconst control=/^(approve|create) contact ([a-z0-9-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nif(lower==='cancel contact'){if(t.status==='pending')return show('A write may have occurred. Reconcile contact before further action.');t.status='cancelled';t.approval=null;t.reviewedPayload='';return show('Draft cancelled. No create authorized.');}\nif(lower==='reconcile contact'){if(t.status!=='pending')return show('No uncertain contact attempt is pending.');return fetch('preflight',t.parentId);}\nif(lower==='review contact'){if(!t.requestId||t.status!=='draft')return show('Prepare an editable contact draft before review.');const error=valid(t);if(error)return show(error);if(!t.parentName)return show('Supplier parent has not been verified. Prepare this draft again.');t.reviewedPayload=snapshot(t);t.reviewedRevision=t.revision;t.approval=null;return show('Review every submitted field and supplier parent. To approve this snapshot, enter: approve contact '+t.requestId+' revision '+t.revision+'.');}\nif(control){if(control[2]!==t.requestId||Number(control[3])!==t.revision)return show('Stale request or revision. No create authorized.');if(t.status==='pending')return show('An attempt is pending. Use reconcile contact; do not repeat create.');if(t.status==='verified')return show('This contact was already created and verified. No second POST.');if(t.status!=='draft')return show('No editable draft is available.');const error=valid(t);if(error)return show(error);const exact=snapshot(t);if(control[1].toLowerCase()==='approve'){if(t.reviewedPayload!==exact||t.reviewedRevision!==t.revision)return show('Review the current exact payload before approval.');t.approval={requestId:t.requestId,revision:t.revision,payload:exact};return show('Exact snapshot approved. To create once, enter: create contact '+t.requestId+' revision '+t.revision+'.');}if(!t.approval||t.approval.requestId!==t.requestId||t.approval.revision!==t.revision||t.approval.payload!==exact||t.reviewedPayload!==exact)return show('No current exact approval. Review and approve this revision.');return fetch('preflight',t.parentId);}\nconst literalEdit=/^(change|set) (FirstName|LastName) to (.+)$/i.exec(raw);\nif(literalEdit){const field=fields.find(function(k){return k.toLowerCase()===literalEdit[2].toLowerCase();});let value=literalEdit[3].trim();if(value.endsWith('.'))value=value.slice(0,-1).trim();if(value.startsWith('\"')&&value.endsWith('\"'))value=value.slice(1,-1);r.intent='edit_contact';r.contactPatch={};r.contactPatch[field]=value;delete r.supplierId;}\nif(r.intent==='prepare_contact'||r.intent==='edit_contact'){\n if(t.status==='pending')return show('A write may have occurred. Reconcile before changing a draft.');\n if(r.intent==='prepare_contact'){const parent=String(r.supplierId||s.read.parentId||obj(($context.$variables||{}).readState).selectedSupplierId||'');s.tx=t={parentId:parent,requestId:String($context.$workflow.$jobId).toLowerCase(),revision:0,payload:{},status:'draft',approval:null};}\n if(!t.requestId||t.status!=='draft')return show('Prepare a contact draft first.');\n let changed=false,parentChanged=false;const patch=obj(r.contactPatch);if(Object.keys(patch).some(function(k){return fields.indexOf(k)<0||typeof patch[k]!== 'string';}))return show('Contact patch has an unsupported field or type.');\n if(r.supplierId&&String(r.supplierId)!==t.parentId){t.parentId=String(r.supplierId);t.parentName='';changed=true;parentChanged=true;}\n fields.forEach(function(k){if(Object.prototype.hasOwnProperty.call(patch,k)){const v=typeof patch[k]==='string'?patch[k].trim():patch[k];if(v!==t.payload[k]){t.payload[k]=v;changed=true;}}});if(changed){t.revision++;t.approval=null;t.reviewedPayload='';t.reviewedRevision=null;}if(!t.revision)t.revision=1;\n if(!key(t.parentId))return show('Supply a valid parent Supplier ID.');if(!t.parentName||parentChanged)return fetch('draft',t.parentId);return show((valid(t)||'Required fields supplied.')+' Draft only; no POST. Enter review contact.');\n}\nif(['list_contact','search_contact','detail_contact','next_contact'].indexOf(r.intent)>=0||lower==='next contact page'){\n let parent=String(r.supplierId||s.read.parentId||obj(($context.$variables||{}).readState).selectedSupplierId||'');if(!key(parent))return show('Select a supplier using its returned Supplier ID before contact access.');\n let limit=Number(r.limit),offset=Number(r.offset),q='SupplierContactId>0',id='';\n if(r.intent==='next_contact'||lower==='next contact page'){if(parent!==s.read.parentId||!Number.isInteger(s.read.nextOffset))return show('No next contact page is available.');limit=s.read.limit;offset=s.read.nextOffset;q=s.read.q;}\n else if(r.intent==='search_contact'){const name=String(r.name||'').trim();if(!name||name.length>302||/[\u0000-\u001f]/.test(name))return show('Supply a valid exact ContactName.');q=\"ContactName='\"+name.replace(/'/g,\"''\")+\"'\";}\n else if(r.intent==='detail_contact'){id=String(r.contactId||(parent===s.read.parentId?s.read.selectedId:'')||'');if(!key(id))return show('Select a contact using its returned SupplierContactId.');limit=1;offset=0;}\n if(!Number.isInteger(limit)||limit<1||limit>25||!Number.isInteger(offset)||offset<0)return show('Use contact page size1 to25 and nonnegative offset.');s.read={parentId:parent,limit:limit,offset:offset,q:q,selectedId:id,operation:id?'detail':'list'};return fetch(s.read.operation,parent);\n}\nreturn show('Use contact list/detail or the exact draft control shown. No write authorized.');\n"
          },
