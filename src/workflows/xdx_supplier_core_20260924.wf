        {
          "id": "58",
          "code": "PREPARE_SITE",
          "type": "CODE",
          "metadata": {
            "name": "prepare site",
            "returnType": "object",
            "sourceCode": "\nconst fields=['SupplierSite','ProcurementBUId','SupplierAddressName','SitePurposePurchasingFlag'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''));}\nfunction snapshot(t){return JSON.stringify({parentId:t.parentId,payload:fields.reduce(function(o,k){o[k]=t.payload[k];return o;},{}),referenceAddressId:t.referenceAddressId,buName:t.buName});}\nfunction valid(t){if(!key(t.parentId))return 'Select a valid supplier parent.';const p=t.payload||{};for(const k of ['SupplierSite','SupplierAddressName']){if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>240||Array.from(p[k]).some(function(c){return c.charCodeAt(0)<32;}))return 'Supply a valid '+k+'.';}if(!Number.isSafeInteger(p.ProcurementBUId)||p.ProcurementBUId<=0)return 'Select an explicit ProcurementBUId from the current site lookup.';if(p.SitePurposePurchasingFlag!==true)return 'Purchasing purpose must be true.';return '';}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'cardWidget',title:title,properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx||{},rows=[{cells:['Supplier ID',String(t.parentId||'Not supplied')]},{cells:['Supplier',String(t.parentName||'Not yet verified')]}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.referenceAddressId)rows.push({cells:['Resolved SupplierAddressId',t.referenceAddressId]});if(t.buName)rows.push({cells:['Procurement BU',t.buName]});if(t.siteId)rows.push({cells:['SupplierSiteId',t.siteId]});if(t.buChoices)rows.push({cells:['Current BU choices',t.buChoices]});s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Site created and verified':'Site draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction escaped(t){const p={};fields.forEach(function(k){p[k]=typeof t.payload[k]==='string'?JSON.stringify(t.payload[k]).slice(1,-1):t.payload[k];});return p;}\nfunction state(){const s=obj(($context.$variables||{}).siteState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\n\nlet s=state(),t=s.tx;const r=obj($context.$nodes.EXTRACT_READ.$output),raw=String($context.$system.$inputMessage||'').trim(),lower=raw.toLowerCase();\nfunction show(m){return {route:'display',state:render(s,m)};}\nfunction fetch(operation,parentId){return {route:'parent',operation:operation,parentId:parentId,state:s};}\nconst control=/^(approve|create) site ([a-z0-9-]+) revision ([1-9][0-9]*)$/i.exec(raw);\nif(lower==='cancel site'){if(t.status==='pending')return show('A write may have occurred. Reconcile site before further action.');t.status='cancelled';t.approval=null;t.reviewedPayload='';return show('Draft cancelled. No create authorized.');}\nif(lower==='reconcile site'){if(t.status!=='pending')return show('No uncertain site attempt is pending.');return fetch('preflight',t.parentId);}\nif(lower==='review site'){if(!t.requestId||t.status!=='draft')return show('Prepare an editable site draft before review.');const error=valid(t);if(error)return show(error);return fetch('review',t.parentId);}\nif(control){if(control[2]!==t.requestId||Number(control[3])!==t.revision)return show('Stale request or revision. No create authorized.');if(t.status==='pending')return show('An attempt is pending. Use reconcile site; do not repeat create.');if(t.status==='verified')return show('This site was already created and verified. No second POST.');if(t.status!=='draft')return show('No editable draft is available.');const error=valid(t);if(error)return show(error);const exact=snapshot(t);if(control[1].toLowerCase()==='approve'){if(t.reviewedPayload!==exact||t.reviewedRevision!==t.revision)return show('Review the current exact payload before approval.');t.approval={requestId:t.requestId,revision:t.revision,payload:exact};return show('Exact snapshot approved. To create once, enter: create site '+t.requestId+' revision '+t.revision+'.');}if(!t.approval||t.approval.requestId!==t.requestId||t.approval.revision!==t.revision||t.approval.payload!==exact||t.reviewedPayload!==exact)return show('No current exact approval. Review and approve this revision.');return fetch('preflight',t.parentId);}\nconst literalEdit=/^(change|set) (SupplierSite) to (.+)$/i.exec(raw);\nif(literalEdit){const field=fields.find(function(k){return k.toLowerCase()===literalEdit[2].toLowerCase();});let value=literalEdit[3].trim();if(value.endsWith('.'))value=value.slice(0,-1).trim();if(value.startsWith('\"')&&value.endsWith('\"'))value=value.slice(1,-1);r.intent='edit_site';r.sitePatch={};r.sitePatch[field]=value;delete r.supplierId;}\nif(r.intent==='prepare_site'||r.intent==='edit_site'){\n if(t.status==='pending')return show('A write may have occurred. Reconcile before changing a draft.');\n if(r.intent==='prepare_site'){const parent=String(r.supplierId||s.read.parentId||obj(($context.$variables||{}).readState).selectedSupplierId||'');s.tx=t={parentId:parent,requestId:String($context.$workflow.$jobId).toLowerCase(),revision:0,payload:{},status:'draft',approval:null};}\n if(!t.requestId||t.status!=='draft')return show('Prepare a site draft first.');\n let changed=false,parentChanged=false;const patch=obj(r.sitePatch);if(Object.keys(patch).some(function(k){return fields.indexOf(k)<0||typeof patch[k]!== (k==='SitePurposePurchasingFlag'?'boolean':k==='ProcurementBUId'?'number':'string');}))return show('Site patch has an unsupported field or type.');\n if(r.supplierId&&String(r.supplierId)!==t.parentId){t.parentId=String(r.supplierId);t.parentName='';changed=true;parentChanged=true;}\n fields.forEach(function(k){if(Object.prototype.hasOwnProperty.call(patch,k)){const v=typeof patch[k]==='string'?patch[k].trim():patch[k];if(v!==t.payload[k]){t.payload[k]=v;changed=true;}}});if(changed){t.revision++;t.approval=null;t.reviewedPayload='';t.reviewedRevision=null;}if(!t.revision)t.revision=1;\n if(!key(t.parentId))return show('Supply a valid parent Supplier ID.');if(!t.parentName||parentChanged)return fetch('draft',t.parentId);return show((valid(t)||'Required fields supplied.')+' Draft only; no POST. Enter review site.');\n}\nif(['list_site','search_site','detail_site','next_site'].indexOf(r.intent)>=0||lower==='next site page'){\n let parent=String(r.supplierId||s.read.parentId||obj(($context.$variables||{}).readState).selectedSupplierId||'');if(!key(parent))return show('Select a supplier using its returned Supplier ID before site access.');\n let limit=Number(r.limit),offset=Number(r.offset),q='SupplierSiteId>0',id='';\n if(r.intent==='next_site'||lower==='next site page'){if(parent!==s.read.parentId||!Number.isInteger(s.read.nextOffset))return show('No next site page is available.');limit=s.read.limit;offset=s.read.nextOffset;q=s.read.q;}\n else if(r.intent==='search_site'){const name=String(r.name||'').trim();if(!name||name.length>240||/[\u0000-\u001f]/.test(name))return show('Supply a valid exact SupplierSite.');q=\"SupplierSite='\"+name.replace(/'/g,\"''\")+\"'\";}\n else if(r.intent==='detail_site'){id=String(r.siteId||(parent===s.read.parentId?s.read.selectedId:'')||'');if(!key(id))return show('Select a site using its returned SupplierSiteId.');limit=1;offset=0;}\n if(!Number.isInteger(limit)||limit<1||limit>25||!Number.isInteger(offset)||offset<0)return show('Use site page size1 to25 and nonnegative offset.');s.read={parentId:parent,limit:limit,offset:offset,q:q,selectedId:id,operation:id?'detail':'list'};return fetch(s.read.operation,parent);\n}\nreturn show('Use site list/detail or the exact draft control shown. No write authorized.');\n"
          },
