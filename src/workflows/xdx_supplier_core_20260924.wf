        {
          "id": "14",
          "code": "SHAPE_DETAIL",
          "type": "CODE",
          "metadata": {
            "name": "shape detail",
            "returnType": "object",
            "sourceCode": "const shaped=(function(){\nlet raw=$context.$nodes.FETCH_SUPPLIER_DETAIL.$output;if(typeof raw==='string'){try{raw=JSON.parse(raw);}catch(e){raw=null;}}\nconst r=$context.$nodes.PREPARE_READ.$output.result;\nif(!raw||String(raw.SupplierId)!==r.supplierId||!raw.Supplier)return {state:Object.assign({},r.previous,{view:{error:'Supplier detail could not be verified. No record is selected.'}})};\nconst fields=[\"SupplierId\",\"SupplierNumber\",\"Supplier\",\"SupplierType\",\"BusinessRelationship\",\"InactiveDate\",\"Status\",\"AlternateName\",\"TaxOrganizationType\",\"CorporateWebsite\"];const values=fields.map(function(f){return raw[f]===undefined?null:raw[f];});\nconst view={kind:'detail',title:'Supplier detail',columns:fields,rows:[values],error:'',description:'Verified scalar supplier profile. Child resources are separate.'};\nreturn {state:Object.assign({},r.previous,{selectedSupplierId:String(raw.SupplierId),view:view})};\n})();\n\nconst view=shaped.state.view;\nconst labels={SupplierId:'Supplier ID',SupplierNumber:'Supplier number',Supplier:'Supplier',SupplierType:'Supplier type',BusinessRelationship:'Business relationship',InactiveDate:'Inactive date',Status:'Status',AlternateName:'Alternate name',TaxOrganizationType:'Tax organization type',CorporateWebsite:'Corporate website'};\nlet widget;\nif(view.error)widget={patternId:'cardWidget',title:'Supplier query unavailable',properties:{subject:'Unable to verify the result',summary:view.error}};\nelse if(view.kind==='list'&&view.rows.length===0)widget={patternId:'cardWidget',title:'Supplier query results',description:'count: 0, offset: '+view.offset+', hasMore: false. No next page.',properties:{subject:'No suppliers match',summary:'Try another exact supplier name or list suppliers.'}};\nelse {\n const description=view.kind==='detail'?'Verified scalar supplier profile for '+shaped.state.selectedSupplierId+'.':('Page of supplier results. count: '+view.count+', offset: '+view.offset+', hasMore: '+view.hasMore+', nextOffset: '+(view.nextOffset===null?'Not specified':view.nextOffset)+'. '+(view.hasMore?'Use next page for continuation. ':'No next page. ')+'Use a returned Supplier ID for detail.');\n widget={patternId:'multiRecordWidget',title:view.title,description:description,properties:{cols:view.columns.map(function(x){return labels[x]||x;}),rows:view.rows.map(function(row){return {cells:row.map(function(x){return x===null?'Not specified':String(x);})};})}};\n}\nview.widget='<oraInfoDisplay key=\"supplierRead\">'+JSON.stringify(widget)+'</oraInfoDisplay>';\nreturn shaped;"
          },
