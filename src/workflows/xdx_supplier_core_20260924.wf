        {
          "id": "4",
          "code": "PREPARE_READ",
          "type": "CODE",
          "metadata": {
            "name": "prepare read",
            "returnType": "object",
            "sourceCode": "const prepared=(function(){const init=$context.$app.$OraMessageHint==='InitDisplay';\nlet previous=($context.$variables||{}).readState;\nif(typeof previous==='string'){try{previous=JSON.parse(previous);}catch(e){previous=null;}}\nprevious=previous&&typeof previous==='object'?previous:{};\nlet r=init?{intent:'list',name:'',supplierId:'',limit:5,offset:0}:$context.$nodes.EXTRACT_READ.$output;\nif(typeof r==='string'){try{r=JSON.parse(r);}catch(e){r={intent:'unsupported'};}}r=r||{};\nconst message=String($context.$system.$inputMessage||'').trim().toLowerCase();\nif(!init&&/^(please )?(delete|purge|remove)( |$)/i.test(message))r={intent:'unsupported'};\nif(!init&&/^(next|next page)$/.test(message))r={intent:'next'};\nlet limit=Number(r.limit),offset=Number(r.offset),q='SupplierId>0',id='',error='';\nif(r.intent==='next'){limit=previous.limit;offset=previous.nextOffset;q=previous.q;if(!Number.isInteger(offset)||offset<0||!q)error='No next page is available in this conversation. Run a supplier list first.';}\nelse if(r.intent==='search'){const name=String(r.name||'').trim();if(!name||name.length>360||/[\\r\\n\\x00-\\x1f]/.test(name))error='Supply a valid supplier name.';else q=\"Supplier='\"+name.replace(/'/g,\"''\")+\"'\";}\nelse if(r.intent==='detail'){id=String(r.supplierId||previous.selectedSupplierId||'');if(!/^[1-9][0-9]{0,15}$/.test(id))error='Choose a supplier using its returned Supplier ID.';limit=1;offset=0;}\nelse if(r.intent!=='list')error='Supported reads are supplier, address, site and contact list, exact-name search, next page and selected detail. Child reads require a selected supplier.';\nif(!error&&(!Number.isInteger(limit)||limit<1||limit>25||!Number.isInteger(offset)||offset<0))error='Use a page size from 1 to 25 and a nonnegative offset.';\nreturn {q:q,limit:limit||5,offset:offset||0,supplierId:id,error:error,intent:r.intent,previous:previous};})(); prepared.guidanceWidget='<oraInfoDisplay key=\"supplierGuidance\">'+JSON.stringify({patternId:\"cardWidget\",title:\"Supplier request guidance\",properties:{subject:\"Request not executed\",summary:prepared.error}})+'</oraInfoDisplay>';return prepared;"
          },
