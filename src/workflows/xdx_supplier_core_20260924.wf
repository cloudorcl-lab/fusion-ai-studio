        {
          "id": "87",
          "code": "CHECK_SITE_REFERENCES",
          "type": "CODE",
          "metadata": {
            "name": "check site references",
            "returnType": "object",
            "sourceCode": "\nconst fields=['SupplierSite','ProcurementBUId','SupplierAddressName','SitePurposePurchasingFlag'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''));}\nfunction snapshot(t){return JSON.stringify({parentId:t.parentId,payload:fields.reduce(function(o,k){o[k]=t.payload[k];return o;},{}),referenceAddressId:t.referenceAddressId,buName:t.buName});}\nfunction valid(t){if(!key(t.parentId))return 'Select a valid supplier parent.';const p=t.payload||{};for(const k of ['SupplierSite','SupplierAddressName']){if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>240||Array.from(p[k]).some(function(c){return c.charCodeAt(0)<32;}))return 'Supply a valid '+k+'.';}if(!Number.isSafeInteger(p.ProcurementBUId)||p.ProcurementBUId<=0)return 'Select an explicit ProcurementBUId from the current site lookup.';if(p.SitePurposePurchasingFlag!==true)return 'Purchasing purpose must be true.';return '';}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'cardWidget',title:title,properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx||{},rows=[{cells:['Supplier ID',String(t.parentId||'Not supplied')]},{cells:['Supplier',String(t.parentName||'Not yet verified')]}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.referenceAddressId)rows.push({cells:['Resolved SupplierAddressId',t.referenceAddressId]});if(t.buName)rows.push({cells:['Procurement BU',t.buName]});if(t.siteId)rows.push({cells:['SupplierSiteId',t.siteId]});if(t.buChoices)rows.push({cells:['Current BU choices',t.buChoices]});s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Site created and verified':'Site draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction escaped(t){const p={};fields.forEach(function(k){p[k]=typeof t.payload[k]==='string'?JSON.stringify(t.payload[k]).slice(1,-1):t.payload[k];});return p;}\nfunction state(){const s=obj(($context.$variables||{}).siteState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\n\nconst s=state(),t=s.tx,op=$context.$nodes.CHECK_SITE_PARENT.$output.result.requestedOperation,a=obj($context.$nodes.FETCH_SITE_ADDRESS_REFERENCE.$output),bu=obj($context.$nodes.FETCH_SITE_BU_REFERENCE.$output);\nfunction stop(message){t.approval=null;t.reviewedPayload='';return {next:'display',state:render(s,message)};}\nif(!Array.isArray(a.items)||a.count!==1||a.items.length!==1||a.hasMore!==false||a.offset!==0||a.items[0].AddressName!==t.payload.SupplierAddressName||!key(a.items[0].SupplierAddressId)||a.items[0].AddressPurposeOrderingFlag!==true||a.items[0].Status!=='ACTIVE')return stop('Exactly one active ordering address must be verified under this supplier. No write.');\nif(!Array.isArray(bu.items)||bu.count!==bu.items.length||bu.hasMore!==false||bu.offset!==0||bu.items.some(function(x){return !key(x.ProcurementBUId)||typeof x.ProcurementBU!=='string'||!x.ProcurementBU;}))return stop('BU lookup is unavailable or incomplete; no site approval or write.');\nconst choices={};for(const row of bu.items){const id=String(row.ProcurementBUId);if(choices[id]&&choices[id]!==row.ProcurementBU)return stop('BU lookup has inconsistent names; no site approval or write.');choices[id]=row.ProcurementBU;}\nconst addressId=String(a.items[0].SupplierAddressId),buName=choices[String(t.payload.ProcurementBUId)];\nif(!buName){t.referenceAddressId=addressId;t.buChoices=Object.keys(choices).map(function(id){return choices[id]+' ('+id+')';}).join('; ');return stop('Select ProcurementBUId from these current site field choices. Draft only.');}\nconst changed=t.referenceAddressId&&t.referenceAddressId!==addressId||t.buName&&t.buName!==buName;t.referenceAddressId=addressId;t.buName=buName;delete t.buChoices;\nif(changed){t.approval=null;t.reviewedPayload='';if(op==='preflight')return stop('Resolved site references changed. Review and approve the current draft again.');}\nif(op==='preflight')return {next:'preflight',state:s};const error=valid(t);if(error)return stop(error);\nif(op==='review'){t.reviewedPayload=snapshot(t);t.reviewedRevision=t.revision;t.approval=null;return {next:'display',state:render(s,'Review all four submitted fields, supplier, resolved address and BU. To approve this snapshot, enter: approve site '+t.requestId+' revision '+t.revision+'.')};}\nreturn {next:'display',state:render(s,'Site references verified. Draft only; enter review site.')};\n"
