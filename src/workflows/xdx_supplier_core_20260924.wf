          ],
          "diagram": {
            "x": 7812.5,
            "y": 6538
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplierId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierNumber\": {\n            \"type\": \"string\"\n          },\n          \"Supplier\": {\n            \"type\": \"string\"\n          },\n          \"SupplierType\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"BusinessRelationship\": {\n            \"type\": \"string\"\n          },\n          \"InactiveDate\": {\n            \"type\": \"null\"\n          }\n        },\n        \"required\": [\n          \"SupplierId\",\n          \"SupplierNumber\",\n          \"Supplier\",\n          \"SupplierType\",\n          \"BusinessRelationship\",\n          \"InactiveDate\"\n        ],\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "7",
          "code": "SHAPE_SUPPLIERS",
          "type": "CODE",
          "metadata": {
            "name": "shape suppliers",
            "returnType": "object",
            "sourceCode": "const shaped=(function(){\nlet raw=$context.$nodes.FETCH_SUPPLIERS.$output;if(typeof raw==='string'){try{raw=JSON.parse(raw);}catch(e){raw=null;}}\nconst r=$context.$nodes.PREPARE_READ.$output.result;\nfunction fail(message){return {state:Object.assign({},r.previous,{view:{error:message}})};}\nif(!raw||!Array.isArray(raw.items)||typeof raw.hasMore!=='boolean'||!Number.isInteger(raw.count)||raw.count!==raw.items.length||!Number.isInteger(raw.offset)||raw.offset!==r.offset||raw.limit!==r.limit||raw.items.length>r.limit)return fail('Supplier service returned invalid paging or collection data. No empty-result claim is made.');\nconst fields=['SupplierId','SupplierNumber','Supplier','SupplierType','BusinessRelationship','InactiveDate'];\nif(raw.items.some(function(x){return !/^[1-9][0-9]*$/.test(String(x.SupplierId))||!x.Supplier;}))return fail('Supplier response contains invalid record keys.');\nconst next=raw.hasMore?raw.offset+raw.count:null;\nif(raw.hasMore&&raw.count===0)return fail('Supplier service returned an unusable continuation.');\nconst view={kind:'list',title:'Supplier query results',columns:fields,rows:raw.items.map(function(x){return fields.map(function(f){return x[f]===undefined?null:x[f];});}),count:raw.count,offset:raw.offset,limit:raw.limit,hasMore:raw.hasMore,nextOffset:next,error:'',description:'Use next page for continuation; use a returned Supplier ID for detail.'};\nreturn {state:{q:r.q,limit:r.limit,nextOffset:next,selectedSupplierId:raw.items.length===1?String(raw.items[0].SupplierId):'',view:view}};\n})();\n\nconst view=shaped.state.view;\nconst labels={SupplierId:'Supplier ID',SupplierNumber:'Supplier number',Supplier:'Supplier',SupplierType:'Supplier type',BusinessRelationship:'Business relationship',InactiveDate:'Inactive date',Status:'Status',AlternateName:'Alternate name',TaxOrganizationType:'Tax organization type',CorporateWebsite:'Corporate website'};\nlet widget;\nif(view.error)widget={patternId:'cardWidget',title:'Supplier query unavailable',properties:{subject:'Unable to verify the result',summary:view.error}};\nelse if(view.kind==='list'&&view.rows.length===0)widget={patternId:'cardWidget',title:'Supplier query results',description:'count: 0, offset: '+view.offset+', hasMore: false. No next page.',properties:{subject:'No suppliers match',summary:'Try another exact supplier name or list suppliers.'}};\nelse {\n const description=view.kind==='detail'?'Verified scalar supplier profile for '+shaped.state.selectedSupplierId+'.':('Page of supplier results. count: '+view.count+', offset: '+view.offset+', hasMore: '+view.hasMore+', nextOffset: '+(view.nextOffset===null?'Not specified':view.nextOffset)+'. '+(view.hasMore?'Use next page for continuation. ':'No next page. ')+'Use a returned Supplier ID for detail.');\n widget={patternId:'multiRecordWidget',title:view.title,description:description,properties:{cols:view.columns.map(function(x){return labels[x]||x;}),rows:view.rows.map(function(row){return {cells:row.map(function(x){return x===null?'Not specified':String(x);})};})}};\n}\nview.widget='<oraInfoDisplay key=\"supplierRead\">'+JSON.stringify(widget)+'</oraInfoDisplay>';\nreturn shaped;"
          },
          "outcomes": {
            "success": "15"
          },
          "inputs": [],
