        {
          "id": "55",
          "code": "VERIFY_ADDRESS_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "verify address create",
            "returnType": "object",
            "sourceCode": "\nconst fields=['AddressName','CountryCode','AddressLine1','City','State','PostalCode','Email','AddressPurposeOrderingFlag'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''));}\nfunction snapshot(t){return JSON.stringify({parentId:t.parentId,payload:fields.reduce(function(o,k){o[k]=t.payload[k];return o;},{})});}\nfunction valid(t){if(!key(t.parentId))return 'Select a valid supplier parent.';const p=t.payload||{},limits={AddressName:240,CountryCode:2,AddressLine1:240,City:60,State:60,PostalCode:60,Email:320};for(const k of Object.keys(limits)){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>limits[k]||/[\u0000-\u001f]/.test(p[k]))return 'Invalid '+k+'.';}if(!/^[A-Z]{2}$/.test(p.CountryCode))return 'CountryCode requires two uppercase letters.';const emailParts=p.Email.split('@');if(emailParts.length!==2||!emailParts[0]||emailParts[1].indexOf('.')<1||emailParts[1].endsWith('.')||Array.from(p.Email).some(function(ch){return ch.charCodeAt(0)<=32||ch.charCodeAt(0)===127;}))return 'Supply a valid address email.';if(p.AddressPurposeOrderingFlag!==true)return 'Ordering purpose must be true for this purchasing address.';return '';}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"addressCore\">'+JSON.stringify({patternId:'cardWidget',title:title,properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx||{},rows=[{cells:['Supplier ID',String(t.parentId||'Not supplied')]},{cells:['Supplier',String(t.parentName||'Not yet verified')]}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.addressId)rows.push({cells:['SupplierAddressId',t.addressId]});if(t.addressPartyNumber)rows.push({cells:['AddressPartyNumber',t.addressPartyNumber]});s.widget='<oraInfoDisplay key=\"addressCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Address created and verified':'Address draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction escaped(t){const p={};fields.forEach(function(k){p[k]=typeof t.payload[k]==='boolean'?t.payload[k]:JSON.stringify(t.payload[k]).slice(1,-1);});return p;}\nfunction state(){const s=obj(($context.$variables||{}).addressState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\n\nconst s=state(),t=s.tx,raw=obj($context.$nodes.GET_CREATED_ADDRESS.$output);if(String(raw.SupplierAddressId)!==t.addressId||fields.some(function(k){return raw[k]!==t.payload[k];}))return {state:render(s,'Persisted GET did not confirm every intended field. Outcome remains pending; no retry authorized.')};t.status='verified';t.persisted=raw;t.addressPartyNumber=String(raw.AddressPartyNumber||'');return {state:render(s,'Independent GET under the approved supplier confirms all eight submitted fields. Address created once; this request cannot create again.')};\n"
          },
          "outcomes": {
            "success": "56"
          },
          "inputs": [],
          "diagram": {
            "x": 7643.75,
            "y": 9646
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
