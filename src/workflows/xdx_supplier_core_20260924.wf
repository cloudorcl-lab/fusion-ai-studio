            "name": "shape sites",
            "returnType": "object",
            "sourceCode": "\nconst fields=['SupplierSite','ProcurementBUId','SupplierAddressName','SitePurposePurchasingFlag'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''));}\nfunction snapshot(t){return JSON.stringify({parentId:t.parentId,payload:fields.reduce(function(o,k){o[k]=t.payload[k];return o;},{}),referenceAddressId:t.referenceAddressId,buName:t.buName});}\nfunction valid(t){if(!key(t.parentId))return 'Select a valid supplier parent.';const p=t.payload||{};for(const k of ['SupplierSite','SupplierAddressName']){if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>240||Array.from(p[k]).some(function(c){return c.charCodeAt(0)<32;}))return 'Supply a valid '+k+'.';}if(!Number.isSafeInteger(p.ProcurementBUId)||p.ProcurementBUId<=0)return 'Select an explicit ProcurementBUId from the current site lookup.';if(p.SitePurposePurchasingFlag!==true)return 'Purchasing purpose must be true.';return '';}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'cardWidget',title:title,properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx||{},rows=[{cells:['Supplier ID',String(t.parentId||'Not supplied')]},{cells:['Supplier',String(t.parentName||'Not yet verified')]}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.referenceAddressId)rows.push({cells:['Resolved SupplierAddressId',t.referenceAddressId]});if(t.buName)rows.push({cells:['Procurement BU',t.buName]});if(t.siteId)rows.push({cells:['SupplierSiteId',t.siteId]});if(t.buChoices)rows.push({cells:['Current BU choices',t.buChoices]});s.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Site created and verified':'Site draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction escaped(t){const p={};fields.forEach(function(k){p[k]=typeof t.payload[k]==='string'?JSON.stringify(t.payload[k]).slice(1,-1):t.payload[k];});return p;}\nfunction state(){const s=obj(($context.$variables||{}).siteState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\n\nconst s=state(),read=s.read;const raw=obj($context.$nodes.FETCH_SITES.$output);let rows=[];\nif(false){if(String(raw.SupplierSiteId)!==read.selectedId)return {state:card(s,'Site unavailable','The selected site could not be verified under supplier '+read.parentId+'.')};rows=[raw];read.nextOffset=null;}\nelse {if(!Array.isArray(raw.items)||raw.count!==raw.items.length||typeof raw.hasMore!=='boolean'||raw.offset!==read.offset||raw.limit!==read.limit||raw.items.some(function(x){return !key(x.SupplierSiteId);}))return {state:card(s,'Site query unavailable','Service response or paging could not be verified.')};rows=raw.items;read.nextOffset=raw.hasMore?raw.offset+raw.limit:null;read.hasMore=raw.hasMore;if(rows.length===1)read.selectedId=String(rows[0].SupplierSiteId);}\nconst cols=['SupplierSiteId'].concat(fields,['ProcurementBU','SupplierAddressId','Status','InactiveDate']);\nconst description='Supplier '+read.parentName+' ('+read.parentId+'). '+(false?'Verified selected site.':'count: '+raw.count+', offset: '+raw.offset+', hasMore: '+raw.hasMore+'. '+(raw.hasMore?'Use next site page.':'No next page.'));\nif(!rows.length)return {state:card(s,'No sites match',description+' Select a different exact SupplierSite or prepare a site for this supplier.')};\ns.widget='<oraInfoDisplay key=\"siteCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:false?'Site detail':'Supplier sites',description:description,properties:{cols:cols,rows:rows.map(function(x){return {cells:cols.map(function(k){return x[k]===null||x[k]===undefined?'Not specified':String(x[k]);})};})}})+'</oraInfoDisplay>';return {state:s};\n"
