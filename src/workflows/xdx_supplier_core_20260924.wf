        {
          "id": "113",
          "code": "VERIFY_CONTACT_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "verify contact create",
            "returnType": "object",
            "sourceCode": "\nconst fields=['FirstName','LastName','Email'];\nfunction obj(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction key(x){return /^[1-9][0-9]{0,15}$/.test(String(x||''));}\nfunction snapshot(t){return JSON.stringify({parentId:t.parentId,payload:fields.reduce(function(o,k){o[k]=t.payload[k];return o;},{})});}\nfunction valid(t){if(!key(t.parentId))return 'Select a valid supplier parent.';const p=t.payload||{},limits={FirstName:150,LastName:150,Email:320};for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())return 'Required: '+k+'.';if(p[k].length>limits[k]||Array.from(p[k]).some(function(c){return c.charCodeAt(0)<32;}))return 'Invalid '+k+'.';}const parts=p.Email.split('@');if(parts.length!==2||!parts[0]||!parts[1]||parts[1].indexOf('.')<1||parts[1].endsWith('.')||Array.from(p.Email).some(function(c){return c.charCodeAt(0)<=32;}))return 'Supply a valid contact email.';return '';}\nfunction card(s,title,message){s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'cardWidget',title:title,properties:{subject:title,summary:message}})+'</oraInfoDisplay>';return s;}\nfunction render(s,message){const t=s.tx||{},rows=[{cells:['Supplier ID',String(t.parentId||'Not supplied')]},{cells:['Supplier',String(t.parentName||'Not yet verified')]}].concat(fields.map(function(k){return {cells:[k,t.payload&&t.payload[k]!==undefined?String(t.payload[k]):'Not supplied']};}));if(t.contactId)rows.push({cells:['SupplierContactId',t.contactId]});if(t.personProfileId)rows.push({cells:['PersonProfileId',t.personProfileId]});if(t.status==='verified'){rows.push({cells:['ContactName',String(t.persisted.ContactName||'Not specified')]});rows.push({cells:['UserName',t.persisted.UserName===null?'Not specified':String(t.persisted.UserName)]});rows.push({cells:['UserAccountStatus',t.persisted.UserAccountStatus===null?'Not specified':String(t.persisted.UserAccountStatus)]});}s.widget='<oraInfoDisplay key=\"contactCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Contact created and verified':'Contact draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction escaped(t){const p={};fields.forEach(function(k){p[k]=JSON.stringify(t.payload[k]).slice(1,-1);});return p;}\nfunction state(){const s=obj(($context.$variables||{}).contactState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\n\nconst s=state(),t=s.tx,raw=obj($context.$nodes.GET_CREATED_CONTACT.$output);if(String(raw.SupplierContactId)!==t.contactId||fields.some(function(k){return raw[k]!==t.payload[k];})||!key(raw.PersonProfileId)||raw.UserName!==null||raw.UserAccountStatus!==null)return {state:render(s,'Persisted GET did not confirm every intended field. Outcome remains pending; no retry authorized.')};t.status='verified';t.persisted=raw;t.personProfileId=String(raw.PersonProfileId||'');return {state:render(s,'Independent GET under the approved supplier confirms all three submitted fields and null account fields. Contact created once; this request cannot create again.')};\n"
          },
          "outcomes": {
            "success": "114"
          },
