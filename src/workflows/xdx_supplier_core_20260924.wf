sPartyNumber]});s.widget='<oraInfoDisplay key=\"addressCore\">'+JSON.stringify({patternId:'multiRecordWidget',title:t.status==='verified'?'Address created and verified':'Address draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction escaped(t){const p={};fields.forEach(function(k){p[k]=typeof t.payload[k]==='boolean'?t.payload[k]:JSON.stringify(t.payload[k]).slice(1,-1);});return p;}\nfunction state(){const s=obj(($context.$variables||{}).addressState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\nconst s=state();return {parentId:s.tx.parentId,q:\"AddressName='\"+s.tx.payload.AddressName.replace(/'/g,\"''\")+\"'\"};"
