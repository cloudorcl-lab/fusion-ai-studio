:'Site draft',description:message+(t.requestId?' Request '+t.requestId+', revision '+t.revision+'.':''),properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>';return s;}\nfunction escaped(t){const p={};fields.forEach(function(k){p[k]=typeof t.payload[k]==='string'?JSON.stringify(t.payload[k]).slice(1,-1):t.payload[k];});return p;}\nfunction state(){const s=obj(($context.$variables||{}).siteState);s.read=obj(s.read);s.tx=obj(s.tx);return s;}\n\nconst s=state(),t=s.tx,raw=obj($context.$nodes.GET_CREATED_SITE.$output);if(String(raw.SupplierSiteId)!==t.siteId||fields.some(function(k){return raw[k]!==t.payload[k];})||String(raw.SupplierAddressId)!==t.referenceAddressId||raw.ProcurementBU!==t.buName)return {state:render(s,'Persisted GET did not confirm every intended field. Outcome remains pending; no retry authorized.')};t.status='verified';t.persisted=raw;return {state:render(s,'Independent GET under the approved supplier confirms all four submitted fields and the resolved address and BU. Site created once; this request cannot create again.')};\n"
