        {
          "id": "21",
          "code": "AUTHORIZE_SUPPLIER_WRITE",
          "type": "CODE",
          "metadata": {
            "name": "authorize supplier write",
            "returnType": "object",
            "sourceCode": "\nconst fields=['Supplier','BusinessRelationship','TaxOrganizationType'];\nfunction object(x){if(typeof x==='string'){try{x=JSON.parse(x);}catch(e){return {};}}return x&&typeof x==='object'&&!Array.isArray(x)?x:{};}\nfunction snapshot(p){const result={};fields.forEach(function(k){result[k]=p[k];});return JSON.stringify(result);}\nfunction validate(p){const missing=[];for(const k of fields){if(typeof p[k]!=='string'||!p[k].trim())missing.push(k);else if(p[k].length>(k==='Supplier'?360:80)||/[\\x00-\\x1f]/.test(p[k]))return 'Invalid value for '+k+'.';}return missing.length?'Required: '+missing.join(', ')+'.':'';}\nfunction render(s,message){let rows=fields.map(function(k){return {cells:[k,s.payload&&s.payload[k]!==undefined?s.payload[k]:'Not supplied']};});if(s.supplierId)rows.push({cells:['Supplier ID',s.supplierId]});if(s.supplierNumber)rows.push({cells:['Supplier number',s.supplierNumber]});\nconst title=s.status==='verified'?'Supplier created and verified':s.status==='pending'?'Supplier outcome awaiting verification':'Supplier draft';\nconst description=message+(s.requestId?' Request '+s.requestId+', revision '+s.revision+'.':'');\ns.view={widget:'<oraInfoDisplay key=\"supplierTransaction\">'+JSON.stringify({patternId:'multiRecordWidget',title:title,description:description,properties:{cols:['Field','Value'],rows:rows}})+'</oraInfoDisplay>'};return s;}\nfunction escaped(p){const out={};fields.forEach(function(k){out[k]=JSON.stringify(p[k]).slice(1,-1);});return out;}\nfunction readState(){return object(($context.$variables||{}).transactionState);}\n\nlet s=object($context.$nodes.PREPARE_TRANSACTION.$output.result.state);const raw=object($context.$nodes.CHECK_SUPPLIER_DUPLICATE.$output);\nfunction stop(message){return {next:'display',state:render(s,message)};}\nif(!Array.isArray(raw.items)||typeof raw.hasMore!=='boolean'||raw.count!==raw.items.length||raw.offset!==0)return stop('Duplicate check failed or returned invalid data. No create submitted.');\nif(s.status==='pending'){if(raw.hasMore||raw.items.length!==1)return stop('Uncertain outcome remains unresolved. No retry authorized.');const item=raw.items[0];if(item.Supplier!==s.payload.Supplier||!/^[1-9][0-9]*$/.test(String(item.SupplierId)))return stop('Reconciliation identity mismatch. No retry authorized.');s.supplierId=String(item.SupplierId);s.reconciled=true;return {next:'verify',state:render(s,'A matching supplier was found; verifying all intended fields by independent GET.')};}\nif(raw.items.length||raw.hasMore)return stop('A supplier with this name already exists. No create submitted. Choose a different draft name and review again.');\nconst payload=snapshot(s.payload||{});if(s.status!=='draft'||validate(s.payload||{})||!s.approval||s.approval.requestId!==s.requestId||s.approval.revision!==s.revision||s.approval.payload!==payload||s.reviewedPayload!==payload)return stop('Exact approval no longer matches. No create submitted.');\ns.status='pending';s.attempt={requestId:s.requestId,revision:s.revision,payload:payload,started:String($context.$system.$currentDateTime)};s.approval=null;s.escaped=escaped(s.payload);return {next:'write',state:render(s,'Create attempt recorded. Do not retry while outcome is uncertain.')};\n"
          },
