        {
          "id": "724",
          "code": "LIST_SUPPLIER_ADDRESSES",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "List Supplier Addresses",
            "description": "Runs the selected-parent bounded addresses GET.",
            "businessObjectCode": "XDX_SUPPLIER_INFORMATION",
            "functionName": "ListSupplierAddresses"
          },
          "outcomes": {
            "success": "727"
          },
          "inputs": [
            {
              "id": "724_suppliers_Id",
              "name": "suppliers_Id",
              "type": "string",
              "value": "{{$context.$nodes.REDUCE_LIFECYCLE.$output.result.query.parentId}}"
            },
