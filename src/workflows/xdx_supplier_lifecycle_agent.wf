{
  "workflowId": "300000333950759",
  "workflowCode": "XDX_SUPPLIER_LIFECYCLE_AGENT",
  "name": "XDX Supplier Lifecycle Agent",
  "description": "Ask Oracle supplier query and required-field lifecycle with deterministic approval and independent verification.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
