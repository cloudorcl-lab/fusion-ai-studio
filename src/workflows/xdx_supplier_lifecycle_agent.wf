          }
        },
        {
          "id": "350",
          "code": "PROJECT_RESPONSE_TEXT",
          "type": "CODE",
          "metadata": {
            "name": "Project Response Text",
            "description": "Projects the reducer or normalized read response to one scalar for Human Chat and terminal bindings.",
            "sourceCode": "var reduced = $context.$nodes.REDUCE_LIFECYCLE.$output.result;\nif (reduced.action !== 'PROMPT' && $context.$nodes.NORMALIZE_READ_RESULT && $context.$nodes.NORMALIZE_READ_RESULT.$output) return $context.$nodes.NORMALIZE_READ_RESULT.$output.result.prompt;\nreturn reduced.prompt;",
            "returnType": "string"
          },
          "outcomes": {
