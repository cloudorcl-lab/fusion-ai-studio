          }
        },
        {
          "id": "500",
          "code": "QUERY_RESPONSE",
          "type": "LLM",
          "metadata": {
            "name": "Render Query Response",
            "chatHistoryEnabled": false,
            "description": "Dedicated Ask Oracle Query terminal. It renders only the deterministic lifecycle message."
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "500_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Copy only the text between the boundary lines. Do not output either boundary line.\n<<<XDX_RESPONSE_START>>>\n{{$context.$nodes.PROJECT_RESPONSE_TEXT.$output.result}}\n<<<XDX_RESPONSE_END>>>"
            },
            {
              "id": "500_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Return the text between <<<XDX_RESPONSE_START>>> and <<<XDX_RESPONSE_END>>> verbatim. Omit both boundary lines. Preserve every Markdown table header, separator, row and newline. Do not interpret, paraphrase, explain, label or quote the content."
            }
          ],
          "diagram": {
            "x": 5450,
            "y": 7204
          }
        },
        {
          "id": "350",
          "code": "PROJECT_RESPONSE_TEXT",
          "type": "CODE",
          "metadata": {
            "name": "Project Response Text",
            "description": "Projects a reducer, resolved supplier lookup, or normalized read response to one scalar for a non-suspending Agentic App Query response.",
            "sourceCode": "var reduced = $context.$nodes.REDUCE_LIFECYCLE.$output.result;\nif ($context.$nodes.NORMALIZE_READ_RESULT && $context.$nodes.NORMALIZE_READ_RESULT.$output) return $context.$nodes.NORMALIZE_READ_RESULT.$output.result.prompt;\nif ($context.$nodes.PREPARE_SUPPLIER_RESULT && $context.$nodes.PREPARE_SUPPLIER_RESULT.$output && $context.$nodes.PREPARE_SUPPLIER_RESULT.$output.result.action === 'RETURN') return $context.$nodes.PREPARE_SUPPLIER_RESULT.$output.result.prompt;\nreturn reduced.prompt;",
            "returnType": "string"
          },
          "outcomes": {
            "success": "500"
          },
          "inputs": [],
          "diagram": {
            "x": 5225,
            "y": 6760
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "700",
          "code": "INIT_DISPLAY_RESPONSE",
          "type": "LLM",
          "metadata": {
            "name": "Initialize Supplier Lifecycle Display",
            "description": "Dedicated Agentic App InitDisplay terminal with a static no-write orientation widget."
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "700_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Return exactly one messageListWidget JSON object with this content: patternId messageListWidget; description Supplier lifecycle workspace; properties.items contains exactly two neutral items. Item 1 title Query suppliers, summary Ask Oracle to find an existing supplier before any create. Item 2 title Create with confirmation, summary Provide only required fields, review the exact draft, then explicitly confirm before a write. Do not add actions, fields, markdown, or explanation."
            },
            {
              "id": "700_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Follow the requested JSON content exactly. Do not invent supplier data or claim that any record was created."
