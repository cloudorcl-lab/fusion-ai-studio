        {
          "id": "727",
          "code": "NORMALIZE_READ_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "Normalize Supplier Read Result",
            "description": "Normalizes one BO GET result into typed state and a deterministic four-column response; execution failure remains distinct from an empty collection.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) {\n  if (value === undefined || value === null) return '';\n  return String(value).replace(/[\\u0000-\\u001F\\u007F|]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max);\n}\nfunction cell(value) { var text = clean(value, 120); return text || '—'; }\nfunction table(headers, rows) {\n  var lines = [headers.join(' | '), headers.map(function () { return '---'; }).join(' | ')];\n  rows.forEach(function (row, index) { lines.push((index + 1) + ') ' + row.map(cell).join(' | ')); });\n  return lines.join('\\n');\n}\nvar prepared = $context.$nodes.PREPARE_SUPPLIER_RESULT && $context.$nodes.PREPARE_SUPPLIER_RESULT.$output ? $context.$nodes.PREPARE_SUPPLIER_RESULT.$output.result : null;\nvar reduced = prepared && /^(LIST_ADDRESSES|LIST_SITES|LIST_CONTACTS)$/.test(prepared.action) ? prepared : $context.$nodes.REDUCE_LIFECYCLE.$output.result;\nvar state = JSON.parse(JSON.stringify(reduced.state));\nvar action = reduced.action;\nvar nodeByAction = {\n  SEARCH_NAME: 'FIND_SUPPLIERS_BY_NAME',\n  SEARCH_NUMBER: 'FIND_SUPPLIERS_BY_NUMBER',\n  LIST_ADDRESSES: 'LIST_SUPPLIER_ADDRESSES',\n  LIST_SITES: 'LIST_SUPPLIER_SITES',\n  LIST_CONTACTS: 'LIST_SUPPLIER_CONTACTS'\n};\nvar node = $context.$nodes[nodeByAction[action]];\nvar output = node && node.$output ? node.$output : null;\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN';\n  state.query.status = 'ERROR';\n  state.query.hasMore = false;\n  state.verification = { status: 'READ_ERROR', checks: [] };\n  return { state: state, prompt: 'The supplier query could not be completed. No result was treated as an empty list; retry or refine the request.' };\n}\nvar items = output.items.slice(0, state.query.limit);\nstate.queryResults = JSON.parse(JSON.stringify(items));\nstate.query.offset = Number.isInteger(output.offset) ? output.offset : state.query.offset;\nstate.query.limit = Number.isInteger(output.limit) && output.limit > 0 ? Math.min(output.limit, 25) : state.query.limit;\nstate.query.hasMore = output.hasMore === true;\nstate.query.status = items.length ? 'READY' : 'EMPTY';\nstate.verification = { status: 'READ_COMPLETE', checks: ['parent-scope', 'four-column-projection'] };\nif (!items.length) {\n  state.phase = 'QUERY';\n  var emptyLabel = action === 'SEARCH_NAME' || action === 'SEARCH_NUMBER' ? 'suppliers matched' : state.query.resource + ' were found for the selected supplier';\n  return { state: state, prompt: 'No ' + emptyLabel + '. This was a successful empty result, not an execution error.' };\n}\nvar prompt;\nif (action === 'SEARCH_NAME' || action === 'SEARCH_NUMBER') {\n  state.selectionKeys = items.map(function (item) { return String(item.SupplierId); });\n  if (items.length === 1) {\n    state.selectedSupplier = JSON.parse(JSON.stringify(items[0]));\n    state.phase = 'GATHER';\n  } else {\n    state.phase = 'SELECT';\n  }\n  prompt = table(['Supplier number', 'Supplier', 'Type', 'Relationship'], items.map(function (item) {\n    return [item.SupplierNumber, item.Supplier, item.SupplierType, item.BusinessRelationship];\n  }));\n  prompt += items.length === 1 ? '\\nSelected the only matching supplier. You can show addresses, sites, or contacts.' : '\\nReply select 1 or select ' + items.length + ' to choose a supplier.';\n} else if (action === 'LIST_ADDRESSES') {\n  state.phase = 'GATHER';\n  state.selectionKeys = items.map(function (item) { return String(item.SupplierAddressId); });\n  prompt = table(['Address', 'City', 'State', 'Country'], items.map(function (item) { return [item.AddressName, item.City, item.State, item.Country]; }));\n} else if (action === 'LIST_SITES') {\n  state.phase = 'GATHER';\n  state.selectionKeys = items.map(function (item) { return String(item.SupplierSiteId); });\n  prompt = table(['Site', 'Procurement BU', 'Address', 'Status'], items.map(function (item) { return [item.SupplierSite, item.ProcurementBU, item.SupplierAddressName, item.Status]; }));\n} else {\n  state.phase = 'GATHER';\n  state.selectionKeys = items.map(function (item) { return String(item.SupplierContactId); });\n  prompt = table(['Contact', 'Job title', 'Email', 'Status'], items.map(function (item) { return [item.ContactName || ((item.FirstName || '') + ' ' + (item.LastName || '')), item.JobTitle, item.Email, item.Status]; }));\n}\nif (state.query.hasMore) prompt += '\\nMore results are available. Reply next to load the next page.';\nreturn { state: state, prompt: prompt };\n"
          },
          "outcomes": {
            "success": "728"
          },
          "inputs": [],
          "diagram": {
            "x": 6575,
            "y": 6316
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "728",
          "code": "SAVE_READ_STATE",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "Save Read State",
            "description": "Persists the normalized read state for selection and child scoping."
          },
          "outcomes": {
            "success": "350"
          },
          "inputs": [
            {
              "id": "728_lifecycle",
              "name": "lifecycle",
              "type": "string",
              "value": "{{$context.$nodes.NORMALIZE_READ_RESULT.$output.result.state}}"
            }
          ],
          "diagram": {
            "x": 6575,
            "y": 6538
          }
        },
        {
          "id": "729",
          "code": "PREPARE_SUPPLIER_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Supplier Result",
            "description": "Routes ordinary supplier results to normalization and resolves a self-contained supplier-number child query without a Human/wait boundary.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) {\n  if (value === undefined || value === null) return '';\n  return String(value).replace(/[\\u0000-\\u001F\\u007F|]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max);\n}\nvar reduced = $context.$nodes.REDUCE_LIFECYCLE.$output.result;\nvar state = JSON.parse(JSON.stringify(reduced.state));\nif (/^LIST_(ADDRESSES|SITES|CONTACTS)$/.test(reduced.action)) {\n  return { state: state, action: reduced.action, prompt: '', terminal: false };\n}\nif (reduced.action !== 'RESOLVE_CHILD_NUMBER') {\n  return { state: state, action: 'NORMALIZE', prompt: '', terminal: false };\n}\nvar output = $context.$nodes.FIND_SUPPLIERS_BY_NUMBER && $context.$nodes.FIND_SUPPLIERS_BY_NUMBER.$output;\nif (!output || !Array.isArray(output.items)) {\n  state.phase = 'UNKNOWN';\n  state.query.status = 'ERROR';\n  state.verification = { status: 'PARENT_RESOLUTION_ERROR', checks: [] };\n  return { state: state, action: 'RETURN', prompt: 'The supplier could not be resolved for the child query. No empty result was assumed.', terminal: true };\n}\nvar items = output.items.slice(0, 2);\nif (items.length === 0) {\n  state.phase = 'QUERY';\n  state.query.status = 'EMPTY';\n  state.verification = { status: 'READ_COMPLETE', checks: ['supplier-number-resolution'] };\n  return { state: state, action: 'RETURN', prompt: 'No supplier matched number ' + clean(state.query.term, 30) + '. No child query was executed.', terminal: true };\n}\nif (items.length !== 1 || items[0].SupplierId === undefined || items[0].SupplierId === null) {\n  state.phase = 'VALIDATION_ERROR';\n  state.query.status = 'ERROR';\n  state.verification = { status: 'AMBIGUOUS_PARENT', checks: ['supplier-number-resolution'] };\n  return { state: state, action: 'RETURN', prompt: 'The supplier number did not resolve to exactly one supplier. Refine the supplier number before querying child records.', terminal: true };\n}\nvar supplier = JSON.parse(JSON.stringify(items[0]));\nvar childKind = clean(state.query.targetKind, 20).toUpperCase();\nvar actionByKind = { ADDRESSES: 'LIST_ADDRESSES', SITES: 'LIST_SITES', CONTACTS: 'LIST_CONTACTS' };\nvar action = actionByKind[childKind];\nif (!action) {\n  state.phase = 'VALIDATION_ERROR';\n  return { state: state, action: 'RETURN', prompt: 'The requested child resource is not supported.', terminal: true };\n}\nstate.selectedSupplier = supplier;\nstate.query = { kind: childKind, term: '', filter: '', parentId: String(supplier.SupplierId), targetKind: childKind, limit: 10, offset: 0, hasMore: false, status: 'PENDING', resource: childKind.toLowerCase() };\nstate.queryResults = [];\nstate.selectionKeys = [];\nstate.phase = 'QUERY';\nstate.verification = { status: 'PARENT_RESOLVED', checks: ['supplier-number-resolution'] };\nreturn { state: state, action: action, prompt: '', terminal: false };"
          },
          "outcomes": {
            "success": "730"
          },
          "inputs": [],
          "diagram": {
            "x": 6350,
            "y": 5980
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
