        {
          "id": "200",
          "code": "REDUCE_LIFECYCLE",
          "type": "CODE",
          "metadata": {
            "name": "Reduce Lifecycle State",
            "description": "Validates Ask Oracle input, preserves typed lifecycle state, prepares required-field-only drafts with provenance, and emits one bounded no-write action.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) {\n  if (value === undefined || value === null) return '';\n  return String(value).replace(/[\\u0000-\\u001F\\u007F]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max);\n}\nfunction isObject(value) { return value !== null && typeof value === 'object' && !Array.isArray(value); }\nfunction blankQuery() { return { kind: '', term: '', filter: '', parentId: '', targetKind: '', limit: 10, offset: 0, hasMore: false, status: 'IDLE', resource: '' }; }\nfunction blankState(message) {\n  return {\n    schemaVersion: 1,\n    phase: 'GATHER',\n    revision: 1,\n    requestId: 'supplier-' + Date.now(),\n    selectedSupplier: null,\n    query: blankQuery(),\n    queryResults: [],\n    selectionKeys: [],\n    referenceRecord: null,\n    draft: { resource: 'supplier', intentText: message, requiredFields: {} },\n    fieldProvenance: {},\n    missingFields: ['requiredFields'],\n    approvedSnapshot: null,\n    operations: [],\n    verification: { status: 'NOT_STARTED', checks: [] },\n    lastMessage: message\n  };\n}\nfunction queryAction(state, kind, term, filter, resource, offset) {\n  state.phase = 'QUERY';\n  state.query = { kind: kind, term: term, filter: filter, parentId: '', targetKind: '', limit: 10, offset: offset || 0, hasMore: false, status: 'PENDING', resource: resource };\n  state.queryResults = [];\n  state.selectionKeys = [];\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  var actionByKind = {\n    SUPPLIER_NAME: 'SEARCH_NAME',\n    SUPPLIER_NUMBER: 'SEARCH_NUMBER',\n    ADDRESSES: 'LIST_ADDRESSES',\n    SITES: 'LIST_SITES',\n    CONTACTS: 'LIST_CONTACTS'\n  };\n  return { state: state, terminal: false, action: actionByKind[kind], query: state.query, prompt: '' };\n}\nfunction promptResult(state, prompt, terminal) { return { state: state, terminal: terminal === true, action: 'PROMPT', query: state.query, prompt: prompt }; }\n\nfunction resourceContract(resource) {\n  var contracts = {\n    supplier: { allowed: ['Supplier'], required: ['Supplier'], inherited: [], generated: ['SupplierId', 'SupplierNumber', 'SupplierPartyId'], foreign: [] },\n    address: { allowed: ['AddressName', 'AddressLine1', 'CountryCode', 'Email'], required: ['AddressName', 'AddressLine1', 'CountryCode', 'Email'], inherited: ['CountryCode'], generated: ['SupplierAddressId', 'AddressPartyNumber'], foreign: [] },\n    site: { allowed: ['SupplierSite', 'ProcurementBUId'], required: ['SupplierSite', 'ProcurementBUId'], inherited: ['ProcurementBUId'], generated: ['SupplierSiteId'], foreign: ['ProcurementBUId'] },\n    contact: { allowed: ['Email'], required: ['Email'], inherited: [], generated: ['SupplierContactId', 'PersonProfileId'], foreign: [] }\n  };\n  return contracts[resource] || null;\n}\nfunction inferDraftResource(state, requested) {\n  if (requested && resourceContract(requested)) return requested;\n  var fromQuery = clean(state.query && (state.query.targetKind || state.query.kind), 20).toLowerCase();\n  if (fromQuery === 'addresses') return 'address';\n  if (fromQuery === 'sites') return 'site';\n  if (fromQuery === 'contacts') return 'contact';\n  return resourceContract(state.draft && state.draft.resource) ? state.draft.resource : 'supplier';\n}\nfunction valuePresent(value) { return value !== undefined && value !== null && clean(value, 1000) !== ''; }\nfunction recalculateMissing(state) {\n  var contract = resourceContract(state.draft.resource);\n  state.missingFields = contract ? contract.required.filter(function (field) { return !valuePresent(state.draft.requiredFields[field]); }) : ['requiredFields'];\n}\nfunction parentReady(state, resource) {\n  return resource === 'supplier' || (isObject(state.selectedSupplier) && state.selectedSupplier.SupplierId !== undefined && state.selectedSupplier.SupplierId !== null);\n}\nfunction beginDraft(state, resource, values, sourceName) {\n  var contract = resourceContract(resource);\n  if (!contract) return { error: 'That resource is not enabled for preparation.' };\n  if (!parentReady(state, resource)) return { error: 'Select one supplier before preparing this child resource.' };\n  var isInitialDraft = state.revision === 1 && Object.keys(state.draft.requiredFields || {}).length === 0 && state.draft.intentText === state.lastMessage;\n  var payload = {};\n  var provenance = {};\n  Object.keys(values || {}).forEach(function (field) {\n    if (contract.generated.indexOf(field) >= 0) return;\n    if (contract.allowed.indexOf(field) < 0 || !valuePresent(values[field])) return;\n    payload[field] = values[field];\n    provenance[field] = { source: sourceName || 'USER' };\n  });\n  state.draft = { resource: resource, intentText: state.lastMessage, requiredFields: payload };\n  state.fieldProvenance = provenance;\n  state.referenceRecord = null;\n  state.approvedSnapshot = null;\n  state.phase = 'GATHER';\n  if (!isInitialDraft) state.revision += 1;\n  recalculateMissing(state);\n  return { state: state };\n}\nfunction parsePairs(text) {\n  var values = {};\n  text.split(/\\s*;\\s*/).forEach(function (pair) {\n    var match = pair.match(/^([A-Za-z][A-Za-z0-9]*)\\s*=\\s*(.+)$/);\n    if (match) values[match[1]] = clean(match[2], 1000);\n  });\n  return values;\n}\nfunction exactReview(state) {\n  var fields = Object.keys(state.draft.requiredFields).sort();\n  var lines = ['Exact no-write draft review', 'Resource | ' + state.draft.resource];\n  if (state.draft.resource !== 'supplier') {\n    lines.push('Parent supplier | ' + clean(state.selectedSupplier.Supplier, 200) + ' (' + clean(state.selectedSupplier.SupplierNumber, 80) + ')');\n  }\n  lines.push('Field | Value | Source');\n  lines.push('--- | --- | ---');\n  fields.forEach(function (field) {\n    var provenance = state.fieldProvenance[field];\n    lines.push(field + ' | ' + clean(state.draft.requiredFields[field], 500) + ' | ' + clean(provenance && provenance.source, 40));\n  });\n  lines.push('This review does not authorize creation. Type approve only after checking every value, or provide a change.');\n  return lines.join('\\n');\n}\n\nvar prior = $context && $context.$variables ? $context.$variables.lifecycle : null;\nvar feedback = $context && $context.$nodes && $context.$nodes.HUMAN_COLLECT ? $context.$nodes.HUMAN_COLLECT.$feedbackReceived : '';\nvar currentMessage = clean(feedback || ($context && $context.$system ? $context.$system.$inputMessage : ''), 2000);\nvar validPrior = isObject(prior) && prior.schemaVersion === 1 && typeof prior.revision === 'number' && typeof prior.requestId === 'string' && isObject(prior.draft);\nvar lower = currentMessage.toLowerCase();\n\nif (!validPrior) {\n  var initial = blankState(currentMessage);\n  if (/^(cancel|stop|reject)\\b/.test(lower)) {\n    initial.phase = 'CANCELLED';\n    return promptResult(initial, 'Cancelled. No supplier data was written.', true);\n  }\n  var seed = initial;\n  prior = seed;\n  validPrior = true;\n} else {\n  prior = JSON.parse(JSON.stringify(prior));\n  if (!isObject(prior.query)) prior.query = blankQuery();\n}\n\nif ((prior.phase === 'APPROVED' || prior.phase === 'CANCELLED') && /^(new|start over|new request)\\b/.test(lower)) {\n  var restarted = blankState(currentMessage);\n  return promptResult(restarted, 'I saved the new request. Add or correct the required supplier details, query suppliers, type review to see the exact draft, or type cancel.', false);\n}\n\nvar state = prior;\nstate.lastMessage = currentMessage;\nif (state.phase === 'APPROVED' || state.phase === 'CANCELLED') {\n  return promptResult(state, 'This request is already ' + state.phase.toLowerCase() + '. Start a new request to continue.', true);\n}\nif (/^(cancel|stop|reject)\\b/.test(lower)) {\n  state.phase = 'CANCELLED';\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  return promptResult(state, 'Cancelled. No supplier data was written.', true);\n}\n\nvar directChildMatch = currentMessage.match(/^(?:show|list|query)\\s+(?:supplier\\s+)?(addresses|sites|contacts)\\s+(?:for\\s+)?supplier\\s+(?:number|#)\\s+([A-Za-z0-9._-]{1,30})\\s*$/i);\nif (directChildMatch) {\n  var directChildKind = directChildMatch[1].toUpperCase();\n  var directSupplierNumber = directChildMatch[2];\n  var directChildResult = queryAction(state, 'SUPPLIER_NUMBER', directSupplierNumber, \"SupplierNumber='\" + directSupplierNumber + \"'\", 'suppliers', 0);\n  directChildResult.action = 'RESOLVE_CHILD_NUMBER';\n  directChildResult.query.targetKind = directChildKind;\n  return directChildResult;\n}\n\nvar numberMatch = currentMessage.match(/^(?:find|search|show|query|look up)\\s+(?:for\\s+)?supplier\\s+(?:number|#)\\s+([A-Za-z0-9._-]{1,30})\\s*$/i);\nif (numberMatch) {\n  var supplierNumber = numberMatch[1];\n  return queryAction(state, 'SUPPLIER_NUMBER', supplierNumber, \"SupplierNumber='\" + supplierNumber + \"'\", 'suppliers', 0);\n}\n\nvar nameMatch = currentMessage.match(/^(?:find|search|show|query|look up)\\s+(?:for\\s+)?suppliers?\\s+(?:(?:named?|called)\\s+)?(.+)$/i);\nif (nameMatch) {\n  var supplierName = clean(nameMatch[1], 200);\n  if (!supplierName || /[%_;]|\\bq\\s*=|[\\r\\n]/i.test(supplierName)) {\n    state.phase = 'VALIDATION_ERROR';\n    state.revision += 1;\n    return promptResult(state, 'Enter a safe supplier name using letters, numbers, spaces, apostrophes, ampersands, periods, commas, or hyphens.', false);\n  }\n  supplierName = supplierName.replace(/'/g, \"''\");\n  return queryAction(state, 'SUPPLIER_NAME', supplierName, '', 'suppliers', 0);\n}\n\nvar selectMatch = currentMessage.match(/^select\\s+(\\d{1,3})\\s*$/i);\nif (selectMatch) {\n  var selectionIndex = Number(selectMatch[1]) - 1;\n  if (selectionIndex < 0 || selectionIndex >= state.queryResults.length || !isObject(state.queryResults[selectionIndex])) {\n    state.phase = 'VALIDATION_ERROR';\n    return promptResult(state, 'That selection is not available. Choose one of the displayed supplier row numbers.', false);\n  }\n  state.selectedSupplier = JSON.parse(JSON.stringify(state.queryResults[selectionIndex]));\n  state.phase = 'GATHER';\n  state.revision += 1;\n  return promptResult(state, 'Selected supplier ' + clean(state.selectedSupplier.Supplier, 200) + ' (' + clean(state.selectedSupplier.SupplierNumber, 80) + '). You can show addresses, sites, or contacts.', false);\n}\n\nvar childMatch = currentMessage.match(/^(?:show|list|query)\\s+(?:supplier\\s+)?(addresses|sites|contacts)\\s*$/i);\nif (childMatch) {\n  if (!isObject(state.selectedSupplier) || state.selectedSupplier.SupplierId === undefined || state.selectedSupplier.SupplierId === null) {\n    state.phase = 'VALIDATION_ERROR';\n    return promptResult(state, 'Select one supplier before querying its addresses, sites, or contacts.', false);\n  }\n  var childKind = childMatch[1].toUpperCase();\n  var childFilter = childKind === 'ADDRESSES' ? 'SupplierAddressId is not null' : childKind === 'SITES' ? 'SupplierSiteId is not null' : 'SupplierContactId is not null';\n  var childResult = queryAction(state, childKind, '', childFilter, childKind.toLowerCase(), 0);\n  childResult.query.parentId = String(state.selectedSupplier.SupplierId);\n  return childResult;\n}\n\nif (/^(?:next|next page)\\s*$/i.test(currentMessage)) {\n  if (!isObject(state.query) || !state.query.kind || state.query.status !== 'READY' || state.query.hasMore !== true) {\n    return promptResult(state, 'There is no next page for the current query.', false);\n  }\n  var nextKind = state.query.kind;\n  var nextTerm = state.query.term;\n  var nextFilter = state.query.filter;\n  var nextResource = state.query.resource;\n  var nextOffset = state.query.offset + state.query.limit;\n  var nextResult = queryAction(state, nextKind, nextTerm, nextFilter, nextResource, nextOffset);\n  if (isObject(state.selectedSupplier) && state.selectedSupplier.SupplierId !== undefined && /^(ADDRESSES|SITES|CONTACTS)$/.test(nextKind)) {\n    nextResult.query.parentId = String(state.selectedSupplier.SupplierId);\n  }\n  return nextResult;\n}\n\n\nvar supplierCreateMatch = currentMessage.match(/^create\\s+(?:a\\s+)?supplier\\s+(?:named|called)\\s+(.+)$/i);\nif (supplierCreateMatch) {\n  var supplierDraft = beginDraft(state, 'supplier', { Supplier: clean(supplierCreateMatch[1], 360) }, 'USER');\n  if (supplierDraft.error) return promptResult(state, supplierDraft.error, false);\n  return promptResult(state, 'Prepared the supplier draft using required transaction fields only. Type review to inspect the exact no-write draft.', false);\n}\n\nvar addressCreateMatch = currentMessage.match(/^create\\s+(?:an?\\s+)?address\\s+(?:named|called)\\s+(.+?)\\s+at\\s+(.+)$/i);\nif (addressCreateMatch) {\n  var addressDraft = beginDraft(state, 'address', { AddressName: clean(addressCreateMatch[1], 240), AddressLine1: clean(addressCreateMatch[2], 240) }, 'USER');\n  if (addressDraft.error) return promptResult(state, addressDraft.error, false);\n  return promptResult(state, 'Saved the requested address name and address. Choose a displayed address with use reference N to review eligible required defaults. No create approval was captured.', false);\n}\n\nvar prepareMatch = currentMessage.match(/^prepare\\s+(supplier|address|site|contact)\\s+with\\s+(.+)$/i);\nif (prepareMatch) {\n  var preparedResource = prepareMatch[1].toLowerCase();\n  var preparedDraft = beginDraft(state, preparedResource, parsePairs(prepareMatch[2]), 'USER');\n  if (preparedDraft.error) return promptResult(state, preparedDraft.error, false);\n  var prepareMessage = state.missingFields.length ? 'Prepared the draft. Missing required fields: ' + state.missingFields.join(', ') + '.' : 'Prepared all required transaction fields. Type review to inspect the exact no-write draft.';\n  return promptResult(state, prepareMessage, false);\n}\n\nvar referenceMatch = currentMessage.match(/^use\\s+reference\\s+(\\d{1,3})(?:\\s+for\\s+(supplier|address|site|contact))?\\s*$/i);\nif (referenceMatch) {\n  var referenceIndex = Number(referenceMatch[1]) - 1;\n  var referenceResource = inferDraftResource(state, referenceMatch[2] ? referenceMatch[2].toLowerCase() : '');\n  if (referenceIndex < 0 || referenceIndex >= state.queryResults.length || !isObject(state.queryResults[referenceIndex])) return promptResult(state, 'That reference is not available. Choose one of the displayed rows.', false);\n  if (!parentReady(state, referenceResource)) return promptResult(state, 'Select one supplier before choosing a child reference.', false);\n  state.draft.resource = referenceResource;\n  state.referenceRecord = JSON.parse(JSON.stringify(state.queryResults[referenceIndex]));\n  state.phase = 'REFERENCE_REVIEW';\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  var referenceContract = resourceContract(referenceResource);\n  var eligible = referenceContract.inherited.filter(function (field) { return valuePresent(state.referenceRecord[field]); });\n  var referenceLines = eligible.map(function (field) { return field + ' | ' + clean(state.referenceRecord[field], 500) + ' | REFERENCE'; });\n  var referencePrompt = referenceLines.length ? 'Eligible required reference values:\\nField | Value | Source\\n--- | --- | ---\\n' + referenceLines.join('\\n') + '\\nType apply all to prepare these values, or provide a change.' : 'The selected record has no eligible required values to inherit. Provide the missing required values.';\n  return promptResult(state, referencePrompt, false);\n}\n\nif (/^apply\\s+all\\s*$/i.test(currentMessage)) {\n  if (state.phase !== 'REFERENCE_REVIEW' || !isObject(state.referenceRecord)) return promptResult(state, 'Select a displayed reference before applying eligible values.', false);\n  var applyContract = resourceContract(state.draft.resource);\n  applyContract.inherited.forEach(function (field) {\n    if (!valuePresent(state.draft.requiredFields[field]) && valuePresent(state.referenceRecord[field])) {\n      state.draft.requiredFields[field] = state.referenceRecord[field];\n      state.fieldProvenance[field] = { source: 'REFERENCE' };\n    }\n  });\n  state.phase = 'GATHER';\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  recalculateMissing(state);\n  var appliedMessage = state.missingFields.length ? 'Applied eligible required reference values without approving creation. Missing required fields: ' + state.missingFields.join(', ') + '.' : 'Applied eligible required reference values without approving creation. Type review for the exact draft.';\n  return promptResult(state, appliedMessage, false);\n}\n\nvar changeMatch = currentMessage.match(/^change\\s+([A-Za-z][A-Za-z0-9]*)\\s*=\\s*(.+)$/i);\nif (changeMatch) {\n  var changeField = changeMatch[1];\n  var changeContract = resourceContract(state.draft.resource);\n  if (!changeContract || changeContract.allowed.indexOf(changeField) < 0 || changeContract.generated.indexOf(changeField) >= 0) return promptResult(state, 'That field is not in the required writable allowlist for this transaction.', false);\n  state.draft.requiredFields[changeField] = clean(changeMatch[2], 1000);\n  state.fieldProvenance[changeField] = { source: 'USER' };\n  state.phase = 'GATHER';\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  recalculateMissing(state);\n  return promptResult(state, state.missingFields.length ? 'Saved the user change. Missing required fields: ' + state.missingFields.join(', ') + '.' : 'Saved the user change and invalidated any earlier approval. Type review for the exact draft.', false);\n}\n\nif (/^(approve|approved|confirm create)\\b/.test(lower)) {\n  if (state.phase !== 'FINAL_REVIEW') {\n    state.approvedSnapshot = null;\n    return promptResult(state, 'Approval is stale or premature. Type review after the required fields are ready.', false);\n  }\n  state.approvedSnapshot = { requestId: state.requestId, revision: state.revision, normalizedPayload: JSON.parse(JSON.stringify(state.draft.requiredFields)), targetParent: state.selectedSupplier };\n  state.phase = 'APPROVED';\n  return promptResult(state, 'Approval captured for request ' + state.requestId + ' revision ' + state.revision + '. P3 preparation is no-write, so no supplier data was submitted.', true);\n}\nif (/^review\\b/.test(lower)) {\n  recalculateMissing(state);\n  if (state.missingFields.length) {\n    state.phase = 'GATHER';\n    state.approvedSnapshot = null;\n    return promptResult(state, 'The exact draft is not ready. Missing required fields: ' + state.missingFields.join(', ') + '.', false);\n  }\n  if (!parentReady(state, state.draft.resource)) return promptResult(state, 'Select one supplier before reviewing this child draft.', false);\n  var reviewContract = resourceContract(state.draft.resource);\n  var invalidForeign = reviewContract.foreign.filter(function (field) {\n    var provenance = state.fieldProvenance[field];\n    return !provenance || provenance.source !== 'REFERENCE';\n  });\n  if (invalidForeign.length) {\n    state.phase = 'VALIDATION_ERROR';\n    return promptResult(state, 'Resolve these foreign references from a displayed, parent-scoped source before review: ' + invalidForeign.join(', ') + '.', false);\n  }\n  state.phase = 'FINAL_REVIEW';\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  return promptResult(state, exactReview(state), false);\n}\nif (!currentMessage) return promptResult(state, 'Provide a correction, query suppliers, type review, or type cancel.', false);\n\nif (state.revision === 1 && state.draft.intentText === currentMessage && state.fieldProvenance.intentText === undefined) {\n  return promptResult(state, 'I saved the request. Add or correct the required supplier details, query suppliers, type review to see the exact draft, or type cancel.', false);\n}\nstate.draft.intentText = currentMessage;\nstate.phase = 'GATHER';\nstate.revision += 1;\nstate.approvedSnapshot = null;\nstate.missingFields = ['requiredFields'];\nstate.fieldProvenance = { intentText: 'USER' };\nreturn promptResult(state, 'Saved correction at revision ' + state.revision + ' and invalidated any earlier approval. Query suppliers, type review when the required fields are ready, or type cancel.', false);\n"
          },
          "outcomes": {
            "success": "300"
          },
          "inputs": [],
          "diagram": {
            "x": 5225,
            "y": 5428
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "300",
          "code": "SAVE_LIFECYCLE",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "Save Lifecycle State",
            "description": "Persists the validated typed state for the current conversation."
          },
          "outcomes": {
            "success": "721"
          },
          "inputs": [
            {
              "id": "300_lifecycle",
              "name": "lifecycle",
              "type": "string",
              "value": "{{$context.$nodes.REDUCE_LIFECYCLE.$output.result.state}}"
            }
          ],
