        {
          "id": "200",
          "code": "REDUCE_LIFECYCLE",
          "type": "CODE",
          "metadata": {
            "name": "Reduce Lifecycle State",
            "description": "Validates Ask Oracle or Human input, preserves typed lifecycle state, and emits one bounded read action without side effects.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) {\n  if (value === undefined || value === null) return '';\n  return String(value).replace(/[\\u0000-\\u001F\\u007F]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max);\n}\nfunction isObject(value) { return value !== null && typeof value === 'object' && !Array.isArray(value); }\nfunction blankQuery() { return { kind: '', term: '', filter: '', parentId: '', limit: 10, offset: 0, hasMore: false, status: 'IDLE', resource: '' }; }\nfunction blankState(message) {\n  return {\n    schemaVersion: 1,\n    phase: 'GATHER',\n    revision: 1,\n    requestId: 'supplier-' + Date.now(),\n    selectedSupplier: null,\n    query: blankQuery(),\n    queryResults: [],\n    selectionKeys: [],\n    referenceRecord: null,\n    draft: { resource: 'supplier', intentText: message, requiredFields: {} },\n    fieldProvenance: {},\n    missingFields: ['requiredFields'],\n    approvedSnapshot: null,\n    operations: [],\n    verification: { status: 'NOT_STARTED', checks: [] },\n    lastMessage: message\n  };\n}\nfunction queryAction(state, kind, term, filter, resource, offset) {\n  state.phase = 'QUERY';\n  state.query = { kind: kind, term: term, filter: filter, parentId: '', limit: 10, offset: offset || 0, hasMore: false, status: 'PENDING', resource: resource };\n  state.queryResults = [];\n  state.selectionKeys = [];\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  var actionByKind = {\n    SUPPLIER_NAME: 'SEARCH_NAME',\n    SUPPLIER_NUMBER: 'SEARCH_NUMBER',\n    ADDRESSES: 'LIST_ADDRESSES',\n    SITES: 'LIST_SITES',\n    CONTACTS: 'LIST_CONTACTS'\n  };\n  return { state: state, terminal: false, action: actionByKind[kind], query: state.query, prompt: '' };\n}\nfunction promptResult(state, prompt, terminal) { return { state: state, terminal: terminal === true, action: 'PROMPT', query: state.query, prompt: prompt }; }\n\nvar prior = $context && $context.$variables ? $context.$variables.lifecycle : null;\nvar feedback = $context && $context.$nodes && $context.$nodes.HUMAN_COLLECT ? $context.$nodes.HUMAN_COLLECT.$feedbackReceived : '';\nvar currentMessage = clean(feedback || ($context && $context.$system ? $context.$system.$inputMessage : ''), 2000);\nvar validPrior = isObject(prior) && prior.schemaVersion === 1 && typeof prior.revision === 'number' && typeof prior.requestId === 'string' && isObject(prior.draft);\nvar lower = currentMessage.toLowerCase();\n\nif (!validPrior) {\n  var initial = blankState(currentMessage);\n  if (/^(cancel|stop|reject)\\b/.test(lower)) {\n    initial.phase = 'CANCELLED';\n    return promptResult(initial, 'Cancelled. No supplier data was written.', true);\n  }\n  var seed = initial;\n  prior = seed;\n  validPrior = true;\n} else {\n  prior = JSON.parse(JSON.stringify(prior));\n  if (!isObject(prior.query)) prior.query = blankQuery();\n}\n\nif ((prior.phase === 'APPROVED' || prior.phase === 'CANCELLED') && /^(new|start over|new request)\\b/.test(lower)) {\n  var restarted = blankState(currentMessage);\n  return promptResult(restarted, 'I saved the new request. Add or correct the required supplier details, query suppliers, type review to see the exact draft, or type cancel.', false);\n}\n\nvar state = prior;\nstate.lastMessage = currentMessage;\nif (state.phase === 'APPROVED' || state.phase === 'CANCELLED') {\n  return promptResult(state, 'This request is already ' + state.phase.toLowerCase() + '. Start a new request to continue.', true);\n}\nif (/^(cancel|stop|reject)\\b/.test(lower)) {\n  state.phase = 'CANCELLED';\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  return promptResult(state, 'Cancelled. No supplier data was written.', true);\n}\n\nvar numberMatch = currentMessage.match(/^(?:find|search|show|query|look up)\\s+(?:for\\s+)?supplier\\s+(?:number|#)\\s+([A-Za-z0-9._-]{1,30})\\s*$/i);\nif (numberMatch) {\n  var supplierNumber = numberMatch[1];\n  return queryAction(state, 'SUPPLIER_NUMBER', supplierNumber, \"SupplierNumber='\" + supplierNumber + \"'\", 'suppliers', 0);\n}\n\nvar nameMatch = currentMessage.match(/^(?:find|search|show|query|look up)\\s+(?:for\\s+)?suppliers?\\s+(?:(?:named?|called)\\s+)?(.+)$/i);\nif (nameMatch) {\n  var supplierName = clean(nameMatch[1], 200);\n  if (!supplierName || /[%_;]|\\bq\\s*=|[\\r\\n]/i.test(supplierName)) {\n    state.phase = 'VALIDATION_ERROR';\n    state.revision += 1;\n    return promptResult(state, 'Enter a safe supplier name using letters, numbers, spaces, apostrophes, ampersands, periods, commas, or hyphens.', false);\n  }\n  supplierName = supplierName.replace(/'/g, \"''\");\n  return queryAction(state, 'SUPPLIER_NAME', supplierName, '', 'suppliers', 0);\n}\n\nvar selectMatch = currentMessage.match(/^select\\s+(\\d{1,3})\\s*$/i);\nif (selectMatch) {\n  var selectionIndex = Number(selectMatch[1]) - 1;\n  if (selectionIndex < 0 || selectionIndex >= state.queryResults.length || !isObject(state.queryResults[selectionIndex])) {\n    state.phase = 'VALIDATION_ERROR';\n    return promptResult(state, 'That selection is not available. Choose one of the displayed supplier row numbers.', false);\n  }\n  state.selectedSupplier = JSON.parse(JSON.stringify(state.queryResults[selectionIndex]));\n  state.phase = 'GATHER';\n  state.revision += 1;\n  return promptResult(state, 'Selected supplier ' + clean(state.selectedSupplier.Supplier, 200) + ' (' + clean(state.selectedSupplier.SupplierNumber, 80) + '). You can show addresses, sites, or contacts.', false);\n}\n\nvar childMatch = currentMessage.match(/^(?:show|list|query)\\s+(?:supplier\\s+)?(addresses|sites|contacts)\\s*$/i);\nif (childMatch) {\n  if (!isObject(state.selectedSupplier) || state.selectedSupplier.SupplierId === undefined || state.selectedSupplier.SupplierId === null) {\n    state.phase = 'VALIDATION_ERROR';\n    return promptResult(state, 'Select one supplier before querying its addresses, sites, or contacts.', false);\n  }\n  var childKind = childMatch[1].toUpperCase();\n  var childFilter = childKind === 'ADDRESSES' ? 'SupplierAddressId is not null' : childKind === 'SITES' ? 'SupplierSiteId is not null' : 'SupplierContactId is not null';\n  var childResult = queryAction(state, childKind, '', childFilter, childKind.toLowerCase(), 0);\n  childResult.query.parentId = String(state.selectedSupplier.SupplierId);\n  return childResult;\n}\n\nif (/^(?:next|next page)\\s*$/i.test(currentMessage)) {\n  if (!isObject(state.query) || !state.query.kind || state.query.status !== 'READY' || state.query.hasMore !== true) {\n    return promptResult(state, 'There is no next page for the current query.', false);\n  }\n  var nextKind = state.query.kind;\n  var nextTerm = state.query.term;\n  var nextFilter = state.query.filter;\n  var nextResource = state.query.resource;\n  var nextOffset = state.query.offset + state.query.limit;\n  var nextResult = queryAction(state, nextKind, nextTerm, nextFilter, nextResource, nextOffset);\n  if (isObject(state.selectedSupplier) && state.selectedSupplier.SupplierId !== undefined && /^(ADDRESSES|SITES|CONTACTS)$/.test(nextKind)) {\n    nextResult.query.parentId = String(state.selectedSupplier.SupplierId);\n  }\n  return nextResult;\n}\n\nif (/^(approve|approved|confirm create)\\b/.test(lower)) {\n  if (state.phase !== 'FINAL_REVIEW') {\n    state.approvedSnapshot = null;\n    return promptResult(state, 'Approval is stale or premature. Type review after the required fields are ready.', false);\n  }\n  state.approvedSnapshot = { requestId: state.requestId, revision: state.revision, normalizedPayload: JSON.parse(JSON.stringify(state.draft.requiredFields)), targetParent: state.selectedSupplier };\n  state.phase = 'APPROVED';\n  return promptResult(state, 'Approval captured for request ' + state.requestId + ' revision ' + state.revision + '. P2 is read-only, so no supplier data was submitted.', true);\n}\nif (/^review\\b/.test(lower)) {\n  if (!clean(state.draft.intentText, 2000)) return promptResult(state, 'The request is empty. Provide the required supplier details before review.', false);\n  state.phase = 'FINAL_REVIEW';\n  state.revision += 1;\n  state.approvedSnapshot = null;\n  return promptResult(state, 'Final no-write review for request ' + state.requestId + ', revision ' + state.revision + ': ' + JSON.stringify(state.draft.requiredFields) + '. Type approve, provide a correction, or type cancel.', false);\n}\nif (!currentMessage) return promptResult(state, 'Provide a correction, query suppliers, type review, or type cancel.', false);\n\nif (state.revision === 1 && state.draft.intentText === currentMessage && state.fieldProvenance.intentText === undefined) {\n  return promptResult(state, 'I saved the request. Add or correct the required supplier details, query suppliers, type review to see the exact draft, or type cancel.', false);\n}\nstate.draft.intentText = currentMessage;\nstate.phase = 'GATHER';\nstate.revision += 1;\nstate.approvedSnapshot = null;\nstate.missingFields = ['requiredFields'];\nstate.fieldProvenance = { intentText: 'USER' };\nreturn promptResult(state, 'Saved correction at revision ' + state.revision + ' and invalidated any earlier approval. Query suppliers, type review when the required fields are ready, or type cancel.', false);\n"
          },
          "outcomes": {
            "success": "300"
          },
          "inputs": [],
          "diagram": {
            "x": 5225,
            "y": 5428
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
