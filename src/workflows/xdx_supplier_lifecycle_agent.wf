{
  "workflowId": "300000333950759",
  "workflowCode": "XDX_SUPPLIER_LIFECYCLE_AGENT",
  "name": "XDX Supplier Lifecycle Agent",
  "description": "Ask Oracle supplier query and required-field lifecycle with deterministic approval and independent verification.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
          "code": "START",
          "type": "START",
          "metadata": {
            "name": "Start",
            "description": "Start of data pipeline"
          },
          "outcomes": {
            "success": "100"
          },
          "inputs": [],
          "diagram": {
            "x": 5900,
            "y": 5000
          }
        },
        {
          "id": "100",
          "code": "APP_STAGE_ROUTER",
          "type": "SWITCH",
          "metadata": {
            "name": "Route Ask Oracle Stage",
            "description": "Routes the supported Agentic App message hint."
          },
          "outcomes": {
            "Query": "200",
            "InitDisplay": "700",
            "InitActions": "710",
            "Summary": "720"
          },
          "inputs": [
            {
              "id": "100_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$app.$OraMessageHint}}"
            }
          ],
          "diagram": {
            "x": 5900,
            "y": 5206
          },
          "convergenceTargetId": "end"
        },
        {
          "id": "200",
          "code": "REDUCE_LIFECYCLE",
          "type": "CODE",
          "metadata": {
            "name": "Reduce Lifecycle State",
            "description": "Validates the current Ask Oracle message or Human Chat feedback and advances one typed lifecycle state without side effects.",
            "returnType": "object",
            "sourceCode": "function clean(value, max) { if (value === undefined || value === null) return ''; return String(value).replace(/[\\u0000-\\u001F\\u007F]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max); }\nfunction isObject(value) { return value !== null && typeof value === 'object' && !Array.isArray(value); }\nfunction blankState(message) { return { schemaVersion: 1, phase: 'GATHER', revision: 1, requestId: 'supplier-' + Date.now(), selectedSupplier: null, queryResults: [], selectionKeys: [], referenceRecord: null, draft: { resource: 'supplier', intentText: message, requiredFields: {} }, fieldProvenance: {}, missingFields: ['requiredFields'], approvedSnapshot: null, operations: [], verification: { status: 'NOT_STARTED', checks: [] }, lastMessage: message }; }\nvar prior = $context && $context.$variables ? $context.$variables.lifecycle : null;\nvar feedback = $context && $context.$nodes && $context.$nodes.HUMAN_COLLECT ? $context.$nodes.HUMAN_COLLECT.$feedbackReceived : '';\nvar currentMessage = clean(feedback || ($context && $context.$system ? $context.$system.$inputMessage : ''), 2000);\nvar validPrior = isObject(prior) && prior.schemaVersion === 1 && typeof prior.revision === 'number' && typeof prior.requestId === 'string' && isObject(prior.draft);\nvar lower = currentMessage.toLowerCase();\nif (!validPrior) { var initial = blankState(currentMessage); if (/^(cancel|stop|reject)\\b/.test(lower)) { initial.phase = 'CANCELLED'; return { state: initial, terminal: true, prompt: 'Cancelled. No supplier data was written.' }; } return { state: initial, terminal: false, prompt: 'I saved the request. Add or correct the required supplier details, type review to see the exact draft, or type cancel.' }; }\nif ((prior.phase === 'APPROVED' || prior.phase === 'CANCELLED') && /^(new|start over|new request)\\b/.test(lower)) { var restarted = blankState(currentMessage); return { state: restarted, terminal: false, prompt: 'I saved the new request. Add or correct the required supplier details, type review to see the exact draft, or type cancel.' }; }\nvar state = JSON.parse(JSON.stringify(prior));\nstate.lastMessage = currentMessage;\nif (state.phase === 'APPROVED' || state.phase === 'CANCELLED') { return { state: state, terminal: true, prompt: 'This request is already ' + state.phase.toLowerCase() + '. Start a new request to continue.' }; }\nif (/^(cancel|stop|reject)\\b/.test(lower)) { state.phase = 'CANCELLED'; state.revision += 1; state.approvedSnapshot = null; return { state: state, terminal: true, prompt: 'Cancelled. No supplier data was written.' }; }\nif (/^(approve|approved|confirm create)\\b/.test(lower)) { if (state.phase !== 'FINAL_REVIEW') { state.approvedSnapshot = null; return { state: state, terminal: false, prompt: 'Approval is stale or premature. Type review after the required fields are ready.' }; } state.approvedSnapshot = { requestId: state.requestId, revision: state.revision, normalizedPayload: JSON.parse(JSON.stringify(state.draft.requiredFields)), targetParent: state.selectedSupplier }; state.phase = 'APPROVED'; return { state: state, terminal: true, prompt: 'Approval captured for request ' + state.requestId + ' revision ' + state.revision + '. P1 is no-write, so no supplier data was submitted.' }; }\nif (/^review\\b/.test(lower)) { if (!clean(state.draft.intentText, 2000)) { return { state: state, terminal: false, prompt: 'The request is empty. Provide the required supplier details before review.' }; } state.phase = 'FINAL_REVIEW'; state.revision += 1; state.approvedSnapshot = null; return { state: state, terminal: false, prompt: 'Final no-write review for request ' + state.requestId + ', revision ' + state.revision + ': ' + JSON.stringify(state.draft.requiredFields) + '. Type approve, provide a correction, or type cancel.' }; }\nif (!currentMessage) { return { state: state, terminal: false, prompt: 'Provide a correction, type review, or type cancel.' }; }\nstate.draft.intentText = currentMessage; state.phase = 'GATHER'; state.revision += 1; state.approvedSnapshot = null; state.missingFields = ['requiredFields']; state.fieldProvenance = { intentText: 'USER' }; return { state: state, terminal: false, prompt: 'Saved correction at revision ' + state.revision + ' and invalidated any earlier approval. Type review when the required fields are ready, or type cancel.' };"
          },
          "outcomes": {
            "success": "300"
          },
          "inputs": [],
          "diagram": {
            "x": 5225,
            "y": 5428
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "300",
          "code": "SAVE_LIFECYCLE",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "Save Lifecycle State",
            "description": "Persists the validated typed state for the current conversation."
          },
          "outcomes": {
            "success": "350"
          },
          "inputs": [
            {
              "id": "300_lifecycle",
              "name": "lifecycle",
              "type": "string",
              "value": "{{$context.$nodes.REDUCE_LIFECYCLE.$output.result.state}}"
            }
          ],
          "diagram": {
            "x": 5225,
            "y": 5650
          }
        },
        {
          "id": "400",
          "code": "LIFECYCLE_TERMINAL",
          "type": "CONDITION",
          "metadata": {
            "name": "Lifecycle Terminal",
            "description": "Ends only after cancellation or a bound no-write approval."
          },
          "outcomes": {
            "false": "600",
            "true": "500"
          },
          "inputs": [
            {
              "id": "400_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.REDUCE_LIFECYCLE.$output.result.terminal === true}}"
            }
          ],
          "diagram": {
            "x": 5225,
            "y": 6094
          },
          "convergenceTargetId": "end"
        },
        {
          "id": "600",
          "code": "HUMAN_COLLECT",
          "type": "HUMAN",
          "metadata": {
            "name": "Collect Lifecycle Details",
            "channelType": "CHAT",
            "approvalEnabledFlag": false,
            "feedbackEnabledFlag": true,
            "loopBackNodeId": "200",
            "description": "Collects the next typed lifecycle message and returns it to the deterministic reducer."
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "600_chatChannelInput",
              "name": "chatChannelInput",
