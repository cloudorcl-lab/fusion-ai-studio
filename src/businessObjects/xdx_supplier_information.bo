      {
        "name": "CreateSupplierAddress",
        "description": "Create one supplier address with the four approved user-supplied transaction fields and the tenant-required ordering purpose. Generated IDs, optional address attributes, other purposes, DFFs, attachments and payment fields are excluded. Reconcile uncertain results before retries.",
        "operationId": "create_suppliers-addresses",
        "operationType": "POST",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers/{suppliers_Id}/child/addresses",
