      {
        "name": "ListSupplierAddresses",
        "description": "Retrieve one page of addresses for one supplier. Optional narrowing through a caller-authored framework-v4 rowmatch filter; default selects all child IDs. Preserve count, limit, offset and hasMore. Empty items is valid; errors are not empty results. Continue at offset + count while hasMore is true.",
        "operationId": "getall_suppliers-addresses",
        "operationType": "GET",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05/suppliers/{suppliers_Id}/child/addresses?onlyData=true&q={filter}&orderBy=SupplierAddressId:asc&limit={limit}&offset={offset}",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "suppliers_Id",
            "dataType": "string",
            "description": "SupplierId obtained from an exact resolved supplier lookup in this environment. Required; do not guess or reuse a sample ID. No default.",
            "id": 23,
            "isToken": true,
            "location": "path",
            "source": "openapi",
            "defaultValue": ""
          },
          {
            "name": "filter",
            "dataType": "string",
            "description": "Trusted caller-authored framework-v4 rowmatch expression using documented queryable addresses attributes. Default SupplierAddressId is not null returns all rows. Escape string literals; never pass unvalidated natural-language input as a query.",
            "id": 24,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "SupplierAddressId is not null"
          },
          {
            "name": "limit",
            "dataType": "integer",
            "description": "Positive integer page size, default 25; caller-enforced recommended maximum 100.",
            "id": 25,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "25"
          },
          {
            "name": "offset",
            "dataType": "integer",
            "description": "Nonnegative integer offset, default 0. Advance by response count while hasMore is true.",
            "id": 26,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "0"
          }
        ],
        "headers": {
          "REST-Framework-Version": "4"
        },
