            "isToken": true,
            "location": "path",
            "source": "openapi",
            "defaultValue": ""
          },
          {
            "name": "filter",
            "dataType": "string",
            "description": "Trusted caller-authored framework-v4 rowmatch expression using documented queryable sites attributes. Default SupplierSiteId is not null returns all rows. Escape string literals; never pass unvalidated natural-language input as a query.",
            "id": 31,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "SupplierSiteId is not null"
          },
          {
            "name": "limit",
            "dataType": "integer",
            "description": "Positive integer page size, default 25; caller-enforced recommended maximum 100.",
            "id": 32,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "25"
          },
