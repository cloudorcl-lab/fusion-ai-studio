{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "XDX Supplier Lifecycle Conversation State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "revision",
    "requestId",
    "selectedSupplier",
    "queryResults",
    "selectionKeys",
    "referenceRecord",
    "draft",
    "fieldProvenance",
    "missingFields",
    "approvedSnapshot",
    "operations",
    "verification",
    "lastMessage"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "phase": {
      "type": "string",
      "enum": [
        "QUERY",
        "SELECT",
        "GATHER",
        "REFERENCE_REVIEW",
        "VALIDATE",
        "FINAL_REVIEW",
        "APPROVED",
        "EXECUTING",
        "VERIFYING",
        "COMPLETE",
        "REJECTED",
        "CANCELLED",
        "VALIDATION_ERROR",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "selectedSupplier": { "type": ["object", "null"] },
    "queryResults": { "type": "array", "maxItems": 100 },
    "selectionKeys": { "type": "array", "maxItems": 100 },
    "referenceRecord": { "type": ["object", "null"] },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "intentText", "requiredFields"],
      "properties": {
        "resource": { "type": "string", "minLength": 1, "maxLength": 80 },
        "intentText": { "type": "string", "maxLength": 2000 },
        "requiredFields": { "type": "object" }
      }
    },
    "fieldProvenance": { "type": "object" },
    "missingFields": { "type": "array", "items": { "type": "string" } },
    "approvedSnapshot": {
      "type": ["object", "null"],
      "properties": {
        "requestId": { "type": "string" },
        "revision": { "type": "integer" },
        "normalizedPayload": { "type": "object" },
        "targetParent": { "type": ["object", "null"] }
      }
    },
    "operations": { "type": "array", "maxItems": 25 },
    "verification": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "type": "string" },
        "checks": { "type": "array" }
      }
    },
    "lastMessage": { "type": "string", "maxLength": 2000 }
  }
}
